---
import { ViewTransitions } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import SmartContactModal from '../components/SmartContactModal.astro';
import SmartMeetingModal from '../components/SmartMeetingModal.astro';
import ProvizeModal from '../components/ProvizeModal.astro';
import CookieSystem from '../components/CookieSystem.astro';
import FormThankYouModal from '../components/FormThankYouModal.astro';
import SEO from '../components/SEO.astro';
import IntroLoader from '../components/IntroLoader.astro';
// import IntroLoaderMobile from '../components/IntroLoaderMobile.astro'; // temporarily off
import '../styles/global.css';
import 'aos/dist/aos.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogTitle?: string;
  ogDescription?: string;
  canonical?: string;
  ogType?: string;
  robots?: string;
  heroIntro?: boolean;
  theme?: 'light' | 'dark';
  hideNav?: boolean;
}
const {
  title = 'REAMAR | Reality. Marketing.',
  description = 'Propojujeme marketing a obchod pro realitní developery.',
  image,
  ogTitle,
  ogDescription,
  canonical,
  ogType,
  robots,
  heroIntro = false,
  theme = 'light',
  hideNav = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="cs" class="overflow-x-clip w-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href="/fonts/Yellix-Medium.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    {heroIntro && (
      <link rel="preload" as="image" href="/video/hero-poster.jpg" fetchpriority="high" />
    )}
    {heroIntro && (
      <script is:inline>
        (function () {
          try {
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var desktop = window.matchMedia('(min-width: 1024px)').matches;
            var seen = sessionStorage.getItem('rmIntroSeen') === '1';
            var root = document.documentElement;
            root.classList.remove('rmi-on', 'rmi-skip', 'rmi-landing', 'rmm-on', 'rmm-skip', 'rmm-landing');
            root.classList.add(!reduce && !seen && desktop ? 'rmi-on' : 'rmi-skip');
            // Mobile intro temporarily disabled — was leaking page chrome under the fullscreen stage.
            root.classList.add('rmm-skip');
          } catch (e) {}
        })();
      </script>
    )}
    <SEO
      title={title}
      description={description}
      image={image}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      canonical={canonical}
      ogType={ogType}
      robots={robots}
    />
    <link rel="icon" type="image/svg+xml" href="/images/Reamar%20SVG.svg" />
    <ViewTransitions />
    <script is:inline>
      // Early videoDebug bootstrap — catches inline play() before module scripts.
      (function () {
        try {
          if (!/(?:^|[?&])videoDebug=1(?:&|$)/.test(location.search)) return;
        } catch (e) { return; }
        window.__vdEnabled = true;
        window.__vdLog = window.__vdLog || [];
        var t0 = performance.now();
        function push(line) {
          window.__vdLog.push(line);
          if (window.__vdLog.length > 220) window.__vdLog.splice(0, window.__vdLog.length - 220);
          var pre = document.getElementById('vd-pre');
          if (pre) {
            pre.textContent = window.__vdLog.join('\n');
            var panel = document.getElementById('vd-panel');
            if (panel) panel.scrollTop = panel.scrollHeight;
          }
        }
        window.__vdPush = function (tag, detail) {
          var ms = Math.round((performance.now() - t0) * 10) / 10;
          push(ms + 'ms [' + tag + ']' + (detail ? ' ' + detail : ''));
        };
        function ensure() {
          if (document.getElementById('vd-panel')) return;
          var panel = document.createElement('div');
          panel.id = 'vd-panel';
          panel.setAttribute('aria-live', 'polite');
          panel.style.cssText = 'position:fixed;left:6px;top:6px;z-index:2147483646;width:min(96vw,420px);max-height:48vh;overflow:auto;margin:0;padding:8px;background:rgba(0,0,0,.82);color:#d8ffd8;font:11px/1.35 ui-monospace,Menlo,monospace;border:1px solid rgba(255,255,255,.25);-webkit-overflow-scrolling:touch';
          panel.innerHTML = '<div style="color:#fff;font-weight:600;margin-bottom:6px">videoDebug (early)</div><pre id="vd-pre" style="margin:0;white-space:pre-wrap;word-break:break-word"></pre>';
          (document.body || document.documentElement).appendChild(panel);
          document.getElementById('vd-pre').textContent = window.__vdLog.join('\n');
        }
        if (document.body) ensure();
        else document.addEventListener('DOMContentLoaded', ensure);
        window.__vdPush('early-boot', location.href);
        if (!window.__vdOrigPlay) {
          window.__vdOrigPlay = HTMLVideoElement.prototype.play;
          HTMLVideoElement.prototype.play = function () {
            var label = this.getAttribute('data-mhero-video') || this.getAttribute('data-hero-loop') || this.className.slice(0, 28) || 'video';
            window.__vdPush('play()', JSON.stringify({
              video: label,
              paused: this.paused,
              readyState: this.readyState,
              t: Math.round(this.currentTime * 1000) / 1000,
              muted: this.muted,
              autoplay: this.hasAttribute('autoplay'),
              playsinline: this.hasAttribute('playsinline'),
              w: Math.round(this.getBoundingClientRect().width),
              h: Math.round(this.getBoundingClientRect().height)
            }));
            var result = window.__vdOrigPlay.apply(this, arguments);
            if (result && result.then) {
              result.then(function () {
                window.__vdPush('play:ok', JSON.stringify({ video: label, paused: this.paused, t: Math.round(this.currentTime * 1000) / 1000, readyState: this.readyState }));
              }.bind(this), function (err) {
                window.__vdPush('play:fail', JSON.stringify({ video: label, name: err && err.name, message: err && err.message }));
              });
            }
            return result;
          };
        }
      })();
    </script>
    <script is:inline>
      function handleModalClick(event) {
        console.log('[Modal] click fired, target:', event.target);
        var target = event.target.closest('[data-smart-contact-open], [data-smart-meeting-open], [data-provize-open]');
        console.log('[Modal] closest result:', target);
        if (!target) return;
        event.preventDefault();
        event.stopPropagation();
        console.log('[Modal] dispatching event for:', target);
        if (target.hasAttribute('data-provize-open')) {
          var variant = target.getAttribute('data-provize-variant') || 'priority';
          window.dispatchEvent(new CustomEvent('provize-open', { detail: { variant: variant } }));
        } else if (target.hasAttribute('data-smart-contact-open')) {
          var type = target.getAttribute('data-smart-contact-type') || 'developer';
          var service = target.getAttribute('data-smart-contact-service') || null;
          window.dispatchEvent(new CustomEvent('smart-contact-open', { detail: { initialType: type, initialService: service } }));
        } else {
          var meetingType = target.getAttribute('data-smart-meeting-type') || 'developer';
          var meetingService = target.getAttribute('data-smart-meeting-service') || null;
          window.dispatchEvent(new CustomEvent('smart-meeting-open', { detail: { initialType: meetingType, initialService: meetingService } }));
        }
      }

      document.addEventListener('click', handleModalClick, true);

      document.addEventListener('astro:after-swap', function () {
        console.log('[Modal] astro:after-swap fired — re-registering listener');
        document.removeEventListener('click', handleModalClick, true);
        document.addEventListener('click', handleModalClick, true);
      });

      document.addEventListener('astro:page-load', function () {
        console.log('[Modal] astro:page-load fired');
      });

      function rmResetIntroMedia() {
        document.querySelectorAll('[data-intro-media]').forEach(function (el) {
          ['top', 'left', 'right', 'bottom', 'width', 'height'].forEach(function (prop) {
            el.style.removeProperty(prop);
          });
          el.classList.remove('rmi-still', 'rmm-still');
        });
      }

      function rmSkipIntro() {
        try { sessionStorage.setItem('rmIntroSeen', '1'); } catch (e) {}
        var root = document.documentElement;
        root.classList.remove('rmi-on', 'rmi-landing', 'rmm-on', 'rmm-landing');
        root.classList.add('rmi-skip', 'rmm-skip');
        var rmi = document.getElementById('rmi');
        var rmm = document.getElementById('rmm');
        if (rmi) rmi.remove();
        if (rmm) rmm.remove();
        rmResetIntroMedia();
      }

      function rmCloseStuckOverlays() {
        if (document.body) document.body.style.overflow = '';
        var drawer = document.querySelector('[data-menu-drawer]');
        if (drawer) {
          drawer.removeAttribute('data-open');
          drawer.classList.add('pointer-events-none');
          drawer.setAttribute('aria-hidden', 'true');
          var backdrop = drawer.querySelector('[data-drawer-backdrop]');
          var panel = drawer.querySelector('[data-drawer-panel]');
          if (backdrop) backdrop.removeAttribute('data-open');
          if (panel) panel.removeAttribute('data-open');
          var toggle = document.querySelector('[data-nav-toggle]');
          if (toggle) toggle.setAttribute('aria-expanded', 'false');
        }
        ['smart-contact-overlay', 'smart-meeting-overlay', 'provize-overlay', 'form-thankyou-overlay', 'cookie-modal-overlay'].forEach(function (id) {
          var overlay = document.getElementById(id);
          if (!overlay) return;
          overlay.classList.add('opacity-0', 'pointer-events-none');
          overlay.classList.remove('is-open');
          overlay.setAttribute('aria-hidden', 'true');
        });
      }

      function rmOnClientNav() {
        rmSkipIntro();
        rmCloseStuckOverlays();
      }

      if (!window.__rmOverlayCleanupBound) {
        window.__rmOverlayCleanupBound = true;
        document.addEventListener('astro:before-preparation', rmOnClientNav);
        document.addEventListener('astro:before-swap', rmOnClientNav);
        document.addEventListener('astro:after-swap', rmOnClientNav);
        document.addEventListener('astro:page-load', function () {
          rmCloseStuckOverlays();
          try {
            if (sessionStorage.getItem('rmIntroSeen') === '1') rmSkipIntro();
          } catch (e) {}
        });
      }
    </script>
  </head>
  <body class="font-yellix overflow-x-clip w-full min-w-0">
    {heroIntro && <IntroLoader />}
    {/* Mobile intro (IntroLoaderMobile) temporarily off */}
    {!hideNav && <Navigation currentPath={Astro.url.pathname} />}
    <main id="main" role="main" class="min-w-0 overflow-x-clip">
      <slot />
    </main>
    <SmartContactModal />
    <SmartMeetingModal />
    <ProvizeModal />
    <CookieSystem />
    <FormThankYouModal />
    <script>
      import AOS from 'aos';
      const aosOptions = { duration: 800, easing: 'ease', offset: 60, once: false };
      AOS.init(aosOptions);
      document.addEventListener('astro:page-load', function () {
        AOS.init(aosOptions);
      });
    </script>
    <script>
      import { bindHeroLoop, installHeroLoopLifecycle } from '../scripts/hero-loop';
      import { installVideoDebug, isVideoDebug } from '../scripts/video-debug';

      // VT cleanup for owned loops lives in hero-loop — Layout must not play/pause heroes.
      installHeroLoopLifecycle();
      if (isVideoDebug()) installVideoDebug();

      function initUnmanagedDecorativeLoops() {
        document.querySelectorAll('.video-decorative-wrap').forEach(function (wrap) {
          if (wrap.hasAttribute('data-cover-managed')) return;
          var video = wrap.querySelector('video[data-decorative-autoplay]');
          if (!video || video.hasAttribute('data-loop-owned')) return;
          bindHeroLoop(video, {
            host: wrap,
            markHost: wrap,
            eager: true,
          });
        });
      }

      initUnmanagedDecorativeLoops();
      document.addEventListener('astro:page-load', initUnmanagedDecorativeLoops);
    </script>
  </body>
</html>
