---
import Layout from '../layouts/Layout.astro';
import { seoHomepage } from '../data/seo';
import HeroSplit from '../components/HeroSplit.astro';
import SectionFormujeme from '../components/SectionFormujeme.astro';
import DeveloperServices from '../components/DeveloperServices.astro';
import ServiceList from '../components/ServiceList.astro';
import SectionProdej from '../components/SectionProdej.astro';
import SectionKlientyHero from '../components/SectionKlientyHero.astro';
import SectionKlientyServices from '../components/SectionKlientyServices.astro';
import SectionZahranici from '../components/SectionZahranici.astro';
import Footer from '../components/Footer.astro';
---
<Layout title={seoHomepage.title} description={seoHomepage.description} ogTitle={seoHomepage.ogTitle} ogDescription={seoHomepage.ogDescription} canonical={seoHomepage.canonical} image={seoHomepage.image}>
  <HeroSplit />
  <SectionFormujeme />
  <DeveloperServices />
  <ServiceList />
  <SectionProdej />
  <SectionKlientyHero />
  <SectionKlientyServices />
  <SectionZahranici />
  <Footer />
</Layout>
