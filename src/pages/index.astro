---
import Layout from '../layouts/Layout.astro';
import HeroStrip from '../components/HeroStrip.astro';
import SectionBuyersAgentHorizont from '../components/SectionBuyersAgentHorizont.astro';
import SectionNasPribeh from '../components/SectionNasPribeh.astro';
import ManifestSection from '../components/ManifestSection.astro';
import SectionPorovnaniNakup from '../components/SectionPorovnaniNakup.astro';
import SectionZastoupeni from '../components/onepager/SectionZastoupeni.astro';
import CoZiskate from '../components/CoZiskate.astro';
import SectionCoDelaAgent from '../components/SectionCoDelaAgent.astro';
import CoOdNasDostanete from '../components/CoOdNasDostanete.astro';
import NasRozdil from '../components/NasRozdil.astro';
import SectionReference from '../components/SectionReference.astro';
import SectionFooter from '../components/SectionFooter.astro';
import PoptavkaPatickaSvetla from '../components/PoptavkaPatickaSvetla.astro';
import JsonLd from '../components/JsonLd.astro';
import { seoPages } from '../data/seo-pages';
import { organizationGraph } from '../lib/jsonld';

const s = seoPages.home;
---
<Layout
  title={s.title}
  description={s.description}
  canonical={s.canonical}
  image={s.image}
  ogTitle={s.ogTitle}
  ogDescription={s.ogDescription}
  ogImageAlt={s.ogImageAlt}
  heroIntro
>
  <JsonLd data={organizationGraph()} />
  <div class="hero-cover hero-cover--plain-em">
    <div class="hero-cover-pin">
      <HeroStrip />
    </div>
    <SectionBuyersAgentHorizont
      videoSrc="/video/penthouse-nahled.mp4"
      posterSrc="/video/penthouse-nahled.jpg"
      mobileCards="editorial"
      showPack={false}
    />
  </div>
  <div class="home-flow">
    <div class="home-slot home-chat"><SectionCoDelaAgent /></div>
    <div class="home-slot home-zazemi"><CoOdNasDostanete /></div>
    <div class="home-slot home-role">
      <NasRozdil videoSrc="/videos/motivace.mp4" poster="/videos/motivace-poster.jpg" layout="editorial" />
    </div>
    <div class="home-slot home-pribeh">
      <SectionNasPribeh
        ctaHref="/o-nas"
        ctaLabel="Více o nás"
      />
    </div>
    <div class="home-slot home-manifest"><ManifestSection /></div>
    <div class="home-slot home-compare">
      <SectionPorovnaniNakup ctaHref="#poptavka" />
    </div>
    <div class="home-slot home-rozhodnuti"><SectionZastoupeni showCompare /></div>
    <div class="home-slot home-software"><CoZiskate ctaHref="/klientsky-portal" /></div>
    <div class="home-slot home-reference"><SectionReference /></div>
    <div class="home-slot home-kontakt">
      <PoptavkaPatickaSvetla
        context="/"
        photoCol="820px"
        video="/images/agency/agent-pise.mp4"
        videoPoster="/images/agency/agent-pise.webp"
        photoPosition="center 22%"
      />
    </div>
    <div class="home-slot home-footer"><SectionFooter showIntro={false} /></div>
  </div>
</Layout>

<style>
  .hero-cover--plain-em :global(.hero-em) {
    text-decoration: none;
  }
  .hero-cover--plain-em :global(.hero-em::after) {
    content: none;
    display: none;
  }

  .home-flow,
  .home-slot {
    display: contents;
  }

  @media (max-width: 899px) {
    .home-flow {
      display: flex;
      flex-direction: column;
    }
    .home-slot {
      display: block;
      width: 100%;
      min-width: 0;
    }
    .home-chat { order: 1; }
    .home-zazemi { order: 2; }
    .home-software { order: 3; }
    .home-rozhodnuti { order: 4; }
    .home-role { order: 5; }
    .home-pribeh { order: 6; }
    .home-reference { order: 7; }
    .home-kontakt { order: 8; }
    .home-footer { order: 9; }
    .home-manifest,
    .home-compare {
      display: none;
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .hero-cover-pin {
      position: sticky;
      top: 0;
    }
    .hero-cover-pin:has([data-strip-modal]:not([hidden])) {
      z-index: 80;
    }
    .hero-cover :global(.bah) {
      position: relative;
      z-index: 1;
    }
  }
</style>
