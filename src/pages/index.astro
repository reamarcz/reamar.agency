---
import Layout from '../layouts/Layout.astro';
import HeroStrip from '../components/HeroStrip.astro';
import SectionBuyersAgentHorizont from '../components/SectionBuyersAgentHorizont.astro';
import SectionPrilecitosti from '../components/SectionPrilecitosti.astro';
import SectionSpecializace from '../components/SectionSpecializace.astro';
import SectionNasPribeh from '../components/SectionNasPribeh.astro';
import ManifestSection from '../components/ManifestSection.astro';
import SectionPorovnani from '../components/SectionPorovnani.astro';
import SectionZastoupeni from '../components/onepager/SectionZastoupeni.astro';
import SectionVyberSluzeb from '../components/SectionVyberSluzeb.astro';
import SectionReference from '../components/SectionReference.astro';
import SectionFooter from '../components/SectionFooter.astro';
---
<Layout
  title="REAMAR Agency"
  description="Zastupujeme kupující na developerském trhu. Sledujeme trh, vybíráme vhodné jednotky a jednáme s developerem na vaší straně."
  canonical="/"
  heroIntro
>
  <div class="hero-cover hero-cover--plain-em">
    <div class="hero-cover-pin">
      <HeroStrip />
    </div>
    <SectionBuyersAgentHorizont
      videoSrc="/video/penthouse-nahled.mp4"
      posterSrc="/video/penthouse-nahled.jpg"
    />
  </div>
  <div class="lg:hidden">
    <SectionPrilecitosti ctaHref="#vyber-sluzeb" />
    <SectionSpecializace />
  </div>
  <div class="flex flex-col">
    <div class="order-2 lg:order-1">
      <ManifestSection />
    </div>
    <div class="order-3 lg:order-2">
      <SectionPorovnani ctaHref="#vyber-sluzeb" intro={false} />
    </div>
    <div class="order-1 lg:order-3">
      <SectionNasPribeh
        ctaHref="/o-nas"
        ctaLabel="Více o nás"
      />
    </div>
    <div class="order-5 lg:order-4">
      <SectionVyberSluzeb headingAs="h2" compactTop={false} />
    </div>
    <div class="order-4 lg:order-5">
      <SectionZastoupeni />
    </div>
  </div>
  <SectionReference />
  <SectionFooter />
</Layout>

<style>
  .hero-cover--plain-em :global(.hero-em) {
    text-decoration: none;
  }
  .hero-cover--plain-em :global(.hero-em::after) {
    content: none;
    display: none;
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .hero-cover-pin {
      position: sticky;
      top: 0;
    }
    .hero-cover-pin:has([data-strip-modal]:not([hidden])) {
      z-index: 80;
    }
    .hero-cover :global(.bah) {
      position: relative;
      z-index: 1;
    }
  }
</style>
