---
import Layout from '../layouts/Layout.astro';
import BydleniHero from '../components/BydleniHero.astro';
import InvesticePruchod from '../components/InvesticePruchod.astro';
import SectionSpecializace from '../components/SectionSpecializace.astro';
import SectionVyberSluzeb from '../components/SectionVyberSluzeb.astro';
import SectionFooter from '../components/SectionFooter.astro';
import PoptavkaPatickaSvetla from '../components/PoptavkaPatickaSvetla.astro';
import JsonLd from '../components/JsonLd.astro';
import { seoPages } from '../data/seo-pages';
import { organizationGraph, serviceLd } from '../lib/jsonld';

const s = seoPages.investice;
---

<Layout
  title={s.title}
  description={s.description}
  canonical={s.canonical}
  image={s.image}
  ogTitle={s.ogTitle}
  ogDescription={s.ogDescription}
  ogImageAlt={s.ogImageAlt}
>
  <JsonLd data={organizationGraph()} />
  <JsonLd
    data={serviceLd({
      name: 'Vyhledávání investičních novostaveb',
      description: s.description,
      url: s.canonical,
    })}
  />
  <div class="hero-cover">
    <div class="hero-cover-pin">
      <BydleniHero
        mode="trh"
        claim={['Zastupujeme investory', 'na developerském trhu']}
        mobilePosterSrc="/images/agency/poster-epizoda-0-14-720.webp"
      />
    </div>
    <InvesticePruchod />
  </div>
  <SectionSpecializace />
  <SectionVyberSluzeb headingAs="h2" compactTop={false} showSubline={false} />
  <PoptavkaPatickaSvetla
    tone="dark"
    preset="investice"
    context="/investice"
    photoCol="820px"
    photo="/images/agency/poptavka-jan-u-stolu.jpg"
  />
  <SectionFooter showIntro={false} />
</Layout>

<style>
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .hero-cover-pin {
      position: sticky;
      top: 0;
    }
    .hero-cover :global(.invp) {
      position: relative;
      z-index: 1;
    }
  }
</style>
