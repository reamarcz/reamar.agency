    'district-praha-4':  { label: 'Praha 4',  price: 175,  role: 'Volume mid' },
    'district-praha-5':  { label: 'Praha 5',  price: 184,  role: 'Broad market' },
    'district-praha-6':  { label: 'Praha 6',  price: 169,  role: '' },
    'district-praha-7':  { label: 'Praha 7',  price: 252,  role: 'Premium pricing ★' },
    'district-praha-8':  { label: 'Praha 8',  price: 178,  role: '' },
    'district-praha-9':  { label: 'Praha 9',  price: 171,  role: 'Volume leader ★' },
    'district-praha-10': { label: 'Praha 10', price: 162,  role: 'Mainstream' },
    'district-praha-11': { label: 'Praha 11', price: 188,  role: '' },
    'district-praha-12': { label: 'Praha 12', price: 170,  role: '' },
    'district-praha-13': { label: 'Praha 13', price: 149,  role: '' },
    'district-praha-14': { label: 'Praha 14', price: 159,  role: '' },
    'district-praha-15': { label: 'Praha 15', price: 162,  role: '' },
    'district-praha-16': { label: 'Praha 16', price: 168,  role: '' },
    'district-praha-17': { label: 'Praha 17', price: 193,  role: '' },
    'district-praha-18': { label: 'Praha 18', price: 147,  role: '' },
    'district-praha-19': { label: 'Praha 19', price: 160,  role: '' },
    'district-praha-20': { label: 'Praha 20', price: null,  role: '' },
    'district-praha-21': { label: 'Praha 21', price: null,  role: '' },
    'district-praha-22': { label: 'Praha 22', price: 146,  role: '' },
  };
  function mapColor() {
    // Clean map design: keep all districts visually neutral and reveal detail via hover tooltip.
    return '#dadad7';
  }
  var mapTooltip = document.getElementById('map-tooltip');
  var ttName = document.getElementById('map-tt-name');
  var ttPrice = document.getElementById('map-tt-price');
  var ttRole = document.getElementById('map-tt-role');
  var mapContainer = document.getElementById('map-container');
  var mapPanel = document.getElementById('map-panel');
  var panelName = document.getElementById('map-panel-name');
  var panelPrice = document.getElementById('map-panel-price');
  var panelRole = document.getElementById('map-panel-role');
  var panelClose = document.getElementById('map-panel-close');
  var isTouch = window.matchMedia('(hover: none)').matches;

  if (panelClose && mapPanel) {
    panelClose.addEventListener('click', function() { mapPanel.classList.add('hidden'); });
  }

  Object.keys(mapData).forEach(function(id) {
    var d = mapData[id];
    var g = document.getElementById(id);
    if (!g) return;
    var path = g.querySelector('.a');
    if (!path) return;
    var baseColor = mapColor(d.price);
    path.style.fill = baseColor;
    g.style.cursor = 'pointer';

    // Desktop: tooltip on hover
    g.addEventListener('mouseenter', function() {
      path.style.fill = '#000';
      if (!isTouch && mapTooltip) {
        ttName.textContent = d.label;
        ttPrice.textContent = d.price ? d.price + ' 000 Kč/m²' : 'Omezená data';
        ttRole.textContent = d.role || '';
        ttRole.style.display = d.role ? '' : 'none';
        mapTooltip.classList.remove('opacity-0');
      }
    });
    g.addEventListener('mousemove', function(e) {
      if (isTouch || !mapTooltip || !mapContainer) return;
      var rect = mapContainer.getBoundingClientRect();
      var x = e.clientX - rect.left + 16;
      var y = e.clientY - rect.top - 80;
      mapTooltip.style.left = Math.min(x, rect.width - 210) + 'px';
      mapTooltip.style.top = Math.max(y, 0) + 'px';
    });
    g.addEventListener('mouseleave', function() {
      path.style.fill = baseColor;
      if (mapTooltip) mapTooltip.classList.add('opacity-0');
    });

    // Touch/click: panel below map
    g.addEventListener('click', function() {
      if (!mapPanel || !panelName || !panelPrice || !panelRole) return;
      panelName.textContent = d.label;
      panelPrice.textContent = d.price ? d.price + ' 000 Kč/m²' : 'Omezená data';
      panelRole.textContent = d.role || '';
      panelRole.style.display = d.role ? '' : 'none';
      mapPanel.classList.remove('hidden');
      if (isTouch) mapPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });

  // ── 6. Forecast chart ─────────────────────────────────────────────
  const fcLabels = ['25Q1','25Q2','25Q3','25Q4','26Q1','26Q2','26Q3','26Q4'];
  const fcActual = [159778,165019,168785,174375,176464,null,null,null];
  const fcPred   = [null,null,null,null,176464,182000,187000,192000];

  new Chart(document.getElementById('chartForecast'), {
    type: 'line',
    data: {
      labels: fcLabels,
      datasets: [
        { label: 'Skutečnost', data: fcActual, borderColor: '#000', borderWidth: 2.5, pointRadius: 3, pointBackgroundColor: '#000', tension: 0.3 },
        { label: 'Predikce', data: fcPred, borderColor: 'rgba(0,0,0,0.35)', borderWidth: 2, borderDash: [6,4], pointRadius: 3, pointBackgroundColor: '#fff', pointBorderColor: '#000', tension: 0.3 }
      ]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: true, position: 'bottom', labels: { font: { size: 10 }, boxWidth: 10, padding: 12 } },
        tooltip: { callbacks: { label: ctx => ctx.raw ? ctx.raw.toLocaleString('cs-CZ') + ' Kč/m²' : '' } }
      },
      scales: {
        x: { grid: { display: false }, ticks: { font: { size: 10 } } },
        y: { grid: { color: 'rgba(0,0,0,0.05)' }, ticks: { font: { size: 10 }, callback: v => (v/1000).toFixed(0) + 'k' }, min: 150000 }
      }
    }
  });

});
</script>

</Layout>
