<script is:inline>
(function () {
  var form = document.getElementById('newsletter-form');
  var msg  = document.getElementById('newsletter-msg');
  var btn  = document.getElementById('newsletter-btn');
  if (!form) return;
  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    var email = form.querySelector('input[name="email"]').value.trim();
    btn.disabled = true;
    btn.textContent = 'Odesílám…';
    try {
      var res = await fetch('/_actions/sendContactForm', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ formSource: 'newsletter', email: email })
      });
      var json = await res.json();
      if (json && json.data && json.data.success) {
        form.classList.add('hidden');
        msg.textContent = 'Hotovo — budeme vás informovat o dalším vydání.';
        msg.className = 'text-sm text-white/55';
      } else {
        throw new Error((json && json.error && json.error.message) || 'Chyba odesílání.');
      }
    } catch (err) {
      msg.textContent = err.message || 'Nepodařilo se odeslat. Zkuste to prosím znovu.';
      msg.className = 'text-sm text-red-400';
      btn.disabled = false;
      btn.textContent = 'Přihlásit k odběru';
    }
  });
})();
</script>

