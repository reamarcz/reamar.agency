    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20 pt-14">
      <div data-aos="fade-right">
        <p class="text-[10px] font-medium uppercase tracking-[0.2em] text-black/35 mb-5">Velikostní prémie</p>
