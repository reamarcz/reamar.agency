---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const summaryItems = [
  { label: 'Nabídka', value: 'Mírně vzrostla na začátku roku na 5 852 dostupných jednotek.' },
  { label: 'Poptávka', value: 'Po silném závěru roku oslabila, ale nadále zůstává silná.' },
  { label: 'Absorpce', value: 'Prodala se čtvrtina nabídky — 26 % dostupných jednotek.' },
  { label: 'Nabídková cena', value: 'Mezikvartálně nárůst o 0,9 % vůči Q4 2025. Historické maximum.' },
  { label: 'Ceny dle dispozice', value: 'Nejdražší jsou malé byty 1+kk a velké byty 4+kk+.' },
  { label: 'Prodeje Q1 2026', value: 'Dominoval Kolbenova park (CPI, P9) a Tesla Hloubětín.' },
  { label: 'Inflace', value: 'V Q1 poklesla pod 2 % — nejnižší hodnota od 2021.' },
  { label: 'HDP', value: 'Stabilizace na úrovni kolem 3 % s předpokladem dalšího růstu.' },
  { label: 'Úrokové sazby', value: '3,5 % PRIBOR s očekáváním pomalého růstu.' },
  { label: 'Predikce prodejů', value: 'Prodejní tempo zůstane solidní kolem 1 500 prodejů za čtvrtletí.' },
  { label: 'Predikce ceny', value: 'Růst bude dále pokračovat přibližně 4–5% tempem za rok.' },
];

const newsItems = [
  {
    title: 'Více nových projektů',
    image: '/images/vicenovychprojektu.jpg',
    alt: 'Vizualizace nových rezidenčních projektů v Praze',
    body: 'V prvním čtvrtletí roku 2026 se pražský rezidenční trh rozrostl o několik nových projektů a nabídka se rozrostla o více než 2 000 bytů. Do prodeje zároveň vstoupily i významnější developerské projekty, jako jsou Žižkov 3.0, Skytowers Malešice či Dvory Vysočany.',
  },
  {
    title: 'Posun na Nákladovém nádraží Žižkov',
    image: '/images/zizkov.webp',
    alt: 'Nákladové nádraží Žižkov a rozvoj lokality',
    body: 'Lokalita brownfieldu na Žižkově se dále posunula. Společnost Penta Real Estate už zahájila výstavbu svého projektu a společnosti Sekyra a Cresco se k zahájení výrazně přiblížily. Jde o další krok v rozvoji celého území — již v létě by se zde měla začít stavět tramvajová trať.',
  },
  {
    title: 'Úrokové sazby pod tlakem',
    image: '/images/sazby.jpeg',
    alt: 'Graf úrokových sazeb hypoték',
    body: 'Nejistá geopolitická situace vedla některé banky ke zvýšení úrokových sazeb u nových hypoték na konci čtvrtletí. Jejich další vývoj bude záviset zejména na dalším dění na Blízkém východě a rozhodnutích ECB a ČNB.',
  },
];

const liquidityBands = [
  { band: '< 120 000', pct: 97, color: 'bg-black' },
  { band: '130 000', pct: 88, color: 'bg-black/60' },
  { band: '140 000', pct: 69, color: 'bg-black/60' },
  { band: '150 000', pct: 71, color: 'bg-black/60' },
  { band: '160 000', pct: 66, color: 'bg-black/60' },
  { band: '170 000', pct: 60, color: 'bg-black/30' },
  { band: '180 000', pct: 53, color: 'bg-black/30' },
  { band: '190 000', pct: 52, color: 'bg-black/30' },
  { band: '200 000', pct: 49, color: 'bg-black/[0.12]' },
  { band: '210 000', pct: 43, color: 'bg-black/[0.12]' },
  { band: '220 000+', pct: 34, color: 'bg-black/[0.12]' },
];

const topHouses2025 = [
  { n: 'Alterna', s: 26 },
  { n: 'Nová Květice', s: 24 },
  { n: 'Na Malé Růži 6. Etapa', s: 18 },
  { n: 'Klecanská Alej', s: 18 },
  { n: 'Bydlení Jinočany', s: 15 },
  { n: 'Rodinné domy Satalice', s: 15 },
  { n: 'Řadové domy Buštěhrad', s: 15 },
  { n: 'Praha - Park Nehvizdy', s: 12 },
  { n: 'Domy Bílý Vrch', s: 11 },
  { n: 'Zahradní čtvrť Kyje', s: 11 },
];
---
<Layout
  title="Pražský rezidenční trh | REAMAR"
  description="Prague Residential Intelligence Report Q1 2026 – ceny, absorpce, likvidita, obvody, nájemní výnosy a výhled pro investory a developery."
  canonical="https://www.reamar.cz/prazsky-rezidencni-trh"
>

<!-- ── HERO ─────────────────────────────────────────────────────────────── -->
<section class="pt-32 pb-20 md:pt-44 md:pb-28 bg-white">
  <div class="mx-auto max-w-[1600px] px-6 lg:px-10">
    <div class="max-w-3xl">
      <p class="text-xs font-medium tracking-[0.18em] uppercase text-black/40 mb-5">Prague Residential Intelligence · Q1 2026</p>
      <h1 class="font-yellix text-[clamp(2.4rem,5vw,4rem)] font-medium leading-[1.08] tracking-tight text-black">
        Pražský<br/>rezidenční trh
      </h1>
      <p class="mt-6 text-lg text-black/60 max-w-xl leading-relaxed">
        Komplexní datový přehled novostaveb v Praze. Ceny, absorpce, likvidita, obvody a výhled – vše na jednom místě.
      </p>
      <p class="mt-3 text-xs text-black/35">Zdroje: BuiltMind, Deloitte, Sreality, ČNB</p>
    </div>

    <!-- KPI grid -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-px bg-black/8" data-aos="fade-up" data-aos-delay="100">
      <div class="bg-white px-4 py-6 md:px-8 md:py-8">
        <p class="text-xs font-medium tracking-widest uppercase text-black/40 mb-2">Průměrná cena / m²</p>
        <p class="font-yellix text-2xl md:text-4xl font-medium text-black whitespace-nowrap counter" data-target="176464" data-suffix="&nbsp;Kč">0</p>
        <p class="mt-1 text-xs text-black/40">+10,4 % meziročně</p>
      </div>
      <div class="bg-white px-4 py-6 md:px-8 md:py-8">
        <p class="text-xs font-medium tracking-widest uppercase text-black/40 mb-2">Prodané jednotky Q1</p>
        <p class="font-yellix text-2xl md:text-4xl font-medium text-black counter" data-target="1504" data-suffix="">0</p>
        <p class="mt-1 text-xs text-black/40">Absorpce 26 %</p>
      </div>
      <div class="bg-white px-4 py-6 md:px-8 md:py-8">
        <p class="text-xs font-medium tracking-widest uppercase text-black/40 mb-2">Dostupné jednotky</p>
        <p class="font-yellix text-2xl md:text-4xl font-medium text-black counter" data-target="5852" data-suffix="">0</p>
        <p class="mt-1 text-xs text-black/40">Praha, novostavby</p>
      </div>
      <div class="bg-white px-4 py-6 md:px-8 md:py-8">
        <p class="text-xs font-medium tracking-widest uppercase text-black/40 mb-2">Mezikvartální růst</p>
        <p class="font-yellix text-2xl md:text-4xl font-medium text-black">+0,9 %</p>
        <p class="mt-1 text-xs text-black/40">QoQ, 8. čtvrtletí v řadě</p>
      </div>
    </div>

    <!-- Teze -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6" data-aos="fade-up" data-aos-delay="150">
      <div class="border border-black/10 p-6">
        <div class="w-6 h-px bg-black mb-4"></div>
        <p class="text-sm font-medium text-black leading-relaxed">Historické maximum 176 464 Kč/m². Tempo růstu se stabilizuje, trend zůstává.</p>
      </div>
      <div class="border border-black/10 p-6">
        <div class="w-6 h-px bg-black mb-4"></div>
        <p class="text-sm font-medium text-black leading-relaxed">Sweet spot likvidity: 130–170 tis. Kč/m². Pod 120k prakticky vyprodáno.</p>
      </div>
      <div class="border border-black/10 p-6">
        <div class="w-6 h-px bg-black mb-4"></div>
        <p class="text-sm font-medium text-black leading-relaxed">1+kk = nejvyšší likvidita (65 %). 2+kk = objemový motor trhu (42 % všech prodejů).</p>
      </div>
    </div>
  </div>
</section>

<!-- ── EXECUTIVE SUMMARY ─────────────────────────────────────────────── -->
<section class="py-20 md:py-28 bg-black text-white">
  <div class="mx-auto max-w-[1600px] px-6 lg:px-10">
    <div class="mb-14" data-aos="fade-up">
      <p class="text-xs font-medium tracking-[0.2em] uppercase text-white/65 mb-3">Q1 2026 · Přehled</p>
      <h2 class="font-yellix text-2xl md:text-4xl font-medium text-white leading-tight">Novinky a trendy</h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

      <!-- Bullet summary -->
      <div data-aos="fade-right">
        <div class="divide-y divide-white/10">
          {summaryItems.map(item => (
            <div class="py-4 flex gap-6 items-baseline">
              <span class="text-[10px] font-medium uppercase tracking-widest text-white/60 w-36 flex-shrink-0 leading-relaxed">{item.label}</span>
              <span class="text-sm text-white/85 leading-relaxed">{item.value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Zprávy z trhu -->
      <div data-aos="fade-left" data-aos-delay="80">
        <p class="text-[10px] font-medium uppercase tracking-[0.2em] text-white/65 mb-8">Zprávy z trhu</p>
        <div class="space-y-6">
          {newsItems.map((item) => (
            <article class="grid grid-cols-1 sm:grid-cols-[140px,1fr] gap-5 border border-white/15 bg-white/[0.02] p-4">
              <img
                src={item.image}
                alt={item.alt}
                loading="lazy"
                width="280"
                height="180"
                class="h-full min-h-[90px] w-full object-cover"
              />
              <div>
                <p class="text-sm font-medium text-white mb-2 leading-relaxed">{item.title}</p>
                <p class="text-sm text-white/80 leading-relaxed">{item.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>

    <!-- BuiltMind attribution -->
    <div class="mt-16 pt-10 border-t border-white/10" data-aos="fade-up">
      <p class="text-[10px] font-medium uppercase tracking-[0.2em] text-white/30 mb-7">
        Datový partner · Prague Residential Intelligence
      </p>
      <div class="flex flex-col md:flex-row md:items-center gap-7 md:gap-14">
        <a
          href="https://www.builtmind.com/cs/cs-cz/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 opacity-70 hover:opacity-100 transition-opacity duration-200"
          aria-label="BuiltMind"
        >
          <img
            src="/images/builtmind-logo.png"
            alt="BuiltMind"
            width="420"
            height="100"
            class="h-10 w-auto object-contain"
          />
        </a>
        <p class="text-sm text-white/38 leading-relaxed max-w-xl">
          BuiltMind je technologickým partnerem v oblasti datové analytiky pro rezidenční development. Zaměřuje se na automatizaci a dynamické oceňování nemovitostí za využití umělé inteligence a datové vědy. Své služby poskytuje nejvýznamnějším developerům v České republice i v zahraničí.&#32;<a
            href="https://www.builtmind.com/cs/cs-cz/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-white/50 hover:text-white/80 transition-colors duration-200 underline underline-offset-2 decoration-white/20"
          >builtmind.com<svg class="w-2.5 h-2.5 flex-shrink-0" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 9.5l7-7M4 2.5h5.5V8"/></svg></a>
        </p>
      </div>
    </div>

  </div>
</section>

<!-- ── HISTORICKÝ VÝVOJ CEN ───────────────────────────────────────────── -->
<section class="py-24 md:py-32 bg-[#f5f5f3]">
  <div class="mx-auto max-w-[1600px] px-6 lg:px-10">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10" data-aos="fade-up">
      <div>
        <p class="text-xs font-medium tracking-widest uppercase text-black/40 mb-2">2014 – 2026</p>
        <h2 class="font-yellix text-2xl md:text-3xl font-medium text-black">Historický vývoj cen</h2>
      </div>
      <div class="flex gap-6 text-xs text-black/50">
        <span class="flex items-center gap-2"><span class="w-8 h-0.5 bg-black inline-block"></span>Skutečnost</span>
        <span class="flex items-center gap-2"><span class="w-8 h-0.5 bg-black/30 inline-block border-dashed border-b border-black/30"></span>Predikce</span>
      </div>
    </div>
    <div class="bg-white p-4 md:p-8" data-aos="fade-up" data-aos-delay="80">
      <canvas id="chartHistory" style="max-height:420px"></canvas>
    </div>
    <!-- Fáze -->
    <div class="mt-8 grid grid-cols-2 md:grid-cols-5 gap-3" data-aos="fade-up" data-aos-delay="120">
      <div class="bg-white p-4 border-t-2 border-black/20">
        <p class="text-[10px] font-medium uppercase tracking-widest text-black/40 mb-1">2014–2015</p>
        <p class="text-sm font-medium text-black">Stabilní základ</p>
        <p class="text-lg font-medium text-black mt-1">+7,3 %</p>
      </div>
      <div class="bg-white p-4 border-t-2 border-black">
        <p class="text-[10px] font-medium uppercase tracking-widest text-black/40 mb-1">2016–2019</p>
        <p class="text-sm font-medium text-black">První akcelerace</p>
        <p class="text-lg font-medium text-black mt-1">+74,4 %</p>
      </div>
      <div class="bg-white p-4 border-t-2 border-black/60">
        <p class="text-[10px] font-medium uppercase tracking-widest text-black/40 mb-1">2020–2022</p>
        <p class="text-sm font-medium text-black">Pandemický boom</p>
        <p class="text-lg font-medium text-black mt-1">+42,5 %</p>
      </div>
      <div class="bg-white p-4 border-t-2 border-black/20">
        <p class="text-[10px] font-medium uppercase tracking-widest text-black/40 mb-1">2023</p>
        <p class="text-sm font-medium text-black">Korekce (PRIBOR 7 %)</p>
        <p class="text-lg font-medium text-black mt-1">−6,5 %</p>
      </div>
      <div class="bg-white p-4 border-t-2 border-black">
        <p class="text-[10px] font-medium uppercase tracking-widest text-black/40 mb-1">2024–2026 Q1</p>
        <p class="text-sm font-medium text-black">Nový rekordní cyklus</p>
        <p class="text-lg font-medium text-black mt-1">+24,2 %</p>
      </div>
    </div>
  </div>
</section>

<!-- ── CELKOVÁ CENA: SEGMENTY ────────────────────────────────────────── -->
<section class="py-20 md:py-28 bg-white">
  <div class="mx-auto max-w-[1600px] px-6 lg:px-10">
    <div class="mb-14" data-aos="fade-up">
      <p class="text-xs font-medium tracking-widest uppercase text-black/40 mb-2">Aktuální nabídka · Q1 2026</p>
      <h2 class="font-yellix text-2xl md:text-3xl font-medium text-black">Bytů pod 6 mil. Kč postupně ubývá</h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 items-start">
      <!-- Chart -->
      <div class="lg:col-span-2 bg-[#f5f5f3] p-4 md:p-8" data-aos="fade-right">
        <p class="text-xs font-medium uppercase tracking-widest text-black/40 mb-4">Nabídka podle dispozic (segmenty ceny) — počet jednotek</p>
        <canvas id="chartPriceTiers" style="max-height:360px"></canvas>
        <!-- Legend -->
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
          <span class="flex items-center gap-2 text-xs text-black/60"><span class="w-3 h-3 flex-shrink-0" style="background:#0d0d0d"></span>&lt; 6,0 mil. Kč</span>
          <span class="flex items-center gap-2 text-xs text-black/60"><span class="w-3 h-3 flex-shrink-0" style="background:#a0a0a0"></span>6,0–9,0 mil. Kč</span>
          <span class="flex items-center gap-2 text-xs text-black/60"><span class="w-3 h-3 flex-shrink-0" style="background:#676767"></span>9,0–12,0 mil. Kč</span>
          <span class="flex items-center gap-2 text-xs text-black/60"><span class="w-3 h-3 flex-shrink-0" style="background:#d4d4d4"></span>&gt; 12,0 mil. Kč</span>
        </div>
      </div>
      <!-- Editorial -->
      <div class="space-y-8" data-aos="fade-left" data-aos-delay="60">
        <div class="border-l-2 border-black pl-6">
          <p class="font-yellix text-lg md:text-xl font-medium text-black leading-snug">
            Největší nabídku tvoří byty v kategoriích <span class="border-b-2 border-black">140–200 tis. Kč/m²</span>.
          </p>
        </div>
        <div class="border-l-2 border-black/25 pl-6">
          <p class="text-sm text-black/65 leading-relaxed">
            Nejlevnější segment pod <strong class="text-black">140 tis. Kč/m²</strong> je zastoupen jen okrajově, zatímco byty s cenou nad <strong class="text-black">200 tis. Kč/m²</strong> tvoří výraznější část nabídky hlavně u menších dispozic.
          </p>
        </div>
        <div class="border-l-2 border-black pl-6">
          <p class="text-sm font-medium text-black leading-relaxed">
            Největší nabídka na trhu je u bytů <strong>2+kk</strong> v rozmezí <strong>9–12 mil. Kč</strong>.
          </p>
        </div>
        <div class="border-l-2 border-black/25 pl-6">
          <p class="text-sm text-black/60 leading-relaxed">
            Na trhu je však také velké množství bytů v kategorii <strong class="text-black">3+kk nad 12 mil. Kč</strong>, nebo <strong class="text-black">2+kk mezi 6–9 mil. Kč</strong>.
          </p>
        </div>
        <div class="border-l-2 border-black/25 pl-6">
          <p class="text-sm text-black/60 leading-relaxed">
            Levnější <strong class="text-black">4+kk+ do 12 milionů Kč</strong> už na trhu prakticky <span class="border-b-2 border-black">neexistují</span>.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── STATEMENT: NABÍDKA + POPTÁVKA ────────────────────────────────── -->
<section class="py-16 md:py-24 bg-white">
  <div class="mx-auto max-w-[1600px] px-6 lg:px-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20">
      <div class="border-l-2 border-black pl-8" data-aos="fade-right">
        <p class="text-[10px] font-medium uppercase tracking-[0.2em] text-black/35 mb-5">Nabídka · Q1 2026</p>
        <p class="font-yellix text-xl md:text-2xl font-medium text-black leading-snug">
          V&nbsp;Q1 2026 nabídka mezikvartálně mírně vzrostla na&nbsp;<span class="border-b-2 border-black">5&nbsp;852 jednotek</span> oproti 5&nbsp;760 v&nbsp;Q4&nbsp;2025.
        </p>
      </div>
      <div class="border-l-2 border-black/20 pl-8" data-aos="fade-left" data-aos-delay="60">
        <p class="text-[10px] font-medium uppercase tracking-[0.2em] text-black/35 mb-5">Poptávka & prodeje · Q1 2026</p>
        <p class="font-yellix text-xl md:text-2xl font-medium text-black/55 leading-snug">
          V&nbsp;Q1 2026 došlo k&nbsp;mezikvartálnímu poklesu prodejů na&nbsp;<span class="text-black border-b-2 border-black/30">1&nbsp;504 jednotek</span> oproti silnému Q4&nbsp;2025. Pro trh s&nbsp;novostavbami v&nbsp;Praze to bylo ale další silné čtvrtletí, které i&nbsp;tak překonalo průměry předchozích let.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ── CENY DLE DISPOZICE ─────────────────────────────────────────────── -->
<section class="py-20 md:py-28 bg-white">
  <div class="mx-auto max-w-[1600px] px-6 lg:px-10">
    <div class="mb-10" data-aos="fade-up">
      <p class="text-xs font-medium tracking-widest uppercase text-black/40 mb-2">Q1 2026</p>
      <h2 class="font-yellix text-2xl md:text-3xl font-medium text-black">Ceny dle dispozice</h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
      <div class="bg-[#f5f5f3] p-4 md:p-8" data-aos="fade-right">
        <p class="text-xs font-medium uppercase tracking-widest text-black/40 mb-4">Kč/m² — dostupné vs. prodané</p>
        <canvas id="chartLayout" style="max-height:320px"></canvas>
      </div>
      <div data-aos="fade-left" data-aos-delay="60">
        <!-- Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-black/10">
                <th class="text-left py-3 pr-6 font-medium text-black/40 text-xs tracking-widest uppercase">Dispozice</th>
                <th class="text-right py-3 pr-6 font-medium text-black/40 text-xs tracking-widest uppercase">Dostupné</th>
                <th class="text-right py-3 pr-6 font-medium text-black/40 text-xs tracking-widest uppercase">Prodané</th>
                <th class="text-right py-3 font-medium text-black/40 text-xs tracking-widest uppercase">QoQ</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-black/6">
              <tr>
                <td class="py-4 pr-6 font-medium text-black">1+kk</td>
                <td class="py-4 pr-6 text-right font-medium text-black">197 000</td>
                <td class="py-4 pr-6 text-right text-black/60">188 000</td>
                <td class="py-4 text-right font-medium text-black">+4,8 %</td>
              </tr>
              <tr>
                <td class="py-4 pr-6 font-medium text-black">2+kk</td>
                <td class="py-4 pr-6 text-right font-medium text-black">176 000</td>
