<script>
  var alternaPskInterval = null;
  var alternaCampaignInterval = null;

  function initAlternaPage() {
    /* ── Slideshow ── */
    var slides = [
      document.getElementById('slide-a'),
      document.getElementById('slide-b'),
      document.getElementById('slide-c'),
    ];
    if (slides[0]) {
      var cur = 0;
      setInterval(function() {
        slides[cur].classList.add('slide-hidden');
        cur = (cur + 1) % slides.length;
        slides[cur].classList.remove('slide-hidden');
      }, 4000);
    }

    /* ── Bar chart ── */
    var chart   = document.getElementById('alterna-chart');
    var tooltip = document.getElementById('chart-tooltip');
    if (chart) {
      var obs = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) {
          chart.classList.add('animated');
          obs.unobserve(chart);
        }
      }, { threshold: 0.2 });
      obs.observe(chart);

      if (tooltip) {
        chart.querySelectorAll('.chart-col').forEach(function(col) {
          col.addEventListener('mouseenter', function() {
            tooltip.textContent = col.dataset.tip;
            tooltip.classList.add('visible');
          });
          col.addEventListener('mousemove', function(e) {
            tooltip.style.left = (e.clientX + 12) + 'px';
            tooltip.style.top  = (e.clientY - 30) + 'px';
          });
          col.addEventListener('mouseleave', function() {
            tooltip.classList.remove('visible');
          });
        });
      }
    }

    /* ── Prostor / Světlo / Komfort — rotace textu v banneru ── */
    if (alternaPskInterval) {
      clearInterval(alternaPskInterval);
      alternaPskInterval = null;
    }
    var pskEl = document.getElementById('alterna-psk-word');
    if (pskEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var pskWords = ['Prostor.', 'Světlo.', 'Komfort.'];
      var pskI = 0;
      alternaPskInterval = setInterval(function() {
        pskEl.style.opacity = '0';
        setTimeout(function() {
          pskI = (pskI + 1) % pskWords.length;
          pskEl.textContent = pskWords[pskI];
          pskEl.style.opacity = '1';
        }, 220);
      }, 3800);
    }

    /* ── Kampaně — rotace rolí: vždy jedna vizuálně ve středu (větší) ── */
    if (alternaCampaignInterval) {
      clearInterval(alternaCampaignInterval);
      alternaCampaignInterval = null;
    }
    var campRoot = document.getElementById('alterna-campaign');
    if (
      campRoot &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      var u0 = campRoot.getAttribute('data-k0');
      var u1 = campRoot.getAttribute('data-k1');
      var u2 = campRoot.getAttribute('data-k2');
      if (u0 && u1 && u2) {
        var urls = [u0, u1, u2];
        var centerIdx = 1;

        function slotFrom(selector) {
          var stack = campRoot.querySelector(selector + ' .alterna-campaign__imgstack');
          if (!stack) return null;
          var imgs = stack.querySelectorAll('.alterna-campaign__layer');
          if (imgs.length < 2) return null;
          return { stack: stack, imgs: [imgs[0], imgs[1]], visible: 0 };
        }

        var leftSlot = slotFrom('[data-slot="left"]');
        var centerSlot = slotFrom('[data-slot="center"]');
        var rightSlot = slotFrom('[data-slot="right"]');

        function crossfadeSlot(slot, newUrl) {
          if (!slot) return;
          var vis = slot.visible;
          var hid = 1 - vis;
          var nextEl = slot.imgs[hid];
          var curEl = slot.imgs[vis];

          function finish() {
            nextEl.classList.remove('alterna-campaign__layer--under');
            nextEl.classList.add('alterna-campaign__layer--over');
            curEl.classList.remove('alterna-campaign__layer--over');
            curEl.classList.add('alterna-campaign__layer--under');
            slot.visible = hid;
          }

          function afterReady() {
            if (nextEl.decode) {
              nextEl.decode().then(finish).catch(finish);
            } else {
              finish();
            }
          }

          var resolved = new URL(newUrl, window.location.href).href;
          if (nextEl.src === resolved) {
            afterReady();
            return;
          }

          nextEl.src = newUrl;
          if (nextEl.complete && nextEl.naturalWidth > 0) {
            requestAnimationFrame(afterReady);
          } else {
            nextEl.onload = function() {
              nextEl.onload = null;
              afterReady();
            };
            nextEl.onerror = function() {
              nextEl.onerror = null;
            };
          }
        }

        function applyCampaignRotation() {
          var L = (centerIdx + 2) % 3;
          var C = centerIdx;
          var R = (centerIdx + 1) % 3;
          crossfadeSlot(leftSlot, urls[L]);
          crossfadeSlot(centerSlot, urls[C]);
          crossfadeSlot(rightSlot, urls[R]);
        }

        alternaCampaignInterval = setInterval(function() {
          centerIdx = (centerIdx + 1) % 3;
          applyCampaignRotation();
        }, 5200);
      }
    }
  }

  initAlternaPage();
  document.addEventListener('astro:page-load', initAlternaPage);
</script>
