---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const alternaLogo = '/images/Alterna/Alterna%20logo.svg';
const squareLogo  = '/images/Alterna/Square_svg_logo.svg';
const kampan2     = '/images/Alterna/Alterna%20-%20kampan%282%29.webp';
const kampan3     = '/images/Alterna/Alterna%20-%20kampan%283%29.webp';
const kampan4     = '/images/Alterna/Alterna%20-%20kampan%284%29.webp';

/** Top 10 na desktopu, prvních 5 na mobilu (< md) — bez horizontálního scrollu */
/** Výška plochy sloupců (px) – menší = nižší měřítko grafu */
const chartPlotH = 200;

const chartData = [
  { name: 'Alterna',                  value: 26, main: true },
  { name: 'Nová Květice',             value: 24 },
  { name: 'Na Malé Růži 6. Etapa',    value: 18 },
  { name: 'Klecanská Alej',           value: 18 },
  { name: 'Bydlení Jinočany',         value: 15 },
  { name: 'Rodinné domy Satalice',    value: 15 },
  { name: 'Řadové domy Buštěhrad',    value: 15 },
  { name: 'Praha - Park Nehvizdy',    value: 12 },
  { name: 'Domy Bílý Vrch',           value: 11 },
  { name: 'Zahradní čtvrť Kyje',      value: 11 },
];

const klicoveKroky = [
  { label: 'Cílová skupina',     titleTop: 'MLADÉ RODINY',              titleBot: 'VÝCHOD A JIH PRAHY',               body: 'Kupující, kteří řešili, zda zůstat v bytě v Praze, nebo získat více prostoru a zahradu za hranicí města.' },
  { label: 'Positioning',        titleTop: 'DŮM SE ZAHRADOU MÍSTO',    titleBot: 'KOMPROMISU V BYTĚ',                body: 'Z projektu jsme udělali jasně pochopitelnou variantu pro rodinné bydlení.' },
  { label: 'Komunikace',         titleTop: 'NOVÝ JAZYK PROJEKTU',      titleBot: '',                                  body: 'Nová komunikace postavená na rodinném životě, prostoru a vznikající komunitě posílila důvěru i představivost kupujících.' },
  { label: 'Sales architektura', titleTop: 'PRÁCE S ETAPAMI',          titleBot: '',                                  body: 'Místo rozmělnění nabídky jsme postupně budovali prodejní momentum. Pozornost trhu jsme nejprve soustředili na I. etapu a její úspěch využili při spuštění II. etapy.' },
  { label: 'Lead generation',    titleTop: 'ONLINE A OFFLINE NÁSTROJE', titleBot: 'V JEDNOM FUNNELU',                body: 'Zájem jsme nestavěli jen na reklamě. Kampaně, web i vzorový dům fungovaly jako navazující systém pro získávání relevantních zájemců.' },
];
---
<Layout
  title="Alterna Sluštice – Reference | REAMAR"
  description="Z neznámého projektu jsme vytvořili nejprodávanější rodinné domy v Praze a okolí. Reference REAMAR pro developerský projekt Alterna Sluštice."
  ogTitle="Alterna Sluštice – Reference REAMAR"
  canonical="https://www.reamar.cz/alterna"
  image="/images/Alterna/Alterna-hero.webp"
>

<!-- ── HERO ─────────────────────────────────────────────────────────────── -->
<section id="alterna-hero" data-hero-transparent class="relative h-screen min-h-[580px] flex flex-col justify-end bg-black overflow-hidden">
  <!-- Mobil: Alterna-heromobil | Desktop beze změny -->
  <img
    src="/images/Alterna/Alterna-heromobil.webp"
    alt="Alterna Sluštice"
    class="absolute inset-0 h-full w-full object-cover object-center md:hidden"
    width="941"
    height="1672"
    fetchpriority="high"
  />
  <img
    src="/images/Alterna/Alterna-hero.webp"
    alt="Alterna Sluštice"
    class="absolute inset-0 hidden h-full w-full object-cover object-center md:block"
    width="1920"
    height="1080"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-black/10"></div>

  <div class="relative z-10 mx-auto w-full max-w-none">
    <div class="mx-auto max-w-[1280px] w-[90%] pb-[max(2.5rem,calc(0.75rem+env(safe-area-inset-bottom)))] md:pb-14">
      <!-- Label + Claim -->
      <p class="text-[11px] font-medium tracking-[0.22em] uppercase text-white/70 mb-4">Reference</p>
      <h1 class="font-yellix text-[clamp(1.5rem,3vw,2.4rem)] font-medium leading-[1.12] tracking-tight text-white max-w-xl">
        Cesta k nejprodávanějším<br />rodinným domům<br />v Praze a okolí
      </h1>
      <a href="#alterna-story" class="inline-block mt-4 text-sm text-white/65 underline underline-offset-4 hover:text-white transition-colors">Přečíst</a>

      <!-- Bottom bar: šipka uvnitř tlačítka přímo před „alternaslustice.cz“ -->
      <div class="mt-10 flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
        <a
          href="https://www.alternaslustice.cz"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-white border border-white/40 bg-white/5 px-4 py-2 hover:bg-white/15 transition-colors"
        >
          <img
            src="/images/arrow-1.svg"
            alt=""
            aria-hidden="true"
            class="h-4 w-4 shrink-0 opacity-95"
            width="16"
            height="16"
          />
          alternaslustice.cz
        </a>
        <img src={alternaLogo} alt="Alterna" class="h-5 md:h-6 w-auto hero-logo-invert" width="120" height="30" />
      </div>
    </div>
  </div>
</section>

<!-- ── STORY ─────────────────────────────────────────────────────────────── -->
<section id="alterna-story" class="pt-20 pb-0 md:pt-32 bg-white">
  <div class="mx-auto max-w-[1280px] w-[90%]">

    <!-- Title + Klient -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-20 md:mb-28">
      <div class="lg:col-span-7" data-aos="fade-right">
        <h2 class="font-yellix text-[1.75rem] md:text-[2.2rem] font-medium leading-tight text-black mb-5">
          Z neznámého projektu jsme vytvořili<br class="hidden md:block" />nejprodávanější rodinné domy v Praze
        </h2>
        <p class="text-sm text-black/55 leading-relaxed max-w-lg">
          Alterna měla silný produkt, ale slabou tržní čitelnost. Projekt jsme nově vymezili pro mladé rodiny hledající alternativu k bytu v Praze a postavili jsme kolem něj nový prodejní příběh. Díky přesnému positioningu, nové komunikaci a chytré práci s etapami se projekt zařadil na špičku trhu.
        </p>
      </div>
      <div class="lg:col-span-5 flex gap-12 lg:justify-end lg:items-start lg:pt-1" data-aos="fade-left" data-aos-delay="60">
        <div>
          <p class="text-[10px] font-medium tracking-[0.18em] uppercase text-black/35 mb-2">Klient</p>
          <img src={squareLogo} alt="Square" class="h-[18px] w-auto object-contain" width="80" height="18" />
        </div>
        <div>
          <p class="text-[10px] font-medium tracking-[0.18em] uppercase text-black/35 mb-2">Služby</p>
          <p class="text-sm font-medium text-black">Full Marketing & Sales</p>
        </div>
      </div>
    </div>

    <!-- Bar chart (layout + styling pod referenčním screenshotem BuiltMind) -->
    <div data-aos="fade-up" data-aos-delay="40" class="mx-auto ac-chart-wrap">
      <div class="ac-chart-head">
        <div class="ac-chart-head__row">
          <a
            href="/prazsky-rezidencni-trh"
            class="ac-chart-title"
          >
            Nejprodávanější projekty rodinných domů, Praha a okolí, 2025
          </a>
        </div>
      </div>
      <!-- padding-bottom: místo pro štítky osy X otočené o 45° -->
      <div class="ac-chart-scroll">
        <div id="alterna-chart" class="ac-root" style={`--plot-h:${chartPlotH}px`}>
          <div class="ac-y" aria-hidden="true">
            {[30, 25, 20, 15, 10, 5, 0].map((v) => (
              <span style={`--ty:${((30 - v) / 30) * 100}%`}>{v}</span>
            ))}
          </div>
          <div class="ac-body">
            {chartData.map((item, i) => (
              <div
                class:list={['chart-col', i >= 5 && 'chart-col--desktop-extra']}
                data-tip={`${item.name}: ${item.value}`}
              >
                <!-- výška plotu = chartPlotH; štítky X až pod slotem -->
                <div class="chart-col-barslot">
                  <div
                    class="ac-bar"
                    style={`--bh:${Math.round((item.value / 30) * chartPlotH)}px`}
                  >
                    {item.main && (
                      <div class="ac-bar-logo-wrap">
                        <img
                          src={alternaLogo}
                          alt="Alterna"
                          class="ac-bar-logo"
                          width="140"
                          height="36"
                        />
                      </div>
                    )}
                  </div>
                </div>
                <div class="ac-lbl-wrap">
                  <span class="ac-lbl">{item.name}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div id="chart-tooltip" class="chart-tooltip" aria-hidden="true" />
      </div>
      <div class="ac-chart-foot">
        <a href="/prazsky-rezidencni-trh" class="ac-chart-source">
          <span class="ac-chart-source__zdroj">zdroj</span>
          <img src="/images/builtmind-logo.png" alt="" class="ac-chart-source__logo" width="56" height="14" />
        </a>
      </div>
    </div>

    <!-- Quote + cycling image (asymetrická dvousloupcová kompozice) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-0 mt-28 md:mt-36 lg:items-start">
      <div class="lg:col-span-5 max-w-[min(100%,30rem)] xl:pr-4" data-aos="fade-right">
        <p class="font-yellix text-[1.1rem] md:text-[1.2rem] font-medium leading-[1.55] text-black">
          „Klíčem nebyl vyšší mediální tlak, ale správná interpretace produktu pro konkrétního kupujícího. Projekt jsme přestali komunikovat jako soubor domů a začali ho stavět jako jasnou alternativu k bytu a nově <span class="underline decoration-black/45 underline-offset-[3px]">vznikající komunitu mladých&nbsp;rodin</span>. Tím jsme zlepšili čitelnost projektu, výkon kampaní i celkové tempo prodeje.“
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-8 xl:pt-10 xl:pl-6" data-aos="fade-left" data-aos-delay="60">
        <div class="ml-auto w-full max-w-2xl lg:max-w-none">
          <div class="relative overflow-hidden" style="aspect-ratio:4/3; max-height:min(400px,52vw)">
            <img id="slide-a" src="/images/Alterna/Alterna-Bungalov.webp"    alt="Alterna" class="slide-img" width="800" height="600" loading="lazy" />
            <img id="slide-b" src="/images/Alterna/Alterna-DoubleBlock.webp" alt="Alterna" class="slide-img slide-hidden" width="800" height="600" loading="lazy" />
            <img id="slide-c" src="/images/Alterna/Alterna-TwoStory.webp"    alt="Alterna" class="slide-img slide-hidden" width="800" height="600" loading="lazy" />
          </div>
          <p class="mt-4 text-xs text-black/40 text-right max-w-2xl ml-auto leading-snug">
            Díky silnému prodejnímu tempu<br />
            jsme mohli <strong class="text-black font-medium">zdražit o 15&nbsp;%</strong>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── VÝCHOZÍ / SOUČASNÝ STAV ───────────────────────────────────────────── -->
<section class="py-20 md:py-32 bg-white">
  <div class="mx-auto w-[90%] max-w-3xl">
    <div class="flex flex-col md:flex-row md:items-stretch md:justify-center gap-10 md:gap-0">

      <!-- Výchozí -->
      <div class="md:flex-1 md:min-w-0 md:pr-6 lg:pr-8" data-aos="fade-right">
        <div class="inline-block bg-neutral-200 text-black/60 text-[10px] font-medium tracking-[0.18em] uppercase px-3 py-1.5 mb-3">
          Výchozí stav
        </div>
        <h3 class="font-yellix text-2xl md:text-[1.75rem] font-medium text-black mb-7">Zaseknuté prodeje</h3>
        <ul class="space-y-3">
          {[
            'souběžný prodej obou etap bez jasného fokusu',
            'projekt bez konkrétní komunikační linky',
            'trh nerozuměl hlavním výhodám projektu',
            'nízká znalost projektu',
          ].map((t) => (
            <li class="text-sm text-black/55 leading-relaxed">{t}</li>
          ))}
        </ul>
      </div>

      <div
        class="hidden md:block w-px shrink-0 self-stretch bg-black/12"
        aria-hidden="true"
      />

      <!-- Současný -->
      <div class="md:flex-1 md:min-w-0 md:pl-6 lg:pl-8" data-aos="fade-left" data-aos-delay="60">
        <div class="inline-block bg-[#022d20] text-white text-[10px] font-medium tracking-[0.18em] uppercase px-3 py-1.5 mb-3">
          Současný stav
        </div>
        <h3 class="font-yellix text-2xl md:text-[1.75rem] font-medium text-black mb-7">Silný prodejní výkon</h3>
        <ul class="space-y-3">
          {[
            { t: '70 % domů prodaných', bold: true, icon: true },
            { t: 'zdražení bez zpomalení prodejů', bold: false },
            { t: 'úspěšné spuštění II. etapy', bold: false },
            { t: 'otevření vzorového domu pro zvýšení konverze', bold: false },
          ].map(({ t, bold, icon }) =>
            icon ? (
              <li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm leading-relaxed">
                <span class="font-semibold text-black">{t}</span>
                <span class="text-[#022d20] flex-shrink-0 translate-y-[2px]" aria-hidden="true">
                  <svg
                    class="w-[15px] h-[15px] md:w-4 md:h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                    <polyline points="17 6 23 6 23 12" />
                  </svg>
                </span>
              </li>
            ) : (
              <li class={`text-sm leading-relaxed ${bold ? 'font-semibold text-black' : 'text-black/55'}`}>{t}</li>
            ),
          )}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ── KAMPANĚ (rotace – střed vždy zvýrazněný) ─────────────────────────── -->
<section class="pb-0 bg-white">
  <div class="mx-auto max-w-[1280px] w-[90%]">
    <div class="alterna-campaign-row relative" data-aos="fade-up">
      <h2
        class="alterna-campaign__title relative z-10 mb-4 font-yellix text-xl font-medium leading-tight text-black sm:text-2xl md:absolute md:left-0 md:mb-0 md:text-[1.65rem]"
      >
        Kampaně
      </h2>
    <div
      id="alterna-campaign"
      class="alterna-campaign flex w-full min-w-0 items-center justify-center gap-2 sm:gap-3 md:gap-5"
      data-k0={kampan2}
      data-k1={kampan3}
      data-k2={kampan4}
    >
      <div class="alterna-campaign__slot alterna-campaign__slot--side group relative min-w-0" data-slot="left">
        <div class="alterna-campaign__imgstack">
          <img
            src={kampan2}
            alt="Alterna – kampaň"
            class="alterna-campaign__layer alterna-campaign__layer--over object-cover"
            width="400"
            height="533"
            loading="lazy"
            decoding="async"
          />
          <img
            src={kampan2}
            alt=""
            class="alterna-campaign__layer alterna-campaign__layer--under object-cover"
            width="400"
            height="533"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </div>
        <span
          class="pointer-events-none absolute z-10 bottom-2 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-black/85 px-2.5 py-1 text-[10px] font-medium text-white opacity-0 shadow-md transition-opacity duration-200 group-hover:opacity-100 sm:bottom-3 sm:px-3 sm:py-1.5 sm:text-[11px]"
          aria-hidden="true"
        >
          Náhled kampaně
        </span>
      </div>
      <div class="alterna-campaign__slot alterna-campaign__slot--feat group relative min-w-0" data-slot="center">
        <div class="alterna-campaign__imgstack">
          <img
            src={kampan3}
            alt="Alterna – kampaň"
            class="alterna-campaign__layer alterna-campaign__layer--over object-cover"
            width="400"
            height="533"
            loading="lazy"
            decoding="async"
          />
          <img
            src={kampan3}
            alt=""
            class="alterna-campaign__layer alterna-campaign__layer--under object-cover"
            width="400"
            height="533"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </div>
        <span
          class="pointer-events-none absolute z-10 bottom-2 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-black/85 px-2.5 py-1 text-[10px] font-medium text-white opacity-0 shadow-md transition-opacity duration-200 group-hover:opacity-100 sm:bottom-3 sm:px-3 sm:py-1.5 sm:text-[11px]"
          aria-hidden="true"
        >
          Náhled kampaně
        </span>
      </div>
      <div class="alterna-campaign__slot alterna-campaign__slot--side group relative min-w-0" data-slot="right">
        <div class="alterna-campaign__imgstack">
          <img
            src={kampan4}
            alt="Alterna – kampaň"
            class="alterna-campaign__layer alterna-campaign__layer--over object-cover"
            width="400"
            height="533"
            loading="lazy"
            decoding="async"
          />
          <img
            src={kampan4}
            alt=""
            class="alterna-campaign__layer alterna-campaign__layer--under object-cover"
            width="400"
            height="533"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </div>
        <span
          class="pointer-events-none absolute z-10 bottom-2 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-black/85 px-2.5 py-1 text-[10px] font-medium text-white opacity-0 shadow-md transition-opacity duration-200 group-hover:opacity-100 sm:bottom-3 sm:px-3 sm:py-1.5 sm:text-[11px]"
          aria-hidden="true"
        >
          Náhled kampaně
        </span>
      </div>
    </div>
    </div>
  </div>
</section>

<!-- ── PROSTOR · SVĚTLO · KOMFORT ─────────────────────────────────────────── -->
<section class="relative overflow-hidden mt-12 md:mt-16 alterna-psk-banner h-[600px]">
  <!-- Mobil: Prostor.Svetlo.Komfort-mob | Desktop beze změny -->
  <img
    src="/images/Alterna/Prostor.Svetlo.Komfort-mob.webp"
    alt="Alterna – Prostor, Světlo, Komfort"
    class="absolute inset-0 h-full w-full object-cover object-center md:hidden"
    width="1122"
    height="1402"
    loading="lazy"
  />
  <img
    src="/images/Alterna/Prostor.Svetlo.Komfort.webp"
    alt="Alterna – Prostor, Světlo, Komfort"
    class="absolute inset-0 hidden h-full w-full object-cover object-center md:block"
    width="1920"
    height="1080"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/15 to-transparent"></div>
  <div class="relative z-10 mx-auto flex h-full max-w-[1280px] w-[90%] flex-col py-6 md:py-8">
    <h2
      id="alterna-psk-word"
      class="alterna-psk-word mt-10 self-start font-yellix text-[clamp(1.65rem,3.2vw,2.4rem)] font-medium leading-tight tracking-tight text-[#022d20] md:mt-12 lg:mt-14"
    >
      Prostor.
    </h2>
    <p class="mt-auto mb-2.5 self-end text-base md:text-lg text-white/90 text-right max-w-[min(100%,24rem)] leading-snug drop-shadow-md">
      Nové rodinné domy
      <br />
      na hranici Prahy
    </p>
  </div>
</section>

<!-- ── KLÍČOVÉ KROKY ─────────────────────────────────────────────────────── -->
<section class="py-16 md:py-24 bg-white lg:overflow-visible">
  <div class="mx-auto max-w-[1280px] w-[90%]">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2 lg:items-stretch lg:gap-20">

      <!-- Left: timeline -->
      <div>
        <div class="inline-block bg-[#022d20] text-white text-[10px] font-medium tracking-[0.2em] uppercase px-3 py-1.5 mb-10" data-aos="fade-right">
          Klíčové kroky
        </div>

        <ol class="krok-list">
          {klicoveKroky.map((krok, i) => (
            <li class="krok-item" data-aos="fade-right" data-aos-delay={i * 70}>
              <p class="krok-label">{krok.label}</p>
              <p class="krok-title">{krok.titleTop}{krok.titleBot ? <><br />{krok.titleBot}</> : ''}</p>
              <p class="krok-body">{krok.body}</p>
            </li>
          ))}
        </ol>
      </div>

      <!-- Right: celek vertikálně vystředěný vůči výšce sloupce Klíčové kroky (viz lg:justify-center) -->
      <div class="flex min-h-0 flex-col lg:h-full lg:justify-center" data-aos="fade-left" data-aos-delay="80">
        <a
          href="https://www.alternaslustice.cz"
          target="_blank"
          rel="noopener noreferrer"
          class="alterna-kroky-logo mb-5 inline-block w-max shrink-0 self-start transition-opacity hover:opacity-[0.85]"
          aria-label="Alterna Sluštice – web projektu"
        >
          <img
            src={alternaLogo}
            alt="Alterna"
            class="alterna-kroky-logo-img h-5 w-auto object-contain md:h-6"
            width="100"
            height="13"
          />
        </a>

        <div class="alterna-vid-bleed-right relative my-4 aspect-video min-h-0 w-full overflow-hidden bg-neutral-100 md:my-5">
          <video
            class="w-full h-full object-cover"
            autoplay muted loop playsinline preload="metadata"
            poster="/images/Alterna/Alterna-vid-cover.webp"
          >
            <source src="/images/Alterna/Alterna-vid.mp4" type="video/mp4" />
            <img src="/images/Alterna/Alterna-vid-cover.webp" alt="Alterna" class="w-full h-full object-cover" />
          </video>
        </div>

