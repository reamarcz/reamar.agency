---
/**
 * Isolated iOS autoplay probe — no bindHeroLoop, no IO, no VT, no animation wrappers.
 * Compare against production heroes with ?videoDebug=1.
 */
const videoSrc = '/videos/agentprokupujici.mp4';
const posterSrc = '/video/hero-poster.jpg';
---
<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>video-ios debug</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font: 15px/1.4 -apple-system, system-ui, sans-serif;
        background: #111;
        color: #eee;
      }
      h1 { font-size: 16px; margin: 12px 16px; font-weight: 600; }
      p { margin: 0 16px 12px; color: #bbb; font-size: 13px; }
      .box {
        position: relative;
        width: 100%;
        height: 56vh;
        min-height: 280px;
        background: #000;
        overflow: hidden;
      }
      .box video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: #000;
      }
      .meta {
        margin: 12px 16px;
        padding: 10px;
        background: #1c1c1c;
        font: 12px/1.4 ui-monospace, Menlo, monospace;
        white-space: pre-wrap;
        word-break: break-word;
      }
      a { color: #9cf; }
    </style>
    <script is:inline>
      (function () {
        try {
          if (!/(?:^|[?&])videoDebug=1(?:&|$)/.test(location.search)) {
            // Always log on this page — it exists only for diagnostics.
            history.replaceState(null, '', location.pathname + '?videoDebug=1' + location.hash);
          }
        } catch (e) {}
        window.__vdEnabled = true;
        window.__vdLog = window.__vdLog || [];
        var t0 = performance.now();
        function push(line) {
          window.__vdLog.push(line);
          var el = document.getElementById('iso-log');
          if (el) el.textContent = window.__vdLog.join('\n');
          var pre = document.getElementById('vd-pre');
          if (pre) pre.textContent = window.__vdLog.join('\n');
        }
        window.__vdPush = function (tag, detail) {
          push(Math.round((performance.now() - t0) * 10) / 10 + 'ms [' + tag + ']' + (detail ? ' ' + detail : ''));
        };
        if (!window.__vdOrigPlay) {
          window.__vdOrigPlay = HTMLVideoElement.prototype.play;
          HTMLVideoElement.prototype.play = function () {
            window.__vdPush('play()', JSON.stringify({
              paused: this.paused,
              readyState: this.readyState,
              t: this.currentTime,
              muted: this.muted,
              w: Math.round(this.getBoundingClientRect().width),
              h: Math.round(this.getBoundingClientRect().height)
            }));
            var result = window.__vdOrigPlay.apply(this, arguments);
            if (result && result.then) {
              result.then(function () {
                window.__vdPush('play:ok', JSON.stringify({ paused: this.paused, t: this.currentTime, readyState: this.readyState }));
              }.bind(this), function (err) {
                window.__vdPush('play:fail', JSON.stringify({ name: err && err.name, message: err && err.message }));
              });
            }
            return result;
          };
        }
        window.__vdPush('iso-boot', location.href);
      })();
    </script>
  </head>
  <body>
    <h1>Isolated native video (no bindHeroLoop)</h1>
    <p>
      Stejný soubor jako homepage hero. Pokud se toto spustí bez scrollu a produkční hero ne,
      problém je v aplikační logice. Pokud ani toto ne, jde o WebKit / video / zařízení.
      Porovnej s <a href="/?videoDebug=1">/?videoDebug=1</a> a
      <a href="/bydleni?videoDebug=1">/bydleni?videoDebug=1</a>.
    </p>
    <div class="box">
      <video
        id="iso-video"
        src={videoSrc}
        poster={posterSrc}
        muted
        autoplay
        loop
        playsinline
        webkit-playsinline="true"
        preload="auto"
        disablepictureinpicture
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    </div>
    <div class="meta" id="iso-log">waiting…</div>
    <script is:inline>
      (function () {
        var video = document.getElementById('iso-video');
        if (!video) return;
        video.muted = true;
        video.defaultMuted = true;
        video.volume = 0;
        video.playsInline = true;
        ['loadeddata', 'canplay', 'play', 'playing', 'pause', 'waiting', 'error'].forEach(function (name) {
          video.addEventListener(name, function () {
            window.__vdPush && window.__vdPush('evt:' + name, JSON.stringify({
              paused: video.paused,
              readyState: video.readyState,
              t: Math.round(video.currentTime * 1000) / 1000
            }));
          });
        });
        window.addEventListener('scroll', function () {
          window.__vdPush && window.__vdPush('scroll', JSON.stringify({
            y: Math.round(window.scrollY || 0),
            paused: video.paused,
            t: Math.round(video.currentTime * 1000) / 1000
          }));
        }, { passive: true });
        window.addEventListener('touchstart', function () {
          window.__vdPush && window.__vdPush('touchstart', JSON.stringify({
            paused: video.paused,
            t: Math.round(video.currentTime * 1000) / 1000
          }));
        }, { passive: true });
        var play = video.play();
        if (play && play.catch) play.catch(function () {});
        setInterval(function () {
          window.__vdPush && window.__vdPush('tick', JSON.stringify({
            paused: video.paused,
            readyState: video.readyState,
            t: Math.round(video.currentTime * 1000) / 1000,
            w: Math.round(video.getBoundingClientRect().width),
            h: Math.round(video.getBoundingClientRect().height)
          }));
        }, 1000);
      })();
    </script>
    <p style="height:120vh;margin-top:24px;padding:16px;color:#666">
      Scroll zóna — použij jen pokud video ještě nehraje. Sleduj, jestli se po touchstart/scroll
      objeví play:ok a roste currentTime.
    </p>
  </body>
</html>
