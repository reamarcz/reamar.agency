  <dialog id="offer-lightbox" class="offer-lightbox">
    <button type="button" class="offer-lightbox-close" data-lightbox-close>Zavřít</button>
    <figure class="flex max-h-[100svh] w-full flex-col items-center justify-center px-4 py-16">
      <img alt="" class="o-lightbox-img max-h-[78svh] w-auto max-w-full object-contain" data-lightbox-img />
      <figcaption class="mt-4 text-center text-[13px] font-medium text-white/70" data-lightbox-caption></figcaption>
    </figure>
  </dialog>

  <script>
    import { actions } from 'astro:actions';

    const root = document.documentElement;
    const motion = root.classList.contains('motion');
    const header = document.querySelector<HTMLElement>('[data-offer-header]');
    const hero = document.querySelector<HTMLElement>('[data-offer-hero]');
    const heroImg = document.querySelector<HTMLElement>('[data-hero-img]');
    const heroContent = document.querySelector<HTMLElement>('[data-hero-content]');
    const progress = document.querySelector<HTMLElement>('[data-progress]');
    const floatCta = document.querySelector<HTMLElement>('[data-float-cta]');
    const contact = document.querySelector<HTMLElement>('#kontakt');
    const menuBtn = document.querySelector<HTMLButtonElement>('[data-offer-menu-btn]');
    const menu = document.querySelector<HTMLElement>('[data-offer-menu]');

    const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
      const text = (el.textContent || '').trim().replace(/\s+/g, ' ');
      el.setAttribute('aria-label', text);
      el.innerHTML = text
        .split(' ')
        .map((w, i) => `<span class="o-w" aria-hidden="true"><span style="--i:${i}">${escapeHtml(w)}</span></span>`)
        .join(' ');
    });

    const scrubEls = [...document.querySelectorAll<HTMLElement>('[data-scrub]')].map((el) => {
      const text = (el.textContent || '').trim().replace(/\s+/g, ' ');
      el.setAttribute('aria-label', text);
      el.innerHTML = text
        .split(' ')
        .map((w) => `<span class="o-sw" aria-hidden="true">${escapeHtml(w)}</span>`)
        .join(' ');
      return { el, words: [...el.querySelectorAll<HTMLElement>('.o-sw')] };
    });

    const formatter = new Intl.NumberFormat('cs-CZ');
    function countUp(el: HTMLElement, delay = 0) {
      const target = Number(el.dataset.count || 0);
      if (!motion || !target) return;
      el.textContent = '0';
      const duration = target > 100 ? 1800 : 1300;
      setTimeout(() => {
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - t, 4);
          el.textContent = formatter.format(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }, delay);
    }

    requestAnimationFrame(() => {
      hero?.classList.add('is-loaded');
      document.querySelectorAll<HTMLElement>('[data-count-hero]').forEach((el, i) => countUp(el, 950 + i * 90));
    });

    const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal], [data-split], [data-route], [data-count]:not([data-count-hero])');
    if (motion && 'IntersectionObserver' in window) {
      const watched = new Map<Element, HTMLElement[]>();
      revealTargets.forEach((el) => watched.set(el, [el]));
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            (watched.get(entry.target) || []).forEach((el) => {
              const img = el.dataset.reveal === 'photo' ? el.querySelector('img') : null;
              if (img && !img.complete) {
                // Uncover the photo once it has arrived instead of revealing an empty grey frame.
                const show = () => el.classList.add('is-in');
                img.addEventListener('load', show, { once: true });
                img.addEventListener('error', show, { once: true });
                setTimeout(show, 1200);
                return;
              }
              el.classList.add('is-in');
              if (el.hasAttribute('data-count')) countUp(el, 150);
            });
            io.unobserve(entry.target);
          });
        },
        { threshold: 0, rootMargin: '0px 0px -40px 0px' },
      );
      watched.forEach((_, key) => io.observe(key));
    } else {
      revealTargets.forEach((el) => el.classList.add('is-in'));
    }

    const parallaxEls = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
    let lastY = window.scrollY;
    let ticking = false;

    function update() {
      ticking = false;
      const y = window.scrollY;
      const vh = window.innerHeight;
      const heroH = hero?.offsetHeight || vh;
      const menuOpen = menu ? !menu.hasAttribute('hidden') : false;

      if (header) {
        header.classList.toggle('is-solid', y > heroH - 90);
        const goingDown = y > lastY + 2;
        const goingUp = y < lastY - 2;
        if (goingDown && y > heroH * 0.6 && !menuOpen) header.classList.add('is-hidden');
        else if (goingUp || y < heroH * 0.6) header.classList.remove('is-hidden');
      }
      lastY = y;

      if (progress) {
        const max = document.documentElement.scrollHeight - vh;
        progress.style.transform = `scaleX(${max > 0 ? Math.min(1, y / max) : 0})`;
      }

      if (floatCta && contact) {
        const contactTop = contact.getBoundingClientRect().top;
        floatCta.classList.toggle('is-on', y > heroH * 0.9 && contactTop > vh * 0.85);
      }

      if (!motion) return;

      if (y < heroH * 1.1) {
        if (heroImg) heroImg.style.transform = `translate3d(0, ${y * 0.32}px, 0)`;
        if (heroContent) {
          heroContent.style.transform = `translate3d(0, ${y * 0.14}px, 0)`;
          heroContent.style.opacity = String(Math.max(0, 1 - y / (heroH * 0.85)));
        }
      }

      parallaxEls.forEach((img) => {
        const frame = img.parentElement;
        if (!frame) return;
        const rect = frame.getBoundingClientRect();
        if (rect.bottom < -100 || rect.top > vh + 100) return;
        const speed = Number(img.dataset.parallax || 0.1);
        const room = rect.height * 0.09 - 2;
        const offset = Math.max(-room, Math.min(room, (rect.top + rect.height / 2 - vh / 2) * speed));
        img.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0) scale(1.18)`;
      });

      scrubEls.forEach(({ el, words }) => {
        const rect = el.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (vh * 0.88 - rect.top) / (rect.height + vh * 0.4)));
        const lit = Math.round(p * words.length);
        words.forEach((w, i) => w.classList.toggle('on', i < lit));
      });
    }

    function requestUpdate() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }
    // Mirrors object-fit: cover / preserveAspectRatio slice so the tag sits on the plot's top corner.
    const plotTags = [...document.querySelectorAll<HTMLElement>('[data-plot-anchor]')];
    function placePlotTags() {
      plotTags.forEach((tag) => {
        const layer = tag.parentElement;
        if (!layer) return;
        const [ax, ay] = (tag.dataset.plotAnchor || '').split(',').map(Number);
        const w = layer.offsetWidth;
        const h = layer.offsetHeight;
        const s = Math.max(w / 1800, h / 985);
        tag.style.left = `${(w - 1800 * s) / 2 + ax * s}px`;
        tag.style.top = `${(h - 985 * s) / 2 + ay * s}px`;
      });
    }
    placePlotTags();

    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', () => {
      placePlotTags();
      requestUpdate();
    });

    const sections = ['pozemek', 'dostupnost', 'regulace', 'lokalita']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    if ('IntersectionObserver' in window) {
      const navIo = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = entry.target.id;
            navLinks.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === `#${id}`));
          });
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      sections.forEach((s) => navIo.observe(s));
    }

    menuBtn?.addEventListener('click', () => {
      const open = menu?.hasAttribute('hidden');
      if (open) menu?.removeAttribute('hidden');
      else menu?.setAttribute('hidden', '');
      menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      menuBtn.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
      header?.classList.toggle('is-menu', Boolean(open));
      header?.classList.remove('is-hidden');
    });
    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.setAttribute('hidden', '');
        menuBtn?.setAttribute('aria-expanded', 'false');
        menuBtn?.setAttribute('aria-label', 'Otevřít menu');
        header?.classList.remove('is-menu');
      });
    });

    const dialog = document.querySelector<HTMLDialogElement>('#offer-lightbox');
    const dialogImg = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const dialogCaption = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');
    document.querySelectorAll<HTMLElement>('[data-shot]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!dialog || !dialogImg) return;
        dialogImg.src = btn.getAttribute('data-shot') || '';
        dialogImg.alt = btn.querySelector('img')?.getAttribute('alt') || '';
        if (dialogCaption) dialogCaption.textContent = btn.getAttribute('data-caption') || '';
        dialog.showModal();
      });
    });
    dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    const form = document.querySelector<HTMLFormElement>('#plot-form');
    const errorEl = document.querySelector<HTMLElement>('[data-plot-error]');
    const successEl = document.querySelector<HTMLElement>('[data-plot-success]');
    const submitBtn = document.querySelector<HTMLButtonElement>('[data-plot-submit]');
    const submitLabel = document.querySelector<HTMLElement>('[data-plot-submit-label]');

    function showError(message: string) {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
    function setSubmitting(on: boolean) {
      if (submitBtn) submitBtn.disabled = on;
      if (submitLabel) submitLabel.textContent = on ? 'Odesílám…' : 'Odeslat';
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorEl?.classList.add('hidden');

      const data = new FormData(form);
      if (String(data.get('company') || '').trim()) return;

      const jmeno = String(data.get('jmeno') || '').trim();
      const telefon = String(data.get('telefon') || '').trim();
      const email = String(data.get('email') || '').trim();
      const vzkaz = String(data.get('vzkaz') || '').trim();
      const souhlas = form.querySelector<HTMLInputElement>('#plot-souhlas');

      if (!jmeno || telefon.replace(/\s/g, '').length < 9 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Vyplňte jméno, telefon a platný e-mail.');
        return;
      }
      if (!souhlas?.checked) {
        showError('Pro odeslání je potřeba souhlas se zpracováním údajů.');
        return;
      }

      setSubmitting(true);
      try {
        const { error } = await actions.sendContactForm({
          formSource: 'pozemek-husinec-rez',
          jmeno,
          telefon,
          email,
          vzkaz,
          pozemek: 'Husinec–Řež, ulice V Údolí, p. č. 774',
          souhlas: 'ano',
        });
        if (error) {
          showError(error.message || 'Odeslání se nepovedlo. Zavolejte prosím přímo.');
          setSubmitting(false);
          return;
        }
        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
      } catch {
        showError('Odeslání se nepovedlo. Zavolejte prosím přímo.');
        setSubmitting(false);
      }
    });
  </script>

