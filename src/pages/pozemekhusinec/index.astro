    icon: 'M208,114a45.88,45.88,0,0,0-17.8,3.58L162.45,70H192a10,10,0,0,1,10,10,6,6,0,0,0,12,0,22,22,0,0,0-22-22H152a6,6,0,0,0-5.18,9l13.4,23H98.11L81.18,61A6,6,0,0,0,76,58H48a6,6,0,0,0,0,12H72.55l15,25.64L70,119.62a46.22,46.22,0,1,0,9.68,7.09L94.11,107,126.82,163a6,6,0,0,0,5.19,3,5.91,5.91,0,0,0,3-.82,6,6,0,0,0,2.16-8.2l-32.07-55h62.11l12.63,21.66A46,46,0,1,0,208,114ZM82,160a34,34,0,1,1-19.13-30.57l-19.72,27a6,6,0,0,0,9.7,7.08l19.7-27A33.88,33.88,0,0,1,82,160Zm126,34a34,34,0,0,1-22-59.86L202.82,163a6,6,0,0,0,5.19,3,5.91,5.91,0,0,0,3-.82,6,6,0,0,0,2.16-8.2l-16.86-28.91A34,34,0,1,1,208,194Z',
  },
  {
    text: 'Škola a školka v docházkové vzdálenosti.',
    icon: 'M166,42.34V32a22,22,0,0,0-22-22H112A22,22,0,0,0,90,32V42.34A54.07,54.07,0,0,0,42,96V216a14,14,0,0,0,14,14H200a14,14,0,0,0,14-14V96A54.07,54.07,0,0,0,166,42.34ZM112,22h32a10,10,0,0,1,10,10V42H102V32A10,10,0,0,1,112,22Zm58,140H86V152a10,10,0,0,1,10-10h64a10,10,0,0,1,10,10ZM86,174h52v10a6,6,0,0,0,12,0V174h20v44H86Zm116,42a2,2,0,0,1-2,2H182V152a22,22,0,0,0-22-22H96a22,22,0,0,0-22,22v66H56a2,2,0,0,1-2-2V96A42,42,0,0,1,96,54h64a42,42,0,0,1,42,42ZM150,88a6,6,0,0,1-6,6H112a6,6,0,0,1,0-12h32A6,6,0,0,1,150,88Z',
  },
];

const ready = [
  ['Parcelace', 'dokončená'],
  ['Inženýrské sítě', 'přivedené'],
  ['Komunikace', 'nově vybudovaná'],
  ['Vjezd a stání', 'vydlážděné'],
];

const route = [
  { place: 'Řež', time: 'odjezd' },
  { place: 'Praha-Podbaba', time: '14 min' },
  { place: 'Praha-Bubny', time: '19 min' },
  { place: 'Masarykovo nádraží', time: '24 min' },
];

const params = [
  ['Výměra pozemku', '1 008 m²'],
  ['Délka pozemku', '54,4 m'],
  ['Strana do ulice V Údolí', '41,1 m'],
  ['Funkční plocha', 'BI – bydlení v RD'],
  ['Typ stavby', 'izolovaný RD, max. 3 byty'],
  ['Podlažnost', '2 NP, nebo 1 NP + podkroví'],
  ['Max. výška', '9 m'],
  ['Zeleň', 'min. 60 % · 605 m²'],
  ['Zastavěno a zpevněno', 'max. 403 m²'],
  ['Doprovodné stavby', 'každá do 50 m²'],
  ['Oplocení do ulice', 'max. 1,8 m'],
  ['Záplavové území', 'mimo Q100 i aktivní zónu'],
];

const extras = [
  'Domácí kancelář, služby či obchod v domě do 200 m², bez rušení okolí.',
  'Garáž, pergola, bazén nebo altán jako doprovodné stavby.',
  'Penzion až pro 20 lůžek, podmíněně přípustné.',
  'Klidné sousedství: v lokalitě nejvýše 4 izolované domy, bez řadovek a bytových domů.',
];

const place = [
  ['Škola a školka', 'ZŠ (1.–5. ročník) a MŠ Husinec-Řež v docházkové vzdálenosti.'],
  ['Příroda za domem', 'Skály, lesy a stezky údolí Vltavy pár metrů od pozemku.'],
  ['Vltava a cyklostezka', 'Řeka kousek pěšky, po cyklostezce 13 km do Holešovic.'],
  ['Nová sousedská lokalita', 'Nové domy a nová komunikace, v lokalitě max. 4 domy.'],
  ['Krásné výhledy', 'Do údolí Vltavy a na zalesněné svahy okolo.'],
  ['Klidná obec u Prahy', 'Řež leží v meandru Vltavy, 6 km severně od Prahy.'],
];

// Hranice p. č. 774 převzaté z vektorové kresby v nabídkovém PDF, v pixelech letecky.webp (1800 × 985).
const plotPath =
  'M775.3 496.8L778.4 501.5L801.7 515.2L817 511.8L822 512.4L838.1 525.1L838 532L832.2 538.5L833 541.6L932.3 607.2L956.9 619.7L988.9 626.9L1004.7 627.2L1025.5 631L1057 633.3L1076.9 630.5L1115.2 621.6L1125.1 617L1131.4 611.4L1132.5 598.3L1128 581.5L1127.1 568.9L1122.4 557.1L1041.4 447.1L975.1 390.2L968.9 391.1Z';
const plotAnchor = [972, 390];

const arrow = '<svg class="o-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2.5 8h11M9.5 4.5 13 8l-3.5 3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<OfferLayout
  title="Stavební pozemek 1 008 m², Husinec–Řež | REAMAR"
  description="Zasíťovaný stavební pozemek p. č. 774 v ulici V Údolí, Husinec–Řež. 1 008 m² u nové komunikace, vjezd hotový. 24 minut vlakem na Masarykovo nádraží. Cena 9 990 000 Kč."
  image={`${base}/og.jpg`}
  canonical="/pozemekhusinec"
  robots="noindex, nofollow"
>
  <script is:inline>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('motion');
    }
  </script>
  <header class="offer-header" data-offer-header>
    <div class="mx-auto flex h-[72px] w-[90%] max-w-[1280px] items-center justify-between gap-6 md:h-[84px]">
      <a href="https://www.reamar.cz/" class="relative shrink-0" title="Reamar">
        <img src="/images/logo-rig-w.svg" alt="Reamar" width="140" height="36" class="offer-logo-w h-8 w-auto md:h-9" />
        <img src="/images/logo-rig-b.svg" alt="" width="140" height="36" class="offer-logo-b h-8 w-auto md:h-9" aria-hidden="true" />
      </a>

      <nav class="hidden items-center gap-8 lg:flex" aria-label="Nabídka">
        <a href="#pozemek" class="offer-nav" data-nav-link>Pozemek</a>
        <a href="#dostupnost" class="offer-nav" data-nav-link>Dostupnost</a>
        <a href="#regulace" class="offer-nav" data-nav-link>Regulace</a>
        <a href="#lokalita" class="offer-nav" data-nav-link>Lokalita</a>
      </nav>

      <div class="flex items-center gap-3 md:gap-6">
        <a href={phoneHref} class="offer-nav hidden md:inline">{phone}</a>
        <a href="#kontakt" class="offer-cta o-btn">
          <Fragment set:html={arrow} />
          Domluvit prohlídku
        </a>
        <button type="button" class="offer-menu-btn lg:hidden" aria-expanded="false" aria-controls="offer-menu" aria-label="Otevřít menu" data-offer-menu-btn>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </div>
    <div id="offer-menu" class="offer-menu" hidden data-offer-menu>
      <a href="#pozemek">Pozemek</a>
      <a href="#dostupnost">Dostupnost</a>
      <a href="#regulace">Regulace</a>
      <a href="#lokalita">Lokalita</a>
      <a href="#kontakt">Domluvit prohlídku</a>
      <a href={phoneHref}>{phone}</a>
    </div>
    <span class="o-progress" aria-hidden="true" data-progress></span>
  </header>

  <main id="main">
    <section class="o-hero relative min-h-[100svh] overflow-hidden bg-black text-white" data-offer-hero>
      <div class="o-hero-media" aria-hidden="true">
        <img
          src={`${base}/hero-udoli.webp`}
          alt=""
          width="1800"
          height="1350"
          class="h-full w-full object-cover object-[center_62%]"
          fetchpriority="high"
          data-hero-img
        />
      </div>
      <div class="o-hero-shade absolute inset-0" aria-hidden="true"></div>

      <div class="relative z-10 mx-auto flex min-h-[100svh] w-[90%] max-w-[1280px] flex-col justify-end pb-10 pt-32 md:pb-14" data-hero-content>
        <div class="grid grid-cols-12 gap-x-6">
          <p class="o-hero-in col-span-12 text-[11px] font-medium uppercase tracking-[0.24em] text-white/75" style="--d:150ms">
            Nabídka k prodeji · Husinec – Řež · 6 km severně od Prahy
          </p>
          <h1 class="col-span-12 mt-6 text-[44px] font-medium leading-[0.95] tracking-[-0.035em] md:text-[76px] lg:text-[104px]">
            <span class="o-line"><span style="--d:250ms">Stavební pozemek</span></span>
            <span class="o-line o-line-shift"><span style="--d:360ms">v&nbsp;meandru Vltavy</span></span>
          </h1>
          <div class="col-span-12 mt-8 flex flex-col gap-7 md:mt-10 lg:col-span-5 lg:col-start-8 lg:mt-12">
            <p class="o-hero-in o-hero-badge" style="--d:520ms">
              <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M240,210H222V131.17l5.76,5.76a6,6,0,0,0,8.48-8.49L137.9,30.09a14,14,0,0,0-19.8,0L19.76,128.44a6,6,0,0,0,8.48,8.49L34,131.17V210H16a6,6,0,0,0,0,12H240a6,6,0,0,0,0-12ZM46,119.17l80.58-80.59a2,2,0,0,1,2.84,0L210,119.17V210H158V152a6,6,0,0,0-6-6H104a6,6,0,0,0-6,6v58H46ZM146,210H110V158h36Z" /></svg>
              Vhodné pro rodinný dům
            </p>
            <p class="o-hero-in max-w-[44ch] text-[16px] font-medium leading-[1.55] text-white/85 md:text-[17px]" style="--d:600ms">
              Zasíťovaný pozemek o&nbsp;výměře 1&nbsp;008&nbsp;m² v&nbsp;nové lokalitě rodinných domů, přímo u&nbsp;nově vybudované komunikace. Parcelace je hotová, vjezd s&nbsp;návštěvnickým stáním je vydlážděný.
            </p>
            <p class="o-hero-in flex items-baseline gap-4" style="--d:660ms">
              <span class="text-[11px] font-medium uppercase tracking-[0.2em] text-white/60">Cena</span>
              <span class="text-[30px] font-medium leading-none tracking-[-0.03em] tabular-nums md:text-[38px]">{price}</span>
            </p>
            <div class="o-hero-in flex flex-wrap items-center gap-2" style="--d:720ms">
              <a href="#kontakt" class="o-btn inline-flex items-center gap-1.5 bg-white px-3 py-1.5 text-[13px] font-medium leading-none text-black no-underline">
                <Fragment set:html={arrow} />
                Domluvit prohlídku
              </a>
              <a href="#regulace" class="inline-flex items-center border border-white/60 px-3 py-1.5 text-[13px] font-medium leading-none text-white no-underline transition-colors hover:bg-white hover:text-black">
                Co zde postavíte
              </a>
            </div>
          </div>
        </div>

        <dl class="mt-14 grid grid-cols-2 gap-x-6 gap-y-7 md:mt-20 md:grid-cols-4">
          {stats.map((item, i) => (
            <div class="o-hero-in relative pt-5" style={`--d:${850 + i * 90}ms`}>
              <span class="o-hero-rule" style={`--d:${850 + i * 90}ms`} aria-hidden="true"></span>
              <dt class="text-[30px] font-medium leading-none tracking-[-0.035em] tabular-nums md:text-[40px]">
                <span data-count={item.count} data-count-hero>{item.display}</span>&nbsp;{item.unit}
              </dt>
              <dd class="mt-2.5 text-[11px] font-medium uppercase tracking-[0.14em] text-white/60">{item.label}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-8 flex items-end justify-between gap-6">
          <p class="o-hero-in text-[11px] font-medium text-white/45" style="--d:1250ms">
            p.&nbsp;č.&nbsp;774 · k.&nbsp;ú. Husinec u&nbsp;Řeže · ulice V&nbsp;Údolí · foto z&nbsp;dronu, září 2026
          </p>
          <a href="#pozemek" class="o-hero-in o-scroll-cue hidden md:flex" style="--d:1350ms" aria-label="Posunout na informace o pozemku">
            <span>Scroll</span>
            <span class="o-scroll-line" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>

    <div class="o-marquee border-b border-black/10 bg-white py-5 md:py-6" aria-hidden="true">
      <div class="o-marquee-track">
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {marquee.map((item) => (
              <span class="flex items-center whitespace-nowrap px-6 text-[18px] font-medium tracking-[-0.01em] md:px-9 md:text-[22px]">
                {item}
                <span class="ml-12 inline-block h-1.5 w-1.5 rounded-full bg-black/25 md:ml-[4.5rem]"></span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <section id="pozemek" class="o-section scroll-mt-20 bg-white">
      <div class="o-wrap grid grid-cols-12 gap-x-6 gap-y-8">
        <p class="o-eyebrow col-span-12 lg:col-span-3" data-reveal>01 — O pozemku</p>
        <p class="col-span-12 text-[26px] font-medium leading-[1.2] tracking-[-0.025em] md:text-[40px] lg:col-span-9 lg:text-[46px]" data-scrub>
          Pozemek p.&nbsp;č.&nbsp;774 v&nbsp;k.&nbsp;ú. Husinec u&nbsp;Řeže leží v&nbsp;ulici V&nbsp;Údolí, v&nbsp;lokalitě, kde vyrůstají nové rodinné domy. Navazuje přímo na nově vybudovanou komunikaci, sítě jsou přivedené a&nbsp;parcelace je dokončená.
        </p>
      </div>

      <div class="o-wrap mt-24 grid grid-cols-12 items-end gap-x-6 gap-y-12 md:mt-36">
        <figure class="col-span-12 lg:col-span-7">
          <button type="button" class="o-shot block w-full" data-shot={`${base}/vjezd.webp`} data-caption="Vjezd a návštěvnické stání, ulice V Údolí, září 2026" data-reveal="photo">
            <span class="o-frame aspect-[5/4]">
              <img src={`${base}/vjezd.webp`} alt="Vydlážděný vjezd a návštěvnické stání před pozemkem" width="1500" height="1125" loading="lazy" data-parallax="0.08" />
            </span>
          </button>
          <figcaption class="o-caption" data-reveal>Vjezd a návštěvnické stání · vydlážděno, připraveno</figcaption>
        </figure>

        <div class="col-span-12 lg:col-span-4 lg:col-start-9 lg:pb-12">
          <h2 class="o-h2 lg:!text-[52px]" data-split>Připraveno ke stavbě</h2>
          <p class="mt-6 text-[16px] font-medium leading-[1.65] text-black/70" data-reveal style="--d:150ms">
            Stačí projekt a&nbsp;povolení stavby. <strong class="font-semibold text-black">Územní plán tu umožňuje izolovaný rodinný dům</strong> až o&nbsp;dvou podlažích a&nbsp;výšce 9&nbsp;m.
          </p>
          <ul class="mt-10 grid grid-cols-2 gap-x-6 gap-y-6">
            {ready.map(([title, note], i) => (
              <li class="relative pt-4" data-reveal style={`--d:${200 + i * 90}ms`}>
                <span class="o-rule" data-reveal="line" style={`--d:${200 + i * 90}ms`} aria-hidden="true"></span>
                <span class="flex items-center gap-2 text-[15px] font-medium">
                  <svg class="o-check h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 8.5 3.2 3L13 4.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  {title}
                </span>
                <span class="mt-1 block pl-[22px] text-[13px] font-medium text-black/45">{note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="o-wrap mt-28 md:mt-44">
        <div class="grid grid-cols-12 gap-x-6">
          <p class="o-eyebrow col-span-12 lg:col-span-3" data-reveal>Přednosti pozemku</p>
        </div>
