  <a href="#kontakt" class="o-float o-btn" data-float-cta>
    <span class="o-float-dot" aria-hidden="true"></span>
    <span>Domluvit prohlídku</span>
    <span class="text-white/50">·</span>
    <span class="text-white/70">{price}</span>
