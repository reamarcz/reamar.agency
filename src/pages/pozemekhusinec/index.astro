            <div class="sm:col-span-2">
              <button type="submit" class="o-btn inline-flex items-center gap-1.5 bg-black px-3 py-1.5 text-[13px] font-medium leading-none text-white disabled:cursor-not-allowed disabled:opacity-60" data-plot-submit>
                <Fragment set:html={arrow} />
                <span data-plot-submit-label>Odeslat</span>
              </button>
            </div>
          </form>

          <div class="hidden" data-plot-success>
            <h3 class="text-[28px] font-medium leading-tight">Děkujeme</h3>
            <p class="mt-3 text-[15px] font-medium leading-[1.55]">
