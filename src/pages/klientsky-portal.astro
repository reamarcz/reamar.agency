---
import Layout from '../layouts/Layout.astro';
import KlientskyPortal2 from '../components/KlientskyPortal2.astro';
import { seoPages } from '../data/seo-pages';

const s = seoPages.portal;
---

<Layout
  title={s.title}
  description={s.description}
  canonical={s.canonical}
  image={s.image}
  ogTitle={s.ogTitle}
  ogDescription={s.ogDescription}
  ogImageAlt={s.ogImageAlt}
  theme="dark"
>
  <KlientskyPortal2
    loginHref="https://www.reamar-konzultace.cz"
    screenImage="/img/portal/screen-desktop.png"
    mobileImage="/img/portal/screen-mobile.png"
  />
</Layout>
