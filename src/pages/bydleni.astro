---
import Layout from '../layouts/Layout.astro';
import BydleniHero from '../components/BydleniHero.astro';
import SectionSpecializace from '../components/SectionSpecializace.astro';
import SectionZastoupeni from '../components/SectionZastoupeni.astro';
import SectionFooter from '../components/SectionFooter.astro';
import PoptavkaPatickaSvetla from '../components/PoptavkaPatickaSvetla.astro';
import JsonLd from '../components/JsonLd.astro';
import { seoPages } from '../data/seo-pages';
import { organizationGraph, serviceLd } from '../lib/jsonld';

const s = seoPages.bydleni;
---

<Layout
  title={s.title}
  description={s.description}
  canonical={s.canonical}
  image={s.image}
  ogTitle={s.ogTitle}
  ogDescription={s.ogDescription}
  ogImageAlt={s.ogImageAlt}
>
  <JsonLd data={organizationGraph()} />
  <JsonLd
    data={serviceLd({
      name: 'Zastupování kupujících při výběru bydlení v novostavbě',
      description: s.description,
      url: s.canonical,
    })}
  />
  <BydleniHero
    videoSrc="/videos/Intro_ALT_Bydleni.mp4"
    posterSrc="/images/agency/poster-bydleni-honza.webp"
    mobilePosterSrc="/images/agency/poster-bydleni-honza.webp"
  />
  <SectionSpecializace />
  <SectionZastoupeni />
  <PoptavkaPatickaSvetla
    context="/bydleni"
    photoCol="820px"
    video="/images/agency/agent-pise.mp4"
    videoPoster="/images/agency/agent-pise.webp"
    photoPosition="center 22%"
  />
  <SectionFooter showIntro={false} />
</Layout>
