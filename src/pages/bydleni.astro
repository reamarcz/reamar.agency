---
import Layout from '../layouts/Layout.astro';
import BydleniHero from '../components/BydleniHero.astro';
import SectionSpecializace from '../components/SectionSpecializace.astro';
import SectionZastoupeni from '../components/SectionZastoupeni.astro';
import SectionVyberSluzeb from '../components/SectionVyberSluzeb.astro';
import SectionPrilecitosti from '../components/SectionPrilecitosti.astro';
import SectionFooter from '../components/SectionFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import { seoPages } from '../data/seo-pages';
import { organizationGraph, serviceLd } from '../lib/jsonld';

const s = seoPages.bydleni;
---

<Layout
  title={s.title}
  description={s.description}
  canonical={s.canonical}
  image={s.image}
  ogTitle={s.ogTitle}
  ogDescription={s.ogDescription}
  ogImageAlt={s.ogImageAlt}
>
  <JsonLd data={organizationGraph()} />
  <JsonLd
    data={serviceLd({
      name: 'Zastupování kupujících při výběru bydlení v novostavbě',
      description: s.description,
      url: s.canonical,
    })}
  />
  <BydleniHero
    videoSrc="/videos/agentprokupujici.mp4"
    posterSrc="/images/agency/jv-holder1.png"
    mobilePosterSrc="/images/agency/poster-epizoda-0-16-720.webp"
  />
  <div class="bydleni-flow">
    <SectionSpecializace />
    <SectionZastoupeni />
    <SectionVyberSluzeb headingAs="h2" compactTop={false} showSubline={false} />
    <SectionPrilecitosti ctaLabel="První krok" openContact />
  </div>
  <SectionFooter showIntro={false} />
</Layout>

<style>
  .bydleni-flow {
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 767px) {
    .bydleni-flow :global(#prilezitosti) {
      order: -1;
    }
  }
</style>
