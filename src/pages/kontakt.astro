---
import Layout from '../layouts/Layout.astro';
---
<Layout title="REAMAR | Kontakt" description="Kontaktujte Reamar – marketing a prodej pro realitní developery." canonical="https://www.reamar.cz/kontakt">
  <section class="min-h-screen pt-24 pb-20 md:pt-32">
    <div class="mx-auto max-w-[1600px] px-6 lg:px-10">
      <h1 class="font-yellix text-3xl font-medium tracking-tight text-black md:text-4xl">Kontakt</h1>
      <p class="mt-6 max-w-xl leading-relaxed text-black/80">
        Ozvěte se nám pro konzultaci nebo domluvu schůzky.
      </p>
      <div class="mt-12 space-y-2">
        <p class="font-yellix text-lg font-medium text-black">+420 227 026 892</p>
        <a href="mailto:info@reamar.cz" class="text-black/80 underline hover:text-black transition-colors">info@reamar.cz</a>
      </div>
      <p class="mt-12 text-sm text-black/60">
        Reamar Invest Group, s.r.o.<br />
        Rybná 716/24, Staré Město, 110 00 Praha
      </p>
      <a href="/" class="btn-premium mt-12 inline-block border border-black/20 px-6 py-3 text-sm font-medium text-black transition-colors hover:border-black/40">
        ← Zpět na úvod
      </a>
    </div>
  </section>
</Layout>
