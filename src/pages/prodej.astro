            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
              <rect x="1" y="1" width="18" height="12"/>
              <polygon points="2,13 2,18 7,13" fill="currentColor" stroke="none"/>
              <rect x="11" y="17" width="18" height="12"/>
              <polygon points="28,17 28,12 23,17" fill="currentColor" stroke="none"/>
