<script>
  function initProdejRotate() {
    if (window.__prodejWordTimeoutId) {
      clearTimeout(window.__prodejWordTimeoutId);
      window.__prodejWordTimeoutId = null;
    }
    const el = document.querySelector('[data-prodej-word]');
    if (!el) return;

    const words = ['byt', 'dům', 'pozemek', 'projekt'];
    let i = 0;
    const DISPLAY_MS = 2200;
    const SWAP_MS = 320;

    function tick() {
      if (!document.body.contains(el)) return;
      el.classList.add('is-out');
      setTimeout(function () {
        i = (i + 1) % words.length;
        el.textContent = words[i];
        el.classList.remove('is-out');
        el.classList.add('is-in');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            el.classList.remove('is-in');
          });
        });
      }, SWAP_MS);
      window.__prodejWordTimeoutId = setTimeout(tick, DISPLAY_MS);
    }

    window.__prodejWordTimeoutId = setTimeout(tick, DISPLAY_MS);
  }

  initProdejRotate();
  document.addEventListener('astro:page-load', initProdejRotate);

  function initProdejScroll() {
    document.querySelectorAll('[data-prodej-scroll]').forEach(function (el) {
      if (el.dataset.prodejScrollInit === '1') return;
      el.dataset.prodejScrollInit = '1';
      el.addEventListener('click', function (e) {
        const href = el.getAttribute('href') || '';
        if (!href.startsWith('#')) return;
        const target = document.querySelector(href);
        if (!target) return;
        e.preventDefault();
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      });
    });
  }
  initProdejScroll();
  document.addEventListener('astro:page-load', initProdejScroll);

  /* ── Plovoucí pill: zavření jako mkt-pill na homepage (sessionStorage) ─── */
  function initProdejPillDismiss() {
    var pill = document.getElementById('prodej-pill');
    var closeBtn = document.getElementById('prodej-pill-close');
    if (!pill || !closeBtn) return;
    if (pill.getAttribute('data-pill-dismiss-init') === '1') return;
    pill.setAttribute('data-pill-dismiss-init', '1');

    try {
      if (sessionStorage.getItem('prodej-pill-dismissed') === '1') {
        pill.classList.add('is-dismissed');
        return;
      }
    } catch (_) {}

    closeBtn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      pill.classList.add('is-dismissed');
      try {
        sessionStorage.setItem('prodej-pill-dismissed', '1');
      } catch (_) {}
    });
  }
  initProdejPillDismiss();
  document.addEventListener('astro:page-load', initProdejPillDismiss);

  /* ── Osa "Průběh spolupráce": reveal animation na scroll ──────────────────
     Když sekce vstoupí do viewportu, přidáme .is-visible na <ol class="prodej-postup-steps">.
     CSS pak postupně odhalí connectory, ikony a texty s kaskádovým delay.
     One-shot — observer se po prvním vstupu odpojí. */
  function initProdejPostupReveal() {
    var steps = document.querySelector('.prodej-postup-steps');
    if (!steps) return;
    if (steps.dataset.prodejPostupInit === '1') return;
    steps.dataset.prodejPostupInit = '1';

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || !('IntersectionObserver' in window)) {
      steps.classList.add('is-visible');
      return;
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          steps.classList.add('is-visible');
          observer.disconnect();
        }
      });
    }, { threshold: 0.18, rootMargin: '0px 0px -10% 0px' });

    observer.observe(steps);
  }
  initProdejPostupReveal();
  document.addEventListener('astro:page-load', initProdejPostupReveal);

  /* ── Grid kampaní: 6 karet + lightbox po kliku ── */

  /* Dynamicky čte data-k0, data-k1, … data-kN z root elementu — pool je libovolně škálovatelný */
  function readProdejCampaignUrls(campRoot) {
    var urls = [];
    for (var i = 0; i < 64; i++) {
      var v = campRoot.getAttribute('data-k' + i);
      if (!v) break;
      urls.push(v);
    }
    return urls;
  }

  function bindProdejCampaignLightbox() {
    var dialog = document.getElementById('prodej-campaign-lightbox');
    var campRoot = document.getElementById('prodej-campaign');
    if (!dialog || !campRoot) return;

    var imgEl = document.getElementById('prodej-campaign-lb-img');
    var btnClose = dialog.querySelector('[data-prodej-lb-close]');
    var btnPrev = dialog.querySelector('[data-prodej-lb-prev]');
    var btnNext = dialog.querySelector('[data-prodej-lb-next]');
    var stage = document.getElementById('prodej-campaign-lb-stage');

    var urls = readProdejCampaignUrls(campRoot);
    if (urls.length < 1 || !imgEl || !btnClose || !btnPrev || !btnNext) return;

    function showSlide(i) {
      var idx = (((i % urls.length) + urls.length) % urls.length);
      dialog._lbCurrent = idx;
      imgEl.src = urls[idx];
      imgEl.alt = 'Náhled kampaně (' + (idx + 1) + ' z ' + urls.length + ')';
    }

    if (!campRoot.dataset.lbDelegated) {
      campRoot.dataset.lbDelegated = '1';
      campRoot.addEventListener('click', function (e) {
        var trig = e.target.closest('[data-prodej-campaign-open]');
        if (!trig || !campRoot.contains(trig)) return;
        e.preventDefault();
        var idx = parseInt(trig.dataset.idx || '0', 10);
        showSlide(isNaN(idx) ? 0 : idx);
        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
      });
    }

    if (!dialog.dataset.lbInit) {
      dialog.dataset.lbInit = '1';
      dialog._lbShowSlide = showSlide;

      btnClose.addEventListener('click', function () {
        dialog.close();
      });
      btnPrev.addEventListener('click', function (e) {
        e.stopPropagation();
        showSlide((dialog._lbCurrent || 0) - 1);
      });
      btnNext.addEventListener('click', function (e) {
        e.stopPropagation();
        showSlide((dialog._lbCurrent || 0) + 1);
      });
      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) dialog.close();
      });
      dialog.addEventListener('cancel', function (e) {
        e.preventDefault();
        dialog.close();
      });

      dialog._lbCurrent = 0;

      if (!dialog._lbKbdAttached) {
        dialog._lbKbdAttached = true;
        document.addEventListener('keydown', function (e) {
          var d = document.getElementById('prodej-campaign-lightbox');
          if (!d || !d.open || typeof d._lbShowSlide !== 'function') return;
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            d._lbShowSlide((d._lbCurrent || 0) - 1);
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            d._lbShowSlide((d._lbCurrent || 0) + 1);
          }
        });
      }

      var touchStartX = null;
      if (stage) {
        stage.addEventListener('touchstart', function (e) {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        stage.addEventListener('touchend', function (e) {
          if (touchStartX == null || typeof dialog._lbShowSlide !== 'function' || !dialog.open) return;
          var dx = e.changedTouches[0].screenX - touchStartX;
          touchStartX = null;
          if (Math.abs(dx) < 48) return;
          if (dx > 0) {
            dialog._lbShowSlide((dialog._lbCurrent || 0) - 1);
          } else {
            dialog._lbShowSlide((dialog._lbCurrent || 0) + 1);
          }
        }, { passive: true });
      }
    }
  }

  /* Magnetic tilt — kurzor v rámci karty způsobí mírný 3D náklon.
     Max ±4° po obou osách, návrat plynule k 0° při mouseleave.
     Respektuje prefers-reduced-motion (žádné transformy). */
  function bindProdejCampaignTilt(campRoot) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (campRoot.dataset.tiltBound === '1') return;
    campRoot.dataset.tiltBound = '1';

    var MAX_DEG = 4;

    function tiltOnMove(card, e) {
      var rect = card.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      var rotateY = ((x / rect.width) * 2 - 1) * MAX_DEG;
      var rotateX = ((y / rect.height) * 2 - 1) * -MAX_DEG;
      card.style.transform =
        'perspective(800px) rotateX(' + rotateX.toFixed(2) +
        'deg) rotateY(' + rotateY.toFixed(2) + 'deg) scale(1.015)';
    }
    function resetTilt(card) {
      card.style.transform = '';
    }

    var cards = campRoot.querySelectorAll('.prodej-campaign__card');
    cards.forEach(function (card) {
      card.addEventListener('mousemove', function (e) { tiltOnMove(card, e); });
      card.addEventListener('mouseleave', function () { resetTilt(card); });
      /* Při focus/blur z klávesnice taky reset, ať neuvízne v posledním tilt stavu */
      card.addEventListener('blur', function () { resetTilt(card); });
    });
  }

  function initProdejCampaign() {
    var campRoot = document.getElementById('prodej-campaign');
    if (!campRoot) return;
    bindProdejCampaignLightbox();
    bindProdejCampaignTilt(campRoot);
  }

  initProdejCampaign();
  document.addEventListener('astro:page-load', initProdejCampaign);

  /* ── Rotátor výhod funnelu ──────────────────────────────────────────────── */
  function initBenefitsRotator() {
    var stage = document.querySelector('.prodej-funnel-benefits-stage');
    if (!stage) return;

    var items = Array.from(stage.querySelectorAll('.prodej-funnel-benefit'));
    var dots  = Array.from(document.querySelectorAll('[data-benefits-dot]'));
    var counterEl = document.querySelector('[data-benefits-current]');
    var current = 0;
    var leaveTimer = null;
    var rotateTimer = null;
    var INTERVAL = 3200;
    var TRANSITION = 480;

    function goTo(next) {
      if (next === current) return;
      var prev = current;
      current = next;

      items[prev].classList.remove('is-active');
      items[prev].classList.add('is-leaving');
      items[next].classList.add('is-active');
      items[next].removeAttribute('aria-current');
      items[next].setAttribute('aria-current', 'true');
      items[prev].removeAttribute('aria-current');

      dots.forEach(function (d, i) {
        d.classList.toggle('is-active', i === current);
      });
      if (counterEl) counterEl.textContent = String(current + 1).padStart(2, '0');

      clearTimeout(leaveTimer);
      leaveTimer = setTimeout(function () {
        items[prev].classList.remove('is-leaving');
      }, TRANSITION + 60);
    }

    function next() { goTo((current + 1) % items.length); }

    function startRotation() {
      clearInterval(rotateTimer);
      rotateTimer = setInterval(next, INTERVAL);
    }

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        goTo(i);
        startRotation();
      });
    });

    startRotation();
  }

  initBenefitsRotator();
  document.addEventListener('astro:page-load', initBenefitsRotator);
</script>

<!-- ═══════════════════════════════════════════════════════════════════════
     SCRIPT: WIZARD POPTÁVKA — 3-krokový formulář napojený na sendContactForm
     Importuje actions z astro:actions, drží state napříč kroky, validuje
     jednotlivé kroky před přechodem dál a submituje payload do Resend emailu.
     ═══════════════════════════════════════════════════════════════════════ -->
<script>
  import { actions } from 'astro:actions';

  function initProdejPoptavka() {
    const section = document.getElementById('prodej-poptavka');
    if (!section) return;
    if (section.dataset.initialized === '1') return;
    section.dataset.initialized = '1';

    const form = section.querySelector('#prodej-poptavka-form');
    const stages = section.querySelectorAll('.prodej-poptavka-stage');
    const stepNavBtns = section.querySelectorAll('.prodej-poptavka-stepnav');
    const submitBtn = section.querySelector('[data-poptavka-submit]');

    let currentStep = 1;

    /* Stav napříč kroky — jeden objekt drží všechny volby a inputy.
       Hlavní volby jsou single-select (string), doplňky multi-select (array). */
    const state = {
      typ: null,
      dispozice: null,
      stav: null,
      lokalita: '',
      hlavni: null,
      jmeno: '',
      telefon: '',
      email: '',
      termin: null,
      poznamka: '',
      odkaz: '',
      souhlas: false,
    };

    function showStep(step, opts) {
      opts = opts || {};
      currentStep = step;
      stages.forEach(function (s) {
        const stepNum = s.getAttribute('data-step');
        if (String(stepNum) === String(step)) s.removeAttribute('hidden');
        else s.setAttribute('hidden', '');
      });
      stepNavBtns.forEach(function (btn) {
        const stepNum = btn.getAttribute('data-step-go');
        btn.classList.remove('is-active', 'is-completed');
        if (String(stepNum) === String(step)) {
          btn.classList.add('is-active');
          btn.setAttribute('aria-current', 'step');
        } else {
          btn.removeAttribute('aria-current');
          if (typeof step === 'number' && parseInt(stepNum, 10) < step) {
            btn.classList.add('is-completed');
          }
        }
      });
      /* Scroll jen při přechodu kroků z akce uživatele — ne při prvním showStep(1) po načtení stránky. */
      if (typeof step === 'number' && opts.scroll) {
        try {
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (_) {}
      }
    }

    function setChoice(group, value, multiple) {
      if (multiple) {
        const arr = state[group] || [];
        const idx = arr.indexOf(value);
        if (idx === -1) arr.push(value);
        else arr.splice(idx, 1);
        state[group] = arr;
      } else {
        state[group] = state[group] === value ? null : value;
      }
      repaintChoices(group);
    }

    function repaintChoices(group) {
      const containers = section.querySelectorAll('[data-choice-group="' + group + '"]');
      containers.forEach(function (container) {
        const multiple = container.getAttribute('data-multiple') === 'true';
        container.querySelectorAll('.prodej-poptavka-choice, .prodej-poptavka-card-choice').forEach(function (btn) {
          const v = btn.getAttribute('data-value');
          if (multiple) {
            btn.classList.toggle('is-selected', (state[group] || []).indexOf(v) !== -1);
          } else {
            btn.classList.toggle('is-selected', state[group] === v);
          }
        });
      });
    }

    /* Bind click handlerů na všechny choice tlačítka (jednou pro celou sekci) */
    section.querySelectorAll('[data-choice-group]').forEach(function (container) {
      const group = container.getAttribute('data-choice-group');
      const multiple = container.getAttribute('data-multiple') === 'true';
      container.querySelectorAll('.prodej-poptavka-choice, .prodej-poptavka-card-choice').forEach(function (btn) {
        btn.addEventListener('click', function () {
          setChoice(group, btn.getAttribute('data-value'), multiple);
        });
      });
    });

    /* Sync text inputů do state objektu */
    const inputBindings = ['lokalita', 'jmeno', 'telefon', 'email', 'poznamka', 'odkaz'];
    inputBindings.forEach(function (name) {
      const el = section.querySelector('[name="' + name + '"]');
      if (el) {
        el.addEventListener('input', function () { state[name] = el.value; });
      }
    });
    const souhlasEl = section.querySelector('[name="souhlas"]');
    if (souhlasEl) {
      souhlasEl.addEventListener('change', function () { state.souhlas = souhlasEl.checked; });
    }

    function showError(step, message) {
      const errEl = section.querySelector('[data-error-step="' + step + '"]');
      if (!errEl) return;
      if (message) {
        errEl.textContent = message;
        errEl.removeAttribute('hidden');
      } else {
        errEl.setAttribute('hidden', '');
      }
    }

    function markInvalidInput(name, invalid) {
      const input = section.querySelector('input[name="' + name + '"], textarea[name="' + name + '"]');
      const field = input ? input.closest('.prodej-poptavka-field') : null;
      if (field) field.classList.toggle('is-invalid', invalid);
    }

    function clearInvalidStates() {
      section.querySelectorAll('.prodej-poptavka-field').forEach(function (f) {
        f.classList.remove('is-invalid');
      });
    }

    function validateStep(step) {
      clearInvalidStates();
      showError(step, '');
      let valid = true;
      const missing = [];

      if (step === 1) {
        if (!state.typ) { missing.push('typ nemovitosti'); valid = false; }
        if (!state.dispozice) { missing.push('dispozice'); valid = false; }
        if (!state.stav) { missing.push('stav'); valid = false; }
        if (!state.lokalita.trim()) { markInvalidInput('lokalita', true); missing.push('lokalita'); valid = false; }
      } else if (step === 2) {
        if (!state.hlavni) { missing.push('hlavní volba služby'); valid = false; }
      } else if (step === 3) {
        if (!state.jmeno.trim()) { markInvalidInput('jmeno', true); missing.push('jméno'); valid = false; }
        const hasTel = state.telefon.trim().length >= 9;
        const hasEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(state.email.trim());
        if (!hasTel && !hasEmail) {
          markInvalidInput('telefon', true);
          markInvalidInput('email', true);
          missing.push('telefon nebo e-mail');
          valid = false;
        }
        if (!state.souhlas) { missing.push('souhlas se zpracováním údajů'); valid = false; }
      }

      if (!valid) {
        showError(step, 'Vyplňte prosím: ' + missing.join(', ') + '.');
      }
      return valid;
    }

    /* Step nav: Pokračovat → další krok (s validací), Zpět → předchozí (bez validace) */
    section.querySelectorAll('[data-step-next]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (validateStep(currentStep)) {
          const next = currentStep + 1;
          if (next <= 3) showStep(next, { scroll: true });
        }
      });
    });
    section.querySelectorAll('[data-step-prev]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const prev = currentStep - 1;
        if (prev >= 1) showStep(prev, { scroll: true });
      });
    });

    /* Direct step nav (klik na header krok): zpět free, dopředu jen pokud aktuální OK */
    stepNavBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const stepNum = parseInt(btn.getAttribute('data-step-go'), 10);
        if (!stepNum) return;
        if (stepNum === currentStep) return;
        if (stepNum < currentStep) {
          showStep(stepNum, { scroll: true });
        } else if (validateStep(currentStep)) {
          showStep(stepNum, { scroll: true });
        }
      });
    });

    /* Submit — sestaví payload a pošle přes Astro action.
       Server-side action validuje jméno/telefon/email; tady ošetřuju i UI feedback. */
    form?.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!validateStep(3)) return;

      if (submitBtn) {
        submitBtn.textContent = 'Odesílám…';
        submitBtn.disabled = true;
      }

      try {
        /* Server vyžaduje jméno + telefon + email pro non-newsletter/callback.
           Když uživatel zadal jen jedno z (telefon, email), doplníme placeholder
           do druhého, aby validace na serveru prošla. */
        const telefonForApi = state.telefon.trim() || 'neuvedeno';
        const emailForApi = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(state.email.trim())
          ? state.email.trim()
          : 'neuveden@reamar.cz';

        const payload = {
          formSource: 'contact',
          jmeno: state.jmeno.trim(),
          telefon: telefonForApi,
          email: emailForApi,
          vzkaz: state.poznamka.trim(),
          userType: 'client',
          selectedService: state.hlavni || 'Prodej nemovitosti',
          /* Doplňkové fieldy — server je serializuje do emailu */
          typ_nemovitosti: state.typ || '',
          dispozice: state.dispozice || '',
          stav: state.stav || '',
          lokalita: state.lokalita.trim(),
          hlavni_volba: state.hlavni || '',
          termin: state.termin || '',
          odkaz: state.odkaz.trim(),
          souhlas: state.souhlas ? 'ano' : 'ne',
        };

        const { data, error } = await actions.sendContactForm(payload);

        if (error) {
          showError(3, error.message || 'Odeslání selhalo. Zkuste to prosím znovu.');
          if (submitBtn) {
            submitBtn.textContent = 'Odeslat k posouzení';
            submitBtn.disabled = false;
          }
          return;
        }

        if (data) {
          showStep('success');
        }
      } catch (err) {
        showError(3, 'Odeslání selhalo. Zkuste to prosím znovu.');
        if (submitBtn) {
          submitBtn.textContent = 'Odeslat k posouzení';
          submitBtn.disabled = false;
        }
      }
    });

    /* Externí CTA na stránce s atributem [data-poptavka-link] míří na formulář.
       Pokud má [data-poptavka-preselect], předvybereme hlavní volbu v kroku 2.
       Smooth scroll provádíme ručně, aby fungoval i bez globální scroll-behavior. */
    document.querySelectorAll('[data-poptavka-link]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        const preselect = link.getAttribute('data-poptavka-preselect');
        if (preselect) {
          state.hlavni = preselect;
          repaintChoices('hlavni');
        }
        e.preventDefault();
        try {
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (_) {
          section.scrollIntoView();
        }
        try {
          if (history && typeof history.replaceState === 'function') {
            history.replaceState(null, '', '#prodej-poptavka');
          }
        } catch (_) {}
      });
    });

    /* Po reloadu/page-load resetneme state */
    showStep(1);
  }

  initProdejPoptavka();
  document.addEventListener('astro:page-load', initProdejPoptavka);

  /* ── Scroll Reveal ──────────────────────────────────────────────────── */
  function initProdejReveal() {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* Skupiny, jejichž přímé children se staggerují kaskádovitě */
    var STAGGER_PARENTS = [
      '.prodej-services-grid',
      '.prodej-funnel-stats',
      '.prodej-campaign',
    ];

    /* Jednotlivé elementy, které se odhalují jako celek */
    var SOLO_SELECTORS = [
      '.prodej-services-head',
      '.prodej-services-footnote',
      '.prodej-process-h',
      '.prodej-funnel-content',
      '.prodej-funnel-detail-main',
      '.prodej-funnel-benefits',
      '.prodej-funnel-detail-divider',
      '.prodej-postup-head',
      '.prodej-poptavka-card',
    ];

    var toObserve = [];

    /* Stagger: přímé children stagger parentů */
    STAGGER_PARENTS.forEach(function(sel) {
      var parent = document.querySelector(sel);
      if (!parent) return;
      Array.from(parent.children).forEach(function(child, i) {
        child.classList.add('prodej-reveal');
        child.style.transitionDelay = (i * 90) + 'ms';
        toObserve.push(child);
      });
    });

    /* Solo elementy */
    SOLO_SELECTORS.forEach(function(sel) {
      var els = document.querySelectorAll(sel);
      els.forEach(function(el) {
        /* Nepřidávat reveal pokud je uvnitř hero (má vlastní animaci) */
        if (el.closest('#prodej-hero')) return;
        el.classList.add('prodej-reveal');
        toObserve.push(el);
      });
    });

    /* Process items — vlastní stagger uvnitř osy */
    var processItems = document.querySelectorAll('.prodej-process-item');
    processItems.forEach(function(el, i) {
      el.classList.add('prodej-reveal');
      el.style.transitionDelay = (i * 70) + 'ms';
      toObserve.push(el);
    });

    if (toObserve.length === 0) return;

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-revealed');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -4% 0px' });

    toObserve.forEach(function(el) { observer.observe(el); });
  }

  initProdejReveal();
  document.addEventListener('astro:page-load', initProdejReveal);

  /* ── Word-by-word quote reveal ──────────────────────────────────────── */
  function initProdejQuoteReveal() {
    var quote = document.querySelector('.prodej-process-quote');
    if (!quote) return;

    /* Split jednou — na re-init stačí jen přidat observer */
    if (!quote.dataset.wordSplit) {
      var text = quote.textContent.trim();
      var words = text.split(' ');
      quote.innerHTML = words.map(function(word, i) {
        var safe = word
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
        return '<span class="prodej-quote-word" style="transition-delay:' + (i * 30) + 'ms">' + safe + '</span>';
      }).join(' ');
      quote.dataset.wordSplit = '1';
    }

    /* Fallback / reduced motion: okamžitě zobraz */
    if (!('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      quote.classList.add('is-word-revealed');
      return;
    }

    quote.classList.remove('is-word-revealed');

    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        quote.classList.add('is-word-revealed');
        obs.unobserve(entry.target);
      });
    }, { threshold: 0.25, rootMargin: '0px 0px -6% 0px' });

    obs.observe(quote);
  }

  initProdejQuoteReveal();
  document.addEventListener('astro:page-load', initProdejQuoteReveal);
</script>
