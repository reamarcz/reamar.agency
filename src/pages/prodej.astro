              <polyline points="19,1 19,9 25,9"/>
              <line x1="7" y1="15" x2="17" y2="15"/>
              <line x1="7" y1="19" x2="15" y2="19"/>
              <polyline points="7,25 11,29 21,21" stroke-width="2.2"/>
            </svg>
          </span>
          <span class="prodej-postup-connector prodej-postup-connector--r"></span>
        </div>
        <div class="prodej-postup-step-text">
          <p class="prodej-postup-num font-yellix">05</p>
          <p class="prodej-postup-title font-yellix">Prodej a právní servis</p>
          <p class="prodej-postup-desc font-yellix">Dohlédneme na smlouvy, úschovu, katastr i&nbsp;bezpečné předání.</p>
        </div>
      </li>

    </ol>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════
     SEKCE: POPTÁVKA — 3-krokový wizard formulář napojený na actions.sendContactForm
     Editorial styl podle předlohy: vzdušné karty, klikatelné textové volby,
     podtržené inputy, minimum vizuálního šumu. Validace per krok.
     ═══════════════════════════════════════════════════════════════════════ -->
<section id="prodej-poptavka" class="prodej-poptavka" aria-labelledby="prodej-poptavka-heading">
  <div class="prodej-poptavka-card font-yellix">

    <!-- Progress nav: 3 kroky oddělené hairline linkami -->
    <nav class="prodej-poptavka-nav" aria-label="Postup formulářem">
      <button type="button" class="prodej-poptavka-stepnav is-active" data-step-go="1" aria-current="step">Informace o nemovitosti</button>
      <span class="prodej-poptavka-stepnav-line" aria-hidden="true"></span>
      <button type="button" class="prodej-poptavka-stepnav" data-step-go="2">Výběr služeb</button>
      <span class="prodej-poptavka-stepnav-line" aria-hidden="true"></span>
      <button type="button" class="prodej-poptavka-stepnav" data-step-go="3">Kontakt</button>
    </nav>

    <form id="prodej-poptavka-form" novalidate>

      <!-- ── KROK 1: INFORMACE O NEMOVITOSTI ────────────────────────── -->
      <div class="prodej-poptavka-stage" data-step="1">
        <h2 id="prodej-poptavka-heading" class="prodej-poptavka-h">
          Získejte návrh, jak nejlépe<br />prodat vaši nemovitost
        </h2>
        <p class="prodej-poptavka-intro">
          Odpovězte na pár otázek a&nbsp;získejte návrh, jak nejlépe prodat vaši nemovitost.<br /><strong>Zabere to&nbsp;přibližně 1&nbsp;minutu.</strong>
        </p>

        <div class="prodej-poptavka-fields">
          <div class="prodej-poptavka-field">
            <span class="prodej-poptavka-label">Typ nemovitosti</span>
            <div class="prodej-poptavka-choices" data-choice-group="typ" data-multiple="false">
              <button type="button" class="prodej-poptavka-choice" data-value="byt">byt</button>
              <button type="button" class="prodej-poptavka-choice" data-value="dům">dům</button>
              <button type="button" class="prodej-poptavka-choice" data-value="pozemek">pozemek</button>
              <button type="button" class="prodej-poptavka-choice" data-value="postoupení smlouvy">postoupení smlouvy</button>
            </div>
          </div>

          <div class="prodej-poptavka-field">
            <span class="prodej-poptavka-label">Dispozice</span>
            <div class="prodej-poptavka-choices prodej-poptavka-choices--slashed" data-choice-group="dispozice" data-multiple="false">
              <button type="button" class="prodej-poptavka-choice" data-value="1+kk">1+kk</button>
              <button type="button" class="prodej-poptavka-choice" data-value="2+kk">2+kk</button>
              <button type="button" class="prodej-poptavka-choice" data-value="3+kk">3+kk</button>
              <button type="button" class="prodej-poptavka-choice" data-value="4+kk+">4+kk+</button>
              <button type="button" class="prodej-poptavka-choice" data-value="dům">dům</button>
              <button type="button" class="prodej-poptavka-choice" data-value="jiné">jiné</button>
            </div>
          </div>

          <div class="prodej-poptavka-field">
            <span class="prodej-poptavka-label">Stav</span>
            <div class="prodej-poptavka-choices prodej-poptavka-choices--slashed" data-choice-group="stav" data-multiple="false">
              <button type="button" class="prodej-poptavka-choice" data-value="novostavba">novostavba</button>
              <button type="button" class="prodej-poptavka-choice" data-value="po rekonstrukci">po rekonstrukci</button>
              <button type="button" class="prodej-poptavka-choice" data-value="udržovaný stav">udržovaný stav</button>
              <button type="button" class="prodej-poptavka-choice" data-value="před rekonstrukcí">před rekonstrukcí</button>
            </div>
          </div>

          <div class="prodej-poptavka-field">
            <label class="prodej-poptavka-label" for="prodej-poptavka-lokalita">Lokalita</label>
            <input
              id="prodej-poptavka-lokalita"
              name="lokalita"
              type="text"
              class="prodej-poptavka-input"
              placeholder="zadejte adresu"
              autocomplete="street-address"
            />
          </div>
        </div>

        <p class="prodej-poptavka-error" data-error-step="1" hidden></p>

        <div class="prodej-poptavka-actions">
          <button type="button" class="prodej-poptavka-cta" data-step-next>Pokračovat</button>
        </div>
      </div>

      <!-- ── KROK 2: VÝBĚR SLUŽEB ──────────────────────────────────── -->
      <div class="prodej-poptavka-stage" data-step="2" hidden>
        <h2 class="prodej-poptavka-h">Vyberte, co od&nbsp;nás chcete využít</h2>
        <p class="prodej-poptavka-intro">
          Můžete si vzít jen marketingové zázemí, nebo nám svěřit celý prodej. Pokud si nejste jistí, vyberte možnost doporučení postupu.
        </p>

        <div class="prodej-poptavka-fields">
          <div class="prodej-poptavka-field prodej-poptavka-field--main">
            <div class="prodej-poptavka-cards" data-choice-group="hlavni" data-multiple="false">
              <button type="button" class="prodej-poptavka-card-choice" data-value="Marketing nemovitosti">
                <span class="prodej-poptavka-card-title">Marketing nemovitosti</span>
                <span class="prodej-poptavka-card-desc">Pro majitele, kteří chtějí prodávat sami.</span>
              </button>
              <button type="button" class="prodej-poptavka-card-choice" data-value="Marketing a prodej nemovitosti">
                <span class="prodej-poptavka-card-title">Marketing a&nbsp;prodej nemovitosti</span>
                <span class="prodej-poptavka-card-desc">Pro majitele, kteří chtějí celý prodej svěřit nám.</span>
              </button>
              <button type="button" class="prodej-poptavka-card-choice" data-value="Nabídka na výkup">
                <span class="prodej-poptavka-card-title">Nabídka na&nbsp;výkup</span>
                <span class="prodej-poptavka-card-desc">Pro majitele, kteří chtějí rychlé a&nbsp;diskrétní řešení.</span>
              </button>
              <button type="button" class="prodej-poptavka-card-choice" data-value="Doporučte mi postup">
                <span class="prodej-poptavka-card-title">Nejsem si jistý</span>
                <span class="prodej-poptavka-card-desc">Doporučte mi vhodný postup podle nemovitosti.</span>
              </button>
            </div>
          </div>

        </div>

        <p class="prodej-poptavka-error" data-error-step="2" hidden></p>

        <div class="prodej-poptavka-actions">
          <button type="button" class="prodej-poptavka-cta prodej-poptavka-cta--secondary" data-step-prev>Zpět</button>
          <button type="button" class="prodej-poptavka-cta" data-step-next>Pokračovat</button>
        </div>
      </div>

      <!-- ── KROK 3: KONTAKT ───────────────────────────────────────── -->
      <div class="prodej-poptavka-stage" data-step="3" hidden>
        <h2 class="prodej-poptavka-h">Kam vám máme poslat návrh?</h2>
        <p class="prodej-poptavka-intro">
          Po odeslání se podíváme na nemovitost, zvolený rozsah služeb a&nbsp;navrhneme další postup.
        </p>

        <div class="prodej-poptavka-fields">
          <div class="prodej-poptavka-field">
            <label class="prodej-poptavka-label" for="prodej-poptavka-jmeno">Jméno</label>
            <input id="prodej-poptavka-jmeno" name="jmeno" type="text" class="prodej-poptavka-input" placeholder="vaše jméno a příjmení" autocomplete="name" />
          </div>
          <div class="prodej-poptavka-field">
            <label class="prodej-poptavka-label" for="prodej-poptavka-telefon">Telefon</label>
            <input id="prodej-poptavka-telefon" name="telefon" type="tel" class="prodej-poptavka-input" placeholder="váš telefon" autocomplete="tel" />
          </div>
          <div class="prodej-poptavka-field">
            <label class="prodej-poptavka-label" for="prodej-poptavka-email">E-mail</label>
            <input id="prodej-poptavka-email" name="email" type="email" class="prodej-poptavka-input" placeholder="váš e-mail" autocomplete="email" />
          </div>

          <div class="prodej-poptavka-field">
            <span class="prodej-poptavka-label">Kdy chcete prodej řešit?</span>
            <div class="prodej-poptavka-choices" data-choice-group="termin" data-multiple="false">
              <button type="button" class="prodej-poptavka-choice" data-value="co nejdříve">co nejdříve</button>
              <button type="button" class="prodej-poptavka-choice" data-value="do 3 měsíců">do 3 měsíců</button>
              <button type="button" class="prodej-poptavka-choice" data-value="do 6 měsíců">do 6 měsíců</button>
              <button type="button" class="prodej-poptavka-choice" data-value="zatím jen zjišťuji možnosti">zatím jen zjišťuji možnosti</button>
            </div>
          </div>

          <div class="prodej-poptavka-field">
            <label class="prodej-poptavka-label" for="prodej-poptavka-poznamka">Poznámka</label>
            <textarea id="prodej-poptavka-poznamka" name="poznamka" class="prodej-poptavka-input prodej-poptavka-textarea" rows="3" placeholder="Můžete doplnit cokoliv důležitého k nemovitosti nebo prodeji."></textarea>
          </div>

          <div class="prodej-poptavka-field">
            <label class="prodej-poptavka-label" for="prodej-poptavka-odkaz">Odkaz na fotky / inzerát / dokumentaci</label>
            <input id="prodej-poptavka-odkaz" name="odkaz" type="url" class="prodej-poptavka-input" placeholder="volitelné" />
          </div>

          <div class="prodej-poptavka-field prodej-poptavka-field--consent">
            <span class="prodej-poptavka-label" aria-hidden="true">Souhlas</span>
            <label class="prodej-poptavka-consent">
              <input type="checkbox" class="prodej-poptavka-checkbox" name="souhlas" />
              <span class="prodej-poptavka-consent-text">Souhlasím se&nbsp;zpracováním údajů za&nbsp;účelem posouzení nemovitosti a&nbsp;zpětného kontaktování.</span>
            </label>
          </div>
        </div>

        <p class="prodej-poptavka-error" data-error-step="3" hidden></p>

        <div class="prodej-poptavka-actions">
          <button type="button" class="prodej-poptavka-cta prodej-poptavka-cta--secondary" data-step-prev>Zpět</button>
          <button type="submit" class="prodej-poptavka-cta" data-poptavka-submit>Odeslat k posouzení</button>
        </div>
      </div>

      <!-- ── SUCCESS STATE ─────────────────────────────────────────── -->
      <div class="prodej-poptavka-stage prodej-poptavka-success" data-step="success" hidden>
        <h2 class="prodej-poptavka-h">
          Děkujeme. Návrh prodeje připravíme<br />podle zadaných informací.
        </h2>
        <p class="prodej-poptavka-intro">
          Podíváme se na nemovitost, zvolený rozsah služeb a&nbsp;možnosti dalšího postupu. Ozveme se vám co nejdříve.
        </p>
      </div>

    </form>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════
     SEKCE: VÝKUP — alternativní cesta pro klienty, kteří nechtějí prodávat
     standardní cestou. Full-bleed dark s pozadím vykup.png, centrovaný
     obsah, USPs jako spec-list a jediná primární CTA.
     ═══════════════════════════════════════════════════════════════════════ -->
<section id="prodej-vykup" class="prodej-vykup" data-nav-sticky="light" aria-labelledby="prodej-vykup-heading">
  <img
    src="/images/Prodej/vykup.png"
    alt=""
    aria-hidden="true"
    class="prodej-vykup-bg"
    width="1920"
    height="1080"
    loading="lazy"
  />
  <div class="prodej-vykup-overlay" aria-hidden="true"></div>

  <div class="prodej-vykup-wrap">
    <div class="prodej-vykup-content font-yellix">

      <h2 id="prodej-vykup-heading" class="prodej-vykup-h">
        Vykupujeme nemovitosti
      </h2>

      <p class="prodej-vykup-lead">
        Ne&nbsp;každý prodej musí jít přes trh. Pokud chcete rychlé řešení bez&nbsp;portálů, prohlídek a&nbsp;vyjednávání s&nbsp;kupujícími, připravíme individuální nabídku na&nbsp;výkup.
      </p>

      <!-- USPs jako spec-list: každý item má hairline marker nad textem -->
      <ul class="prodej-vykup-usps" aria-label="Co vám výkup přinese">
        <li class="prodej-vykup-usp">Diskrétní posouzení</li>
        <li class="prodej-vykup-usp">Rychlá nabídka</li>
        <li class="prodej-vykup-usp">Bez veřejné inzerce</li>
        <li class="prodej-vykup-usp">Bez prohlídek</li>
        <li class="prodej-vykup-usp">Právní servis v&nbsp;ceně</li>
        <li class="prodej-vykup-usp">Jasný termín vypořádání</li>
      </ul>

    </div>
  </div>

  <!-- CTA — absolutně kotvená do pravého dolního rohu sekce (desktop),
       na mobilu spadne do flow pod USPs jako full-width tlačítko. -->
  <div class="prodej-vykup-cta-row">
    <a
      href="#prodej-poptavka"
      class="prodej-vykup-btn"
      data-poptavka-link
      data-poptavka-preselect="Nabídka na výkup"
    >
      <img
        src="/images/arrow-1.svg"
        alt=""
        class="prodej-vykup-btn-icon"
        width="16"
        height="16"
        aria-hidden="true"
      />
      <span class="prodej-vykup-btn-label">Nabídnout k&nbsp;výkupu</span>
    </a>
  </div>
</section>

<!-- ── Slider kampaní — velký náhled (dialog) ─────────────────────────────── -->
<dialog
  id="prodej-campaign-lightbox"
  class="prodej-campaign-lb"
