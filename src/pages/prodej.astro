---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

/* Produkty — bento grid 6 karet, pořadí podle vizuální váhy v bento layoutu.
   kamp1 = hero (3:2 velký), kamp2/3 = wide tiles, kamp4/5/6 = small tiles */
const kamp1 = '/images/Prodej/novostavba.png';    /* Hero — Novostavby do 15 let stáří */
const kamp2 = '/images/Prodej/luxusni.png';       /* Wide — Prémiové nemovitosti */
const kamp3 = '/images/Prodej/postoupeni.png';    /* Wide — Postoupení developerských smluv */
const kamp4 = '/images/Prodej/investicni.png';    /* Small — Investiční 1+kk a 2+kk */
const kamp5 = '/images/Prodej/rekonstrukce.png';  /* Small — Kvalitní rekonstrukce */
const kamp6 = '/images/Prodej/dum.png';           /* Small — Dům jako alternativa k bytu */
---
<Layout
  title="Prodej nemovitosti v Praze | Marketing od týmu pro developery"
  description="Prodej bytu nebo domu v Praze a okolí s marketingovým zázemím z rezidenčního developmentu. Marketing nemovitosti za 1,5 %, nebo kompletní prodej s makléřem za 2,5 %."
  canonical="https://www.reamar.cz/prodej"
  image="/images/Prodej/prodejog.png"
>

<!-- ── HERO ─────────────────────────────────────────────────────────────── -->
<section
  id="prodej-hero"
  data-hero-transparent
  data-nav-sticky="dark"
  class="prodej-hero relative bg-black text-white overflow-hidden"
>
  <!-- Vnitřní wrapper – na velkých displejích omezí šířku celé kompozice -->
  <div class="prodej-hero-inner">

  <!-- Pozadí: mesh vlna + wireframe — stejný agencyhero.webp i na mobilu (contain + střed, viz MOBILE). -->
  <img
    src="/images/Prodej/agencyhero.webp"
    alt=""
    aria-hidden="true"
    class="prodej-hero-bg"
    width="1920"
    height="1080"
    fetchpriority="high"
  />

  <!-- Plovoucí částice — jen dekorace, pure CSS -->
  <div class="prodej-particles" aria-hidden="true">
    <span class="prodej-particle prodej-particle--p1"></span>
    <span class="prodej-particle prodej-particle--p2"></span>
    <span class="prodej-particle prodej-particle--p3"></span>
    <span class="prodej-particle prodej-particle--p4"></span>
    <span class="prodej-particle prodej-particle--p5"></span>
    <span class="prodej-particle prodej-particle--p6"></span>
    <span class="prodej-particle prodej-particle--p7"></span>
    <span class="prodej-particle prodej-particle--p8"></span>
    <span class="prodej-particle prodej-particle--p9"></span>
    <span class="prodej-particle prodej-particle--p10"></span>
    <span class="prodej-particle prodej-particle--p11"></span>
    <span class="prodej-particle prodej-particle--p12"></span>
  </div>

  <!-- Levá třetina: bílé texty jako grafický prvek (pozice dle předlohy 1024×600) -->
  <div class="prodej-hero-left">

    <!-- Horní cluster -->
    <div class="prodej-hero-top">
      <!-- Lede: eyebrow + H1 — na mobilu větší vertikální rytmus, oddělené od perexu mezerou -->
      <div class="prodej-hero-lede">
        <p class="prodej-enter prodej-enter--d1 prodej-eyebrow">
          Prodáváte nemovitost?
        </p>

        <h1 class="prodej-enter prodej-enter--d2 prodej-h1">
          <span class="prodej-h1-main">
            Marketingová a&nbsp;prodejní<br />agentura pro developery
          </span>
          <span class="prodej-h1-big">
            Nyní i pro váš <span class="prodej-rotate" aria-live="polite"><span class="prodej-rotate-word prodej-underline" data-prodej-word>byt</span></span>
          </span>
        </h1>
      </div>

      <!-- Spodní blok: perex + výběr služeb (na mobilu drží pohromadě, celý blok u dna hero) -->
      <div class="prodej-hero-bottom">
        <p class="prodej-enter prodej-enter--d3 prodej-paragraph">
          Pomáháme prodávat rezidenční projekty v&nbsp;Praze a&nbsp;okolí.<br />Stejný tým, stejný marketingový přístup a&nbsp;stejný prodejní standard teď můžete využít i&nbsp;pro vlastní byt nebo dům.
        </p>

        <!-- Dva badge vedle sebe — kotvy na sekci s podrobnostmi -->
        <div class="prodej-enter prodej-enter--d4 prodej-hero-pills">
          <a href="#prodej-services" class="prodej-badge" data-prodej-scroll aria-label="Marketing nemovitosti — 1,5 % z prodejní ceny">
            <div class="prodej-badge-text">
              <span class="prodej-badge-label">Bez makléře</span>
              <span class="prodej-badge-title">Marketing nemovitosti</span>
            </div>
            <span class="prodej-badge-pct">1,5&nbsp;%</span>
          </a>
          <a href="#prodej-services" class="prodej-badge" data-prodej-scroll aria-label="Kompletní prodej — 2,5 % z prodejní ceny">
            <div class="prodej-badge-text">
              <span class="prodej-badge-label">Osobní makléř</span>
              <span class="prodej-badge-title">Kompletní prodej</span>
            </div>
            <span class="prodej-badge-pct">2,5&nbsp;%</span>
          </a>
        </div>
      </div>
    </div>

  </div>

  </div><!-- /prodej-hero-inner -->

  <!-- Plovoucí pill — jako mkt-pill na homepage: odkaz + zavírací tlačítko (sessionStorage) -->
  <div id="prodej-pill" class="font-yellix">
    <a
      id="prodej-pill-link"
      href="#prodej-poptavka"
      data-poptavka-link
      data-poptavka-preselect="Nabídka na výkup"
      aria-label="Nabídnout nemovitost k výkupu"
    >
      <svg class="prodej-pill-house" width="34" height="30" viewBox="0 0 34 30" fill="none" aria-hidden="true">
        <polyline class="house-roof" points="4,22 4,14 17,4 30,14 30,22"
          stroke="rgba(0,0,0,0.32)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <line class="house-floor" x1="1.5" y1="24" x2="32.5" y2="24"
          stroke="rgba(0,0,0,0.32)" stroke-width="1.5" stroke-linecap="round"/>
        <polyline class="house-arrow" points="12,18 17,13 22,18"
          stroke="rgba(236,72,153,0.95)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <div class="prodej-pill-txt">
        <span class="prodej-pill-title">Nabídnout k výkupu</span>
        <span class="prodej-pill-sub"><span class="prodej-pill-live"></span>Nezávazná nabídka · do 48 h</span>
      </div>
      <span class="prodej-pill-arr" aria-hidden="true">→</span>
    </a>
    <button type="button" id="prodej-pill-close" aria-label="Zavřít">×</button>
  </div>
</section>

<!-- ── SEKCE: Výběr služeb ──────────────────────────────────────────────── -->
<section id="prodej-services" class="prodej-services bg-black text-white" aria-labelledby="prodej-services-heading">
  <div class="prodej-services-wrap">

    <!-- Záhlaví sekce — vycentrovaný úvodní claim -->
    <header class="prodej-services-head">
      <p id="prodej-services-heading" class="prodej-services-claim font-yellix">
        Běžný prodej nemovitosti často znamená provizi 3&nbsp;až 5&nbsp;%.<br />U&nbsp;nás si za <span class="prodej-services-underline">zlomek ceny</span> můžete vzít jen to, co opravdu potřebujete.
      </p>
    </header>

    <!-- Karty -->
    <div class="prodej-services-grid">

      <!-- Karta 1: Marketing nemovitosti -->
      <article class="prodej-service-card">
        <div class="prodej-service-media">
          <img
            src="/images/Prodej/bezmaklere.webp"
            alt="Marketing nemovitosti — pro majitele, kteří si prodej vedou sami"
            loading="lazy"
            width="800"
            height="500"
          />
          <div class="prodej-service-badges">
            <span class="prodej-service-badge">Bez makléře</span>
            <span class="prodej-service-badge">Právní servis</span>
            <span class="prodej-service-badge prodej-service-badge--dark">Úsporné</span>
          </div>
        </div>

        <div class="prodej-service-body font-yellix">
          <span class="prodej-service-overline">Strategie a propagace</span>

          <div class="prodej-service-head">
            <div class="prodej-service-head-text">
              <h3 class="prodej-service-title">Marketing nemovitosti</h3>
              <p class="prodej-service-subtitle">Pro majitele, kteří chtějí prodat sami.</p>
            </div>
            <div class="prodej-service-price">
              <span class="prodej-service-price-big">1,5&nbsp;%</span>
              <span class="prodej-service-price-sub">z&nbsp;prodejní ceny + DPH</span>
            </div>
          </div>

          <ul class="prodej-service-list">
            <li>Prodejní strategie a&nbsp;nastavení ceny dle tržních dat</li>
            <li>Profesionální focení a&nbsp;prezentace nemovitosti</li>
            <li>Zalistování na realitní portály</li>
            <li>
              <span class="prodej-service-underline">Výkonnostní reklama</span>
              <span class="prodej-service-info-wrap">
                <button
                  type="button"
                  class="prodej-service-info"
                  aria-label="Více o výkonnostní reklamě"
                  aria-describedby="prodej-tip-vykon-1"
                >i</button>
                <span id="prodej-tip-vykon-1" class="prodej-service-tip" role="tooltip">
                  Výkonnostní marketing zahrnuje přípravu, spuštění a&nbsp;správu kampaní. Mediální <strong class="prodej-service-tip-strong">rozpočet není součástí fee</strong>, doporučíme ho podle nemovitosti a&nbsp;tempa prodeje.
                </span>
              </span>
            </li>
            <li>Oslovení kupujících z&nbsp;databáze</li>
          </ul>

          <div class="prodej-service-extra">
            <div class="prodej-service-extra-left">
              <span class="prodej-service-extra-plus" aria-hidden="true">+</span>
              <span class="prodej-service-extra-text">Právní servis</span>
            </div>
            <span class="prodej-service-extra-pill">v&nbsp;ceně balíčku</span>
          </div>

          <a
            href="#prodej-poptavka"
            class="prodej-service-cta"
            data-poptavka-link
            data-poptavka-preselect="Marketing nemovitosti"
          >
            <img
              src="/images/arrow-1.svg"
              alt=""
              class="prodej-service-cta-icon"
              width="16"
              height="16"
              aria-hidden="true"
            />
            <span class="prodej-service-cta-label">Chci marketingový tým</span>
          </a>
        </div>
      </article>

      <!-- Karta 2: Marketing a prodej nemovitosti -->
      <article class="prodej-service-card">
        <div class="prodej-service-media">
          <img
            src="/images/Prodej/smaklerem.webp"
            alt="Marketing a prodej nemovitosti — kompletní zastoupení osobním makléřem"
            loading="lazy"
            width="800"
            height="500"
          />
          <div class="prodej-service-badges">
            <span class="prodej-service-badge">Osobní makléř</span>
            <span class="prodej-service-badge">Právní servis</span>
          </div>
        </div>

        <div class="prodej-service-body font-yellix">
          <span class="prodej-service-overline">Kompletní prodej</span>

          <div class="prodej-service-head">
            <div class="prodej-service-head-text">
              <h3 class="prodej-service-title">Marketing a&nbsp;prodej nemovitosti</h3>
              <p class="prodej-service-subtitle">Pro majitele, kteří chtějí prodej svěřit celý nám.</p>
            </div>
            <div class="prodej-service-price">
              <span class="prodej-service-price-big">2,5&nbsp;%</span>
              <span class="prodej-service-price-sub">z&nbsp;prodejní ceny + DPH</span>
            </div>
          </div>

          <ul class="prodej-service-list">
            <li>Prodejní strategie a&nbsp;nastavení ceny dle tržních dat</li>
            <li>Profesionální focení a&nbsp;prezentace nemovitosti</li>
            <li>Zalistování na realitní portály</li>
            <li>
              <span class="prodej-service-underline">Výkonnostní reklama</span>
              <span class="prodej-service-info-wrap">
                <button
                  type="button"
                  class="prodej-service-info"
                  aria-label="Více o výkonnostní reklamě"
                  aria-describedby="prodej-tip-vykon-2"
                >i</button>
                <span id="prodej-tip-vykon-2" class="prodej-service-tip" role="tooltip">
                  Výkonnostní marketing zahrnuje přípravu, spuštění a&nbsp;správu kampaní. Mediální <strong class="prodej-service-tip-strong">rozpočet není součástí fee</strong>, doporučíme ho podle nemovitosti a&nbsp;tempa prodeje.
                </span>
              </span>
            </li>
            <li>Oslovení kupujících z&nbsp;databáze</li>
            <li>Osobní makléř pro prodej</li>
            <li>Komunikace se&nbsp;zájemci a&nbsp;vedení prohlídek</li>
            <li>Dotažení obchodu až k&nbsp;předání</li>
          </ul>

          <div class="prodej-service-extra">
            <div class="prodej-service-extra-left">
              <span class="prodej-service-extra-plus" aria-hidden="true">+</span>
              <span class="prodej-service-extra-text">Právní servis</span>
            </div>
            <span class="prodej-service-extra-pill">v&nbsp;ceně balíčku</span>
          </div>

          <a
            href="#prodej-poptavka"
            class="prodej-service-cta"
            data-poptavka-link
            data-poptavka-preselect="Marketing a prodej nemovitosti"
          >
            <img
              src="/images/arrow-1.svg"
              alt=""
              class="prodej-service-cta-icon"
              width="16"
              height="16"
              aria-hidden="true"
            />
            <span class="prodej-service-cta-label">Chci prodej s&nbsp;makléřem</span>
          </a>
        </div>
      </article>

    </div>

    <!-- Spodní text -->
    <p class="prodej-services-footnote font-yellix">
      Nízká provize není trik. Je to výsledek dobře postaveného procesu, který prověřily největší developerské projekty. Díky tomu <span class="prodej-services-footnote-underline">neplatíte za&nbsp;těžkopádný realitní balík</span>, ale jen za&nbsp;rozsah práce, který pro&nbsp;svůj prodej opravdu potřebujete.
    </p>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════
     SEKCE: CO SKUTEČNĚ ROZHODUJE — proces řízeného prodeje
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="prodej-process bg-black text-white" aria-labelledby="prodej-process-heading">
  <div class="prodej-process-wrap">

    <h2 id="prodej-process-heading" class="prodej-process-h font-yellix">
      Hezké fotografie a&nbsp;poutavé video<br />už <span class="prodej-process-underline">dnes nestačí</span>
    </h2>

    <p class="prodej-process-lead font-yellix">
      Kvalitní prezentace je jen začátek. Sama o&nbsp;sobě ale nemovitost neprodá. Rozhoduje cena, načasování, způsob uvedení na&nbsp;trh, práce s&nbsp;poptávkou a&nbsp;to, jak rychle se ze&nbsp;zájemce stane reálný kupující. Přesně tam začíná rozdíl mezi obyčejnou inzercí a&nbsp;řízeným prodejem.
    </p>

    <!-- 2-col grid: vlevo manifest citát, vpravo strukturovaná osa procesu -->
    <div class="prodej-process-grid">

      <!-- AXIS (osa) — DOM order: první, aby na mobilu byla nad citátem (manifest jako uzavření) -->
      <div class="prodej-process-axis">
        <p class="prodej-process-overline font-yellix">Co skutečně rozhoduje</p>

        <ul class="prodej-process-list">
          <li class="prodej-process-item">
            <h3 class="prodej-process-item-title font-yellix">Cenová strategie na&nbsp;základě dat</h3>
            <p class="prodej-process-item-desc font-yellix">
              Správná cena není ta nejvyšší na&nbsp;papíře. Je to cena, která dokáže přitáhnout zájem, obhájit hodnotu nemovitosti a&nbsp;udržet prostor pro vyjednávání.
            </p>
            <a href="/prazsky-rezidencni-trh" class="prodej-process-item-link font-yellix">
              Zobrazit report Pražský rezidenční trh 2026
            </a>
          </li>
          <li class="prodej-process-item">
            <h3 class="prodej-process-item-title font-yellix">Positioning</h3>
            <p class="prodej-process-item-desc font-yellix">
              Kupující musí během pár vteřin pochopit, proč má řešit právě tuto nemovitost. Stavíme proto jasný prodejní argument, ne jen popis dispozice a&nbsp;výměry.
            </p>
          </li>
          <li class="prodej-process-item">
            <h3 class="prodej-process-item-title font-yellix">Správné kanály</h3>
            <p class="prodej-process-item-desc font-yellix">
              Nabídka nemá být jen „někde online". Musí se dostat na&nbsp;místa, kde se pohybují lidé s&nbsp;reálným zájmem, rozpočtem a&nbsp;důvodem koupit.
            </p>
          </li>
          <li class="prodej-process-item">
            <h3 class="prodej-process-item-title font-yellix">Kvalifikace poptávky</h3>
            <p class="prodej-process-item-desc font-yellix">
              Každý zájemce ještě není kupující. Oddělujeme zvědavost od&nbsp;skutečné motivace, aby čas neodtékal na&nbsp;prohlídkách bez výsledku.
            </p>
          </li>
          <li class="prodej-process-item">
            <h3 class="prodej-process-item-title font-yellix">Dotažení obchodu</h3>
            <p class="prodej-process-item-desc font-yellix">
              Prodej se často láme až po&nbsp;projevení zájmu. Držíme pohromadě vyjednávání, financování, smlouvy i&nbsp;kroky k&nbsp;předání, aby obchod doběhl bezpečně.
            </p>
          </li>
        </ul>
      </div>

      <!-- QUOTE — manifest, vlevo, vertically centered v dostupném prostoru -->
      <aside class="prodej-process-quote-wrap">
        <blockquote class="prodej-process-quote font-yellix">
          „Dobrý prodej není náhoda ani jeden silný inzerát. Je to sled správných rozhodnutí od&nbsp;ceny a&nbsp;postavení nemovitosti proti trhu až po&nbsp;výběr kanálů a&nbsp;práci se zájemcem ve&nbsp;chvíli, kdy se z&nbsp;poptávky stává obchod."
        </blockquote>
      </aside>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════
     SEKCE: FUNNEL — máme kupující, kteří hledají nové bydlení
     full-width fotka, vlevo content + dashboard čísel
     ═══════════════════════════════════════════════════════════════════════ -->
<section id="prodej-funnel" class="prodej-funnel" data-nav-sticky="light" aria-labelledby="prodej-funnel-heading">
  <!-- Pozadí: fotka kupujícího v jeho budoucím domě -->
  <img
    src="/images/Prodej/mamekupujiciho.webp"
    alt=""
    aria-hidden="true"
    class="prodej-funnel-bg"
    width="1920"
    height="1080"
    loading="lazy"
  />
  <!-- Gradient overlay zleva doprava — vlevo dark pro čitelnost, vpravo prosvítá subjekt -->
  <div class="prodej-funnel-overlay" aria-hidden="true"></div>

  <div class="prodej-funnel-wrap">
    <div class="prodej-funnel-content font-yellix">

      <h2 id="prodej-funnel-heading" class="prodej-funnel-h">
        Máme <span class="prodej-funnel-underline">kupující</span>, kteří hledají<br />nové bydlení. Možná hledají i&nbsp;váš byt.
      </h2>

      <p class="prodej-funnel-lead">
        Pracujeme s&nbsp;poptávkou po&nbsp;novostavbách v&nbsp;Praze a&nbsp;okolí. Kvalitní byty z&nbsp;druhé ruky umíme nabídnout lidem, kteří chtějí koupit, ale ne vždy najdou vhodnou novostavbu.
      </p>

      <div class="prodej-funnel-ctas">
        <a
          href="#prodej-poptavka"
          class="prodej-funnel-btn prodej-funnel-btn--primary"
          data-poptavka-link
          data-poptavka-preselect="Marketing a prodej nemovitosti"
        >
          <img
            src="/images/arrow-1.svg"
            alt=""
            class="prodej-funnel-btn-icon"
            width="16"
            height="16"
            aria-hidden="true"
          />
          <span class="prodej-funnel-btn-label">Prodat nemovitost</span>
        </a>
        <a
          href="#prodej-poptavka"
          class="prodej-funnel-btn prodej-funnel-btn--secondary"
          data-poptavka-link
          data-poptavka-preselect="Nabídka na výkup"
        >
          <span class="prodej-funnel-btn-label">Nabídnout k&nbsp;výkupu</span>
        </a>
      </div>

      <!-- Dashboard s živými čísly z databáze poptávajících -->
      <dl class="prodej-funnel-stats" aria-label="Aktuální poptávka v naší databázi">
        <div class="prodej-funnel-stat">
          <dt class="prodej-funnel-stat-num">1&nbsp;tis.</dt>
          <dd class="prodej-funnel-stat-label">poptávajících<br />tento měsíc</dd>
        </div>
        <div class="prodej-funnel-stat">
          <dt class="prodej-funnel-stat-num">248</dt>
          <dd class="prodej-funnel-stat-label">hledá 2+kk nebo<br />3+kk v&nbsp;Praze</dd>
        </div>
        <div class="prodej-funnel-stat">
