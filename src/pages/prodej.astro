<!-- ── Průběh prodeje ──────────────────────────────────────────────────────── -->
<section id="prodej-postup" class="prodej-postup" aria-labelledby="prodej-postup-heading">
  <div class="prodej-postup-wrap">

    <header class="prodej-postup-head">
      <p id="prodej-postup-heading" class="prodej-postup-overline font-yellix">Průběh spolupráce</p>
