---
interface Item {
  title: string;
  text: string;
  icon: string;
}

interface Step {
  title: string;
  text: string;
}

interface Props {
  title?: string;
  id?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  title = 'Co zahrnuje služba agentury',
  id = 'sluzba',
  ctaHref = '#poptavka',
  ctaLabel = 'Probrat možnosti',
} = Astro.props;

const items: Item[] = [
  {
    title: 'Osobní konzultant',
    text: 'Jeden člověk, který zná vaše zadání a provede vás celým nákupem.',
    icon: `<svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="24" cy="15" r="7" fill="currentColor" stroke="none"/><path d="M10 41V31h28v10"/></svg>`,
  },
  {
    title: 'Klientský portál',
    text: 'Projekty, které právě zlevnily, neveřejné předprodeje a výběr na míru od konzultanta na jednom místě.',
    icon: `<svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="9" y="8" width="30" height="9" fill="currentColor" stroke="none"/><rect x="9.75" y="21.75" width="28.5" height="7.5"/><rect x="9.75" y="33.75" width="28.5" height="7.5"/></svg>`,
  },
  {
    title: 'Přístup k příležitostem',
    text: 'Nabídky a předprodeje, které se na portály často vůbec nedostanou.',
    icon: `<svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 41V7h30v34"/><rect x="24" y="15" width="9" height="26" fill="currentColor" stroke="none"/></svg>`,
  },
  {
    title: 'Vyjednávání s developerem',
    text: 'Cena, splátkový kalendář, parkování, sklep. Jednáme za vás.',
    icon: `<svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="19" y="19" width="10" height="10" fill="currentColor" stroke="none"/><path d="M4 24h11"/><path d="M10 18l6 6-6 6"/><path d="M44 24H33"/><path d="M38 18l-6 6 6 6"/></svg>`,
  },
  {
    title: 'Právní servis',
    text: 'Rezervační i kupní smlouvu zkontroluje náš právník dřív, než podepíšete.',
    icon: `<svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M11 6h26v36H11z"/><path d="M17 15h14M17 21h14M17 27h8"/><rect x="25" y="32" width="12" height="10" fill="currentColor" stroke="none"/></svg>`,
  },
  {
    title: 'Zastoupení až do předání',
    text: 'Hlídáme termíny, platby i předání bytu.',
    icon: `<svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="23" y="23" width="18" height="18" fill="currentColor" stroke="none"/><path d="M7 7l12 12"/><path d="M19 10v9h-9"/></svg>`,
  },
];

const steps: Step[] = [
  {
    title: 'Úvodní konzultace',
    text: 'Projdeme zadání, rozpočet a preference. Ujasníme, podle čeho budeme vybírat.',
  },
  {
    title: 'Objednávka služeb',
    text: 'Potvrdíme rozsah spolupráce a pravidla osobního vyhledávání a zastoupení.',
  },
  {
    title: 'Osobní vyhledávání',
    text: 'Otevřeme vám portál a aktivně doporučujeme nemovitosti podle zadání.',
  },
  {
    title: 'Vyjednávání podmínek',
    text: 'Jednáme s developerem o rezervaci, ceně, splátkách i dalších podmínkách.',
  },
  {
    title: 'Právní servis při podpisu',
    text: 'Zkontrolujeme smlouvy dřív, než cokoli podepíšete.',
  },
];

const titleHtml = title.includes('zahrnuje')
  ? 'Co zahrnuje<br />služba agentury'
  : title.replace(' / ', '<br />');
---

<section class="cod" id={id} aria-labelledby="cod-title" data-cod>
  <div class="cod__in">
    <div class="cod__side">
      <h2 id="cod-title" set:html={titleHtml} />
      <a class="cod__cta" href={ctaHref}>
        <img src="/images/arrow-1.svg" alt="" width="12" height="12" />
        {ctaLabel}
      </a>
    </div>
    <div class="cod__main">
      <ul class="cod__grid">
        {
          items.map((item) => (
            <li class="cd">
              <span class="cd__ic" set:html={item.icon} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="cod__foot">
        <button type="button" class="cod__how" data-cod-how>
          <span class="cod__how-i" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 11v5.5M12 7.6v.1" />
            </svg>
          </span>
          Jak to funguje
        </button>
      </div>
    </div>
  </div>
</section>

<div
  class="cod-ov"
  data-cod-overlay
  aria-hidden="true"
>
  <div
    class="cod-md"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cod-how-title"
    tabindex="-1"
    data-cod-modal
  >
    <button type="button" class="cod-md__close" data-cod-close aria-label="Zavřít">
      Zavřít <span aria-hidden="true">×</span>
    </button>
    <p class="cod-md__kick">Průběh spolupráce</p>
    <h2 id="cod-how-title" class="cod-md__title">Jak to funguje</h2>
    <ol class="cod-md__list">
      {
        steps.map((step, i) => (
          <li>
            <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <b>{step.title}</b>
              <p>{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .cod {
    background: #fff;
    color: #000;
    padding: 88px 0;
    font-family: 'Yellix', system-ui, sans-serif;
    font-weight: 500;
    -webkit-font-smoothing: antialiased;
  }
  .cod__in {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 70px;
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 56px;
    align-items: start;
  }
  .cod__side {
    position: sticky;
    top: 120px;
  }
  .cod h2 {
    margin: 0;
    font-size: 36px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .cod__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    padding: 12px 18px;
    background: #000;
    color: #fff;
    text-decoration: none;
    font: inherit;
    font-size: 14px;
    line-height: 1;
    font-weight: 500;
  }
  .cod__cta:hover {
    opacity: 0.85;
  }
  .cod__cta img {
    display: block;
    width: 12px;
    height: 12px;
    filter: brightness(0) invert(1);
  }
  .cod__main {
    min-width: 0;
  }
  .cod__foot {
    display: flex;
    justify-content: flex-end;
    margin-top: 18px;
  }
  .cod__how {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.85);
    background: transparent;
    font: inherit;
    font-size: 14px;
    line-height: 1.2;
    color: #000;
    cursor: pointer;
  }
  .cod__how:hover {
    opacity: 0.7;
  }
  .cod__how-i {
    display: block;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .cod__how-i svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cod__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(0, 0, 0, 0.14);
    border-left: 1px solid rgba(0, 0, 0, 0.14);
  }
  .cd {
    position: relative;
    padding: 28px 24px 32px;
    border-right: 1px solid rgba(0, 0, 0, 0.14);
    border-bottom: 1px solid rgba(0, 0, 0, 0.14);
    min-height: 240px;
    display: flex;
    flex-direction: column;
    transition: background 0.3s, color 0.3s;
  }
  .cd__ic {
    display: block;
    width: 44px;
    height: 44px;
    color: #000;
    transition: color 0.3s;
  }
  .cd__ic :global(svg) {
    display: block;
    width: 44px;
    height: 44px;
  }
  .cd h3 {
    margin: 40px 0 8px;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 500;
  }
  .cd p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(0, 0, 0, 0.6);
    transition: color 0.3s;
  }

  @media (hover: hover) {
    .cd:hover {
      background: #000;
      color: #fff;
    }
    .cd:hover .cd__ic {
      color: #fff;
    }
    .cd:hover p {
      color: rgba(255, 255, 255, 0.7);
    }
  }

  .cod-ov {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0, 0, 0, 0.72);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .cod-ov.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .cod-md {
    position: relative;
    width: min(560px, 100%);
    max-height: min(86vh, 720px);
    overflow: auto;
    background: #fff;
    color: #000;
    padding: 40px 36px 36px;
    transform: translateY(10px) scale(0.98);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cod-ov.is-open .cod-md {
    transform: none;
  }
  .cod-md__close {
    position: absolute;
    top: 20px;
    right: 20px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  .cod-md__close:hover {
    opacity: 0.7;
  }
  .cod-md__kick {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
  }
  .cod-md__title {
    margin: 10px 0 0;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .cod-md__list {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }
  .cod-md__list li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }
  .cod-md__list span {
    font-size: 12px;
    letter-spacing: 0.12em;
    color: rgba(0, 0, 0, 0.4);
    padding-top: 3px;
  }
  .cod-md__list b {
    display: block;
    margin: 0 0 4px;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .cod-md__list p {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 1100px) {
    .cod__in {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 0 40px;
    }
    .cod__side {
      position: static;
    }
    .cod h2 {
      font-size: 32px;
    }
    .cod__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 699px) {
    .cod {
      padding: 56px 0;
    }
    .cod__in {
      padding: 0 20px;
      gap: 20px;
    }
    .cod h2 {
      font-size: 28px;
    }
    .cod__cta {
      margin-top: 20px;
    }
    .cod__foot {
      margin-top: 14px;
    }
    .cod__grid {
      grid-template-columns: 1fr;
      border-left: 0;
    }
    .cd {
      min-height: 0;
      padding: 20px 0 20px 52px;
      border-right: 0;
    }
    .cd__ic,
    .cd__ic :global(svg) {
      position: absolute;
      left: 0;
      top: 20px;
      width: 34px;
      height: 34px;
    }
    .cd__ic :global(svg) {
      position: static;
    }
    .cd h3 {
      margin: 2px 0 6px;
      font-size: 17px;
    }
    .cd p {
      font-size: 14px;
    }
    .cod-md {
      padding: 32px 20px 28px;
    }
    .cod-md__title {
      font-size: 24px;
      padding-right: 72px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cd,
    .cd :global(*),
    .cod-ov,
    .cod-md {
      transition: none;
    }
  }
</style>

<script>
  function initCodHow() {
    const root = document.querySelector('[data-cod]');
    const overlay = document.querySelector('[data-cod-overlay]');
    const modal = overlay?.querySelector('[data-cod-modal]');
    const openBtn = root?.querySelector('[data-cod-how]');
    if (!overlay || !modal || !openBtn) return;
    if (overlay.dataset.codReady === '1') return;
    overlay.dataset.codReady = '1';

    function open() {
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modal.focus();
    }
    function close() {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      openBtn.focus();
    }

    openBtn.addEventListener('click', open);
    overlay.querySelectorAll('[data-cod-close]').forEach(function (btn) {
      btn.addEventListener('click', close);
    });
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('is-open')) close();
    });
  }

  initCodHow();
  document.addEventListener('astro:page-load', initCodHow);
</script>
