  @keyframes kp-draw { to { stroke-dashoffset: 0; } }
  @keyframes kp-bar { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) {
    .kp-chart-line, .kp-soldbar i { animation: none; stroke-dashoffset: 0; transform: none; }
  }

  .kp .maplibregl-popup-content {
