---
import data from '../data/praha9-nahled.json';

const quarters = [...new Set(data.projects.map((p) => p.quarter).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b, 'cs')
);

const priceCaps = [
  { value: 6000000, label: '6 mil.' },
  { value: 8000000, label: '8 mil.' },
  { value: 10000000, label: '10 mil.' },
  { value: 15000000, label: '15 mil.' },
];

const liveLayouts = ['1+kk', '1,5+kk', '2+kk', '3+kk', '4+kk', '5+kk'];
const lockedLayouts = ['6+kk', '7+kk a větší'];

const explorer = [
  { id: 'projekty', label: 'Projekty' },
  { id: 'jednotky', label: 'Jednotky' },
  { id: 'developeri', label: 'Developeři' },
  { id: 'mapa', label: 'Mapa', current: true },
  { id: 'predprodeje', label: 'Předprodeje' },
  { id: 'second-hand', label: 'Second hand' },
  { id: 'statistiky', label: 'Statistiky' },
  { id: 'budouci', label: 'Budoucí projekty' },
];

const explorerIcon = (id: string) => {
  const s = 'fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"';
  const wrap = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true"><path ${s} d="${d}"/></svg>`;
  if (id === 'projekty') return wrap('M4 10.5 12 4l8 6.5V20H4zM9 20v-7h6v7');
  if (id === 'jednotky') return wrap('M5 5h6v6H5zM13 5h6v6h-6zM5 13h6v6H5zM13 13h6v6h-6z');
  if (id === 'developeri') return wrap('M16 19v-1.2A3.8 3.8 0 0 0 12.2 14H7.8A3.8 3.8 0 0 0 4 17.8V19M10 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6M20 19v-1.1a3.2 3.2 0 0 0-2.4-3.1M16.5 4.6a2.6 2.6 0 0 1 0 4.8');
  if (id === 'mapa') return wrap('M9 4.5 3.5 6.5v13L9 17.5 15 19.5l5.5-2v-13L15 6.5 9 4.5zM9 4.5v13M15 6.5v13');
  if (id === 'predprodeje') return wrap('M12 4.5 13.7 9h4.8l-3.9 2.9 1.5 4.6L12 13.8 7.9 16.5 9.4 11.9 5.5 9h4.8z');
  if (id === 'second-hand') return wrap('M4.5 11.5A7.5 7.5 0 0 1 12 4.5 7.5 7.5 0 0 1 19 8M19.5 12.5A7.5 7.5 0 0 1 12 19.5 7.5 7.5 0 0 1 5 16M19 8V4.5H15.5M5 16v3.5H8.5');
  if (id === 'statistiky') return wrap('M5 19V11M10 19V5M15 19v-8M20 19V8');
  return wrap('M7 4.5h10v4H7zM5 8.5h14v11H5zM9 12.5h6');
};
---

<div class="kp" data-kp>
  <div class="kp-app" data-kp-app>
    <nav class="kp-nav" aria-label="Explorer">
      <p class="kp-nav-kicker">Explorer</p>
      <ul>
        {explorer.map((item) => (
          <li>
            {item.current ? (
              <span class="kp-nav-item is-on" aria-current="page">
                <span class="kp-nav-ico" set:html={explorerIcon(item.id)} />
                {item.label}
              </span>
            ) : (
              <button type="button" class="kp-nav-item" data-kp-locked>
                <span class="kp-nav-ico" set:html={explorerIcon(item.id)} />
                {item.label}
              </button>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <aside class="kp-side">
      <div class="kp-side-top">
        <div class="kp-side-head">
          <span>Projekty</span>
          <b data-kp-count></b>
        </div>
        <button type="button" class="kp-filters-btn" data-kp-filters-toggle aria-expanded="false">
          <span class="kp-filters-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 5h16l-6 8v5l-4 2v-7L4 5z"/>
            </svg>
          </span>
          Filtry
          <em data-kp-filter-badge hidden>0</em>
        </button>
      </div>
      <div class="kp-cards" data-kp-cards></div>
      <p class="kp-empty font-yellix" data-kp-empty hidden>Této kombinaci teď neodpovídá žádný projekt.</p>
    </aside>
    <div class="kp-mapwrap">
      <div class="kp-map" data-kp-mapbox></div>
      <aside class="kp-legend" aria-label="Barva pinu podle ceny za metr">
        <div class="kp-legend-head">
          <span>Barva podle ceny / m²</span>
        </div>
        <div class="kp-legend-bar" aria-hidden="true"></div>
        <div class="kp-legend-scale" aria-hidden="true">
          <span>levnější</span>
          <span>dražší</span>
        </div>
        <ul>
          <li><i class="is-low"></i>Nižší cena</li>
          <li><i class="is-mid"></i>Střed spektra</li>
          <li><i class="is-high"></i>Vyšší cena</li>
        </ul>
      </aside>
    </div>
  </div>
  <div class="kp-detail" data-kp-detail hidden></div>
  <div class="kp-ff" data-kp-filter-panel hidden>
    <div class="kp-ff-card" role="dialog" aria-modal="true" aria-labelledby="kp-ff-title" data-kp-filter-card>
      <header class="kp-ff-head">
        <h2 class="font-yellix" id="kp-ff-title">
          <span class="kp-filters-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 5h16l-6 8v5l-4 2v-7L4 5z"/>
            </svg>
          </span>
          Filtry
        </h2>
        <button type="button" class="kp-ff-clear font-yellix" data-kp-filters-clear>Vyčistit vše</button>
        <button type="button" class="kp-ff-x" data-kp-filters-close aria-label="Zavřít">×</button>
      </header>
      <div class="kp-ff-grid">
        <div class="kp-ff-col">
          <section class="kp-ff-box">
            <h3 class="font-yellix">Projekt a lokalita</h3>
            <div class="kp-ff-field" data-kp-locked>
              <p class="kp-ff-label">Projekt / developer</p>
              <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="Alterna, Skanska…" />
            </div>
            <div class="kp-ff-field">
              <p class="kp-ff-label">Oblast</p>
              <div class="kp-ff-locked" data-kp-locked>
                <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="Karin, Praha 9, Říčany…" />
              </div>
              <div class="kp-ff-chips" role="group" aria-label="Čtvrť">
                <button type="button" class="kp-ff-chip is-on" data-kp-quarter="">Vše</button>
                {quarters.map((quarter) => (
                  <button type="button" class="kp-ff-chip" data-kp-quarter={quarter}>{quarter}</button>
                ))}
              </div>
            </div>
            <div class="kp-ff-pair kp-ff-field">
              <div data-kp-locked>
                <p class="kp-ff-label">Autem do centra</p>
                <div class="kp-ff-range">
                  <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="max" />
                  <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="min" />
                  <span>min</span>
                </div>
              </div>
              <div data-kp-locked>
                <p class="kp-ff-label">MHD do centra</p>
                <div class="kp-ff-range">
                  <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="max" />
                  <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="min" />
                  <span>min</span>
                </div>
              </div>
            </div>
            <div class="kp-ff-field" data-kp-locked>
              <p class="kp-ff-label">Dojezd na místo — každý bod musí vyhovět</p>
              <button type="button" class="kp-ff-add font-yellix">+ přidat bod (0/4)</button>
            </div>
            <div class="kp-ff-field" data-kp-locked>
              <p class="kp-ff-label">Okolí — každá podmínka musí platit</p>
              <button type="button" class="kp-ff-add font-yellix">+ přidat podmínku okolí</button>
            </div>
          </section>
          <section class="kp-ff-box">
            <h3 class="font-yellix">Cena</h3>
            <div class="kp-ff-field">
              <p class="kp-ff-label">Cena do</p>
              <div class="kp-ff-chips" role="group" aria-label="Cena do">
                <button type="button" class="kp-ff-chip is-on" data-kp-price="">Vše</button>
                {priceCaps.map((cap) => (
                  <button type="button" class="kp-ff-chip" data-kp-price={String(cap.value)}>{cap.label}</button>
                ))}
              </div>
            </div>
            <div class="kp-ff-field" data-kp-locked>
              <p class="kp-ff-label">Cena</p>
              <div class="kp-ff-range">
                <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="od" />
                <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="do" />
                <span>Kč</span>
              </div>
            </div>
            <div class="kp-ff-field" data-kp-locked>
              <p class="kp-ff-label">Cena za m²</p>
              <div class="kp-ff-range">
                <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="od" />
                <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="do" />
                <span>Kč/m²</span>
              </div>
            </div>
            <button type="button" class="kp-ff-check font-yellix" data-kp-locked><i></i>zlevněné: sleva za posledních 30 dní</button>
            <button type="button" class="kp-ff-check font-yellix" data-kp-locked><i></i>pod trhem o % a víc</button>
          </section>
        </div>
        <div class="kp-ff-col">
          <section class="kp-ff-box">
            <h3 class="font-yellix">Dispozice a jednotka</h3>
            <div class="kp-ff-field">
              <p class="kp-ff-label">Dispozice</p>
              <div class="kp-ff-chips" role="group" aria-label="Dispozice">
                <button type="button" class="kp-ff-chip is-on" data-kp-layout="">Vše</button>
                {liveLayouts.map((layout) => (
                  <button type="button" class="kp-ff-chip" data-kp-layout={layout}>{layout}</button>
                ))}
                {lockedLayouts.map((layout) => (
                  <button type="button" class="kp-ff-chip" data-kp-locked>{layout}</button>
                ))}
              </div>
            </div>
            <div class="kp-ff-pair kp-ff-field">
              <div data-kp-locked>
                <p class="kp-ff-label">Plocha</p>
                <div class="kp-ff-range">
                  <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="od" />
                  <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="do" />
                  <span>m²</span>
                </div>
              </div>
              <div>
                <p class="kp-ff-label">Typ</p>
                <div class="kp-ff-chips">
                  <button type="button" class="kp-ff-chip is-on">Obě</button>
                  <button type="button" class="kp-ff-chip" data-kp-locked>Byt</button>
                  <button type="button" class="kp-ff-chip" data-kp-locked>Dům</button>
                </div>
              </div>
            </div>
            <button type="button" class="kp-ff-check font-yellix" data-kp-locked><i></i>má venkovní prostor</button>
            <button type="button" class="kp-ff-check font-yellix" data-kp-locked><i></i>jen zahrada / předzahrádka</button>
            <div class="kp-ff-field" data-kp-locked>
              <p class="kp-ff-label">Patro</p>
              <div class="kp-ff-range">
                <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="od" />
                <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="do" />
                <span>NP</span>
              </div>
            </div>
            <button type="button" class="kp-ff-check font-yellix" data-kp-locked><i></i>ne přízemí</button>
            <button type="button" class="kp-ff-check font-yellix" data-kp-locked><i></i>jen poslední patro</button>
          </section>
          <section class="kp-ff-box">
            <h3 class="font-yellix">Velikost místností</h3>
            <p class="kp-ff-hint font-yellix">Z metrů stažených z karet. Ukáže jen jednotky se změřenými místnostmi.</p>
            <div class="kp-ff-pair kp-ff-field">
              <div data-kp-locked>
                <p class="kp-ff-label">Obyvací pokoj + kuchyň</p>
                <div class="kp-ff-range">
                  <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="min" />
                  <span>m²</span>
                </div>
              </div>
              <div data-kp-locked>
                <p class="kp-ff-label">Počet koupelen · min.</p>
                <div class="kp-ff-range">
                  <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="min" />
                  <span>ks</span>
                </div>
              </div>
            </div>
            <div class="kp-ff-field" data-kp-locked>
              <p class="kp-ff-label">Samostatné WC · min., mimo koupelnu</p>
              <div class="kp-ff-range">
                <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="min" />
                <span>ks</span>
              </div>
            </div>
            <div class="kp-ff-field" data-kp-locked>
              <p class="kp-ff-label">Pokoj 1–5 · velikost od největšího</p>
              <div class="kp-ff-rooms">
                {['1', '2', '3', '4', '5'].map((n) => (
                  <div>
                    <span>Pokoj {n}</span>
                    <div class="kp-ff-range">
                      <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="m" />
                      <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="m" />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </section>
        </div>
        <div class="kp-ff-col">
          <section class="kp-ff-box">
            <h3 class="font-yellix">Parametry projektu</h3>
            <div class="kp-ff-field">
              <p class="kp-ff-label">Druh projektu</p>
              <div class="kp-ff-chips">
                <button type="button" class="kp-ff-chip is-on">Oboje</button>
                <button type="button" class="kp-ff-chip" data-kp-locked>Novostavba</button>
                <button type="button" class="kp-ff-chip" data-kp-locked>Rekonstrukce</button>
              </div>
            </div>
            <div class="kp-ff-field">
              <p class="kp-ff-label">Dokončení</p>
              <div class="kp-ff-chips">
                <button type="button" class="kp-ff-chip is-on">Vše</button>
                <button type="button" class="kp-ff-chip" data-kp-locked>Hotové</button>
                <button type="button" class="kp-ff-chip" data-kp-locked>Termín</button>
              </div>
            </div>
            <div class="kp-ff-field" data-kp-locked>
              <p class="kp-ff-label">Volné jednotky v projektu</p>
              <div class="kp-ff-range">
                <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" placeholder="min" />
                <span>volných jednotek</span>
              </div>
            </div>
            <div class="kp-ff-field" data-kp-locked>
              <p class="kp-ff-label">Financování · neuvedené projekty zůstávají</p>
              <p class="kp-ff-sub">max. % při podpisu</p>
              <div class="kp-ff-range">
                <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" />
                <span>%</span>
              </div>
              <p class="kp-ff-sub">max. % v průběhu výstavby</p>
              <div class="kp-ff-range">
                <input class="kp-ff-input font-yellix" type="text" readonly tabindex="-1" />
                <span>%</span>
              </div>
            </div>
            <div class="kp-ff-field">
              <p class="kp-ff-label">Chlazení · neuvedené projekty zůstávají</p>
              <div class="kp-ff-chips">
                <button type="button" class="kp-ff-chip is-on">jakékoliv</button>
                <button type="button" class="kp-ff-chip" data-kp-locked>klimatizace (všude)</button>
                <button type="button" class="kp-ff-chip" data-kp-locked>klimatizace (část bytů)</button>
                <button type="button" class="kp-ff-chip" data-kp-locked>příprava na klimatizaci</button>
                <button type="button" class="kp-ff-chip" data-kp-locked>strojní chlazení</button>
                <button type="button" class="kp-ff-chip" data-kp-locked>jiné (TČ, podlahové…)</button>
              </div>
            </div>
            <div class="kp-ff-field">
              <p class="kp-ff-label">Vybavení a standardy · neuvedené projekty zůstávají</p>
              <button type="button" class="kp-ff-check font-yellix" data-kp-locked><i></i>Rekuperace</button>
              <button type="button" class="kp-ff-check font-yellix" data-kp-locked><i></i>Chytrá domácnost</button>
              <button type="button" class="kp-ff-check font-yellix" data-kp-locked><i></i>Venkovní žaluzie</button>
            </div>
            <button type="button" class="kp-ff-check font-yellix" data-kp-locked><i></i>Brzy</button>
          </section>
        </div>
      </div>
      <footer class="kp-ff-foot">
        <p class="font-yellix" data-kp-ff-count></p>
        <button type="button" class="kp-ff-done font-yellix" data-kp-filters-done>Hotovo</button>
      </footer>
    </div>
  </div>
  <div class="kp-lock" data-kp-lock hidden>
    <div class="kp-lock-card" role="dialog" aria-modal="true" aria-labelledby="kp-lock-title" data-kp-lock-card>
      <button type="button" class="kp-lock-close" data-kp-lock-close aria-label="Zavřít">×</button>
      <div class="kp-lock-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5.5" y="11" width="13" height="9" rx="0"/>
          <path d="M8 11V8.4a4 4 0 0 1 8 0V11"/>
        </svg>
      </div>
      <h2 class="kp-lock-title font-yellix" id="kp-lock-title">Tahle část je zamčená</h2>
      <p class="kp-lock-text font-yellix">Plnou verzi portálu dostanete až při domluvení spolupráce.</p>
      <a class="kp-lock-cta font-yellix" href="/sluzby">
        <img src="/images/arrow-1.svg" alt="" width="12" height="12" />
        Vybrat služby
      </a>
    </div>
  </div>
</div>

<style is:global>
  .kp {
    --kp-green: #022d20;
    --kp-blue: #1d3b8a;
    --kp-blue-soft: #e8eeff;
    --kp-blue-mid: #5b8def;
    --kp-blue-line: #c9d6f5;
    --kp-line: rgba(0, 0, 0, 0.1);
    --kp-soft: #f4f4f3;
    --kp-low: #2f9e6b;
    --kp-mid: #d4a017;
    --kp-high: #e24b4a;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--kp-line);
    background: #fff;
    min-height: 36rem;
    height: min(74rem, calc(100dvh - var(--nav-h) - 8.5rem));
  }
  .kp [hidden] { display: none !important; }
  .kp .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  @media (max-width: 959px) {
    .kp {
      height: auto;
      min-height: 0;
      border-left: 0;
      border-right: 0;
    }
  }

  .kp-app {
    display: grid;
    grid-template-columns: 11.25rem minmax(16.5rem, 22rem) 1fr;
    height: 100%;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
  }
  @media (max-width: 959px) {
    .kp-app {
      display: flex;
      flex-direction: column;
      height: auto;
    }
    .kp-side { display: contents; }
  }

  .kp-nav {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0.85rem 0.55rem 1rem;
    background: #fbfbfb;
    border-right: 1px solid var(--kp-line);
  }
  @media (max-width: 959px) {
    .kp-nav {
      order: 0;
      flex-direction: row;
      align-items: center;
      gap: 0.65rem;
      overflow-x: auto;
      padding: 0.65rem 0.75rem;
      border-right: 0;
      border-bottom: 1px solid var(--kp-line);
    }
  }
  .kp-nav-kicker {
    margin: 0 0.45rem 0.55rem;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.38);
  }
  @media (max-width: 959px) {
    .kp-nav-kicker { margin: 0; flex-shrink: 0; }
  }
  .kp-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  @media (max-width: 959px) {
    .kp-nav ul {
      flex-direction: row;
      gap: 0.25rem;
    }
  }
  .kp-nav-item {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.55rem;
    padding: 0.48rem 0.55rem;
    border: 0;
    background: none;
    color: rgba(0, 0, 0, 0.72);
    cursor: pointer;
    text-align: left;
    font-family: 'Yellix', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
  }
  @media (max-width: 959px) {
    .kp-nav-item {
      width: auto;
      white-space: nowrap;
      padding: 0.4rem 0.55rem;
    }
  }
  .kp-nav-item:hover { color: #111; background: rgba(0, 0, 0, 0.04); }
  .kp-nav-item.is-on {
    background: #e8eeff;
    color: #1d3b8a;
    cursor: default;
  }
  .kp-nav-ico {
    display: flex;
    width: 1.05rem;
