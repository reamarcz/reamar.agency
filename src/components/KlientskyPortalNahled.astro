  .kp-lock-cta:hover { opacity: 0.85; }
</style>

<script>
  import payloadJson from '../data/praha9-nahled.json';

  type Project = {
    id: string;
    name: string;
    developer?: string;
    quarter: string;
    address?: string;
    lat: number;
    lng: number;
    completion?: string | null;
    coverUrl?: string | null;
    priceFrom: number;
    pricePerSmFrom: number;
    layouts: string[];
    counts: { available: number; reserved: number; sold: number; total: number };
    header?: { payments?: { contractPct: number; constructionPct: number; moveInPct: number } };
    surroundings?: { category: string; label: string; name: string | null; distanceM: number }[];
    summary?: {
      available: number;
      sold: number;
      total: number;
      soldPct: number;
      layoutMix: { layout: string; available: number; total: number }[];
      pricePerSm: { min: number; median: number; max: number };
    };
    priceTrend?: { month: string; medianPerSm: number | null }[];
    standards?: Record<string, unknown>;
  };

  const MONTHS = ['leden', 'únor', 'březen', 'duben', 'květen', 'červen', 'červenec', 'srpen', 'září', 'říjen', 'listopad', 'prosinec'];
  const FALLBACKS = ['#d7e2d9', '#e4ddd4', '#d9e0e6', '#e8e4dc', '#dce6df'];
  const POI_ORDER = ['supermarket', 'school', 'kindergarten', 'metro', 'tram', 'park', 'vlak', 'bus'];
  const PIN = { low: '#2f9e6b', mid: '#d4a017', high: '#e24b4a' };
  const ML_CSS = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css';
  const ML_JS = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js';
  const STYLE = 'https://tiles.openfreemap.org/styles/positron';

  let root: HTMLElement | null = null;
  let projects: Project[] = [];
  let state = { layout: '', price: '', quarter: '', selected: '', hover: '', filtersOpen: false };
  let map: any = null;
  let mini: any = null;
  let markers: { id: string; marker: any; el: HTMLButtonElement }[] = [];
  let hoverPop: any = null;
  let clickPop: any = null;
  let t1 = 0;
  let t2 = 0;

  function qs<T extends Element>(sel: string) {
    return root!.querySelector(sel) as T;
  }
  function prefersLess() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  function czk(n: number) {
    return `${Math.round(n).toLocaleString('cs-CZ')}\u00a0Kč`;
  }
  function odCzk(n: number) {
    if (n >= 1_000_000) {
      const mil = n / 1_000_000;
      const t = mil >= 10 ? mil.toLocaleString('cs-CZ', { maximumFractionDigits: 0 }) : mil.toLocaleString('cs-CZ', { maximumFractionDigits: 1 });
      return `od ${t}\u00a0mil.\u00a0Kč`;
    }
    return `od ${czk(n)}`;
  }
  function kPps(n: number) {
    return `${Math.round(n / 1000).toLocaleString('cs-CZ')}k`;
  }
  function dist(m: number) {
    if (m >= 1000) return `${(m / 1000).toLocaleString('cs-CZ', { maximumFractionDigits: 1 })}\u00a0km`;
    return `${Math.round(m)}\u00a0m`;
  }
  function doneWhen(raw?: string | null) {
    if (!raw) return 'termín upřesníme';
    const [y, m] = raw.split('-');
    if (!m) return y;
    return `${MONTHS[Number(m) - 1] || m} ${y}`;
  }
  function fallback(id: string) {
    let h = 0;
    for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;
    return FALLBACKS[h % FALLBACKS.length];
  }
  function pinBand(pps: number): 'low' | 'mid' | 'high' {
    if (pps <= t1) return 'low';
    if (pps <= t2) return 'mid';
    return 'high';
  }
  function pinColor(pps: number) {
    return PIN[pinBand(pps)];
  }
  function esc(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }
  function photo(url: string | null | undefined, alt: string) {
    if (!url) return '';
    return `<img src="${url}" alt="${esc(alt)}" loading="lazy" onerror="this.remove()">`;
  }
  function hasLayout(p: Project, layout: string) {
    const row = p.summary?.layoutMix?.find((m) => m.layout === layout);
    if (row) return row.available > 0;
    return (p.layouts || []).includes(layout);
  }
  function trendOf(p: Project) {
    const pts = (p.priceTrend || []).filter((t) => t.medianPerSm != null) as { medianPerSm: number }[];
    if (pts.length < 2) return null;
    const a = pts[0].medianPerSm;
    const b = pts[pts.length - 1].medianPerSm;
    if (!a) return null;
    const pct = ((b - a) / a) * 100;
    const dir = Math.abs(pct) < 0.15 ? 'flat' : pct > 0 ? 'up' : 'down';
    const n = `${pct > 0 ? '+' : ''}${pct.toLocaleString('cs-CZ', { maximumFractionDigits: 1 })}`;
    return { dir, text: `cena ${n}\u00a0%` };
  }
  function poiList(p: Project, n = 4) {
    const items = [...(p.surroundings || [])].filter((s) => s.distanceM != null);
    items.sort((a, b) => {
      const ia = POI_ORDER.indexOf(a.category);
      const ib = POI_ORDER.indexOf(b.category);
      return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
    });
    return items.slice(0, n);
  }
  function ico(kind: string) {
    const s = 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
    const wrap = (d: string) => `<svg viewBox="0 0 16 16" aria-hidden="true"><path ${s} d="${d}"/></svg>`;
    if (kind === 'supermarket') return wrap('M2.5 3.5h2l.8 8h7.4l1.3-6H5.2M6.5 13.5h.1M11.5 13.5h.1');
    if (kind === 'school') return wrap('M2 12.5 8 4l6 8.5M8 4v8.5M4.5 12.5h7');
    if (kind === 'kindergarten') return wrap('M8 3.5v9M4 7.5c0-2 1.8-4 4-4s4 2 4 4M4.5 13h7');
    if (kind === 'metro') return wrap('M3.5 3.5h9v9h-9zM6 12.5v-6M10 12.5v-6');
    if (kind === 'tram') return wrap('M4 5.5h8v6H4zM6 3.5h4M5 14h.1M11 14h.1M4 8.5h8');
    if (kind === 'bus') return wrap('M4 3.5h8v8H4zM5.5 13.5h.1M10.5 13.5h.1M4 9.5h8');
    if (kind === 'vlak') return wrap('M4 4.5h8v7H4zM6 13.5h4M4 8.5h8');
    return wrap('M8 13.5s-5-3.2-5-7A5 5 0 0 1 8 1.5a5 5 0 0 1 5 5c0 3.8-5 7-5 7z');
  }
  function filtered() {
    const pin = 'd5dd1a8d-f2da-40e3-ae83-28b2db25063c';
    return projects.filter((p) => {
      if (state.layout && !hasLayout(p, state.layout)) return false;
      if (state.price && !(p.priceFrom <= Number(state.price))) return false;
      if (state.quarter && p.quarter !== state.quarter) return false;
      return true;
    }).sort((a, b) => Number(b.id === pin) - Number(a.id === pin));
  }
  function poiHtml(p: Project, n = 4) {
    return poiList(p, n).map((s) => `<li>${ico(s.category)}<span>${dist(s.distanceM)}</span></li>`).join('');
  }
  function cardHtml(p: Project) {
    const color = fallback(p.id);
    const tr = trendOf(p);
    return `<button type="button" class="kp-card" data-kp-card="${p.id}" style="--kp-fallback:${color}">
      <div class="kp-card-photo">
        ${photo(p.coverUrl, p.name)}
        ${tr ? `<span class="kp-badge kp-badge-trend is-${tr.dir}">${esc(tr.text)}</span>` : ''}
        <span class="kp-badge kp-badge-av">${p.counts.available} dostupných</span>
        ${p.completion ? `<span class="kp-badge kp-badge-date">${esc(p.completion)}</span>` : ''}
      </div>
      <div class="kp-card-body">
        <h3>${esc(p.name)}</h3>
        <p class="kp-card-loc">Praha · ${esc(p.quarter)}</p>
        <p class="kp-card-pps">${kPps(p.pricePerSmFrom)} Kč/m² <span>od</span></p>
        <ul class="kp-poi">${poiHtml(p)}</ul>
      </div>
    </button>`;
  }

  function render() {
    const list = filtered();
    const count = qs<HTMLElement>('[data-kp-count]');
    const empty = qs<HTMLElement>('[data-kp-empty]');
    const cards = qs<HTMLElement>('[data-kp-cards]');
    const app = qs<HTMLElement>('[data-kp-app]');
    const detail = qs<HTMLElement>('[data-kp-detail]');
    const badge = qs<HTMLElement>('[data-kp-filter-badge]');
    const panel = qs<HTMLElement>('[data-kp-filter-panel]');
    const toggle = qs<HTMLButtonElement>('[data-kp-filters-toggle]');
    const active = [state.layout, state.price, state.quarter].filter(Boolean).length;

    count.textContent = `${list.length} ve výřezu`;
    badge.hidden = active === 0;
    badge.textContent = String(active);
    panel.hidden = !state.filtersOpen;
    toggle.setAttribute('aria-expanded', state.filtersOpen ? 'true' : 'false');
    const ffCount = root!.querySelector('[data-kp-ff-count]') as HTMLElement | null;
    if (ffCount) ffCount.textContent = `${list.length} z ${projects.length} projektů v ukázce`;
    syncFilterChips();

    app.toggleAttribute('inert', !!state.selected);
    app.setAttribute('aria-hidden', state.selected ? 'true' : 'false');

    if (state.selected) {
      detail.hidden = false;
      renderDetail(projects.find((p) => p.id === state.selected)!);
      return;
    }

    detail.hidden = true;
    destroyMini();
    const none = list.length === 0;
    empty.hidden = !none;
    cards.hidden = none;
    cards.innerHTML = list.map((p) => cardHtml(p)).join('');
    requestAnimationFrame(() => {
      map?.resize();
      syncMap(list);
    });
  }

  function setHover(id: string, opts: { fly?: boolean; pop?: boolean } = {}) {
    state.hover = id;
    root!.querySelectorAll('[data-kp-card]').forEach((el) => {
      el.classList.toggle('is-on', (el as HTMLElement).dataset.kpCard === id);
    });
    markers.forEach(({ id: mid, el }) => el.classList.toggle('is-on', !!id && mid === id));
    const p = projects.find((x) => x.id === id);
    if (id && p) {
      const card = qs<HTMLElement>('[data-kp-cards]').querySelector(`[data-kp-card="${id}"]`) as HTMLElement | null;
      card?.scrollIntoView({ block: 'nearest' });
      if (opts.pop && hoverPop && map) {
        hoverPop.setLngLat([p.lng, p.lat]).setHTML(
          `<div class="kp-tip"><strong>${esc(p.name)}</strong>${esc(p.quarter)}<br>${kPps(p.pricePerSmFrom)} Kč/m² od<ul class="kp-tip-poi">${poiList(p, 3).map((s) => `<li>${dist(s.distanceM)}</li>`).join('')}</ul></div>`
        ).addTo(map);
      }
      if (opts.fly && map && !prefersLess()) {
        map.easeTo({ center: [p.lng, p.lat], duration: 450, essential: true });
      }
    } else {
      hoverPop?.remove();
    }
  }

  function loadMapLibre() {
    return new Promise<void>((resolve, reject) => {
      if ((window as any).maplibregl) return resolve();
      if (!document.getElementById('kp-ml-css')) {
        const link = document.createElement('link');
        link.id = 'kp-ml-css';
        link.rel = 'stylesheet';
        link.href = ML_CSS;
        document.head.appendChild(link);
      }
      if (document.getElementById('kp-ml-js')) {
        const wait = () => ((window as any).maplibregl ? resolve() : setTimeout(wait, 40));
        wait();
        return;
      }
      const s = document.createElement('script');
      s.id = 'kp-ml-js';
      s.src = ML_JS;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('maplibre'));
      document.head.appendChild(s);
    });
  }

  function ensureMap() {
    const box = qs<HTMLElement>('[data-kp-mapbox]');
    const ml = (window as any).maplibregl;
    if (!ml || !box) return;
    if (map) {
      map.resize();
      return;
    }
    map = new ml.Map({
      container: box,
      style: STYLE,
      center: [14.505, 50.105],
      zoom: 12,
      attributionControl: true,
    });
    map.addControl(new ml.NavigationControl({ showCompass: false }), 'bottom-right');
    hoverPop = new ml.Popup({ closeButton: false, closeOnClick: false, offset: 14, className: 'kp-hover-pop' });
    clickPop = new ml.Popup({ offset: 16, maxWidth: '280px' });
    map.on('load', () => syncMap(filtered()));
  }

  function clearMarkers() {
    markers.forEach(({ marker }) => marker.remove());
    markers = [];
  }

  function syncMap(list: Project[]) {
    if (!map) return;
    const ml = (window as any).maplibregl;
    clearMarkers();
    hoverPop?.remove();
    clickPop?.remove();
    const bounds = new ml.LngLatBounds();
    list.forEach((p) => {
      const el = document.createElement('button');
      el.type = 'button';
      el.className = 'kp-pin';
      el.style.background = pinColor(p.pricePerSmFrom);
      el.dataset.id = p.id;
      el.setAttribute('aria-label', p.name);
      el.addEventListener('mouseenter', () => {
        setHover(p.id, { pop: true });
      });
      el.addEventListener('mouseleave', () => {
        setHover('');
      });
      el.addEventListener('click', (event) => {
        event.stopPropagation();
        hoverPop?.remove();
        const color = fallback(p.id);
        const tr = trendOf(p);
        clickPop.setLngLat([p.lng, p.lat]).setHTML(
          `<div class="kp-pop">
            <div class="kp-card-photo" style="--kp-fallback:${color}">
              ${photo(p.coverUrl, p.name)}
              ${tr ? `<span class="kp-badge kp-badge-trend is-${tr.dir}">${esc(tr.text)}</span>` : ''}
              <span class="kp-badge kp-badge-av">${p.counts.available} dostupných</span>
            </div>
            <div class="kp-pop-body">
              <h3>${esc(p.name)}</h3>
              <p>Praha · ${esc(p.quarter)}</p>
              <strong>${kPps(p.pricePerSmFrom)} Kč/m² <span style="font-size:12px;font-weight:500;color:rgba(0,0,0,.45)">od</span></strong>
              <button type="button" data-kp-open="${p.id}">Otevřít detail</button>
            </div>
          </div>`
        ).addTo(map);
        clickPop.getElement()?.querySelector('[data-kp-open]')?.addEventListener('click', (e: Event) => {
          e.preventDefault();
          e.stopPropagation();
          openDetail(p.id);
        });
      });
      const marker = new ml.Marker({ element: el, anchor: 'center' }).setLngLat([p.lng, p.lat]).addTo(map);
      el.setAttribute('aria-label', p.name);
      markers.push({ id: p.id, marker, el });
      bounds.extend([p.lng, p.lat]);
    });
    if (list.length) {
      map.fitBounds(bounds, { padding: { top: 48, right: 72, bottom: 48, left: 40 }, maxZoom: 13.4, duration: prefersLess() ? 0 : 500 });
    }
  }

  function destroyMap() {
    clearMarkers();
    hoverPop?.remove();
    clickPop?.remove();
    map?.remove();
    map = null;
    hoverPop = null;
    clickPop = null;
  }
  function destroyMini() {
    mini?.remove();
    mini = null;
  }
  function yesNo(v: unknown) {
    if (v === true || v === 'ano') return 'Ano';
    if (v === 'příprava') return 'Příprava';
    if (v === false || v === 'ne') return 'Ne';
    return '';
  }

  function lockedTail(p: Project) {
    const mix = p.summary?.layoutMix || [];
    const layouts = [...new Set((mix.length ? mix.map((m) => m.layout) : p.layouts || ['2+kk', '3+kk', '4+kk']).filter(Boolean))].slice(0, 5);
    while (layouts.length < 4) layouts.push('');
    const bars = ['62%', '48%', '40%', '70%', '54%'];
    const docs = ['Půdorysy jednotek', 'Ceník', 'Standard provedení', 'Smlouva o smlouvě budoucí'];
    return `
      <div class="kp-d-lock">
        <div class="kp-d-lock-ghost" aria-hidden="true">
          <section>
            <h3 class="font-yellix">Jednotky</h3>
            <div class="kp-d-lock-head font-yellix"><span>Dispozice</span><span>Plocha</span><span>Patro</span><span>Stav</span><span>Cena</span></div>
            ${layouts.map((layout, i) => `
              <div class="kp-d-lock-row font-yellix">
                <span>${esc(layout)}</span>
                <i class="kp-d-lock-bar" style="width:${bars[i % bars.length]}"></i>
                <i class="kp-d-lock-bar" style="width:38%"></i>
                <i class="kp-d-lock-bar" style="width:52%"></i>
                <i class="kp-d-lock-bar" style="width:72%"></i>
              </div>
            `).join('')}
          </section>
          <section>
            <h3 class="font-yellix">Dokumenty</h3>
            ${docs.map((name) => `<div class="kp-d-lock-doc font-yellix"><i></i>${esc(name)}</div>`).join('')}
          </section>
        </div>
        <div class="kp-d-lock-veil">
          <div class="kp-lock-card kp-d-lock-card">
            <div class="kp-lock-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5.5" y="11" width="13" height="9" rx="0"/>
                <path d="M8 11V8.4a4 4 0 0 1 8 0V11"/>
              </svg>
            </div>
            <h2 class="kp-lock-title font-yellix">Tahle část je zamčená</h2>
            <p class="kp-lock-text font-yellix">Plnou verzi portálu dostanete až při domluvení spolupráce.</p>
            <a class="kp-lock-cta font-yellix" href="/sluzby">
              <img src="/images/arrow-1.svg" alt="" width="12" height="12" />
              Vybrat služby
            </a>
          </div>
        </div>
      </div>
    `;
  }

  function renderDetail(p: Project) {
    const color = fallback(p.id);
    const pay = p.header?.payments;
    const mix = p.summary?.layoutMix || [];
    const pps = p.summary?.pricePerSm;
    const std = p.standards || {};
    const around = (p.surroundings || []).filter((s) => s.distanceM != null);
    const trend = (p.priceTrend || []).filter((t) => t.medianPerSm != null) as { month: string; medianPerSm: number }[];
    const sold = p.summary?.soldPct ?? 0;
    const tech: string[] = [];
    if (Array.isArray(std.amenities)) tech.push(...(std.amenities as string[]).map((x) => String(x).replace(/\u00a0/g, ' ')));
    const rec = yesNo(std.recuperation);
    if (rec === 'Ano') tech.push('rekuperace');
    const ac = yesNo(std.airConditioning);
    if (ac === 'Ano') tech.push('klimatizace');
    if (typeof std.cooling === 'string' && std.cooling) tech.push(String(std.cooling).toLowerCase());
    const blinds = yesNo(std.exteriorBlinds);
    if (blinds === 'Ano') tech.push('venkovní žaluzie');
    if (blinds === 'Příprava') tech.push('příprava žaluzií');
    if (std.smartHome === true) tech.push('chytrá domácnost');
    const stdRows = [
      ['Podlahy', std.flooring],
      ['Vytápění', std.heating],
      ['Okna', std.windows],
      ['Příčky', std.partitionWalls],
    ].filter(([, v]) => v);

    qs<HTMLElement>('[data-kp-detail]').innerHTML = `
      <button type="button" class="kp-back" data-kp-back>← Zpět na mapu</button>
      <div class="kp-d-hero">
        <div class="kp-d-photo" style="--kp-fallback:${color}">${photo(p.coverUrl, p.name)}</div>
        <div class="kp-d-mini" data-kp-mini></div>
      </div>
      <h2 class="kp-d-name font-yellix">${esc(p.name)}</h2>
      <p class="kp-d-sub font-yellix">Praha · ${esc(p.quarter)}${p.address ? ` · ${esc(p.address)}` : ''}</p>
      <div class="kp-strip">
        <div><span>Cena</span><strong class="font-yellix">${odCzk(p.priceFrom)}</strong></div>
        <div><span>Za m²</span><strong class="font-yellix">${czk(p.pricePerSmFrom)}</strong></div>
        <div><span>Volných bytů</span><strong class="font-yellix">${p.counts.available} z ${p.counts.total}</strong></div>
        <div><span>Dokončení</span><strong class="font-yellix">${doneWhen(p.completion)}</strong></div>
      </div>
      ${pay ? `<p class="kp-d-sub font-yellix" style="margin-top:-1.15rem">Při podpisu ${pay.contractPct}\u00a0%, během stavby ${pay.constructionPct}\u00a0%, při nastěhování ${pay.moveInPct}\u00a0%.</p>` : ''}

      <section class="kp-d-sec">
        <h3 class="font-yellix">Okolí</h3>
        <ul class="kp-okoli">
          ${around.map((s) => {
            const name = (s.name || '').trim();
            const label = (s.label || '').trim();
            const title = !name ? label : name.toLocaleLowerCase('cs').startsWith(label.toLocaleLowerCase('cs')) ? name : `${label} ${name}`;
            return `<li class="font-yellix"><b>${esc(title)}</b><span>${dist(s.distanceM)}</span></li>`;
          }).join('')}
        </ul>
      </section>

      <section class="kp-d-sec">
        <h3 class="font-yellix">Souhrn nabídky</h3>
        <div class="kp-sum">
          <article>
            <h4>Prodanost</h4>
            <div class="kp-sum-num font-yellix">${sold}\u00a0%</div>
            <div class="kp-soldbar" aria-hidden="true"><i style="width:${Math.max(0, Math.min(100, sold))}%"></i></div>
            <p class="font-yellix">Z ${p.summary?.total ?? p.counts.total} bytů je volných ${p.summary?.available ?? p.counts.available}.</p>
          </article>
          <article>
            <h4>Mix dispozic</h4>
            <ul class="kp-mix">
              ${mix.map((m) => `<li class="font-yellix"><span>${esc(m.layout)}</span><span>${m.available} volných z ${m.total}</span></li>`).join('')}
            </ul>
          </article>
          <article>
            <h4>Kč / m²</h4>
            <div class="kp-range">
              <div><b class="font-yellix">${pps ? czk(pps.min) : '—'}</b><span>min</span></div>
              <div><b class="font-yellix">${pps ? czk(pps.median) : '—'}</b><span>medián</span></div>
              <div><b class="font-yellix">${pps ? czk(pps.max) : '—'}</b><span>max</span></div>
            </div>
          </article>
        </div>
      </section>

      <section class="kp-d-sec">
        <h3 class="font-yellix">Vývoj ceny</h3>
        <div data-kp-chart></div>
        <p class="kp-chart-note font-yellix" data-kp-range></p>
      </section>

      <section class="kp-d-sec">
        <h3 class="font-yellix">Standardy domu</h3>
        <dl class="kp-std">
          ${stdRows.map(([k, v]) => `<div><dt>${k}</dt><dd>${esc(String(v))}</dd></div>`).join('')}
        </dl>
        ${tech.length ? `<ul class="kp-tech">${[...new Set(tech)].map((t) => `<li class="font-yellix">${esc(t)}</li>`).join('')}</ul>` : ''}
      </section>

      ${lockedTail(p)}
    `;

    const range = qs<HTMLElement>('[data-kp-range]');
    if (pps) range.textContent = `Rozpětí teď: ${czk(pps.min)}–${czk(pps.max)} za m².`;
    drawChart(qs<HTMLElement>('[data-kp-chart]'), trend);
    setupMini(p);
  }

  function drawChart(host: HTMLElement, series: { month: string; medianPerSm: number }[]) {
    if (series.length < 2) {
      host.innerHTML = `<p class="kp-chart-note font-yellix">Zatím tu není delší řada cen, jen aktuální rozpětí.</p>`;
      return;
    }
    const w = 640;
    const h = 180;
    const pad = { l: 54, r: 12, t: 12, b: 28 };
    const vals = series.map((s) => s.medianPerSm);
    const min = Math.min(...vals) * 0.98;
    const max = Math.max(...vals) * 1.02;
    const x = (i: number) => pad.l + (i * (w - pad.l - pad.r)) / (series.length - 1);
    const y = (v: number) => pad.t + (1 - (v - min) / (max - min || 1)) * (h - pad.t - pad.b);
    const d = series.map((s, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(s.medianPerSm).toFixed(1)}`).join(' ');
    const ticks = series.filter((_, i) => i === 0 || i === series.length - 1 || i % 2 === 0);
    host.innerHTML = `<svg class="kp-chart" viewBox="0 0 ${w} ${h}" role="img" aria-label="Vývoj mediánu ceny za m²">
      <line x1="${pad.l}" y1="${h - pad.b}" x2="${w - pad.r}" y2="${h - pad.b}" stroke="rgba(0,0,0,.12)" />
      <line x1="${pad.l}" y1="${pad.t}" x2="${pad.l}" y2="${h - pad.b}" stroke="rgba(0,0,0,.12)" />
      <path class="kp-chart-line" pathLength="1" d="${d}" fill="none" stroke="#022d20" stroke-width="2" />
      ${series.map((s, i) => `<circle cx="${x(i)}" cy="${y(s.medianPerSm)}" r="3" fill="#022d20" />`).join('')}
      <text x="4" y="${y(max) + 4}" font-size="10" fill="rgba(0,0,0,.45)">${Math.round(max).toLocaleString('cs-CZ')}</text>
      <text x="4" y="${y(min) + 4}" font-size="10" fill="rgba(0,0,0,.45)">${Math.round(min).toLocaleString('cs-CZ')}</text>
      ${ticks.map((s) => {
        const i = series.indexOf(s);
        const [yy, mm] = s.month.split('-');
        return `<text x="${x(i)}" y="${h - 8}" font-size="10" text-anchor="middle" fill="rgba(0,0,0,.45)">${mm}/${yy.slice(2)}</text>`;
      }).join('')}
    </svg>`;
  }

  async function setupMini(p: Project) {
    const box = root!.querySelector('[data-kp-mini]') as HTMLElement | null;
    if (!box) return;
    try {
      await loadMapLibre();
    } catch {
      return;
    }
    const ml = (window as any).maplibregl;
    destroyMini();
    mini = new ml.Map({
      container: box,
      style: STYLE,
      center: [p.lng, p.lat],
      zoom: 13.2,
      interactive: false,
      attributionControl: true,
    });
    mini.on('load', () => {
      const el = document.createElement('div');
      el.className = 'kp-pin is-on';
      el.style.background = pinColor(p.pricePerSmFrom);
      new ml.Marker({ element: el, anchor: 'center' }).setLngLat([p.lng, p.lat]).addTo(mini);
    });
  }

  function openDetail(id: string) {
    state.selected = id;
    clickPop?.remove();
    hoverPop?.remove();
    render();
  }

  function openLock() {
    const lock = qs<HTMLElement>('[data-kp-lock]');
    lock.hidden = false;
    (qs<HTMLElement>('[data-kp-lock-close]') as HTMLButtonElement).focus();
  }
  function closeLock() {
    const lock = root?.querySelector('[data-kp-lock]') as HTMLElement | null;
    if (lock) lock.hidden = true;
  }

  function onClick(event: Event) {
    const t = event.target as HTMLElement;
    if (t.closest('[data-kp-lock-close]')) {
      closeLock();
      return;
    }
    if (t.closest('[data-kp-lock]') && !t.closest('[data-kp-lock-card]')) {
      closeLock();
      return;
    }
    const locked = t.closest('[data-kp-locked]') as HTMLElement | null;
    if (locked) {
      openLock();
      return;
    }
    if (t.closest('[data-kp-filters-toggle]')) {
      state.filtersOpen = !state.filtersOpen;
      render();
      return;
    }
    if (t.closest('[data-kp-filters-close], [data-kp-filters-done]')) {
      state.filtersOpen = false;
      render();
      return;
    }
    if (t.closest('[data-kp-filters-clear]')) {
      state.layout = '';
      state.price = '';
      state.quarter = '';
      render();
      return;
    }
    if (t.closest('[data-kp-filter-panel]') && !t.closest('[data-kp-filter-card]')) {
      state.filtersOpen = false;
      render();
      return;
    }
    const layout = t.closest('[data-kp-layout]') as HTMLElement | null;
    if (layout) {
      state.layout = layout.dataset.kpLayout || '';
      render();
      return;
    }
    const price = t.closest('[data-kp-price]') as HTMLElement | null;
    if (price) {
      state.price = price.dataset.kpPrice || '';
      render();
      return;
    }
    const quarter = t.closest('[data-kp-quarter]') as HTMLElement | null;
    if (quarter) {
      state.quarter = quarter.dataset.kpQuarter || '';
      render();
      return;
    }
    const open = t.closest('[data-kp-open]') as HTMLElement | null;
    if (open) {
      openDetail(open.dataset.kpOpen || '');
      return;
    }
    const card = t.closest('[data-kp-card]') as HTMLElement | null;
    if (card) {
      openDetail(card.dataset.kpCard || '');
      return;
    }
    if (t.closest('[data-kp-back]')) {
      state.selected = '';
      render();
      requestAnimationFrame(() => {
        map?.resize();
        syncMap(filtered());
      });
    }
  }

  function syncFilterChips() {
    if (!root) return;
    root.querySelectorAll('[data-kp-layout]').forEach((b) => {
      const el = b as HTMLElement;
      el.classList.toggle('is-on', (el.dataset.kpLayout || '') === state.layout);
    });
    root.querySelectorAll('[data-kp-price]').forEach((b) => {
      const el = b as HTMLElement;
      el.classList.toggle('is-on', (el.dataset.kpPrice || '') === state.price);
    });
    root.querySelectorAll('[data-kp-quarter]').forEach((b) => {
      const el = b as HTMLElement;
      el.classList.toggle('is-on', (el.dataset.kpQuarter || '') === state.quarter);
    });
  }

  function onFocusIn(event: Event) {
    const locked = (event.target as HTMLElement).closest?.('[data-kp-locked]') as HTMLElement | null;
    if (!locked || !root?.contains(locked)) return;
    (event.target as HTMLElement).blur?.();
    openLock();
  }

  function onKey(event: KeyboardEvent) {
    if (event.key !== 'Escape') return;
    const lock = root?.querySelector('[data-kp-lock]') as HTMLElement | null;
    if (lock && !lock.hidden) {
      closeLock();
      event.stopPropagation();
      return;
    }
    if (state.filtersOpen) {
      state.filtersOpen = false;
      render();
      event.stopPropagation();
    }
  }

  function onOver(event: Event) {
    if (state.selected) return;
    const card = (event.target as HTMLElement).closest('[data-kp-card]') as HTMLElement | null;
    if (!card || !root!.contains(card)) return;
    const id = card.dataset.kpCard || '';
    if (id === state.hover) return;
    setHover(id, { fly: true, pop: true });
  }
  function onOut(event: Event) {
    const card = (event.target as HTMLElement).closest('[data-kp-card]') as HTMLElement | null;
    if (!card) return;
    const next = (event as MouseEvent).relatedTarget as Node | null;
    if (next && card.contains(next)) return;
    if (next && (next as HTMLElement).closest?.('.kp-pin')) return;
    setHover('');
  }

  function cleanup() {
    if (!root) return;
    root.removeEventListener('click', onClick);
    root.removeEventListener('focusin', onFocusIn);
    root.removeEventListener('mouseover', onOver);
    root.removeEventListener('mouseout', onOut);
    document.removeEventListener('keydown', onKey);
    window.removeEventListener('resize', onWinResize);
    destroyMap();
    destroyMini();
    root = null;
  }

  function onWinResize() {
    map?.resize();
  }

  function init() {
    const next = document.querySelector('[data-kp]') as HTMLElement | null;
    if (!next) return;
    if (root === next) return;
    cleanup();
    root = next;
    projects = ((payloadJson as { projects: Project[] }).projects || []);
    const pps = [...projects.map((p) => p.pricePerSmFrom)].sort((a, b) => a - b);
    t1 = pps[Math.floor(pps.length / 3)] || 0;
    t2 = pps[Math.floor((pps.length * 2) / 3)] || 0;
    state = { layout: '', price: '', quarter: '', selected: '', hover: '', filtersOpen: false };
    root.addEventListener('click', onClick);
    root.addEventListener('focusin', onFocusIn);
    root.addEventListener('mouseover', onOver);
    root.addEventListener('mouseout', onOut);
    document.addEventListener('keydown', onKey);
    window.addEventListener('resize', onWinResize);
    render();
    loadMapLibre().then(() => {
      ensureMap();
      syncMap(filtered());
    }).catch(() => {});
  }

  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', cleanup);
</script>
