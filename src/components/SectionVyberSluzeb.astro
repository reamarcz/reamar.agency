---
const priorityFeatures = [
  { icon: 'search', text: 'aktivní vyhledávání podle vašeho zadání' },
  { icon: 'user', text: 'osobní konzultant, který se vám 3 měsíce plně věnuje' },
  { icon: 'screen', text: 'přístup do klientského portálu' },
];

const standardFeatures = [
  { icon: 'send', text: 'nabídky vybrané podle toho, co hledáte' },
  { icon: 'building', text: 'priority' },
  { icon: 'deal', text: 'zastoupení při koupi, vyjednávání s developerem a právní servis' },
];

const prioritySteps = [
  {
    icon: 'chat',
    title: 'Úvodní konzultace',
    text: 'Projdeme vaše zadání, rozpočet, motivaci nákupu a preference. Ujasníme si, co hledáte a podle čeho budeme vhodné jednotky vybírat.',
  },
  {
    icon: 'sign',
    title: 'Objednávka služeb',
    text: 'Potvrdíme rozsah služby, pravidla spolupráce a odměnu za osobní vyhledávání a zastoupení při nákupu.',
    badge: '15 000 Kč',
    badgePlain: true,
  },
  {
    icon: 'search',
    title: 'Osobní vyhledávání',
    text: 'Získáte přístup do našeho portálu a my pro vás aktivně vyhledáváme a doporučujeme nemovitosti podle vašeho zadání.',
  },
  {
    icon: 'talk',
    title: 'Vyjednávání podmínek',
    text: 'Zastupujeme vás při jednání s developerem, řešíme rezervaci, platební režim, cenu a další podmínky nákupu.',
  },
  {
    icon: 'scales',
    title: 'Právní servis při podpisu',
    text: 'Zkontrolujeme smluvní dokumentaci a pohlídáme, abyste před podpisem rozuměli podmínkám, závazkům i termínům.',
    badge: 'Provize',
  },
];

const standardSteps = [
  {
    icon: 'chat',
    title: 'Určení preferencí',
    text: 'Na osobní konzultaci nebo v online dotazníku si ujasníme, co hledáte, v jakém rozpočtu a podle čeho pro vás nemovitost dává smysl.',
  },
  {
    icon: 'sign',
    title: 'Souhlas se zasíláním',
    text: 'Potvrdíme si rozsah služby, pravidla doporučení a odměnu v případě pořízení nemovitosti z našeho výběru.',
    badge: 'Zdarma',
  },
  {
    icon: 'grid',
    title: 'Zasílání nemovitostí',
    text: 'Otevřeme vám výběr relevantních projektů z naší databáze, včetně neveřejných nabídek.',
  },
  {
    icon: 'deal',
    title: 'Nákup nemovitosti',
    text: 'Pokud si vyberete nemovitost z našeho doporučení, pomůžeme vám zajistit rezervaci vybrané jednotky u developera.',
    badge: 'Provize',
  },
];

interface Props {
  headingAs?: 'h1' | 'h2';
  compactTop?: boolean;
  showSubline?: boolean;
}

const { headingAs = 'h1', compactTop = true } = Astro.props;
const Heading = headingAs;
---

<section id="vyber-sluzeb" class="sluzby-section" aria-labelledby="vyber-heading" data-sluzby-vyber>
  <div class:list={['sluzby-wrap mx-auto max-w-[1440px] px-5 md:px-10 xl:px-14', compactTop && 'sluzby-wrap--compact']}>
    <div class="sluzby-head sluzby-in" style="--i: 0">
      <p class="sluzby-kicker">Výběr služeb</p>
      <Heading id="vyber-heading" class="sluzby-title">
        Dva způsoby, jak koupit <span class="sluzby-em">lépe</span>.
      </Heading>
    </div>

    <div class="sluzby-grid">
      <article class="sluzba-card sluzba-card--forest sluzby-in" style="--i: 1">
        <p class="sluzba-kicker">Priority</p>
        <h3 class="sluzba-headline">Vybírejte jako první</h3>
        <p class="sluzba-lead">
          Aktivně pro vás hledáme napříč trhem a jako prvním vám zpřístupňujeme předprodeje a neveřejné nabídky.
        </p>
        <p class="sluzba-label">Co získáte</p>
        <p class="sluzba-feature sluzba-feature--lead">
          <span class="sluzba-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.5 12.5l4.8 4.8L19.5 7"/>
            </svg>
          </span>
          <span>vše, co obsahuje Standard</span>
        </p>
        <div class="sluzba-priority-box">
          <svg class="sluzba-star" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3.2l2.6 5.6 6.1.7-4.5 4.2 1.2 6.1L12 16.8l-5.4 3 1.2-6.1-4.5-4.2 6.1-.7L12 3.2Z"/>
          </svg>
          <div>
            <p class="sluzba-priority-kicker">Priority list</p>
            <p class="sluzba-priority-text">Nové projekty a předprodeje vidíte dříve než ostatní.</p>
          </div>
        </div>
        <ul class="sluzba-features">
          {priorityFeatures.map((item) => (
            <li class="sluzba-feature">
              <span class="sluzba-feature-icon" aria-hidden="true">
                {item.icon === 'search' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="6.2"/>
                    <path d="M16.2 16.2 21 21"/>
                  </svg>
                )}
                {item.icon === 'user' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="3.2"/>
                    <path d="M5.4 19.2c.7-3.3 3.3-5.1 6.6-5.1s5.9 1.8 6.6 5.1"/>
                  </svg>
                )}
                {item.icon === 'screen' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="13"/>
                    <path d="M8 21h8M12 17v4"/>
                  </svg>
                )}
              </span>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>
        <div class="sluzba-foot">
          <div class="sluzba-foot-rule">
            <p class="sluzba-price">
              <span class="sluzba-price-num">15 000 Kč</span>
              <span class="sluzba-price-note">/ spolupráce na 3 měsíce</span>
            </p>
            <button type="button" class="sluzba-provize" data-provize-open data-provize-variant="priority" aria-haspopup="dialog" aria-controls="provize-modal">
              <span>+ provize z nákupu</span>
              <span class="sluzba-info" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M12 11v5.5M12 7.6v.1"/>
                </svg>
              </span>
              <span class="sr-only">Podrobnosti k provizi z nákupu</span>
            </button>
            <div class="sluzba-actions">
              <button
                type="button"
                class="sluzba-cta"
                data-smart-contact-open
                data-smart-contact-type="client"
                data-smart-contact-service="Priority"
              >
                <img src="/images/arrow-1.svg" alt="" width="13" height="13" />
                Zahájit spolupráci
              </button>
              <button type="button" class="sluzba-how-hint" data-how-open="priority" aria-haspopup="dialog" aria-controls="how-modal">
                Jak to funguje
              </button>
            </div>
          </div>
        </div>
      </article>

      <article class="sluzba-card sluzba-card--plain sluzby-in" style="--i: 2">
        <p class="sluzba-kicker">Standard</p>
        <h3 class="sluzba-headline">Sledujte nové příležitosti</h3>
        <p class="sluzba-lead">
          Pro ty, kteří zatím hledají sami, ale chtějí mít přístup k tomu, co se na developerském trhu objeví.
        </p>
        <p class="sluzba-label">Co získáte</p>
        <ul class="sluzba-features">
          {standardFeatures.map((item) => (
            <li class="sluzba-feature">
              <span class="sluzba-feature-icon" aria-hidden="true">
                {item.icon === 'send' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 6.5h16v11H4z"/>
                    <path d="m4 6.5 8 6.2 8-6.2"/>
                  </svg>
                )}
                {item.icon === 'building' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.5 21V5.5h11V21"/>
                    <path d="M15.5 10.5H20.5V21"/>
                    <path d="M4.5 21h16"/>
                    <path d="M7.5 8.5h2M7.5 12h2M7.5 15.5h2"/>
                    <path d="M17.5 14h1.2M17.5 17h1.2"/>
                    <path d="M9.2 21v-3.2h2.6V21"/>
                  </svg>
                )}
                {item.icon === 'deal' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.7 7h5.8a2.1 2.1 0 0 1 2.1 2.1v5.8a2.1 2.1 0 0 1-2.1 2.1H4.7a2.1 2.1 0 0 1-2.1-2.1V9.1A2.1 2.1 0 0 1 4.7 7Z"/>
                    <circle cx="7.6" cy="12" r="1.55"/>
                    <path d="M12.6 10.55h9.1v2.9h-2.15v2.15h-1.8v-2.15h-1.65v1.55h-1.7v-1.55H12.6"/>
                  </svg>
                )}
              </span>
              {item.icon === 'building' ? (
                <span>
                  neveřejné projekty a předprodeje, jakmile je uvolníme z{' '}
                  <span class="sluzba-nowrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 3.2l2.6 5.6 6.1.7-4.5 4.2 1.2 6.1L12 16.8l-5.4 3 1.2-6.1-4.5-4.2 6.1-.7L12 3.2Z"/>
                    </svg>
                    Priority listu
                  </span>
                </span>
              ) : (
                <span>{item.text}</span>
              )}
            </li>
          ))}
        </ul>
        <div class="sluzba-foot">
          <div class="sluzba-foot-rule">
            <p class="sluzba-price">
              <span class="sluzba-price-num">ZDARMA</span>
              <span class="sluzba-price-note">/ bez časového omezení</span>
            </p>
            <button type="button" class="sluzba-provize" data-provize-open data-provize-variant="standard" aria-haspopup="dialog" aria-controls="provize-modal">
              <span>+ provize z nákupu</span>
              <span class="sluzba-info" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M12 11v5.5M12 7.6v.1"/>
                </svg>
              </span>
              <span class="sr-only">Podrobnosti k provizi z nákupu</span>
            </button>
            <div class="sluzba-actions">
              <button
                type="button"
                class="sluzba-cta sluzba-cta--line"
                data-smart-contact-open
                data-smart-contact-type="client"
                data-smart-contact-service="Standard"
              >
                <img src="/images/arrow-1.svg" alt="" width="13" height="13" />
                Začít zdarma
              </button>
              <button type="button" class="sluzba-how-hint" data-how-open="standard" aria-haspopup="dialog" aria-controls="how-modal">
                Jak to funguje
              </button>
            </div>
          </div>
        </div>
      </article>
    </div>

    <p class="sluzby-note sluzby-in" style="--i: 3">
      Pokud si po dobu spolupráce z našeho doporučení nevyberete, <strong>neúčtujeme si žádnou provizi.</strong>
    </p>
  </div>
</section>

<div id="how-overlay" class="how-overlay" aria-hidden="true" data-how>
  <div
    id="how-modal"
    class="how-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="how-title-priority"
    tabindex="-1"
    data-how-modal
  >
    <button type="button" class="how-close" data-how-close>
      <span>Zavřít</span>
      <span aria-hidden="true">×</span>
    </button>
    <div data-how-panel="priority">
      <p class="how-kicker">Jak to funguje</p>
      <h2 id="how-title-priority" class="how-title">Priority</h2>
      <ol class="how-steps">
        {prioritySteps.map((step) => (
          <li class="how-step">
            <span class="how-step-rail" aria-hidden="true">
              <span class="how-step-icon">
                {step.icon === 'chat' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 6.2h9.2A1.8 1.8 0 0 1 15 8v5.2a1.8 1.8 0 0 1-1.8 1.8H9.4L6.2 18v-3H4A1.8 1.8 0 0 1 2.2 13.2V8A1.8 1.8 0 0 1 4 6.2Z"/>
                    <path d="M15.4 9.2H19A1.8 1.8 0 0 1 20.8 11v5.2A1.8 1.8 0 0 1 19 18h-2.2V20l-2.6-2"/>
                  </svg>
                )}
                {step.icon === 'sign' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 3.5h8.5L19 7v13.5H7V3.5Z"/>
                    <path d="M15.5 3.5V7H19"/>
                    <path d="M12.2 16.2c1.7-1.8 3.6-2.2 5.3-1.2"/>
                    <path d="M12.2 16.2l-.4 1.8 1.8-.4"/>
                  </svg>
                )}
                {step.icon === 'search' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="6.2"/>
                    <path d="M16.2 16.2 21 21"/>
                  </svg>
                )}
                {step.icon === 'talk' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8.2 12.2 4.8 8.8a2 2 0 0 1 2.8-2.8l3.2 3.2"/>
                    <path d="M15.8 12.2 19.2 8.8a2 2 0 1 0-2.8-2.8l-3.2 3.2"/>
                    <path d="M7.5 13h9v2.4a3 3 0 0 1-3 3h-3a3 3 0 0 1-3-3V13Z"/>
                  </svg>
                )}
                {step.icon === 'scales' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v18M8 21h8M12 5l-6.5 8h13L12 5Z"/>
                    <path d="M5.5 13v.5a2.5 2.5 0 1 0 5 0V13M13.5 13v.5a2.5 2.5 0 1 0 5 0V13"/>
                  </svg>
                )}
              </span>
            </span>
            <div class="min-w-0">
              <p class="how-step-title">
                {step.title}
                {step.badge && (
                  <span class:list={['how-badge', step.badgePlain && 'how-badge--plain']}>{step.badge}</span>
                )}
              </p>
              <p class="how-step-text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div data-how-panel="standard" hidden>
      <p class="how-kicker">Jak to funguje</p>
      <h2 id="how-title-standard" class="how-title">Standard</h2>
      <ol class="how-steps">
        {standardSteps.map((step) => (
          <li class="how-step">
            <span class="how-step-rail" aria-hidden="true">
              <span class="how-step-icon">
                {step.icon === 'chat' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 6.2h9.2A1.8 1.8 0 0 1 15 8v5.2a1.8 1.8 0 0 1-1.8 1.8H9.4L6.2 18v-3H4A1.8 1.8 0 0 1 2.2 13.2V8A1.8 1.8 0 0 1 4 6.2Z"/>
                    <path d="M15.4 9.2H19A1.8 1.8 0 0 1 20.8 11v5.2A1.8 1.8 0 0 1 19 18h-2.2V20l-2.6-2"/>
                  </svg>
                )}
                {step.icon === 'sign' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 3.5h8.5L19 7v13.5H7V3.5Z"/>
                    <path d="M15.5 3.5V7H19"/>
                    <path d="M12.2 16.2c1.7-1.8 3.6-2.2 5.3-1.2"/>
                    <path d="M12.2 16.2l-.4 1.8 1.8-.4"/>
                  </svg>
                )}
                {step.icon === 'grid' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4.5" width="18" height="15"/>
                    <path d="M3 8.5h18"/>
                    <path d="M8 4.5v4M12 11v8.5M8 11h8M8 15.5h8"/>
                  </svg>
                )}
                {step.icon === 'deal' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2.6" y="7" width="10" height="10" rx="2.1"/>
                    <circle cx="7.6" cy="12" r="1.55"/>
                    <path d="M12.6 10.55h9.1v2.9h-2.15v2.15h-1.8v-2.15h-1.65v1.55h-1.7v-1.55H12.6"/>
                  </svg>
                )}
              </span>
            </span>
            <div class="min-w-0">
              <p class="how-step-title">
                {step.title}
                {step.badge && <span class="how-badge">{step.badge}</span>}
              </p>
              <p class="how-step-text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</div>

<style>
  .sluzby-section {
    background: #fff;
    color: #000;
  }
  .sluzby-wrap {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  .sluzby-wrap--compact {
    padding-top: 2.5rem;
  }
  .sluzby-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .sluzby-kicker {
    margin: 0;
    font-family: 'Yellix', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
  }
  .sluzby-title {
    margin: 0.75rem 0 0;
    font-family: 'Yellix', system-ui, sans-serif;
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
  }
  .sluzby-em {
    color: #032d20;
    text-decoration: underline 2.5px;
    text-underline-offset: 0.11em;
    text-decoration-skip-ink: none;
  }
  .sluzby-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 16px;
    align-items: stretch;
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
  }
  .sluzba-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid rgba(0, 0, 0, 0.16);
    padding: clamp(28px, 3.4vw, 48px);
    transition: border-color 0.35s, background-color 0.35s, box-shadow 0.45s, opacity 0.35s;
  }
  .sluzba-card.sluzby-in {
    transform: none;
  }
  .sluzba-card.sluzby-in.is-in {
    animation-name: sluzba-fade;
  }
  .sluzby-grid:has(.sluzba-card:hover) .sluzba-card:not(:hover) {
    opacity: 0.62;
  }
  .sluzba-card--forest {
    background: #032d20;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.32);
  }
  .sluzba-card--forest:hover {
    background: #043d2c;
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow: rgba(3, 45, 32, 0.22) 0 18px 42px;
  }
  .sluzba-card--forest .sluzba-lead,
  .sluzba-card--forest .sluzba-priority-text,
  .sluzba-card--forest .sluzba-how-hint {
    color: rgba(255, 255, 255, 0.78);
  }
  .sluzba-card--forest .sluzba-label {
    color: rgba(255, 255, 255, 0.55);
  }
  .sluzba-card--forest .sluzba-price-note {
    color: rgba(255, 255, 255, 0.65);
  }
  .sluzba-card--forest .sluzba-provize > span:first-child {
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }
  .sluzba-card--forest .sluzba-foot-rule {
    border-top-color: rgba(255, 255, 255, 0.2);
  }
  .sluzba-card--forest .sluzba-cta {
    background: #fff;
    color: #000;
  }
  .sluzba-card--forest .sluzba-cta img {
    filter: brightness(0);
  }
  .sluzba-card--plain {
    background: transparent;
    color: #000;
  }
  .sluzba-card--plain:hover {
    background: #f6f6f4;
    border-color: rgba(0, 0, 0, 0.55);
    box-shadow: rgba(0, 0, 0, 0.07) 0 18px 42px;
  }
  .sluzba-kicker {
    margin: 0;
