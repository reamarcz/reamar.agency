<script>
  function initSluzbyVyber() {
    const wrap = document.querySelector('[data-sluzby-vyber]');
    if (!wrap) return;
    if (wrap._sluzbyCleanup) wrap._sluzbyCleanup();

    const items = [...wrap.querySelectorAll('.sluzby-in')];
    const overlay = document.getElementById('how-overlay');
    const modal = overlay?.querySelector('[data-how-modal]');

    function openHow(key) {
      if (!overlay || !modal) return;
      overlay.querySelectorAll('[data-how-panel]').forEach((panel) => {
        panel.hidden = panel.getAttribute('data-how-panel') !== key;
      });
      const title = overlay.querySelector(`[data-how-panel="${key}"] h2`);
      if (title) modal.setAttribute('aria-labelledby', title.id);
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modal.focus();
    }

    function closeHow() {
      if (!overlay) return;
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function onClick(event) {
      const btn = event.target.closest('[data-how-open]');
      if (!btn || !wrap.contains(btn)) return;
      event.preventDefault();
      openHow(btn.getAttribute('data-how-open') || 'standard');
    }

    function onOverlayClick() {
      closeHow();
    }

    function onModalClick(event) {
      event.stopPropagation();
    }

    function onKeydown(event) {
      if (event.key === 'Escape') closeHow();
    }

    document.addEventListener('click', onClick);
    overlay?.addEventListener('click', onOverlayClick);
    modal?.addEventListener('click', onModalClick);
    modal?.addEventListener('keydown', onKeydown);
    overlay?.querySelectorAll('[data-how-close]').forEach((btn) => {
      btn.addEventListener('click', closeHow);
    });

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let io = null;
    if (!items.length || reduced) {
      items.forEach((el) => el.classList.add('is-in'));
    } else {
      io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          items.forEach((el) => el.classList.add('is-in'));
          io.disconnect();
        },
        { threshold: 0.12 }
      );
      io.observe(wrap);
    }

    wrap._sluzbyCleanup = () => {
      io?.disconnect();
      document.removeEventListener('click', onClick);
      overlay?.removeEventListener('click', onOverlayClick);
      modal?.removeEventListener('click', onModalClick);
      modal?.removeEventListener('keydown', onKeydown);
      overlay?.querySelectorAll('[data-how-close]').forEach((btn) => {
        btn.removeEventListener('click', closeHow);
      });
      wrap._sluzbyCleanup = null;
    };
  }

  initSluzbyVyber();
  document.addEventListener('astro:page-load', initSluzbyVyber);
</script>
