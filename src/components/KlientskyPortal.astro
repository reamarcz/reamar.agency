---
import KlientskyPortalNahled from './KlientskyPortalNahled.astro';

interface Props {
  loginHref: string;
  screenImage: string;
  mobileImage?: string;
}
const { loginHref, screenImage, mobileImage } = Astro.props;

const User = (s: number) =>
  `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21 c1-4 4-6 8-6 s7 2 8 6"/></svg>`;
---

<div class="kpp" data-kpp>
  <section class="kpp-track" data-kpp-track>
    <div class="kpp-sticky">
      <div class="kpp-stage">
        <div class="kpp-app" data-kpp-app>
          <picture>
            {mobileImage && <source media="(max-width: 1023px)" srcset={mobileImage} />}
            <img
              class="kpp-shot"
              src={screenImage}
              alt="Klientský portál REAMAR – mapa novostaveb"
              fetchpriority="high"
            />
          </picture>
        </div>
        <div class="kpp-shade" data-kpp-shade></div>
        <div class="kpp-hero" data-kpp-hero>
          <p class="kpp-kick font-yellix">Klientský portál</p>
          <h1 class="font-yellix">Trh novostaveb tak, jak ho vidíme my.</h1>
          <div class="kpp-row">
            <a class="kpp-btn font-yellix" href="#ukazka" data-kpp-jump>
              Vyzkoušet ukázku
              <img src="/images/arrow-1.svg" alt="" width="12" height="12" />
            </a>
            <a class="kpp-login font-yellix" href={loginHref}>
              <Fragment set:html={User(16)} />
              Přihlásit se
            </a>
          </div>
        </div>
      </div>

      <div class="kpp-demo" data-kpp-demo id="ukazka">
        <KlientskyPortalNahled />
        <div class="kpp-panel" data-kpp-panel>
          <div class="kpp-panelhead">
            <span class="font-yellix">Ukázka portálu</span>
            <button type="button" class="kpp-x" data-kpp-close aria-label="Zavřít">×</button>
          </div>
          <p class="font-yellix">
            Tohle je náhled našeho portálu s omezenými daty. Celý přístup odemknete s podpisem smlouvy.
          </p>
          <div class="kpp-panelbtns">
            <a class="kpp-pb1 font-yellix" href={loginHref}>
              <Fragment set:html={User(12)} />
              Přihlásit se
            </a>
          </div>
        </div>
        <button type="button" class="kpp-pill font-yellix" data-kpp-open>Ukázka portálu · info</button>
      </div>
    </div>
  </section>
</div>

<style is:global>
  .kpp {
    --pad: 1.25rem;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    background: #0e0e0e;
    color: #fff;
    font-family: Yellix, system-ui, sans-serif;
    font-weight: 500;
  }
  @media (min-width: 768px) { .kpp { --pad: 2.5rem; } }
  @media (min-width: 1280px) { .kpp { --pad: 3.5rem; } }
  .kpp a { color: inherit; }

  .kpp-sticky {
    position: relative;
    min-height: 100svh;
    overflow: visible;
    background: #0e0e0e;
  }
  .kpp-stage {
    position: relative;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    background: #0e0e0e;
  }
  .kpp-app {
    position: absolute;
    inset: 0;
  }
  .kpp-shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    display: block;
    transform-origin: 62% 50%;
    animation: kpp-pan 26s ease-in-out infinite alternate;
  }
  @keyframes kpp-pan {
    from { transform: scale(1.02); }
    to { transform: scale(1.1) translate(-2%, 1.5%); }
  }
  .kpp-demo {
    position: relative;
    z-index: 1;
    padding: 0 0 8px;
    background: #fff;
  }
  .kpp-demo .kp {
    height: min(42rem, calc(100dvh - var(--nav-h) - 4rem));
    min-height: 32rem;
    border-color: #2a2a2a;
  }
  .kpp-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.38) 42%, rgba(0, 0, 0, 0.06) 70%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0) 26%);
  }
  .kpp-hero {
    position: absolute;
    left: 0;
    right: 0;
    top: 66.666%;
    bottom: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 0 var(--pad);
    text-align: center;
  }
  @media (min-width: 640px) {
    .kpp-hero { gap: 1.5rem; }
  }
  .kpp-kick {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1;
  }
  .kpp-hero h1 {
    margin: 0;
    font-size: 32px;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.28);
  }
  .kpp-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
  }
  .kpp-btn,
  .kpp-login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 1rem;
    font-size: 13px;
    line-height: 1;
    text-decoration: none;
  }
  .kpp-btn {
    background: #fff;
    color: #000 !important;
    border: 1px solid #fff;
  }
  .kpp-btn img {
    width: 12px;
    height: 12px;
    filter: brightness(0);
  }
  .kpp-btn:hover { opacity: 0.88; }
  .kpp-login {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.42);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(18px) saturate(1.25);
    -webkit-backdrop-filter: blur(18px) saturate(1.25);
  }
  .kpp-login:hover {
    background: rgba(255, 255, 255, 0.28);
    border-color: rgba(255, 255, 255, 0.6);
  }
  .kpp-login svg { width: 16px; height: 16px; }
  .kpp-panel, .kpp-pill { display: none; }
  @media (min-width: 640px) {
    .kpp-hero h1 { font-size: 40px; }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .kpp-track { position: relative; height: calc(100vh + 70vh); }
    .kpp-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 0;
      overflow: hidden;
    }
    .kpp-stage {
      position: absolute;
      inset: 0;
      height: 100%;
      min-height: 0;
    }
    .kpp-shot { opacity: 0; animation: none; }
    .kpp-demo {
      position: absolute;
      inset: 0;
      z-index: 1;
      margin: 0;
      padding: 0;
      background: #fff;
      opacity: 1;
      visibility: visible;
      pointer-events: none;
    }
    .kpp.is-live .kpp-demo {
      top: var(--nav-h);
      z-index: 5;
      pointer-events: auto;
    }
    .kpp-demo .kp {
      height: 100%;
      min-height: 0;
      border: 0;
    }
    .kpp-shade { z-index: 3; }
    .kpp-shade,
    .kpp-hero { will-change: opacity, transform; }
    .kpp-hero h1 {
      font-size: 42px;
      white-space: nowrap;
    }

    .kpp-panel {
      display: block;
      position: absolute;
      right: var(--pad);
      left: auto;
      bottom: 24px;
      z-index: 6;
      width: 20.5rem;
      padding: 16px 16px 14px;
      background: #fff;
      color: #111;
      border: 1px solid #e3e3e3;
      opacity: 0;
      transform: translateY(16px);
      pointer-events: none;
      transition: opacity 0.3s ease, transform 0.4s var(--ease);
    }
    .kpp.is-live .kpp-panel:not(.is-min) {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .kpp-panelhead { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
    .kpp-panelhead span { font-size: 15px; letter-spacing: -0.025em; line-height: 1.2; }
    .kpp-x { all: unset; cursor: pointer; padding: 2px 4px; color: #999; font-size: 16px; line-height: 1; font-weight: 500; }
    .kpp-x:hover { color: #111; }
    .kpp-panel p { margin: 0 0 12px; font-size: 13px; line-height: 1.45; color: rgba(0, 0, 0, 0.5); }
    .kpp-panelbtns { display: flex; gap: 8px; }
    .kpp-panelbtns a { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; font-size: 12px; text-decoration: none; }
    .kpp-pb1 { background: #111; color: #fff !important; }
    .kpp-pb1 svg { width: 12px; height: 12px; }
    .kpp-pill {
      all: unset;
      cursor: pointer;
      position: absolute;
      right: var(--pad);
      left: auto;
      bottom: 24px;
      z-index: 6;
      display: none;
      padding: 9px 12px;
      background: #fff;
      color: #111;
      border: 1px solid #e3e3e3;
      font-size: 13px;
    }
    .kpp.is-live .kpp-pill.is-on { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kpp-shot { animation: none; }
  }
</style>

<script>
  const REVEAL = 0.7;

  let raf = 0;
  let desk: MediaQueryList | null = null;
  let onScroll: (() => void) | null = null;
  let onResize: (() => void) | null = null;
  let onDesk: (() => void) | null = null;
  let jumpHandler: ((e: Event) => void) | null = null;
  let closeHandler: (() => void) | null = null;
  let openHandler: (() => void) | null = null;

  function setNavSolid(on: boolean) {
    const header = document.querySelector('[data-nav]');
    if (!header) return;
    if (on) header.setAttribute('data-nav-solid', '');
    else header.removeAttribute('data-nav-solid');
  }

  function cleanup() {
    if (onScroll) window.removeEventListener('scroll', onScroll);
    if (onResize) window.removeEventListener('resize', onResize);
    if (desk && onDesk) desk.removeEventListener('change', onDesk);
    const root = document.querySelector('[data-kpp]');
    if (root && jumpHandler) root.querySelector('[data-kpp-jump]')?.removeEventListener('click', jumpHandler);
    if (root && closeHandler) root.querySelector('[data-kpp-close]')?.removeEventListener('click', closeHandler);
    if (root && openHandler) root.querySelector('[data-kpp-open]')?.removeEventListener('click', openHandler);
    raf = 0;
    onScroll = onResize = onDesk = jumpHandler = closeHandler = openHandler = null;
    desk = null;
  }

  function init() {
    cleanup();
    const root = document.querySelector('[data-kpp]') as HTMLElement | null;
    if (!root) return;
    const track = root.querySelector('[data-kpp-track]') as HTMLElement;
    const shade = root.querySelector('[data-kpp-shade]') as HTMLElement;
    const hero = root.querySelector('[data-kpp-hero]') as HTMLElement;
    const panel = root.querySelector('[data-kpp-panel]') as HTMLElement;
    const pill = root.querySelector('[data-kpp-open]') as HTMLElement;
    desk = window.matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)');

    const clamp = (v: number) => Math.max(0, Math.min(1, v));
    const tick = () => {
      raf = 0;
      if (!desk?.matches) {
        [shade, hero].forEach((el) => el.removeAttribute('style'));
        root.classList.remove('is-live');
        const nav = document.querySelector('[data-nav]');
        const navH = nav ? nav.getBoundingClientRect().height : 80;
        setNavSolid(shade.getBoundingClientRect().bottom <= navH + 8);
        return;
      }
      const vh = window.innerHeight;
      const sc = -track.getBoundingClientRect().top / vh;
      const p0 = clamp(sc / REVEAL);
      const p = p0 * p0 * (3 - 2 * p0);
      shade.style.opacity = String(1 - p);
      hero.style.opacity = String(Math.max(0, 1 - p * 1.6));
      hero.style.transform = `translateY(${40 * p}px)`;
      hero.style.pointerEvents = p > 0.3 ? 'none' : 'auto';
      const live = p0 >= 0.999;
      const wasLive = root.classList.contains('is-live');
      root.classList.toggle('is-live', live);
      setNavSolid(live);
      if (live && !wasLive) window.dispatchEvent(new Event('resize'));
    };

    const req = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    jumpHandler = (e: Event) => {
      if (!desk?.matches) return;
      e.preventDefault();
      const top = track.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({ top: top + REVEAL * window.innerHeight + 2, behavior: 'smooth' });
    };
    closeHandler = () => {
      panel.classList.add('is-min');
      pill.classList.add('is-on');
    };
    openHandler = () => {
      panel.classList.remove('is-min');
      pill.classList.remove('is-on');
    };

    root.querySelector('[data-kpp-jump]')?.addEventListener('click', jumpHandler);
    root.querySelector('[data-kpp-close]')?.addEventListener('click', closeHandler);
    pill.addEventListener('click', openHandler);

    onScroll = req;
    onResize = req;
    onDesk = req;
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    desk.addEventListener('change', onDesk);
    req();
  }

  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', cleanup);
</script>
