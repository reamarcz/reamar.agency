---
// SectionBuyersAgentKroky — předchozí druhá sekce homepage.
// Sticky kroky vlevo + postupně se roztahující video. Na `/` se teď nepoužívá.
// Vrácení: importovat místo SectionBuyersAgentHorizont.
interface Props {
  videoSrc?: string;
  posterSrc?: string;
  episodeLabel?: string;
  episodeHref?: string;
  hero?: boolean;
}

const {
  videoSrc = '/videos/agentprokupujici.mp4',
  posterSrc = '/images/agency/hero-obhlidka.jpg',
  episodeLabel = 'Příběhy z trhu · 100 milionů na penthouse. Co vybereme?',
  episodeHref = 'https://www.youtube.com/watch?v=MIYbJdRJYGY',
  hero = false,
} = Astro.props;

const [episodeKicker, episodeTitle] = episodeLabel.split(/\s·\s/);

const rows = [
  {
    title: 'Vyhledávání na celém trhu<br class="ba__br" /> novostaveb',
    text: 'V Praze sledujeme téměř <strong class="ba-em">10&nbsp;000 bytů</strong>. Bez hluboké znalosti trhu a správných technologií je prakticky nemožné tak rozsáhlou nabídku porovnat.',
    icon: 'search',
  },
  {
    title: 'Zvýhodněné podmínky<br class="ba__br" /> u developerů',
    text: 'Díky kontaktům na developerském trhu řešíme předprodeje, <strong class="ba-em">neveřejné nabídky</strong> a podmínky, ke kterým se kupující sám často nedostane.',
    icon: 'reserve',
  },
  {
    title: 'Komunikace s developerem<br class="ba__br" /> a právní servis',
    text: 'Od rezervace po podpis smluv stojíme <strong class="ba-em">na vaší straně</strong>. Hlídáme podmínky, termíny, dokumentaci i body, které se v nákupu snadno přehlédnou.',
    icon: 'deal',
  },
];
---

<section
  id="koncept"
  class:list={['ba', hero && 'ba--hero']}
  aria-labelledby="koncept-heading"
  data-ba
  data-nav-hide-zone
  data-hero-alt={hero ? '' : undefined}
>
  <div class="ba__track" data-ba-track>
    <div class="ba__sticky" data-ba-sticky>
      <div class="ba__grid">
        <div class="ba__left" data-ba-left>
          {rows.map((row) => (
            <article class="ba__row" data-ba-row>
              <span class:list={['ba__icon', `ba__icon--${row.icon}`]} aria-hidden="true">
                {row.icon === 'search' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="6.2"/>
                    <path d="M16.2 16.2 21 21"/>
                  </svg>
                )}
                {row.icon === 'reserve' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="5" width="16" height="15"/>
                    <path d="M4 10h16M8 3v4M16 3v4"/>
                  </svg>
                )}
                {row.icon === 'deal' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 4h10v16H7z"/>
                    <path d="M10 8h4M10 12h4M10 16h2.5"/>
                  </svg>
                )}
              </span>
              <h3 class="ba__row-title font-yellix" set:html={row.title} />
              <p class="ba__row-text font-yellix" set:html={row.text} />
            </article>
          ))}
        </div>

        <div class="ba__right" data-ba-right>
          <div class="ba__head" data-ba-head>
            {!hero && (
              <>
                <h2 id="koncept-heading" class="ba__h font-yellix">Buyer’s agent</h2>
                <p class="ba__sub font-yellix">
                  <span class="ba__sub-arrow" aria-hidden="true"></span>Na západních trzích běžný princip odborného zastoupení kupujícího.
                </p>
              </>
            )}
          </div>

          <div class="ba__ph" data-ba-ph>
            <div
              class="ba__video"
              data-ba-video
              role={hero ? undefined : 'button'}
              tabindex={hero ? undefined : 0}
              aria-label={hero ? undefined : 'Zobrazit video na celou obrazovku'}
            >
              <video
                data-ba-media
                data-src={videoSrc}
                src={hero ? videoSrc : undefined}
                poster={posterSrc}
                muted
                loop
                playsinline
                preload={hero ? 'auto' : 'none'}
                disablepictureinpicture
                disableremoteplayback
                aria-hidden="true"
              ></video>
              <img class="ba__poster" data-ba-poster src={posterSrc} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
              <div class="ba__shade" data-ba-fade></div>
            </div>
          </div>

          <div class="ba__cap" data-ba-cap>
            {hero ? (
              <div class="ba__hero-copy">
                <h1 id="koncept-heading" class="ba__hero-title font-yellix">
                  Zastupujeme vás<br />při výběru nového bydlení
                </h1>
                <a class="ba__hero-cta font-yellix" href="#vyber-sluzeb">
                  <img src="/images/arrow-1.svg" alt="" width="12" height="12" />
                  Vybrat službu
                </a>
              </div>
            ) : (
              <p class="ba__quote font-yellix">Klient má při nákupu nemovitosti partnera, který nestojí na straně konkrétní nabídky, ale na straně jeho rozhodnutí.<span class="ba__quote-more"> Tento přístup přinášíme do Prahy se specializací na developerské projekty.</span></p>
            )}
            <div class="ba__cap-meta">
              <p class="ba__ep font-yellix">
                <span class="ba__ep-kicker">{episodeKicker}</span>
                <span class="ba__ep-dot" aria-hidden="true">·</span>
                <span class="ba__ep-title">{episodeTitle ?? episodeLabel}</span>
              </p>
            </div>
            <a
              class="ba__yt"
              href={episodeHref}
              target="_blank"
              rel="noopener noreferrer"
              data-ba-play
              aria-label={`Přehrát díl na YouTube: ${episodeTitle ?? episodeLabel}`}
            >
              <span class="ba__yt-icon" aria-hidden="true">
                <svg viewBox="0 0 24 17">
                  <path fill="#FF0000" d="M23.5 2.65A3.02 3.02 0 0 0 21.38.5C19.5 0 12 0 12 0S4.5 0 2.62.5A3.02 3.02 0 0 0 .5 2.65 31.9 31.9 0 0 0 0 8.5a31.9 31.9 0 0 0 .5 5.85 3.02 3.02 0 0 0 2.12 2.15C4.5 17 12 17 12 17s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.15A31.9 31.9 0 0 0 24 8.5a31.9 31.9 0 0 0-.5-5.85Z"/>
                  <path fill="#fff" d="M9.75 12.15V4.85L15.7 8.5 9.75 12.15Z"/>
                </svg>
              </span>
              <span class="ba__yt-copy">
                <span class="ba__yt-kicker">{episodeKicker ?? 'YouTube'}</span>
                <span class="ba__yt-title">{episodeTitle ?? episodeLabel}</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ba {
    --ba-pad: 1.25rem;
    --ba-hair: rgba(0, 0, 0, 0.12);
    --ba-max: 1440px;
    background: #f1f1f1;
    color: #000;
  }

  .ba__sticky {
    padding: 3.5rem var(--ba-pad) 3rem;
  }
  .ba__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    max-width: 1440px;
    margin: 0 auto;
  }
  .ba__right {
    display: contents;
  }
  .ba__head,
  .ba__quote,
  .ba__left,
  .ba__ph,
  .ba__cap-meta {
    grid-column: 1;
  }
  .ba__head { grid-row: 1; }
  .ba__quote { grid-row: 2; }
  .ba__left { grid-row: 3; }
  .ba__ph { grid-row: 4; }
  .ba__cap-meta { grid-row: 4; }
  :global(.ba__br) {
    display: inline;
  }

  .ba__h {
    margin: 0;
    font-size: 36px;
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .ba__sub {
    margin: 0.9rem 0 0;
    max-width: 22em;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: rgba(0, 0, 0, 0.7);
  }
  .ba__sub-arrow {
    display: none;
    width: 0.7em;
    height: 0.7em;
    margin-right: 0.55em;
    vertical-align: 0;
    background: currentColor;
    -webkit-mask: url('/images/arrow-1.svg') center / contain no-repeat;
    mask: url('/images/arrow-1.svg') center / contain no-repeat;
  }

  .ba__left {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ba__row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 1.25rem 1.15rem 1.4rem;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.04);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.06);
  }
  .ba__icon {
    display: flex;
    align-self: start;
    width: 32px;
    height: 32px;
    margin-top: 0;
    overflow: visible;
  }
  .ba__icon svg {
    width: 32px;
    height: 32px;
    transform-origin: center;
  }
  .ba__row-title {
    margin: 0;
    align-self: start;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .ba__row-text {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.7);
  }
  :global(.ba-em) {
    font-weight: 600;
  }

  .ba__ph {
    position: relative;
    align-self: start;
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  .ba__video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #111;
    cursor: pointer;
  }
  .ba__video:focus-visible {
    outline: 2px solid #000;
    outline-offset: 3px;
  }
  .ba__poster {
    position: absolute;
    inset: 0;
    z-index: 1;
    transition: opacity 0.25s ease;
  }
  .ba__video.is-playing .ba__poster,
  .ba__video.has-played .ba__poster {
    opacity: 0;
    pointer-events: none;
  }
  .ba__video video,
  .ba__poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .ba__poster {
    object-position: 61% 40%;
    transform: scale(2.25);
    transform-origin: 61% 40%;
  }
  .ba__video video::-webkit-media-controls,
  .ba__video video::-webkit-media-controls-start-playback-button,
  .ba__video video::-webkit-media-controls-overlay-play-button,
  .ba__video video::-webkit-media-controls-enclosure {
    display: none !important;
    -webkit-appearance: none;
    opacity: 0 !important;
  }
  .ba__shade {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48%;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.18) 55%, rgba(0, 0, 0, 0) 100%);
  }

  .ba__cap {
    display: contents;
  }
  .ba__cap-meta {
    z-index: 3;
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0;
    padding: 0.95rem 1rem 1rem;
    pointer-events: none;
    color: inherit;
    text-decoration: none;
  }
  .ba__pill-chevron {
    display: none;
  }
  .ba__yt {
    display: none;
  }
  .ba__quote {
    margin: -0.55rem 0 0.65rem;
    max-width: 38ch;
    padding-left: 1rem;
    border-left: 1px solid rgba(0, 0, 0, 0.16);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0;
    color: rgba(0, 0, 0, 0.62);
  }
  .ba__ep {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-transform: none;
    color: #fff;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
  }
  .ba__ep-kicker {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }
  .ba__ep-dot {
    display: none;
  }
  .ba__pill {
    display: none;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: #000;
    text-decoration: none;
    pointer-events: auto;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    transition: opacity 0.2s ease;
  }
  .ba__pill:hover {
    opacity: 0.85;
  }
  .ba__pill svg {
    width: 11px;
    height: 11px;
    margin-left: 1px;
  }
  .ba__pill-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .ba__row.is-in .ba__icon--search svg {
    animation: ba-search 7.5s ease-in-out infinite;
  }
  .ba__row.is-in .ba__icon--reserve svg {
    animation: ba-reserve 7.5s ease-in-out infinite;
  }
  .ba__row.is-in .ba__icon--deal svg {
    animation: ba-deal 7.5s ease-in-out infinite;
  }
  @keyframes ba-search {
    0%, 10%, 100% { transform: scale(1); }
    5% { transform: scale(1.48); }
  }
  @keyframes ba-reserve {
    0%, 32%, 46%, 100% { transform: rotate(0deg); }
    36% { transform: rotate(-30deg); }
    41% { transform: rotate(22deg); }
    45% { transform: rotate(0deg); }
  }
  @keyframes ba-deal {
    0%, 64%, 80%, 100% { transform: translateY(0); }
    68% { transform: translateY(-11px); }
    72% { transform: translateY(0); }
    75% { transform: translateY(-5px); }
    79% { transform: translateY(0); }
  }
  @keyframes ba-yt-pulse {
    0%, 18%, 100% { transform: scale(1); }
    28% { transform: scale(1.48); }
    36% { transform: scale(1); }
    44% { transform: scale(1.28); }
    52% { transform: scale(1); }
  }

  @media (min-width: 768px) {
    .ba {
      --ba-pad: 2.5rem;
    }
    .ba__sticky {
      padding-top: 4.5rem;
      padding-bottom: 4.5rem;
    }
    .ba__h {
      font-size: 40px;
    }
    .ba__sub {
      font-size: 18px;
    }
    .ba__quote {
      margin-top: -0.35rem;
      margin-bottom: 0.85rem;
      font-size: 15px;
    }
    .ba__row-text {
      font-size: 15px;
    }
    .ba__left {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1rem;
    }
    .ba__row-title {
      font-size: 20px;
    }
  }
  @media (min-width: 1280px) {
    .ba {
      --ba-pad: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .ba__sticky {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
    .ba__grid {
      display: grid;
      grid-template-columns: 1fr 1.25fr 1.25fr;
      gap: 0;
      max-width: var(--ba-max);
      padding-left: var(--ba-pad);
      padding-right: var(--ba-pad);
    }
    .ba__right {
      display: flex;
      flex-direction: column;
      background: #fff;
    }
    .ba__head,
    .ba__left,
    .ba__ph,
    .ba__cap,
    .ba__quote,
    .ba__cap-meta {
      order: 0;
      grid-row: auto;
      grid-column: auto;
    }
    .ba__left {
      grid-column: 1;
      position: relative;
      z-index: 0;
      background: #f1f1f1;
    }
    .ba__right {
      grid-column: 2 / -1;
      position: relative;
      z-index: 0;
    }
    .ba__left::before,
    .ba__right::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      width: 100vw;
      pointer-events: none;
      z-index: -1;
    }
    .ba__left::before {
      right: 100%;
      background: #f1f1f1;
    }
    .ba__right::before {
      left: 100%;
      background: #fff;
    }
    .ba__cap {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    :global(.ba__br) {
      display: none;
    }
    .ba__left {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0;
    }
    .ba__head {
      padding-bottom: 0;
    }
    .ba__h {
      font-size: clamp(50px, 4.2vw, 58px);
      line-height: 0.92;
      letter-spacing: -0.04em;
    }
    .ba__sub {
      margin: 0.75rem 0 0;
      max-width: none;
      font-size: 20px;
      font-weight: 600;
      line-height: 1.3;
      letter-spacing: -0.015em;
      color: inherit;
    }
    .ba__sub-arrow {
      display: inline-block;
    }
    .ba__quote-more {
      display: none;
    }
    .ba__row {
      display: grid;
      grid-template-columns: 40px 1fr;
      align-content: start;
      column-gap: 1.1rem;
      row-gap: 0.5rem;
      padding: 1.5rem 0;
      background: none;
      border: 0;
      border-top: 1px solid var(--ba-hair);
      box-shadow: none;
    }
    .ba__row:last-child {
      border-bottom: 1px solid var(--ba-hair);
    }
    .ba__icon {
      display: flex;
      width: 40px;
      height: 40px;
      margin-top: 4px;
    }
    .ba__icon svg {
      width: 40px;
      height: 40px;
    }
    .ba__row-title {
      font-size: 26px;
      line-height: 1.1;
    }
    .ba__row-text {
      grid-column: 2;
      max-width: 44ch;
      font-size: 15px;
      line-height: 1.55;
    }
    .ba__quote {
      margin: 0;
      max-width: 30ch;
      padding-left: 0;
      border-left: 0;
      font-size: 28px;
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: inherit;
    }
    .ba__shade {
      display: none;
    }
    .ba__cap-meta {
      z-index: auto;
      align-self: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0;
      pointer-events: auto;
    }
    .ba__ep {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem;
      font-size: 11px;
      letter-spacing: 0.1em;
      line-height: 1.35;
      text-transform: uppercase;
      color: rgba(0, 0, 0, 0.55);
      text-shadow: none;
    }
    .ba__ep-kicker {
      font-size: inherit;
      letter-spacing: inherit;
      color: inherit;
    }
    .ba__ep-dot {
      display: inline;
    }
    .ba__ep-title {
      font-size: inherit;
    }
    .ba__pill {
      display: none;
    }
    .ba__yt {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      max-width: min(22rem, 42vw);
      padding: 10px 14px 10px 10px;
      background: rgba(255, 255, 255, 0.86);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(0, 0, 0, 0.08);
      text-decoration: none;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }
    .ba__yt:hover {
      background: rgba(255, 255, 255, 0.96);
      transform: translateY(-1px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
    }
    .ba__yt-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      flex-shrink: 0;
      background: #fff;
      border: 1px solid rgba(0, 0, 0, 0.06);
    }
    .ba__yt-icon svg {
      width: 16px;
      height: 11px;
      transform-origin: 50% 50%;
      animation: ba-yt-pulse 2.4s ease-in-out infinite;
    }
    .ba__yt:hover .ba__yt-icon svg {
      animation: none;
      transform: scale(1.28);
    }
    .ba__yt-copy {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }
    .ba__yt-kicker {
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(0, 0, 0, 0.42);
      line-height: 1;
    }
    .ba__yt-title {
      font-size: 13px;
      font-weight: 500;
      color: #000;
      line-height: 1.25;
    }
  }
  @media (min-width: 1280px) {
    .ba__quote {
      font-size: 32px;
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .ba {
      scroll-margin-top: calc(-1 * var(--nav-h));
    }
    .ba__track {
      position: relative;
      height: calc(100vh + 250vh);
    }
    .ba__sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
      padding: 0;
    }
    .ba__grid {
      position: absolute;
      inset: 0;
      box-sizing: border-box;
      display: grid;
      grid-template-columns: 1fr 1.25fr 1.25fr;
      gap: 0;
      grid-template-rows: minmax(0, 1fr);
      max-width: var(--ba-max);
