<script>
  function initBuyersAgentScroll() {
    const sec = document.querySelector<HTMLElement>('[data-ba]');
    if (!sec) return;
    const state = sec as HTMLElement & { _baCleanup?: () => void };
    if (state._baCleanup) state._baCleanup();

    const track = sec.querySelector<HTMLElement>('[data-ba-track]')!;
    const sticky = sec.querySelector<HTMLElement>('[data-ba-sticky]')!;
    const ph = sec.querySelector<HTMLElement>('[data-ba-ph]')!;
    const box = sec.querySelector<HTMLElement>('[data-ba-video]')!;
    const media = sec.querySelector<HTMLVideoElement>('[data-ba-media]')!;
    const play = sec.querySelector<HTMLAnchorElement>('[data-ba-play]')!;
    const rows = [...sec.querySelectorAll<HTMLElement>('[data-ba-row]')];
    const mq = window.matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hero = sec.classList.contains('ba--hero');

    const poster = sec.querySelector<HTMLElement>('[data-ba-poster]')!;
    const left = sec.querySelector<HTMLElement>('[data-ba-left]')!;
    const head = sec.querySelector<HTMLElement>('[data-ba-head]')!;

    media.muted = true;
    media.controls = false;

    let wantPlay = false;
    let inView = false;

    const setPlaying = (on: boolean) => {
      if (on === wantPlay) return;
      wantPlay = on;
      if (!on) {
        media.pause();
        box.classList.remove('is-playing');
        return;
      }
      const src = media.dataset.src;
      if (src && media.getAttribute('src') !== src) media.setAttribute('src', src);
      media.play().catch(() => {});
    };

    const onPlaying = () => {
      if (!wantPlay) {
        media.pause();
        return;
      }
      box.classList.add('is-playing', 'has-played');
    };
    media.addEventListener('playing', onPlaying);

    const near = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const src = media.dataset.src;
          if (src && media.getAttribute('src') !== src) {
            media.setAttribute('src', src);
            media.preload = 'auto';
          }
        });
      },
      { rootMargin: '300px 0px' }
    );
    near.observe(sec);

    const view = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          inView = entry.isIntersecting;
          if (!mq.matches) setPlaying(inView && !reduced);
        });
      },
      { threshold: 0.6 }
    );
    view.observe(ph);

    const icons = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        rows.forEach((row) => row.classList.add('is-in'));
        icons.disconnect();
      },
      { threshold: 0.12 }
    );
    icons.observe(sec);

    const openEpisode = () => {
      window.open(play.href, '_blank', 'noopener,noreferrer');
    };

    const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
    const smoothstep = (t: number) => t * t * (3 - 2 * t);
    const DWELL = 0.35;
    const STEP = 0.35;
    const STEPS_END = DWELL + STEP * rows.length;
    const EXPAND = 0.75;
    let raf = 0;
    let k = 0;
    let pinSplit = false;
    let catchArmed = true;
    let eatingUntil = 0;
    let lastWheelAt = 0;
    let gestureFromHero = false;
    let activeIdx = -2;

    const dockY = () => Math.round(track.getBoundingClientRect().top + window.scrollY);

    const setInstantScroll = (on: boolean) => {
      document.documentElement.style.scrollBehavior = on ? 'auto' : '';
    };

    const pinDock = () => {
      setInstantScroll(true);
      const y = dockY();
      const root = document.scrollingElement || document.documentElement;
      root.scrollTop = y;
      window.scrollTo({ top: y, behavior: 'auto' });
      snapSplit();
    };

    const catchDock = (now: number) => {
      catchArmed = false;
      eatingUntil = now + 320;
      pinDock();
    };

    const snapSplit = () => {
      pinSplit = true;
      sec.classList.add('is-split', 'is-split-snap');
    };

    const setActive = (i: number) => {
      if (i === activeIdx) return;
      activeIdx = i;
      sec.classList.toggle('is-stepping', i >= 0);
      rows.forEach((row, n) => row.classList.toggle('is-active', n === i));
    };

    const openExpanded = () => {
      catchArmed = false;
      eatingUntil = 0;
      snapSplit();
      setInstantScroll(true);
      const y = dockY() + Math.round((window.innerHeight || 1) * (STEPS_END + EXPAND + 0.12));
      const root = document.scrollingElement || document.documentElement;
      root.scrollTop = y;
      window.scrollTo({ top: y, behavior: 'auto' });
      req();
      requestAnimationFrame(() => setInstantScroll(false));
    };

    const onBox = (event: Event) => {
      event.preventDefault();
      if (mq.matches && k < 0.8) {
        openExpanded();
        return;
      }
      openEpisode();
    };
    const onBoxKey = (event: KeyboardEvent) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      onBox(event);
    };
    if (!hero) {
      box.addEventListener('click', onBox);
      box.addEventListener('keydown', onBoxKey);
    }

    const onWheel = (event: WheelEvent) => {
      if (!mq.matches || hero) return;
      const now = performance.now();
      const vh = window.innerHeight || 1;
      const p = -track.getBoundingClientRect().top / vh;
      let dy = event.deltaY;
      if (event.deltaMode === 1) dy *= 16;
      else if (event.deltaMode === 2) dy *= vh;

      if (now < eatingUntil) {
        if (dy > 0) {
          event.preventDefault();
          pinDock();
          eatingUntil = now + 200;
        } else {
          eatingUntil = 0;
        }
        req();
        return;
      }

      const isNew = now - lastWheelAt > 140;
      lastWheelAt = now;
      if (isNew) gestureFromHero = p < 0;

      if (catchArmed && gestureFromHero && dy > 0 && p > -0.55 && p < 0.12) {
        const projected = p + dy / vh;
        if (projected > 0.28) {
          event.preventDefault();
          catchDock(now);
          req();
        }
      }
    };

    const onKonceptClick = (event: Event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('a[href="#koncept"]')) return;
      if (!mq.matches || hero) return;
      event.preventDefault();
      catchArmed = false;
      eatingUntil = performance.now() + 240;
      snapSplit();
      pinDock();
      if (location.hash !== '#koncept') history.pushState(null, '', '#koncept');
    };

    const onHash = () => {
      if (location.hash === '#koncept' && mq.matches && !hero) {
        catchArmed = false;
        snapSplit();
      }
    };

    document.addEventListener('click', onKonceptClick, true);
    window.addEventListener('hashchange', onHash);
    window.addEventListener('wheel', onWheel, { passive: false });
    if (location.hash === '#koncept') onHash();

    const reset = () => {
      [box, media, poster, left, head].forEach((el) => el.removeAttribute('style'));
      sec.classList.remove('is-expanded', 'is-split', 'is-split-snap', 'is-stepping');
      rows.forEach((row) => row.classList.remove('is-active'));
      k = 0;
      pinSplit = false;
      catchArmed = true;
      eatingUntil = 0;
      activeIdx = -2;
      setInstantScroll(false);
    };

    const frame = (now: number) => {
      raf = 0;
      if (!mq.matches || hero) {
        reset();
        setPlaying(inView && !reduced);
        return;
      }
      const vh = window.innerHeight;
      const t = track.getBoundingClientRect();
      const p = -t.top / vh;
      if (p < -0.35) catchArmed = true;
      if (catchArmed && p > 0.28) catchDock(now);
      else if (p >= 0) catchArmed = false;
      if (now < eatingUntil) pinDock();
      else setInstantScroll(false);
      if (p >= 0 || p < -0.5) pinSplit = false;
      const wantSplit = pinSplit || p >= -0.2;
      sec.classList.toggle('is-split', wantSplit);
      sec.classList.toggle('is-split-snap', pinSplit || p >= 0);

      if (now < eatingUntil || p < DWELL) {
        setActive(-1);
        k = 0;
      } else if (p < STEPS_END) {
        setActive(Math.min(rows.length - 1, Math.floor((p - DWELL) / STEP)));
        k = 0;
      } else {
        setActive(-1);
        k = smoothstep(clamp01((p - STEPS_END) / EXPAND));
      }

      const lerp = (a: number, b: number) => a + (b - a) * k;
      const s = sticky.getBoundingClientRect();
      const q = ph.getBoundingClientRect();
      box.style.left = lerp(0, s.left - q.left) + 'px';
      box.style.top = lerp(0, s.top - q.top) + 'px';
      box.style.width = lerp(q.width, s.width) + 'px';
      box.style.height = lerp(q.height, s.height) + 'px';
      media.style.transform = `scale(${1.08 - 0.08 * k})`;

      const fade = Math.max(0, 1 - k * 1.6);
      left.style.opacity = String(fade);
      left.style.transform = `translateX(${-48 * k}px)`;
      head.style.opacity = String(fade);
      head.style.transform = `translateY(${-36 * k}px)`;

      const covering = s.top <= 1 && s.bottom >= vh - 1;
      setPlaying(covering && p >= 0 && now >= eatingUntil);
      const expanded = k > 0.8 && covering;
      sec.classList.toggle('is-expanded', expanded);
      box.setAttribute(
        'aria-label',
        expanded ? 'Přehrát díl na YouTube' : 'Zobrazit video na celou obrazovku'
      );

      if (now < eatingUntil) req();
    };

    const resize = new ResizeObserver(() => req());
    resize.observe(ph);

    function req() {
      if (!raf) raf = requestAnimationFrame(frame);
    }
    window.addEventListener('scroll', req, { passive: true });
    window.addEventListener('resize', req);
    mq.addEventListener('change', req);
    req();

    state._baCleanup = () => {
      near.disconnect();
      view.disconnect();
      icons.disconnect();
      resize.disconnect();
      media.removeEventListener('playing', onPlaying);
      box.removeEventListener('click', onBox);
      box.removeEventListener('keydown', onBoxKey);
      document.removeEventListener('click', onKonceptClick, true);
      window.removeEventListener('hashchange', onHash);
      window.removeEventListener('wheel', onWheel);
      window.removeEventListener('scroll', req);
      window.removeEventListener('resize', req);
      mq.removeEventListener('change', req);
      if (raf) cancelAnimationFrame(raf);
      state._baCleanup = undefined;
    };
  }

  initBuyersAgentScroll();
  document.addEventListener('astro:page-load', initBuyersAgentScroll);
</script>
