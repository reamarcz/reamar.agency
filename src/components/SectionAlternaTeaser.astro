<section class="alterna-teaser" data-alterna-teaser>
  <a href="/alterna" class="alterna-teaser__link" aria-label="Reference Alterna Sluštice">
    <img
      src="/images/Alterna/alternaslustice.webp"
      alt="Alterna Sluštice"
      class="alterna-teaser__bg"
      width="1920"
      height="560"
      loading="lazy"
      decoding="async"
    />
    <div class="alterna-teaser__overlay" aria-hidden="true"></div>
    <div class="alterna-teaser__inner">
      <div class="alterna-teaser__content">
        <p class="alterna-teaser__kicker">Reference</p>
        <h2 class="alterna-teaser__title">
          Cesta k nejprodávanějším<br />
          rodinným domům<br />
          v Praze a okolí
        </h2>
        <span class="alterna-teaser__read">Přečíst</span>
      </div>
      <img
        src="/images/Alterna/Alterna%20logo.svg"
        alt="Alterna"
        class="alterna-teaser__logo"
        width="120"
        height="30"
        loading="lazy"
        decoding="async"
      />
    </div>
  </a>
</section>

<style>
  .alterna-teaser {
    width: 100%;
    background: #000;
  }
  .alterna-teaser__link {
    position: relative;
    display: block;
    width: 100%;
    height: 450px;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
  }
  .alterna-teaser__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1);
    transition: transform 0.45s ease;
  }
  .alterna-teaser__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0.18) 100%);
  }
  .alterna-teaser__inner {
    position: relative;
    z-index: 1;
    height: 100%;
    width: min(90%, 1280px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .alterna-teaser__content {
    color: #fff;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .alterna-teaser__kicker {
    margin: 0 0 0.35rem;
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.78);
  }
  .alterna-teaser__title {
    margin: 0;
    font-family: inherit;
    font-size: clamp(1rem, 2.2vw, 1.4rem);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .alterna-teaser__read {
    display: inline-block;
    margin-top: 0.65rem;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.88);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .alterna-teaser__logo {
    width: auto;
    height: 22px;
    flex-shrink: 0;
    align-self: flex-end;
    margin-bottom: 1.8rem;
    filter: brightness(0) invert(1);
    opacity: 0.95;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.12s, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.12s;
  }
  .alterna-teaser__link:hover .alterna-teaser__bg {
    transform: scale(1.025);
  }
  .alterna-teaser__link:hover .alterna-teaser__read {
    transform: translateX(2px);
  }
  .alterna-teaser__read {
    transition: transform 0.22s ease;
  }
  .alterna-teaser.is-visible .alterna-teaser__content,
  .alterna-teaser.is-visible .alterna-teaser__logo {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 767px) {
    .alterna-teaser__link {
      height: 310px;
    }
    .alterna-teaser__title {
      font-size: 1.08rem;
    }
    .alterna-teaser__logo {
      height: 18px;
      margin-bottom: 1.2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .alterna-teaser__bg,
    .alterna-teaser__content,
    .alterna-teaser__logo,
    .alterna-teaser__read {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  function initAlternaTeaserReveal() {
    var section = document.querySelector('[data-alterna-teaser]');
    if (!section) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      section.classList.add('is-visible');
      return;
    }
    var obs = new IntersectionObserver(function(entries) {
      if (!entries[0].isIntersecting) return;
      section.classList.add('is-visible');
      obs.disconnect();
    }, { threshold: 0.2 });
    obs.observe(section);
  }

  initAlternaTeaserReveal();
  document.addEventListener('astro:page-load', initAlternaTeaserReveal);
</script>
