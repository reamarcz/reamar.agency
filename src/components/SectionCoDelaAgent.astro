---
/**
 * Co pro vás dělá agent — „Honza píše“.
 * Desktop ≥1024: chat vlevo, vertikální video Honzy vpravo.
 *   Jeden klip na scénář, přepne se při jeho startu.
 * Mobil: jen chat (bez videa).
 * Zprávy mají rezervované místo od začátku (visibility), výška chatu
 * podle nejdelšího scénáře, takže sekce při přehrávání neposkakuje.
 * Bez JS / s reduced motion je vidět celý první scénář.
 */
interface Props {
  title?: string;
  agentName?: string;
  avatarSrc?: string;
  ctaLabel?: string;
}

const {
  title = 'Zkušenosti, které při nákupu oceníte.',
  agentName = 'Honza Vitvera',
  avatarSrc = '/images/agency/profilovka_cista_svetle_seda_1080.jpg',
  ctaLabel = 'Napsat',
} = Astro.props;

type Msg = { text: string; me?: boolean };
type Pace = { read: number; dots: number; scene: number };
type Scenario = { id: string; label: string; clip: number; msgs: Msg[]; pace: Pace };

const scenarios: Scenario[] = [
  {
    id: 'vyjednavani',
    label: 'Vyjednávání',
    clip: 0,
    pace: { read: 1400, dots: 1300, scene: 4200 },
    msgs: [
      { text: 'Pane Dvořáku, u toho 4+kk v Karlíně jsem s developerem domluvil slevu 4 %.' },
      { text: 'Podmínkou je podpis smlouvy do 14 dnů. Je to poslední byt v projektu, developer ho chce prodat.' },
      { text: 'To je přes půl milionu?', me: true },
      { text: 'Přesně tak. Mám připravit rezervaci?' },
    ],
  },
  {
    id: 'predprodej',
    label: 'Předprodej',
    clip: 1,
    pace: { read: 1600, dots: 1000, scene: 3800 },
    msgs: [
      { text: 'Na Praze 5 teď řeším s developery tři projekty, které jdou do prodeje až na jaře.' },
      { text: 'Protože k nim přivádíme víc kupujících, dostanou naši klienti zvýhodněné podmínky. Zařadil jsem vás na priority list.' },
      { text: 'Takže to uvidím dřív než ostatní?', me: true },
      { text: 'Jako jeden z prvních.' },
    ],
  },
  {
    id: 'provereni',
    label: 'Prověření',
    clip: 2,
    pace: { read: 1300, dots: 1300, scene: 4000 },
    msgs: [
      { text: 'K projektu, který jste posílal: developer měl u posledních dvou projektů víc než roční skluz.' },
      { text: 'Byt je hezký, ale tady bych byl opatrný. Ve stejné lokalitě mám dvě lepší alternativy.' },
      { text: 'Dobře, že to vím teď. Pošlete mi je?', me: true },
    ],
  },
  {
    id: 'prohlidka',
    label: 'Prohlídka',
    clip: 3,
    pace: { read: 1200, dots: 1000, scene: 3600 },
    msgs: [
      { text: 'Pane Vitvero, teď opravdu nemám čas na prohlídky.', me: true },
      { text: 'Nevadí. Zítra tam jedu s kameramanem, všechno vám natočíme a pošlu.' },
      { text: 'Ukážu vám i to, co na vizualizacích vidět není.' },
      { text: 'Přesně tohle potřebuju.', me: true },
    ],
  },
];

const clips = [
  { src: '/videos/agent-office.mp4', poster: '/videos/agent-office-poster.jpg' },
];
---

<section class="cda bg-white text-black font-yellix font-medium" aria-labelledby="cda-title" data-cda>
  <div class="cda-in">
    <div class="cda-layout">
      <div class="cda-copy">
        <p class="cda-kicker">Co pro vás řešíme</p>
        <h2 id="cda-title">{title}</h2>

        <div class="cda-chat" data-cda-chat>
          <div class="cda-who">
            <img src={avatarSrc} alt="" width="44" height="44" loading="lazy" decoding="async" />
            <div class="cda-who-id">
              <b>{agentName}</b>
              <span class="cda-status" data-cda-status>váš agent · online</span>
            </div>
            <div class="cda-tabs" role="tablist" aria-label="Scénáře z praxe">
              {
                scenarios.map((s, i) => (
                  <button
                    type="button"
                    class="cda-tab"
                    role="tab"
                    id={`cda-tab-${s.id}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    aria-controls="cda-panel"
                    data-cda-tab={String(i)}
                  >
                    {s.label}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="cda-tab-progress" aria-hidden="true"><span data-cda-fill></span></div>

          <div class="cda-panel" id="cda-panel" role="tabpanel" aria-labelledby="cda-tab-vyjednavani" data-cda-slot>
            {
              scenarios.map((s, si) => (
                <ol
                  class="cda-msgs"
                  data-cda-msgs={String(si)}
                  data-clip={String(s.clip)}
                  data-read={String(s.pace.read)}
                  data-dots={String(s.pace.dots)}
                  data-scene={String(s.pace.scene)}
                  hidden={si !== 0}
                  aria-live={si === 0 ? 'polite' : undefined}
                >
                  {
                    s.msgs.map((m, i) => (
                      <li class:list={['cda-m', m.me && 'cda-m--me', si === 0 && i === 0 && 'is-in']} data-cda-msg>
                        <p class="cda-bubble">{m.text}</p>
                      </li>
                    ))
                  }
                </ol>
              ))
            }
          </div>
          <span class="cda-dots" data-cda-dots aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
      </div>

      <div class="cda-stage">
      <figure class="cda-media" aria-hidden="true" data-cda-media>
        {
          clips.map((c, i) => (
            <div class:list={['cda-slide', i === 0 && 'is-on']} data-cda-slide>
              <img src={c.poster} alt="" width="720" height="1280" loading="lazy" decoding="async" />
              <video
                src={c.src}
                poster={c.poster}
                muted
                loop
                playsinline
                webkit-playsinline="true"
                preload="auto"
                disablepictureinpicture
                disableremoteplayback
              />
            </div>
          ))
        }
        <div class="cda-shade"></div>
        <figcaption>
          <b>Jan Vitvera</b>
          <span>agent pro kupující</span>
        </figcaption>
      </figure>
      <a
        class="cda-cta cda-cta--form"
        href="#poptavka"
        data-cda-cta
      >
        <img src="/images/arrow-1.svg" alt="" width="12" height="12" />
        {ctaLabel}<span class="cda-cta-name"> Honzovi</span>
      </a>
      <a
        class="cda-cta cda-cta--wa"
        href="https://wa.me/420607066044?text=Dobr%C3%BD%20den%2C%20m%C3%A1m%20z%C3%A1jem%20o%20konzultaci."
        target="_blank"
        rel="noopener noreferrer"
        data-cda-cta
        data-track="whatsapp"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.98.53 3.9 1.54 5.6L2 22l4.72-1.55a9.9 9.9 0 0 0 5.32 1.55h.01c5.46 0 9.89-4.4 9.89-9.83C21.94 6.4 17.5 2 12.04 2zm5.77 13.98c-.24.68-1.4 1.25-1.94 1.33-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.26-4.79-4.2-4.93-4.4-.14-.2-1.16-1.54-1.16-2.94 0-1.4.73-2.09 1-2.37.26-.28.57-.35.76-.35h.55c.17 0 .41-.07.64.49.24.57.81 1.98.88 2.12.07.14.12.31.02.5-.1.2-.15.32-.3.49-.14.17-.3.38-.43.51-.14.14-.29.29-.12.57.16.28.72 1.19 1.55 1.93 1.07.95 1.97 1.24 2.25 1.38.28.14.44.12.6-.07.17-.2.7-.81.89-1.09.19-.28.38-.23.64-.14.26.1 1.66.78 1.94.93.28.14.47.21.54.33.07.12.07.69-.17 1.37z"></path>
        </svg>
        {ctaLabel}<span class="cda-cta-name"> Honzovi</span>
      </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cda-in {
    max-width: 1180px;
    margin: 0 auto;
    padding: 56px 20px 64px;
  }
  .cda-layout {
    display: block;
  }

  .cda-kicker {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
    line-height: 1;
  }
  .cda h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* ---------- chat ---------- */
  .cda-chat {
    position: relative;
    margin-top: 24px;
  }
  .cda-tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-end;
    margin-left: auto;
  }
  .cda-tab {
    padding: 0;
    border: 0;
    background: none;
    color: rgba(0, 0, 0, 0.38);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    white-space: nowrap;
    cursor: pointer;
  }
  .cda-tab + .cda-tab {
    margin-left: 0.4em;
  }
  .cda-tab + .cda-tab::before {
    content: '·';
    margin-right: 0.4em;
    color: rgba(0, 0, 0, 0.28);
  }
  .cda-tab[aria-selected='true'],
  .cda-tab:hover {
    color: #000;
  }
  .cda-tab-progress {
    height: 1px;
    margin: 0 0 16px;
    background: rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }
  .cda-tab-progress span {
    display: block;
    height: 100%;
    background: #000;
    transform: scaleX(0);
    transform-origin: left;
  }
  .cda-who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
  }
  .cda-who-id {
    flex: 0 0 auto;
  }
  .cda-who img {
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 38%;
  }
  .cda-who b {
    display: block;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
  }
  .cda-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    line-height: 1.4;
    color: rgba(0, 0, 0, 0.5);
  }
  .cda-status::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16a34a;
  }

  .cda-msgs {
    list-style: none;
    margin: 0;
    padding: 16px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cda-panel {
    position: relative;
  }
  .cda-msgs[hidden] {
    display: none;
  }
  .cda-msgs.is-out {
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .cda-m {
    position: relative;
    display: flex;
  }
  .cda-m--me {
    justify-content: flex-end;
  }
  .cda-bubble {
    margin: 0;
    max-width: 86%;
    padding: 12px 14px 13px;
    border-radius: 18px 18px 18px 6px;
    background: #f1f1f1;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    transform-origin: left bottom;
  }
  .cda-bubble small {
    display: block;
    margin-bottom: 3px;
    font-size: 12px;
    letter-spacing: 0;
    color: rgba(0, 0, 0, 0.4);
  }
  .cda-m--me .cda-bubble {
    border-radius: 20px 20px 6px 20px;
    background: #2f6bed;
    color: #fff;
    font-size: 16px;
    transform-origin: right bottom;
  }

  .cda-dots {
    position: absolute;
    display: none;
    gap: 5px;
    padding: 16px 18px;
    border-radius: 20px 20px 20px 6px;
    background: #f1f1f1;
    pointer-events: none;
  }
  .cda-dots.is-on {
    display: flex;
  }
  .cda-dots.is-me {
    border-radius: 20px 20px 6px 20px;
    background: #2f6bed;
  }
  .cda-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    animation: cda-dot 1.1s infinite;
  }
  .cda-dots.is-me i {
    background: rgba(255, 255, 255, 0.75);
  }
  .cda-dots i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .cda-dots i:nth-child(3) {
    animation-delay: 0.3s;
  }

  .cda-stage {
    margin-top: 28px;
  }
  @media (max-width: 1023px) {
    .cda-kicker,
    .cda h2 {
      text-align: center;
    }
    .cda-chat {
      margin-top: 48px;
    }
    .cda-msgs {
      gap: 14px;
      padding-top: 22px;
    }
    .cda-stage {
      margin-top: 52px;
      text-align: center;
    }
  }
  @media (max-width: 640px) {
    .cda-tabs {
      flex: 1 0 100%;
      margin-left: 0;
      margin-top: 10px;
      justify-content: flex-start;
    }
  }
  .cda-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 18px;
    background: #000;
    color: #fff;
    font-size: 14px;
    line-height: 1;
    font-weight: 500;
    text-decoration: none;
  }
  .cda-cta:hover {
    opacity: 0.85;
  }
  .cda-cta img {
    display: block;
    width: 12px;
    height: 12px;
    filter: brightness(0) invert(1);
  }
  .cda-cta.cda-cta--wa {
    display: none;
  }
  .cda-cta--wa svg {
    display: block;
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }
  @media (max-width: 1023px) {
    .cda-cta.cda-cta--form {
      display: none;
    }
    .cda-cta.cda-cta--wa {
      display: inline-flex;
    }
  }

  /* Animace jen s JS — bez JS je rozhovor celý vidět. */
  .cda.is-js .cda-bubble,
  .cda.is-js .cda-cta {
    visibility: hidden;
    opacity: 0;
  }
  .cda.is-js .cda-bubble {
    transform: translateY(10px) scale(0.98);
  }
  .cda.is-js .cda-m.is-in .cda-bubble,
  .cda.is-js .cda-cta.is-in {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ---------- video (jen desktop) ---------- */
  .cda-media {
    display: none;
  }

  @media (min-width: 640px) {
    .cda-in {
      padding: 72px 40px 80px;
    }
  }

  @media (min-width: 1024px) {
    .cda-in {
      max-width: 1240px;
      padding: 152px 56px 104px;
    }
    .cda-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: 156px;
      align-items: center;
    }
    .cda h2 {
      font-size: 36px;
      line-height: 1.08;
      letter-spacing: -0.03em;
      max-width: 640px;
    }
    .cda-chat {
      margin-top: 2rem;
      max-width: 620px;
    }
    .cda-who {
      padding-bottom: 18px;
    }
    .cda-msgs {
      gap: 12px;
      padding-top: 18px;
    }
    .cda-bubble {
      max-width: 520px;
      padding: 13px 16px 14px;
      border-radius: 16px 16px 16px 5px;
      font-size: 17px;
      line-height: 1.25;
      letter-spacing: -0.015em;
    }
    .cda-m--me .cda-bubble {
      border-radius: 16px 16px 5px 16px;
      font-size: 15px;
    }
    .cda-dots {
      padding: 12px 14px;
    }

    .cda-stage {
      position: relative;
      width: 380px;
      margin-top: 0;
    }
    .cda-cta {
      position: absolute;
      left: 22px;
      bottom: 22px;
      z-index: 2;
      margin: 0;
      padding: 11px 16px;
      background: #fff;
      color: #000;
    }
    .cda-cta img {
      filter: brightness(0);
    }
    .cda-cta-name {
      display: none;
    }

    .cda-media {
      position: relative;
      display: block;
      width: 380px;
      aspect-ratio: 4 / 5;
      margin: 0;
      overflow: hidden;
      background: #111;
    }
    .cda-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.6s ease;
    }
    .cda-slide.is-on {
      opacity: 1;
    }
    .cda-slide img,
    .cda-slide video {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }
    .cda-slide video {
      opacity: 0;
      transition: opacity 0.35s ease;
    }
    .cda-slide video.is-playing {
      opacity: 1;
    }
    .cda-slide video::-webkit-media-controls-start-playback-button {
      display: none !important;
      -webkit-appearance: none;
    }
    .cda-shade {
      position: absolute;
      inset: auto 0 0;
      height: 55%;
      background: linear-gradient(0deg, rgba(0, 0, 0, 0.6), transparent);
      pointer-events: none;
    }
    .cda-media figcaption {
      position: absolute;
      left: 22px;
      right: 22px;
      bottom: 78px;
      margin: 0;
      color: #fff;
      line-height: 1.25;
    }
    .cda-media figcaption b {
      display: block;
      font-size: 17px;
      font-weight: 500;
    }
    .cda-media figcaption span {
      display: block;
      margin-top: 2px;
      font-size: 13px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.72);
    }
  }

  @media (max-width: 1100px) and (min-width: 1024px) {
    .cda-layout {
      gap: 88px;
    }
  }

  @keyframes cda-dot {
    0%,
    60%,
    100% {
      transform: none;
      opacity: 0.5;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cda-slide,
    .cda.is-js .cda-m.is-in .cda-bubble,
    .cda.is-js .cda-cta.is-in {
      transition: none;
    }
    .cda-dots i {
      animation: none;
    }
  }
</style>

<script>
  type CdaEl = HTMLElement & { _cdaCleanup?: (() => void) | null };

  const wait = (ms: number) => new Promise<void>((r) => window.setTimeout(r, ms));

  function initCdaOne(sec: CdaEl) {
    sec._cdaCleanup?.();

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = window.matchMedia('(min-width: 1024px)');
    const chat = sec.querySelector<HTMLElement>('[data-cda-chat]');
    const msgs = [...sec.querySelectorAll<HTMLElement>('[data-cda-msg]')];
    const dots = sec.querySelector<HTMLElement>('[data-cda-dots]');
    const ctas = [...sec.querySelectorAll<HTMLElement>('[data-cda-cta]')];
    const cta = ctas[0];
    const slides = [...sec.querySelectorAll<HTMLElement>('[data-cda-slide]')];
    const videos = slides.map((s) => s.querySelector('video') as HTMLVideoElement);
    if (!chat || !dots || !cta || !slides.length) return;

    const tabs = [...sec.querySelectorAll<HTMLButtonElement>('[data-cda-tab]')];
    const lists = [...sec.querySelectorAll<HTMLElement>('[data-cda-msgs]')];
    const fills = [...sec.querySelectorAll<HTMLElement>('[data-cda-fill]')];
    const slot = sec.querySelector<HTMLElement>('[data-cda-slot]');
    if (!tabs.length || !lists.length || !slot) return;

    let alive = true;
    let token = 0;
    let auto = true;
    let paused = false;
    let ctaShown = false;
    let inView = false;
    const resume: (() => void)[] = [];

    /* ---- video ---- */
    const armVideo = (v: HTMLVideoElement) => {
      const src = v.dataset.src;
      if (src && !v.getAttribute('src')) {
        v.muted = true;
        v.playsInline = true;
        v.preload = 'auto';
        v.src = src;
      }
    };
    const onPlaying = (e: Event) => (e.target as HTMLElement).classList.add('is-playing');
    const onPause = (e: Event) => (e.target as HTMLElement).classList.remove('is-playing');
    videos.forEach((v) => {
      v.addEventListener('playing', onPlaying);
      v.addEventListener('pause', onPause);
    });

    const playCurrent = () => {
      if (reduced || !desktop.matches || !inView) return;
      const v = videos[0];
      if (!v) return;
      armVideo(v);
      const p = v.play();
      if (p && typeof p.catch === 'function') p.catch(() => {}); // zablokováno → zůstane fotka
    };

    /* ---- chat ---- */
    const placeDots = (li: HTMLElement, me: boolean) => {
      const box = chat.getBoundingClientRect();
      const r = li.getBoundingClientRect();
      dots.classList.toggle('is-me', me);
      dots.classList.add('is-on');
      dots.style.top = `${r.top - box.top}px`;
      if (me) {
        dots.style.left = 'auto';
        dots.style.right = `${box.right - r.right}px`;
      } else {
        dots.style.right = 'auto';
        dots.style.left = `${r.left - box.left}px`;
      }
    };

    const showCtas = () => ctas.forEach((el) => el.classList.add('is-in'));

    const setProgress = (_index: number, value: number) => {
      const scale = `scaleX(${Math.max(0, Math.min(1, value))})`;
      fills.forEach((fill) => {
        fill.style.transform = scale;
      });
    };

    const showList = (index: number) => {
      lists.forEach((ol, i) => {
        ol.hidden = i !== index;
        if (i === index) ol.setAttribute('aria-live', 'polite');
        else ol.removeAttribute('aria-live');
      });
      tabs.forEach((tab, i) => tab.setAttribute('aria-selected', i === index ? 'true' : 'false'));
      const tab = tabs[index];
      if (tab) slot.setAttribute('aria-labelledby', tab.id);
    };

    const measure = () => {
      let max = 0;
      lists.forEach((ol) => {
        const wasHidden = ol.hidden;
        ol.hidden = false;
        ol.style.position = 'absolute';
        ol.style.left = '0';
        ol.style.right = '0';
        ol.style.visibility = 'hidden';
        max = Math.max(max, ol.offsetHeight);
        ol.style.position = '';
        ol.style.left = '';
        ol.style.right = '';
        ol.style.visibility = '';
        ol.hidden = wasHidden;
      });
      slot.style.minHeight = `${max}px`;
    };

    const SETTLE = 400;

    const paceOf = (ol: HTMLElement) => ({
      read: Number(ol.dataset.read) || 1400,
      dots: Number(ol.dataset.dots) || 1300,
      scene: Number(ol.dataset.scene) || 4200,
    });

    const duration = (ol: HTMLElement) => {
      const pace = paceOf(ol);
      return pace.read + pace.dots + SETTLE + pace.scene;
    };

    const hold = async (ms: number, my: number, clock: { pausedFor: number }) => {
      let left = ms;
      while (left > 0) {
        if (!alive || my !== token) return false;
        if (paused) {
          const mark = performance.now();
          await new Promise<void>((resolve) => resume.push(resolve));
          clock.pausedFor += performance.now() - mark;
          continue;
        }
        const slice = Math.min(80, left);
        await wait(slice);
        if (!paused) left -= slice;
      }
      return alive && my === token;
    };

    const run = async (index: number, my: number) => {
      const ol = lists[index];
      const items = [...ol.querySelectorAll<HTMLElement>('[data-cda-msg]')];
      if (!ol || !items.length) return;
      items.forEach((li) => li.classList.remove('is-in'));
      ol.classList.remove('is-out');
      dots.classList.remove('is-on');
      showList(index);
      const pre = Math.max(0, items.length - 1);
      for (let i = 0; i < pre; i += 1) items[i].classList.add('is-in');
      playCurrent();
      setProgress(index, 0);

      const pace = paceOf(ol);
      const total = duration(ol);
      const clock = { pausedFor: 0 };
      const startedAt = performance.now();
      let raf = 0;
      const tickProgress = () => {
        if (!alive || my !== token) return;
        if (!paused) {
          const elapsed = performance.now() - startedAt - clock.pausedFor;
          setProgress(index, elapsed / total);
        }
        raf = window.requestAnimationFrame(tickProgress);
      };
      raf = window.requestAnimationFrame(tickProgress);
      const stopProgress = () => window.cancelAnimationFrame(raf);

      if (!(await hold(pace.read, my, clock))) {
        stopProgress();
        return;
      }
      const last = items[items.length - 1];
      if (last) {
        placeDots(last, last.classList.contains('cda-m--me'));
        if (!(await hold(pace.dots, my, clock))) {
          stopProgress();
          return;
        }
        dots.classList.remove('is-on');
        last.classList.add('is-in');
        if (!(await hold(SETTLE, my, clock))) {
          stopProgress();
          return;
        }
      }
      if (!ctaShown) {
        ctaShown = true;
        showCtas();
      }
      if (!auto) {
        setProgress(index, 1);
        stopProgress();
        return;
      }
      if (!(await hold(pace.scene, my, clock))) {
        stopProgress();
        return;
      }
      setProgress(index, 1);
      stopProgress();
      ol.classList.add('is-out');
      if (!(await hold(250, my, clock))) return;
      ol.classList.remove('is-out');
      if (alive && my === token && auto) run((index + 1) % lists.length, my);
    };

    const wake = () => {
      const queued = resume.splice(0);
      queued.forEach((resolve) => resolve());
    };

    if (!reduced) sec.classList.add('is-js');
    measure();

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        if (reduced) {
          showList(index);
          return;
        }
        auto = false;
        token += 1;
        dots.classList.remove('is-on');
        lists.forEach((ol) => ol.classList.remove('is-out'));
        wake();
        run(index, token);
      });
    });

    let started = false;
    const startIo = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting || started) return;
        started = true;
        startIo.disconnect();
        if (reduced) return;
        token = 1;
        run(0, token);
      },
      { threshold: 0.3 },
    );
    startIo.observe(chat);

    /* video hraje jen v obraze, rozepsaný scénář se pozastaví */
    const viewIo = new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        paused = started && !inView;
        if (inView) {
          wake();
          playCurrent();
        } else videos.forEach((v) => v.pause());
      },
      { threshold: 0.15 },
    );
    viewIo.observe(sec);

    const onVisibility = () => {
      if (document.hidden) videos.forEach((v) => v.pause());
      else playCurrent();
    };
    const onResize = () => measure();
    document.addEventListener('visibilitychange', onVisibility);
    window.addEventListener('resize', onResize);

    sec._cdaCleanup = () => {
      alive = false;
      token += 1;
      wake();
      startIo.disconnect();
      viewIo.disconnect();
      document.removeEventListener('visibilitychange', onVisibility);
      window.removeEventListener('resize', onResize);
      videos.forEach((v) => {
        v.pause();
        v.removeEventListener('playing', onPlaying);
        v.removeEventListener('pause', onPause);
      });
      sec._cdaCleanup = null;
    };
  }

  function initCda() {
    document.querySelectorAll<HTMLElement>('[data-cda]').forEach((el) => initCdaOne(el as CdaEl));
  }

  initCda();
  document.addEventListener('astro:page-load', initCda);
</script>
