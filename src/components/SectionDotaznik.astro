---
const href = 'https://www.reamar-konzultace.cz/c/dotaznik';
const total = '9\u00a0689';
const check = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12.5 10 17l9-10"/></svg>`;

const panels = [
  {
    delay: '0s',
    kicker: 'Otázka 1 ze 4 · Rozpočet',
    title: 'Kolik můžete investovat?',
    options: ['do 6 mil. Kč', '6–9 mil. Kč', '9–12 mil. Kč', 'nad 12 mil. Kč'],
    selected: [2],
  },
  {
    delay: '3s',
    kicker: 'Otázka 2 ze 4 · Dispozice',
    title: 'Jakou dispozici hledáte?',
    options: ['1+kk', '2+kk', '3+kk', '4+kk a víc'],
    selected: [2],
  },
  {
    delay: '6s',
    kicker: 'Otázka 3 ze 4 · Lokalita',
    title: 'Kde chcete bydlet?',
    options: ['Praha 4', 'Praha 9', 'Praha 10', 'Okolí Prahy'],
    selected: [1],
  },
  {
    delay: '9s',
    kicker: 'Otázka 4 ze 4 · Standardy',
    title: 'Co je pro vás důležité?',
    options: ['Terasa / balkon', 'Parkování', 'Sklep', 'Výtah'],
    selected: [0, 1],
  },
];

const counts = [
  { n: '4\u00a0210', delay: '0s' },
  { n: '1\u00a0120', delay: '3s' },
  { n: '310', delay: '6s' },
  { n: '146', delay: '9s' },
];
---

<section class="sq" id="dotaznik" aria-labelledby="dotaznik-heading">
  <div class="wrap">
    <div class="l">
      <span class="k font-yellix">Aktuální nabídka v Praze a okolí</span>
      <h2 id="dotaznik-heading" class="font-yellix">Kolik bytů odpovídá vaší představě?</h2>
      <p class="font-yellix">
        Čtyři krátké otázky: rozpočet, dispozice, lokalita a standardy. Na konci hned uvidíte, kolik jednotek a projektů vám odpovídá.
      </p>
      <a class="go font-yellix" href={href}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M6 3h9l4 4v14H6z"/>
          <path d="M15 3v4h4M9 12h7M9 16h7"/>
        </svg>
        Zadat preference
      </a>
      <span class="t font-yellix">Zabere přibližně 3 minuty. Výsledek uvidíte hned.</span>
    </div>

    <div class="card font-yellix" data-dotaznik-card aria-hidden="true">
      <div class="top">
        <div class="bar">
          <i class="sg s0"></i>
          <i class="sg s1"></i>
          <i class="sg s2"></i>
          <i class="sg s3"></i>
        </div>
        <span class="cnt">
          <span class="cn0">{total}</span>
          {counts.map((c) => (
            <span class="cn" style={`animation-delay:${c.delay}`}>{c.n}</span>
          ))}
          <em>bytů</em>
        </span>
      </div>

      <div class="stage">
        {panels.map((panel) => (
          <div class="pn" style={`animation-delay:${panel.delay}`}>
            <small>{panel.kicker}</small>
            <b>{panel.title}</b>
            <div class="ops" style={`--d:${panel.delay}`}>
              {panel.options.map((opt, i) => (
                <span class:list={['op', panel.selected.includes(i) && 'sel']}>
                  <i set:html={check} />
                  {opt}
                </span>
              ))}
            </div>
          </div>
        ))}
        <div class="pn res" style="animation-delay:12s">
          <small>Výsledek</small>
          <b class="rN">146 <span>bytů</span></b>
          <p>ve 38 projektech odpovídá vaší představě</p>
        </div>
      </div>
      <span class="demo">Ukázka</span>
    </div>
  </div>
</section>

<style>
  .sq {
    background: #fff;
    padding: 72px 0;
    color: #000;
    -webkit-font-smoothing: antialiased;
  }
  .sq,
  .sq * {
    box-sizing: border-box;
  }
  .wrap {
    width: auto;
    max-width: 1080px;
    margin: 0 20px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }
  .k {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.5);
  }
  h2 {
    margin: 16px 0 18px;
    font-size: 34px;
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 500;
  }
  .l p {
    margin: 0 0 30px;
    font-size: 16px;
    line-height: 1.55;
    color: rgba(0, 0, 0, 0.65);
    max-width: 40ch;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 46px;
    padding: 0 20px 0 18px;
    font-size: 15px;
    font-weight: 500;
    background: #000;
    color: #fff;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .go:hover {
    opacity: 0.85;
  }
  .t {
    display: block;
    margin-top: 12px;
    font-size: 13px;
    color: rgba(0, 0, 0, 0.5);
  }

  .card {
    position: relative;
    border: 1px solid rgba(0, 0, 0, 0.14);
    padding: 22px 20px 26px;
    background: #fff;
    pointer-events: none;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  .bar {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .sg {
    display: block;
    height: 3px;
    background: rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
  }
  .sg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #032d20;
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .cnt {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    min-width: 120px;
    justify-content: flex-end;
    font-variant-numeric: proportional-nums;
  }
  .cnt span {
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .cnt em {
    font-style: normal;
    font-size: 13px;
    color: rgba(0, 0, 0, 0.5);
  }
  .cn {
    position: absolute;
    right: 38px;
    opacity: 0;
    background: #fff;
    min-width: 80px;
    text-align: right;
  }
  .stage {
    position: relative;
    height: 240px;
    margin-top: 24px;
  }
  .pn {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .pn small {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
  }
  .pn > b {
    display: block;
    margin: 10px 0 20px;
    font-weight: 500;
    font-size: 21px;
    letter-spacing: -0.025em;
  }
  .ops {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    animation-delay: var(--d);
  }
  .op {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border: 1px solid rgba(0, 0, 0, 0.14);
    font-size: 14px;
  }
  .op i {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border: 1px solid rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: transparent;
  }
  .res .rN {
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 16px 0 10px;
    font-variant-numeric: proportional-nums;
  }
  .res .rN span {
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .res p {
    margin: 0;
    font-size: 16px;
    color: rgba(0, 0, 0, 0.6);
  }
  .demo {
    position: absolute;
    right: 16px;
    bottom: 12px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.35);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pn {
      animation: pn 15s infinite both;
    }
    .op.sel {
      animation: sel 15s infinite both;
      animation-delay: inherit;
    }
    .op.sel i {
      animation: seli 15s infinite both;
      animation-delay: inherit;
    }
    .cn {
      animation: cn 15s infinite both;
    }
    .cn0 {
      animation: cn0 15s infinite both;
    }
    .s0::after {
      animation: f0 15s infinite both;
    }
    .s1::after {
      animation: f1 15s infinite both;
    }
    .s2::after {
      animation: f2 15s infinite both;
    }
    .s3::after {
      animation: f3 15s infinite both;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .res {
      opacity: 1;
    }
    .sg::after {
      transform: scaleX(1);
    }
    .cn0 {
      opacity: 0;
    }
    .cn {
      opacity: 0;
    }
    .cnt .cn:last-of-type {
      opacity: 1;
    }
  }

  @keyframes pn {
    0% { opacity: 0; transform: translateX(24px); }
    3% { opacity: 1; transform: none; }
    17% { opacity: 1; transform: none; }
    20% { opacity: 0; transform: translateX(-24px); }
    100% { opacity: 0; }
  }
  @keyframes sel {
    0%, 8% { background: #fff; color: #000; border-color: rgba(0, 0, 0, 0.14); }
    10%, 20% { background: #032d20; color: #fff; border-color: #032d20; }
    21%, 100% { background: #fff; color: #000; border-color: rgba(0, 0, 0, 0.14); }
  }
  @keyframes seli {
    0%, 8% { background: transparent; color: transparent; border-color: rgba(0, 0, 0, 0.25); }
    10%, 20% { background: #fff; color: #032d20; border-color: #fff; }
    21%, 100% { background: transparent; color: transparent; }
  }
  @keyframes cn {
    0%, 10% { opacity: 0; }
    12%, 98% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes cn0 {
    0%, 10% { opacity: 1; }
    12%, 98% { opacity: 0; }
    100% { opacity: 1; }
  }
  @keyframes f0 {
    0%, 10% { transform: scaleX(0); }
    13%, 97% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }
  @keyframes f1 {
    0%, 30% { transform: scaleX(0); }
    33%, 97% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }
  @keyframes f2 {
    0%, 50% { transform: scaleX(0); }
    53%, 97% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }
  @keyframes f3 {
    0%, 70% { transform: scaleX(0); }
    73%, 97% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }

  .card:not(.is-on) *,
  .card:not(.is-on) *::after {
    animation-play-state: paused !important;
  }

  @media (min-width: 768px) {
    .sq {
      padding: 110px 0;
    }
    .wrap {
      margin: 0 40px;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }
    h2 {
      font-size: 46px;
    }
    .l p {
      font-size: 17px;
    }
    .card {
      padding: 28px 32px 30px;
    }
    .stage {
      height: 250px;
    }
    .pn > b {
      font-size: 26px;
    }
    .op {
      padding: 14px 16px;
      font-size: 15px;
    }
    .res .rN {
      font-size: 84px;
    }
  }
  @media (min-width: 1180px) {
    .wrap {
      width: 1080px;
      margin: 0 auto;
      grid-template-columns: 1fr 500px;
      gap: 72px;
    }
  }
</style>

<script>
  function initDotaznikCard() {
    const card = document.querySelector('[data-dotaznik-card]') as HTMLElement | null;
    if (!card) return;
    if (card.dataset.ready === '1') return;
    card.dataset.ready = '1';

    if (!('IntersectionObserver' in window)) {
      card.classList.add('is-on');
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        card.classList.toggle('is-on', entries[0]?.isIntersecting ?? false);
      },
      { threshold: 0.3 }
    );
    io.observe(card);
  }

  initDotaznikCard();
  document.addEventListener('astro:page-load', initDotaznikCard);
</script>
