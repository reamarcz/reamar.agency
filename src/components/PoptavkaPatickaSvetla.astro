---
interface Props {
  preset?: 'bydleni' | 'investice' | 'konkretni-byt' | 'rozhlizim-se';
  context?: string;
  phone?: string;
  email?: string;
  whatsapp?: string;
  photo?: string;
  photoAlt?: string;
  photoPosition?: string;
  photoPositionMobile?: string;
  /** Max šířka levého foto sloupce, např. "820px" */
  photoCol?: string;
  /** Posun fotky nahoru (jako agent banner), např. "-140px" */
  photoTop?: string;
  /** Horizontální posun při zoomu, např. "-12%" */
  photoLeft?: string;
  /** Zoom kresby přes šířku/výšku, např. "130%" */
  photoZoom?: string;
  /** light = bílá plocha (O nás), dark = černá plocha (Investice) */
  tone?: 'light' | 'dark';
  /** První obrazovka pod pevnou hlavičkou: výška sedí do okna, jmenovka zůstane vidět */
  hero?: boolean;
}

const {
  preset,
  context,
  phone = '+420 608 595 984',
  email = 'jan.vitvera@reamar.cz',
  whatsapp,
  photo = '/images/agency/poptavka-jan-u-stolu.jpg',
  photoAlt = 'Jan Vitvera u jednacího stolu na Záběhlickém zámku',
  photoPosition = '14% 22%',
  photoPositionMobile = '12% 18%',
  photoCol = '680px',
  photoTop = '0',
  photoLeft = '0',
  photoZoom = '100%',
  tone = 'light',
  hero = false,
} = Astro.props;
const isDark = tone === 'dark';

const phoneDigits = phone.replace(/\D/g, '');
const waNumber = (whatsapp || phoneDigits).replace(/\D/g, '');
const waHref = `https://wa.me/${waNumber}?text=${encodeURIComponent('Dobrý den, mám zájem o konzultaci.')}`;
const telHref = `tel:+${phoneDigits}`;
const zdrojDefault = context || Astro.url.pathname;
const validPresets = new Set(['bydleni', 'investice', 'konkretni-byt', 'rozhlizim-se']);
const urlPreset = Astro.url.searchParams.get('hledam');
const initialPreset =
  (preset && validPresets.has(preset) && preset) ||
  (urlPreset && validPresets.has(urlPreset) && urlPreset) ||
  'bydleni';
---

<section
  class:list={['kb', isDark ? 'kb--dark' : 'kb--light', hero && 'kb--hero']}
  id="poptavka"
  aria-labelledby="kbl-title"
  data-poptavka-paticka
  data-kb-reveal
  data-nav-hide-zone
  data-preset={initialPreset}
  data-phone={phone}
  style={`--kb-photo-pos: ${photoPosition}; --kb-photo-pos-m: ${photoPositionMobile}; --kbl-photo-col: ${photoCol}; --kb-photo-top: ${photoTop}; --kb-photo-left: ${photoLeft}; --kb-photo-zoom: ${photoZoom};`}
>
  <div class="kbl">
    <div class="kb__photo">
      <img
        src={photo}
        alt={photoAlt}
        loading="lazy"
        decoding="async"
        width="2400"
        height="1600"
        sizes={`(max-width: 899px) 100vw, ${photoCol}`}
      />
      <figure class="kb__quote">
        <p>
          „Každý přirozeně hájí zájmy toho, koho zastupuje.
          <span class="kb__quote-punch">Já zastupuji vás.“</span>
        </p>
        <figcaption class="kb__sig">
          <b>Jan Vitvera</b>
          <span>vedoucí Agentury pro kupující</span>
        </figcaption>
      </figure>
    </div>

    <div class="kbl__pn">
      <div class="kb__head">
        <span class="kb__eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          Ozvu se do 24 hodin
        </span>
        <h2 id="kbl-title">Dobrý nákup začíná správným rozhovorem.</h2>
        <p class="kb__lead">
          Probereme vaše představy, podíváme se na možnosti na trhu a představíme vám formy naší spolupráce.
        </p>
      </div>

      <div class="kb__formwrap">
        <form class="kb__form" novalidate data-kb-form>
          <fieldset class="kb__f">
            <legend>Hledám</legend>
            <div class="kb__seg">
              <label class="kb__opt">
                <input type="radio" name="hledam" value="bydleni" checked={initialPreset === 'bydleni'} />
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <circle cx="8" cy="15.5" r="4"></circle>
                  <path d="M11 12.5 19.5 4M16 7.5l2.5 2.5M13.8 9.7l2 2"></path>
                </svg>
                <span>Bydlení</span>
              </label>
              <label class="kb__opt">
                <input type="radio" name="hledam" value="investice" checked={initialPreset === 'investice'} />
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M6 18 18 6M9 6h9v9"></path>
                </svg>
                <span>Investici</span>
              </label>
              <label class="kb__opt">
                <input type="radio" name="hledam" value="konkretni-byt" checked={initialPreset === 'konkretni-byt'} />
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M4 4h16v16H4z"></path>
                  <path d="M12 4v6M12 14v6M12 14h3M4 12h4"></path>
                </svg>
                <span>Konkrétní byt</span>
              </label>
              <label class="kb__opt">
                <input type="radio" name="hledam" value="rozhlizim-se" checked={initialPreset === 'rozhlizim-se'} />
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="m15.5 8.5-2.2 4.8-4.8 2.2 2.2-4.8z"></path>
                </svg>
                <span>Zatím se rozhlížím</span>
              </label>
            </div>
          </fieldset>

          <div class="kb__r2">
            <label class="kb__f">
              <small>Jméno <span class="kb__req" aria-hidden="true">*</span></small>
              <input name="jmeno" autocomplete="given-name" placeholder="Jak vás oslovit" required />
              <span class="kb__err">Napište, jak vás oslovit.</span>
            </label>
            <label class="kb__f">
              <small>Telefon <span class="kb__req" aria-hidden="true">*</span></small>
              <input name="telefon" type="tel" autocomplete="tel" inputmode="tel" placeholder="+420" required />
              <span class="kb__err">Zkontrolujte telefonní číslo.</span>
            </label>
          </div>

          <label class="kb__f">
            <small data-note-label>Co hledáte</small>
            <input
              name="poznamka"
              data-note
              placeholder="např. 3+kk v Praze 9 do 10 mil., nastěhování 2027"
            />
          </label>

          <input class="kb__hp" name="web" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="zdroj" value={zdrojDefault} />

          <button class="kb__send" type="submit" data-kb-submit>
            <span>Odeslat poptávku</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path d="M6 6 18 18M18 9v9H9"></path>
            </svg>
          </button>
          <p class="kb__gdpr">
            Odesláním souhlasíte se <a href="/ochrana-osobnich-udaju">zpracováním osobních údajů</a>.
          </p>
        </form>

        <div class="kb__ok" role="status" aria-live="polite" data-kb-ok>
          <small>Poptávka odeslána</small>
          <h3><span data-ok-name>Děkuju.</span> Ozvu se do 24 hodin.</h3>
          <p>
            Volat budu z čísla <b data-ok-phone>{phone}</b>. Uložte si ho, ať víte, že volám já. Posíláme vám ho i SMS.
          </p>
          <a class="kb__save" href="/jan-vitvera.vcf" download>
            Uložit kontakt
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M6 6 18 18M18 9v9H9"></path>
            </svg>
          </a>
          <ol>
            <li>Ozvu se vám do 24 hodin.</li>
            <li>Probereme, co hledáte. Zhruba 20 minut, telefonicky, online nebo na zámku.</li>
            <li>Řeknu vám, jak to na trhu vypadá, a představím vám formy spolupráce.</li>
          </ol>
        </div>

        <div class="kb__contacts kbl__contacts">
          <span class="kb__cl">Nebo mě kontaktujte přímo</span>
          <div class="kb__clist">
            <a
              class="kb__ci"
              data-track="whatsapp"
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              <i>
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                  <path d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.98.53 3.9 1.54 5.6L2 22l4.72-1.55a9.9 9.9 0 0 0 5.32 1.55h.01c5.46 0 9.89-4.4 9.89-9.83C21.94 6.4 17.5 2 12.04 2zm5.77 13.98c-.24.68-1.4 1.25-1.94 1.33-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.26-4.79-4.2-4.93-4.4-.14-.2-1.16-1.54-1.16-2.94 0-1.4.73-2.09 1-2.37.26-.28.57-.35.76-.35h.55c.17 0 .41-.07.64.49.24.57.81 1.98.88 2.12.07.14.12.31.02.5-.1.2-.15.32-.3.49-.14.17-.3.38-.43.51-.14.14-.29.29-.12.57.16.28.72 1.19 1.55 1.93 1.07.95 1.97 1.24 2.25 1.38.28.14.44.12.6-.07.17-.2.7-.81.89-1.09.19-.28.38-.23.64-.14.26.1 1.66.78 1.94.93.28.14.47.21.54.33.07.12.07.69-.17 1.37z"></path>
                </svg>
              </i>
              <span><small>WhatsApp</small>Napsat</span>
            </a>
            <a class="kb__ci" data-track="email" href={`mailto:${email}`}>
              <i>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="5.5" width="18" height="13"></rect>
                  <path d="m3.5 6 8.5 7 8.5-7"></path>
                </svg>
              </i>
              <span><small>E-mail</small>{email}</span>
            </a>
            <a class="kb__ci" data-track="phone" href={telHref}>
              <i>
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"></path>
                </svg>
              </i>
              <span><small>Telefon</small>{phone}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .kb {
    --fg: #000;
    --mut: rgba(0, 0, 0, 0.6);
    --ln: rgba(0, 0, 0, 0.16);
    --green: #17804a;
    --field-bg: #f1f1f1;
    --field-hover: #ebebeb;
    --field-focus: #e5e5e5;
    --field-fg: #000;
    --opt-hover: rgba(0, 0, 0, 0.04);
    --opt-active-bg: #f4f4f2;
    --send-bg: #000;
    --send-fg: #fff;
    --send-hover: #222;
    --panel-border: rgba(0, 0, 0, 0.1);
    --err: #c0392b;
    background: #fff;
    color: #000;
    padding: 0;
    font-family: 'Yellix', system-ui, sans-serif;
    font-weight: 500;
    -webkit-font-smoothing: antialiased;
  }
  .kb--dark {
    --fg: #fff;
    --mut: rgba(255, 255, 255, 0.6);
    --ln: rgba(255, 255, 255, 0.22);
    --green: #46c37b;
    --field-bg: rgba(255, 255, 255, 0.07);
    --field-hover: rgba(255, 255, 255, 0.09);
    --field-focus: rgba(255, 255, 255, 0.13);
    --field-fg: #fff;
    --opt-hover: rgba(255, 255, 255, 0.06);
    --opt-active-bg: rgba(255, 255, 255, 0.08);
    --send-bg: #fff;
    --send-fg: #000;
    --send-hover: #ece5da;
    --panel-border: rgba(255, 255, 255, 0.12);
    --err: #ff8a8a;
    background: #000;
    color: #fff;
  }
  .kb a {
    color: inherit;
    text-decoration: none;
  }
  .kb button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .kbl {
    display: grid;
    grid-template-columns: minmax(0, var(--kbl-photo-col, 680px)) 1fr;
    min-height: 0;
  }

  .kb__photo {
    position: relative;
    height: auto;
    min-height: 100%;
    overflow: hidden;
    background: #000;
  }
  .kb__photo img {
    position: absolute;
    top: var(--kb-photo-top, 0);
    left: var(--kb-photo-left, 0);
    z-index: 0;
    display: block;
    width: var(--kb-photo-zoom, 100%);
    height: var(--kb-photo-zoom, 100%);
    max-width: none;
    object-fit: cover;
    object-position: var(--kb-photo-pos, left 22%);
  }
  .kb__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.88) 0,
      rgba(0, 0, 0, 0.55) 26%,
      rgba(0, 0, 0, 0) 52%
    );
  }
  .kb__quote {
    position: absolute;
    z-index: 2;
    /* Stejná levá hrana jako první sloupec černého footru (max 1440 + xl:px-14) */
    left: max(2.5rem, calc((100vw - 1440px) / 2 + 3.5rem));
    right: 44px;
    top: auto;
    bottom: 40px;
    width: auto;
    margin: 0;
    color: #fff;
  }
  .kb__quote p {
    margin: 0 0 26px;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-indent: -0.3em;
    text-wrap: balance;
  }
  .kb__quote-punch {
    display: block;
    margin-top: 0.2em;
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-indent: 0;
  }
  .kb__sig {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .kb__sig b {
    font-weight: 500;
    font-size: 14px;
  }
  .kb__sig span {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
  }

  .kbl__pn {
    padding: 56px 64px 48px;
    max-width: 820px;
  }

  .kb__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 14px;
    line-height: 14px;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green);
  }
  .kb--light .kb__eyebrow svg {
    border-radius: 50%;
    animation: kbPulseL 2.6s ease-in-out infinite;
  }
  .kb--dark .kb__eyebrow {
    text-shadow: 0 0 18px rgba(70, 195, 123, 0.35);
  }
  .kb--dark .kb__eyebrow svg {
    border-radius: 50%;
    animation: kbPulseD 2.6s ease-in-out infinite;
  }
  @keyframes kbPulseL {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(23, 128, 74, 0);
    }
    50% {
      box-shadow: 0 0 0 5px rgba(23, 128, 74, 0.14);
    }
  }
  @keyframes kbPulseD {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(70, 195, 123, 0);
    }
    50% {
      box-shadow: 0 0 0 5px rgba(70, 195, 123, 0.18);
    }
  }
  .kb__head {
    text-align: center;
    margin-bottom: 26px;
  }
  .kb h2 {
    margin: 12px 0 10px;
    font-size: 34px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .kb__lead {
    margin: 0 auto;
    font-size: 15px;
    line-height: 1.55;
    color: var(--mut);
    max-width: 48ch;
  }

  .kb__formwrap {
    display: flex;
    flex-direction: column;
  }
  .kb__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
  }
  .kb__f {
    display: block;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .kb__f > small,
  .kb__f legend {
    display: block;
    padding: 0;
    font-size: 11px;
    line-height: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mut);
    margin-bottom: 10px;
  }
  .kb__req {
    letter-spacing: 0;
  }
  .kb__f em {
    font-style: normal;
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.55;
    margin-left: 6px;
  }
  .kb__f input {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    border: 0;
    background: var(--field-bg);
    color: var(--field-fg);
    font: inherit;
    font-size: 15px;
    outline: 0;
    border-radius: 0;
    transition: background-color 0.2s;
  }
  .kb__f input::placeholder {
    color: var(--mut);
    opacity: 0.7;
  }
  .kb__f input:hover {
    background: var(--field-hover);
  }
  .kb__f input:focus {
    background: var(--field-focus);
  }
  .kb__f.is-err input {
    background: rgba(255, 107, 107, 0.14);
  }
  .kb__err {
    display: none;
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--err);
  }
  .kb__f.is-err .kb__err {
    display: block;
  }
  .kb__r2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .kb__seg {
    display: grid;
    grid-template-columns: 0.85fr 0.95fr 1.1fr 1.3fr;
    border: 1px solid var(--ln);
  }
  .kb__opt {
    position: relative;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 13px;
    color: var(--mut);
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .kb__opt + .kb__opt {
    border-left: 1px solid var(--ln);
  }
  .kb__opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .kb__opt svg {
    flex: none;
    opacity: 0.55;
    transition: opacity 0.2s;
  }
  .kb__opt:hover {
    color: var(--fg);
    background: var(--opt-hover);
  }
  .kb__opt:hover svg {
    opacity: 1;
  }
  .kb__opt:has(input:checked) {
    color: var(--fg);
    background: var(--opt-active-bg);
    box-shadow: inset 0 0 0 1.5px var(--fg);
  }
  .kb__opt:has(input:checked) svg {
    opacity: 1;
  }
  .kb__opt:has(input:focus-visible) {
    outline: 2px solid var(--green);
    outline-offset: -4px;
  }

  .kb__send {
    height: 50px;
    width: 100%;
    background: var(--send-bg) !important;
    color: var(--send-fg) !important;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px !important;
    font-size: 15px;
    transition: background 0.2s;
  }
  .kb__send:hover {
    background: var(--send-hover) !important;
  }
  .kb__send[disabled] {
    opacity: 0.6;
    cursor: default;
  }
  .kb__gdpr {
    margin: 8px 0 0;
    font-size: 11px;
    color: var(--mut);
    opacity: 0.75;
  }
  .kb__gdpr a {
    border-bottom: 1px solid var(--ln);
  }
  .kb__hp {
    position: absolute;
    left: -9999px;
  }

  .kb__ok {
    display: none;
  }
  .kb.is-sent .kb__form {
    display: none;
  }
  .kb.is-sent .kb__ok {
    display: block;
    animation: kbUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .kb__ok small {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green);
  }
  .kb__ok h3 {
    margin: 12px 0;
    font-size: 28px;
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .kb__ok p {
    margin: 0 0 20px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--mut);
  }
  .kb__ok p b {
    color: var(--fg);
    font-weight: 500;
  }
  .kb__save {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 18px;
    border: 1px solid var(--ln);
    font-size: 14px;
  }
  .kb__ok ol {
    margin: 28px 0 0;
    padding: 20px 0 0 20px;
    border-top: 1px solid var(--panel-border);
    font-size: 14px;
    line-height: 1.5;
    color: var(--mut);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  @keyframes kbUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .kbl__contacts {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--panel-border);
  }
  .kb__cl {
    display: block;
    font-size: 11px;
