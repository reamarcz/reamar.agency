---
const badges = [
  {
    label: 'Výběr z celého trhu novostaveb',
    icon: '<circle cx="7" cy="7" r="4.25"/><path d="M10.2 10.2 13.5 13.5"/>',
  },
  {
    label: 'Jednání s developerem',
    icon: '<path d="M2.4 3.6h8.1A1.4 1.4 0 0 1 11.9 5v3.1a1.4 1.4 0 0 1-1.4 1.4H6.1L3.8 11.8V9.5H2.4A1.4 1.4 0 0 1 1 8.1V5a1.4 1.4 0 0 1 1.4-1.4Z"/>',
  },
  {
    label: 'Právní podpora',
    icon: '<path d="M4.2 1.8h5.1L12.4 5v9.2H4.2V1.8Z"/><path d="M9.3 1.8V5h3.1"/><path d="M6.2 8h4M6.2 10.3h2.6"/>',
  },
];
const badgeSizer = badges.reduce((longest, badge) => (badge.label.length > longest.label.length ? badge : longest));
const offerHref = 'https://nabidka.reamar.cz/praha-7';
const offerLines = ['Byty 2+kk', 'Holešovice', '6 475 200 Kč'];
---

<section class="hero-strip" aria-label="Úvod" data-hero-intro="1" data-intro-beats="2" data-hero-strip>
  <div class="intro-stage">
    <div class="intro-beats" aria-hidden="true">
      <p class="intro-beat intro-q1">
        <span class="intro-mask"><span>Kupujete</span></span><span class="intro-gap"></span><span class="intro-mask intro-mask--break" style="--d: 60ms; --od: 25ms"><span>nový&nbsp;byt?</span></span>
      </p>
      <p class="intro-beat intro-q2">
        <span class="intro-mask intro-line"><span>A kdo stojí</span></span>
        <span class="intro-mask intro-line" style="--d: 120ms; --od: 25ms"><span>při vás?</span></span>
      </p>
    </div>
    <div class="intro-film-q" aria-hidden="true">
      <p class="intro-film-line intro-film-a">
        <span class="intro-film-m"><span class="intro-film-w">Kupujete</span></span> <span class="intro-film-m"><span class="intro-film-w" style="--d:.08s">nový</span></span> <span class="intro-film-m"><span class="intro-film-w" style="--d:.16s">byt?</span></span>
      </p>
      <p class="intro-film-line intro-film-b">
        <span class="intro-film-m"><span class="intro-film-w">A</span></span> <span class="intro-film-m"><span class="intro-film-w" style="--d:.07s">kdo</span></span> <span class="intro-film-m"><span class="intro-film-w" style="--d:.14s">stojí</span></span> <span class="intro-film-m"><span class="intro-film-w" style="--d:.21s">při</span></span> <span class="intro-film-m"><span class="intro-film-w" style="--d:.28s">vás?</span></span>
      </p>
    </div>
    <img class="intro-logo" src="/images/logo-rig-b.svg" alt="" width="140" height="36" aria-hidden="true" />
    <button type="button" class="intro-skip" data-intro-skip>Přeskočit úvod</button>
  </div>

  <div class="hero-strip-desktop">
    <div class="hero-strip-film">
      <div class="hero-intro-media" data-intro-media>
        <img
          class="hero-intro-poster"
          src="/video/hero-poster.jpg"
          alt=""
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="async"
        />
        <video
          class="hero-strip-img"
          src="/videos/agentprokupujici.mp4"
          data-src="/videos/agentprokupujici.mp4"
          poster="/video/hero-poster.jpg"
          muted
          autoplay
          loop
          playsinline
          webkit-playsinline="true"
          preload="auto"
          disablepictureinpicture
          disableremoteplayback
          x-webkit-airplay="deny"
          data-hero-loop
          data-intro-video
          aria-hidden="true"
        >
          <source src="/videos/agentprokupujici.mp4" type="video/mp4" />
        </video>
        <script is:inline>
          (function () {
            if (!window.matchMedia('(min-width: 1024px)').matches) return;
            var video = document.currentScript.parentElement.querySelector('[data-intro-video]');
            if (!video) return;
            video.muted = true;
            video.defaultMuted = true;
            video.volume = 0;
            video.playsInline = true;
            video.setAttribute('muted', '');
            video.setAttribute('playsinline', '');
            video.setAttribute('webkit-playsinline', 'true');
            video.preload = 'auto';
            var mark = function () {
              if (video.paused) return;
              video.classList.add('is-live', 'is-playing');
            };
            video.addEventListener('playing', mark, { once: true });
            if (typeof video.requestVideoFrameCallback === 'function') {
              video.requestVideoFrameCallback(function () { mark(); });
            }
            var play = video.play();
            if (play && play.catch) play.catch(function () {
              video.classList.remove('is-live', 'is-playing');
            });
          })();
        </script>
      </div>
      <img class="hero-loop-still" src="/images/agency/hero-loop-open.jpg" alt="" width="2560" height="1440" />
      <div class="hero-strip-rail">
        <button type="button" class="hero-story-card" data-strip-open>
          <span class="hero-story-yt" aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="currentColor"><path d="M3.2 1.6v8.8L10.4 6 3.2 1.6Z"/></svg>
          </span>
          <span class="hero-story-kicker">Agentura pro kupující</span>
        </button>
        <button type="button" class="hero-play-cue" data-strip-open>
          <span>Přehrát video</span>
          <span class="hero-play-cue-line" aria-hidden="true"></span>
        </button>
      </div>
    </div>
    <div class="hero-strip-band" data-intro-target>
      <div class="hero-strip-col hero-strip-col-title">
        <div class="hero-kicker-row">
          <p class="hero-badge" data-hero-badge>
            <span class="hero-badge-sizer" aria-hidden="true">
              <svg viewBox="0 0 16 16" aria-hidden="true" set:html={badgeSizer.icon} />
              <span>{badgeSizer.label}</span>
            </span>
            <span class="hero-badge-mask">
              <span class="hero-badge-stack" data-hero-badge-stack>
                {badges.map((badge) => (
                  <span class="hero-badge-item">
                    <svg viewBox="0 0 16 16" aria-hidden="true" set:html={badge.icon} />
                    <span>{badge.label}</span>
                  </span>
                ))}
                <span class="hero-badge-item" aria-hidden="true">
                  <svg viewBox="0 0 16 16" aria-hidden="true" set:html={badges[0].icon} />
                  <span>{badges[0].label}</span>
                </span>
              </span>
            </span>
          </p>
        </div>
        <h1>
          <span class="hero-w" style="--i: 0"><span>Zastupujeme <span class="hero-em">kupující</span></span></span>
          <span class="hero-w" style="--i: 1"><span>na developerském trhu</span></span>
        </h1>
      </div>
      <div class="hero-strip-col hero-strip-col-copy">
        <div class="hero-kicker-row" aria-hidden="true"></div>
        <p class="hero-intro-lead">Sledujeme trh, vybíráme vhodné jednotky a jednáme s developerem na vaší straně.</p>
        <div class="hero-strip-actions hero-intro-actions">
          <a href="#koncept" class="inline-flex items-center gap-1.5 bg-black px-3 py-1.5 font-yellix text-[13px] font-medium leading-none text-white no-underline transition-opacity hover:opacity-85">
            <img src="/images/arrow-1.svg" alt="" class="h-3 w-3 shrink-0" width="12" height="12" />
            Co děláme
          </a>
        </div>
      </div>
      <div class="hero-strip-col hero-strip-col-data">
        <div class="hero-kicker-row">
          <p class="hero-strip-kicker">Aktuální nabídka v Praze a okolí</p>
        </div>
        <p class="hero-strip-stats">
          <span class="hero-strip-live" aria-hidden="true"></span>
          <span>562 projektů</span>
          <span class="hero-strip-dot" aria-hidden="true">·</span>
          <span>9 689 jednotek</span>
        </p>
        <a href={offerHref} class="hero-strip-offer" target="_blank" rel="noopener noreferrer">
          <span class="hero-strip-offer-copy">
            <span class="hero-strip-offer-kicker">Předprodej</span>
            <span class="hero-strip-offer-tick" data-strip-offer>
              <span class="hero-strip-offer-sizer" aria-hidden="true">6 475 200 Kč</span>
              <span class="hero-strip-offer-mask">
                <span class="hero-strip-offer-stack" data-strip-offer-stack>
                  {offerLines.map((line) => <span>{line}</span>)}
                  <span aria-hidden="true">{offerLines[0]}</span>
                </span>
              </span>
            </span>
          </span>
          <span class="hero-strip-offer-go" aria-hidden="true">
            <img src="/images/arrow-1.svg" alt="" width="11" height="11" />
          </span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-strip-mobile" data-hero-alt>
    <div class="hero-strip-mhero">
      <div class="hero-strip-mhero-win video-decorative-wrap hero-strip-mobile-visual" data-cover-managed data-intro-media>
        <img
          class="video-decorative-cover hero-intro-poster"
          src="/video/hero-poster.jpg"
          alt=""
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="async"
        />
        <video
          class="hero-strip-mobile-img"
          src="/videos/agentprokupujici.mp4"
          data-src="/videos/agentprokupujici.mp4"
          poster="/video/hero-poster.jpg"
          muted
          autoplay
          loop
          playsinline
          webkit-playsinline="true"
          controlsList="nodownload nofullscreen noremoteplayback"
          preload="auto"
          disablepictureinpicture
          disableremoteplayback
          x-webkit-airplay="deny"
          data-hero-loop
          data-intro-video
          data-decorative-autoplay
          aria-hidden="true"
        >
          <source src="/videos/agentprokupujici.mp4" type="video/mp4" />
        </video>
        <script is:inline>
          (function () {
            if (!window.matchMedia('(max-width: 1023px)').matches) return;
            var video = document.currentScript.parentElement.querySelector('[data-intro-video]');
            if (!video) return;
            video.muted = true;
            video.defaultMuted = true;
            video.volume = 0;
            video.playsInline = true;
            video.setAttribute('muted', '');
            video.setAttribute('playsinline', '');
            video.setAttribute('webkit-playsinline', 'true');
            video.controls = false;
            video.removeAttribute('controls');
            video.preload = 'auto';
            var mark = function () {
              if (video.paused) return;
              video.classList.add('is-live', 'is-playing');
              video.closest('.video-decorative-wrap')?.classList.add('is-playing');
            };
            video.addEventListener('playing', mark, { once: true });
            if (typeof video.requestVideoFrameCallback === 'function') {
              video.requestVideoFrameCallback(function () { mark(); });
            }
            var play = video.play();
            if (play && play.catch) play.catch(function () {
              video.classList.remove('is-live', 'is-playing');
              video.closest('.video-decorative-wrap')?.classList.remove('is-playing');
            });
          })();
        </script>
      </div>
      <div class="hero-strip-mhero-text" data-intro-target>
        <span class="hero-strip-mhero-kicker hero-strip-mobile-kicker">Agentura pro kupující</span>
        <h1 class="hero-strip-mhero-h1">
          <span class="hero-w" style="--i: 0"><span>Zastupujeme kupující</span></span>
          <span class="hero-w" style="--i: 1"><span>na developerském trhu</span></span>
        </h1>
        <p class="hero-strip-mhero-lead">Získejte svůj tým pro nákup bytu v&nbsp;novostavbě.</p>
        <div class="hero-strip-mhero-btns hero-intro-actions">
          <a class="hero-strip-mhero-b1" href="#vyber-sluzeb">
            Vybrat službu
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M6 6 L18 18"></path>
              <path d="M18 9 L18 18 L9 18"></path>
            </svg>
          </a>
          <button type="button" class="hero-strip-mhero-b2" data-strip-open>
            <svg width="18" height="13" viewBox="0 0 18 13" aria-hidden="true">
              <rect width="18" height="13" rx="3.5" fill="#ff0033"></rect>
              <path d="M7 3.6v5.8L12 6.5z" fill="#fff"></path>
            </svg>
            Přehrát video
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="strip-modal" data-strip-modal hidden>
    <button type="button" class="strip-modal-backdrop" data-strip-close aria-label="Zavřít video"></button>
    <div class="strip-modal-panel" role="dialog" aria-modal="true" aria-label="Agentura pro kupující">
      <button type="button" class="strip-modal-close" data-strip-close>Zavřít</button>
      <video class="strip-modal-video" data-strip-feature controls playsinline preload="none" poster="/images/agency/hero-obhlidka.jpg">
        <source src="/videos/medailonek-apk.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<style is:global>
.hero-strip [data-hero-loop]{opacity:1;visibility:visible;pointer-events:none}.hero-strip [data-hero-loop]::-webkit-media-controls,.hero-strip [data-hero-loop]::-webkit-media-controls-enclosure,.hero-strip [data-hero-loop]::-webkit-media-controls-panel,.hero-strip [data-hero-loop]::-webkit-media-controls-play-button,.hero-strip [data-hero-loop]::-webkit-media-controls-start-playback-button,.hero-strip [data-hero-loop]::-webkit-media-controls-overlay-play-button,.hero-strip [data-hero-loop]::-webkit-media-controls-overlay-enclosure{display:none!important;-webkit-appearance:none!important;opacity:0!important;pointer-events:none!important;width:0!important;height:0!important}.hero-strip .hero-loop-play,[data-hero-loop-play]{display:none!important}.hero-strip{--out: cubic-bezier(.16, 1, .3, 1);--io: cubic-bezier(.76, 0, .24, 1);--hair: rgba(0, 0, 0, .12);--strip-max: 1440px;--strip-pad: 1.25rem;background:#fff}@media(min-width:768px){.hero-strip{--strip-pad: 2.5rem}}@media(min-width:1280px){.hero-strip{--strip-pad: 3.5rem}}.hero-strip-mobile{display:none}@media(max-width:1023px){.hero-strip-desktop{display:none}.hero-strip-mobile{display:block}}@media(max-width:1023px)and (prefers-reduced-motion:reduce){}@keyframes hero-action-live{0%,to{opacity:1;box-shadow:0 0 #4ade8073}50%{opacity:.7;box-shadow:0 0 0 4px #4ade8000}}.hero-strip-film{position:relative;width:100%;height:clamp(300px,calc(42vh + 5rem),500px);overflow:hidden;background:#fff}.hero-strip-film:after{content:"";position:absolute;inset:0 0 auto;height:150px;background:linear-gradient(to bottom,rgba(0,0,0,.32) 0%,rgba(0,0,0,.12) 55%,transparent 100%);pointer-events:none}@media(min-width:1024px){.hero-strip-film{height:clamp(540px,70vh,800px)}}.hero-strip-img,.hero-strip-film .hero-loop-still{display:block;width:100%;height:100%;-o-object-fit:cover;object-fit:cover;-o-object-position:42% center;object-position:42% center}.hero-strip-film .hero-loop-still{position:absolute;inset:0;z-index:0}.hero-strip-film:has(.is-playing) .hero-loop-still,.hero-strip-mobile-visual:has(.is-playing) .hero-loop-still{opacity:0}.hero-strip-rail{position:absolute;left:0;right:0;bottom:0;z-index:2;display:flex;justify-content:flex-start;max-width:var(--strip-max);margin:0 auto;padding:0 var(--strip-pad) 1.5rem;pointer-events:none}@media(min-width:1024px){.hero-strip-rail{padding-bottom:2rem}}.hero-story-card{pointer-events:auto;display:inline-flex;align-items:center;gap:10px;padding:8px 12px 8px 8px;background:#ffffffdb;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(0,0,0,.08);text-decoration:none;box-shadow:0 10px 30px #00000014;transition:transform .2s ease,background .2s ease,box-shadow .2s ease}.hero-story-card:hover{background:#fffffff5;transform:translateY(-1px);box-shadow:0 12px 32px #0000001a}.hero-story-yt{display:flex;align-items:center;justify-content:center;width:28px;height:28px;flex-shrink:0;background:#fff;border:1px solid rgba(0,0,0,.06);overflow:visible}.hero-story-yt svg{width:16px;height:11px;transform-origin:50% 50%;animation:hero-yt-pulse 2.4s ease-in-out infinite}.hero-story-card:hover .hero-story-yt svg{animation:none;transform:scale(1.28)}@keyframes hero-yt-pulse{0%,18%,to{transform:scale(1)}28%{transform:scale(1.48)}36%{transform:scale(1)}44%{transform:scale(1.28)}52%{transform:scale(1)}}.hero-story-copy{display:flex;flex-direction:column;gap:3px;min-width:0}.hero-story-kicker{font-family:Yellix,system-ui,sans-serif;font-size:9px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:#0000006b;line-height:1}.hero-story-title{font-family:Yellix,system-ui,sans-serif;font-size:13px;font-weight:500;color:#000;line-height:1}.hero-strip-band{display:grid;grid-template-columns:1fr;max-width:var(--strip-max);margin:0 auto;padding:0 var(--strip-pad)}.hero-strip-col{padding:1.6rem 0}.hero-strip-col+.hero-strip-col{border-top:1px solid var(--hair)}@media(min-width:1024px){.hero-strip-band{grid-template-columns:1.15fr 1fr 1fr}.hero-s