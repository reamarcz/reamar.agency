<script>
  function loopHost(video) {
    return video.closest('.hero-strip-mobile-visual, .hero-strip-film') || video.parentElement;
  }

  function muteLoop(video) {
    video.muted = true;
    video.defaultMuted = true;
    video.volume = 0;
    video.loop = true;
    video.playsInline = true;
    video.controls = false;
    video.setAttribute('muted', '');
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', 'true');
    video.removeAttribute('controls');
  }

  function isDesktopFilm(video) {
    return !!video.closest('.hero-strip-film') && window.matchMedia('(min-width: 1024px)').matches;
  }

  function introBusy() {
    const root = document.documentElement;
    return root.classList.contains('intro-on')
      || root.classList.contains('rmi-on')
      || root.classList.contains('rmm-on');
  }

  function markLive(video) {
    if (video.paused) return;
    video.classList.add('is-playing', 'is-live');
    video.closest('.video-decorative-wrap')?.classList.add('is-playing');
  }

  function markStill(video) {
    video.classList.remove('is-playing', 'is-live');
    video.closest('.video-decorative-wrap')?.classList.remove('is-playing');
  }

  function armSrc(video) {
    const src = video.getAttribute('data-src');
    if (!src) return;
    if (video.getAttribute('src') !== src) video.setAttribute('src', src);
    const source = video.querySelector('source');
    if (source && source.getAttribute('src') !== src) source.setAttribute('src', src);
  }

  function armUnlock(video) {
    if (video._heroUnlock) return;
    video._heroUnlock = true;
    const kick = function () {
      if (!video.paused) return;
      if (document.documentElement.classList.contains('intro-on') && !isDesktopFilm(video)) return;
      if (!visible(video)) return;
      tryPlay(video);
    };
    ['pointerdown', 'touchstart', 'touchend', 'click', 'keydown', 'scroll'].forEach(function (ev) {
      window.addEventListener(ev, kick, { passive: true });
    });
  }

  function visible(video) {
    return video.getClientRects().length > 0;
  }

  // Avoid pausing loops before first layout paint — early sync can see 0 rects
  // and cancel the inline autoplay until the user scrolls.
  var heroLayoutReady = false;
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      heroLayoutReady = true;
    });
  });

  function tryPlay(video) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!visible(video)) return;
    armSrc(video);
    muteLoop(video);
    const play = video.play();
    if (play && typeof play.then === 'function') {
      play.then(function () {
        markLive(video);
      }).catch(function () {
        markStill(video);
        armUnlock(video);
      });
    } else if (!video.paused) {
      markLive(video);
    }
  }

  function syncLoop(video) {
    const modal = document.querySelector('[data-strip-modal]');
    if (modal && !modal.hidden) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (document.documentElement.classList.contains('intro-on') && !isDesktopFilm(video)) return;
    if (!visible(video)) {
      if (heroLayoutReady && !video.paused && !isDesktopFilm(video)) video.pause();
      return;
    }
    armSrc(video);
    muteLoop(video);
    tryPlay(video);
  }

  function afterIntro(video) {
    if (document.documentElement.classList.contains('intro-on')) {
      const filmIntro = document.documentElement.classList.contains('intro-film');
      if (filmIntro || isDesktopFilm(video)) {
        if (video._introPrime) return;
        video._introPrime = true;
        const start = function () {
          if (!document.documentElement.classList.contains('intro-on')) return;
          tryPlay(video);
        };
        if (filmIntro) start();
        else window.setTimeout(start, 1200);
      } else {
        video.pause();
      }
      return;
    }
    syncLoop(video);
    requestAnimationFrame(function () { syncLoop(video); });
  }

  function revealWhenPainted(video) {
    if (!video.hasAttribute('data-intro-video') || video.classList.contains('is-live')) return;
    const show = function () { markLive(video); };
    if (typeof video.requestVideoFrameCallback === 'function') video.requestVideoFrameCallback(show);
    else if (!video.paused && video.readyState >= 2) show();
    else video.addEventListener('playing', show, { once: true });
  }

  function bindLoop(video) {
    revealWhenPainted(video);
    video.addEventListener('loadeddata', function () { syncLoop(video); });
    video.addEventListener('canplay', function () { syncLoop(video); });
    video.addEventListener('playing', function () {
      if (document.documentElement.classList.contains('intro-on') && !document.documentElement.classList.contains('intro-film') && !isDesktopFilm(video)) return;
      markLive(video);
    });
    video.addEventListener('pause', function () {
      if (introBusy() || !visible(video) || video.ended) return;
      // Ignore transient stalls; only drop live state if it stays paused.
      window.setTimeout(function () {
        if (!video.paused || !visible(video) || introBusy()) return;
        markStill(video);
      }, 180);
    });
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') syncLoop(video);
    });
    window.addEventListener('pageshow', function () { syncLoop(video); });
    window.addEventListener('focus', function () { syncLoop(video); });
    function onIntroDone() {
      if (isDesktopFilm(video) && !video.paused) markLive(video);
      afterIntro(video);
      tryPlay(video);
      setTimeout(function () { tryPlay(video); }, 200);
      setTimeout(function () { tryPlay(video); }, 900);
    }
    window.addEventListener('hero-intro-done', onIntroDone);
    window.addEventListener('rm:intro-done', onIntroDone);
    window.addEventListener('resize', function () { syncLoop(video); });
    const host = loopHost(video);
    host?.addEventListener('click', function (event) {
      if (document.documentElement.classList.contains('intro-on') || !visible(video)) return;
      if (event.target.closest('a, button')) return;
      if (!video.paused) return;
      armSrc(video);
      muteLoop(video);
      const play = video.play();
      if (play && typeof play.then === 'function') {
        play.then(function () {
          markLive(video);
        }).catch(function () {
          markStill(video);
          armUnlock(video);
        });
      } else if (!video.paused) {
        markLive(video);
      }
    });
  }

  function initLoops() {
    const videos = document.querySelectorAll('[data-hero-strip] [data-hero-loop]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    videos.forEach(function (video) {
      if (reduced) {
        video.removeAttribute('autoplay');
        video.pause();
        markStill(video);
        return;
      }
      muteLoop(video);
      armUnlock(video);
      if (video.dataset.loopArmed !== '1') {
        video.dataset.loopArmed = '1';
        bindLoop(video);
      }
      afterIntro(video);
      if (!document.documentElement.classList.contains('intro-on')) {
        tryPlay(video);
        [50, 150, 400, 900, 1800].forEach(function (ms) {
          setTimeout(function () {
            if (visible(video) && video.paused) tryPlay(video);
          }, ms);
        });
      }
    });
  }

  function initIntro() {
    const root = document.documentElement;
    const strip = document.querySelector('[data-hero-strip][data-hero-intro="1"]');
    if (!strip || strip.dataset.introInit === '1' || !root.classList.contains('intro-on')) return;
    strip.dataset.introInit = '1';
    const timers = [];
    let done = false;
    const twoBeats = strip.getAttribute('data-intro-beats') === '2';
    const film = root.classList.contains('intro-film');
    const steps = film
      ? [
          [4600, function () { strip.classList.add('settled'); }],
          [6000, finish],
        ]
      : twoBeats
      ? [
          [180, function () { strip.classList.add('q1-in'); }],
          [1280, function () { strip.classList.add('q1-out'); }],
          [1480, function () { strip.classList.add('q2-in'); }],
          [3360, function () { strip.classList.add('q2-out', 'settled'); }],
          [4710, finish],
        ]
      : [
          [180, function () { strip.classList.add('q1-in'); }],
          [1280, function () { strip.classList.add('q1-out'); }],
          [1480, function () { strip.classList.add('q2-in'); }],
          [2920, function () { strip.classList.add('q2-out'); }],
          [3120, function () { strip.classList.add('q3-in'); }],
          [5350, function () { strip.classList.add('q3-out', 'settled'); }],
          [6700, finish],
        ];

    function finish() {
      if (done) return;
      done = true;
      timers.forEach(function (id) { clearTimeout(id); });
      try { sessionStorage.setItem('reamarIntroSeen', '1'); } catch (e) {}
      root.classList.remove('intro-on', 'intro-go');
      strip.classList.remove('q1-in', 'q1-out', 'q2-in', 'q2-out', 'q3-in', 'q3-out', 'settled', 'no-anim');
      window.dispatchEvent(new Event('hero-intro-done'));
    }

    function skip(event) {
      if (!event) return finish();
      if (event.type === 'keydown' && event.key === 'Tab') return;
      if (event.type === 'wheel' && Math.abs(event.deltaY) < 8 && Math.abs(event.deltaX) < 8) return;
      strip.classList.add('settled', 'no-anim');
      finish();
    }

    steps.forEach(function (step) {
      timers.push(setTimeout(step[1], step[0]));
    });
    try { sessionStorage.setItem('reamarIntroSeen', '1'); } catch (e) {}

    const stage = strip.querySelector('.intro-stage');
    strip.querySelector('[data-intro-skip]')?.addEventListener('click', skip);
    const arm = setTimeout(function () {
      stage?.addEventListener('click', skip);
      document.addEventListener('keydown', skip);
      window.addEventListener('wheel', skip, { passive: true });
      window.addEventListener('touchmove', skip, { passive: true });
    }, 450);
    function unbind() {
      clearTimeout(arm);
      stage?.removeEventListener('click', skip);
      document.removeEventListener('keydown', skip);
      window.removeEventListener('wheel', skip);
      window.removeEventListener('touchmove', skip);
    }
    window.addEventListener('hero-intro-done', unbind, { once: true });
  }

  function initOffer() {
    if (window.__stripOfferTimeoutId) {
      clearTimeout(window.__stripOfferTimeoutId);
      window.__stripOfferTimeoutId = null;
    }
    const tick = document.querySelector('[data-hero-strip] [data-strip-offer]');
    if (!tick || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const stack = tick.querySelector('[data-strip-offer-stack]');
    if (!stack || stack.children.length < 2) return;
    const last = stack.children.length - 1;
    let index = 0;
    const hold = 2800;
    const duration = 640;
    function rowHeight() {
      return stack.firstElementChild ? stack.firstElementChild.getBoundingClientRect().height : 0;
    }
    function queue() {
      if (!document.body.contains(tick) || !rowHeight()) return;
      window.__stripOfferTimeoutId = setTimeout(step, hold);
    }
    function step() {
      if (!document.body.contains(tick)) return;
      index += 1;
      stack.style.transition = 'transform ' + duration + 'ms cubic-bezier(.45,.02,.2,1)';
      stack.style.transform = 'translateY(' + (-index * rowHeight()) + 'px)';
      if (index === last) {
        window.__stripOfferTimeoutId = setTimeout(function () {
          stack.style.transition = 'none';
          stack.style.transform = 'translateY(0)';
          index = 0;
          window.__stripOfferTimeoutId = setTimeout(step, hold);
        }, duration);
        return;
      }
      window.__stripOfferTimeoutId = setTimeout(step, hold);
    }
    if (document.documentElement.classList.contains('intro-on') && !document.documentElement.classList.contains('intro-film')) {
      window.addEventListener('hero-intro-done', queue, { once: true });
      return;
    }
    queue();
  }

  function initBadge() {
    if (window.__heroBadgeTimeoutId) {
      clearTimeout(window.__heroBadgeTimeoutId);
      window.__heroBadgeTimeoutId = null;
    }
    const badge = document.querySelector('[data-hero-strip] [data-hero-badge]');
    if (!badge || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const stack = badge.querySelector('[data-hero-badge-stack]');
    if (!stack || stack.children.length < 2) return;
    const last = stack.children.length - 1;
    let index = 0;
    const hold = 3200;
    const duration = 640;
    stack.style.transition = 'none';
    stack.style.transform = 'translateY(0)';
    function rowHeight() {
      return stack.firstElementChild ? stack.firstElementChild.getBoundingClientRect().height : 0;
    }
    function queue() {
      if (!document.body.contains(badge) || !rowHeight()) return;
      window.__heroBadgeTimeoutId = setTimeout(step, hold);
    }
    function step() {
      if (!document.body.contains(badge)) return;
      index += 1;
      stack.style.transition = 'transform ' + duration + 'ms cubic-bezier(.45,.02,.2,1)';
      stack.style.transform = 'translateY(' + (-index * rowHeight()) + 'px)';
      if (index === last) {
        window.__heroBadgeTimeoutId = setTimeout(function () {
          stack.style.transition = 'none';
          stack.style.transform = 'translateY(0)';
          index = 0;
          window.__heroBadgeTimeoutId = setTimeout(step, hold);
        }, duration);
        return;
      }
      window.__heroBadgeTimeoutId = setTimeout(step, hold);
    }
    if (document.documentElement.classList.contains('intro-on') && !document.documentElement.classList.contains('intro-film')) {
      window.addEventListener('hero-intro-done', queue, { once: true });
      return;
    }
    queue();
  }

  function initModal() {
    if (window.__heroModalBound) return;
    window.__heroModalBound = true;

    function current() {
      const strip = document.querySelector('[data-hero-strip]');
      const modal = strip && strip.querySelector('[data-strip-modal]');
      const feature = modal && modal.querySelector('[data-strip-feature]');
      return { strip: strip, modal: modal, feature: feature };
    }

    function openModal() {
      const parts = current();
      if (!parts.modal || document.documentElement.classList.contains('intro-on')) return;
      document.querySelectorAll('[data-hero-strip] [data-hero-loop], [data-bah-media]').forEach(function (video) {
        if (!video.paused) video.pause();
      });
      parts.modal.hidden = false;
      document.body.style.overflow = 'hidden';
      if (parts.feature) {
        try { parts.feature.currentTime = 0; } catch (e) {}
        const play = parts.feature.play();
        if (play && typeof play.catch === 'function') play.catch(function () {});
      }
    }

    function closeModal() {
      const parts = current();
      if (!parts.modal || parts.modal.hidden) return;
      if (parts.feature) parts.feature.pause();
      parts.modal.hidden = true;
      document.body.style.overflow = '';
      document.querySelectorAll('[data-hero-strip] [data-hero-loop]').forEach(function (video) {
        syncLoop(video);
      });
    }

    document.addEventListener('click', function (event) {
      if (event.target.closest('[data-strip-open]')) {
        event.preventDefault();
        openModal();
        return;
      }
      if (event.target.closest('[data-strip-close]')) closeModal();
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeModal();
    });
  }

  function initHeroStrip() {
    initLoops();
    initOffer();
    initBadge();
    initIntro();
    initModal();
  }

  initHeroStrip();
  document.addEventListener('astro:page-load', initHeroStrip);
</script>
