---
import '../styles/onas.css';
import OnasHero from './OnasHero.astro';
import OnasZlom from './OnasZlom.astro';
import { instagramPoradu, youtubeKanal } from '../data/porad';

const ext = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 16 16 8M10 8h6v6"/></svg>`;
const corner = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6 L18 18"/><path d="M18 9 L18 18 L9 18"/></svg>`;
const play = `<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15L19.5 12z" fill="currentColor"/></svg>`;

const socials = [
  { name: 'YouTube', href: youtubeKanal },
  { name: 'Instagram', href: instagramPoradu },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/jan-vitvera-6162b1164' },
  { name: 'X', href: 'https://x.com/agentprokupujici' },
  { name: 'Threads', href: 'https://www.threads.com/@agentprokupujici' },
];

const loopSrc = '/videos/agentprokupujici.mp4';
const loopPoster = '/video/hero-poster.jpg';
const featureSrc = '/videos/medailonek-apk.mp4';
const featurePoster = '/images/agency/hero-obhlidka.jpg';
---

<div class="onas">
  <div class="hero-cover">
    <div class="hero-cover-pin">
      <OnasHero />
    </div>

    <section class="onas-c1" id="strana-developera" aria-labelledby="onas-c1-heading" data-nav-hide-zone>
    <div class="onas-wrap onas-c1-g" data-onas-in>
      <div>
        <span class="onas-ch" data-onas-in-item><b>I</b>Strana developera</span>
        <h2 id="onas-c1-heading" class="onas-c1-h">
          <span class="onas-c1-ln"><span>Přes <b data-onas-count="200">200</b> projektů.</span></span>
          <span class="onas-c1-ln"><span>Z pohledu toho, kdo prodává.</span></span>
        </h2>
        <p data-onas-in-item>
          Jan svou kariéru v novostavbách začínal přímo na straně developerů. Řešil prodej a marketing pro více než 200 projektů a do detailu poznal, jak prodejci přemýšlí, jaké mají cíle a jaké vyjednávací strategie používají.
        </p>
        <div class="onas-soc" data-onas-in-item>
          <small>Sledujte Honzu</small>
          {socials.map((item) => (
            <a class="onas-ext" href={item.href} target="_blank" rel="noopener noreferrer">
              {item.name} <Fragment set:html={ext} />
            </a>
          ))}
        </div>
      </div>
      <div class="onas-c1-p video-decorative-wrap" data-onas-in-item data-cover-managed data-onas-story>
        <img
          class="video-decorative-cover"
          src="/images/agency/Storyholder.jpeg"
          alt=""
          width="1080"
          height="1920"
          loading="lazy"
        />
        <video
          data-decorative-autoplay
          data-onas-story-video
          src="/videos/onas.mp4"
          data-src="/videos/onas.mp4"
          poster="/images/agency/Storyholder.jpeg"
          muted
          autoplay
          loop
          playsinline
          webkit-playsinline="true"
          preload="metadata"
          disablepictureinpicture
          aria-hidden="true"
        >
          <source src="/videos/onas.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>
  </div>

  <OnasZlom />

  <section class="onas-c3" id="zazemi" aria-labelledby="onas-c3-heading" data-onas-zazemi>
    <div class="onas-c3-media">
      <img src={loopPoster} alt="" width="1920" height="1080" loading="lazy" data-onas-poster />
      <video
        muted
        loop
        playsinline
        preload="none"
        poster={loopPoster}
        data-onas-loop
        data-src={loopSrc}
        disablepictureinpicture
        disableremoteplayback
        aria-hidden="true"
      ></video>
      <div class="onas-c3-ov" aria-hidden="true"></div>
    </div>
    <button type="button" class="onas-play" data-onas-open aria-label="Přehrát video">
      <span>Přehrát video</span>
      <span class="onas-play-line" aria-hidden="true"></span>
    </button>
    <div class="onas-c3-in" data-onas-in>
      <span class="onas-ch onas-ch--w" data-onas-in-item><b>III</b>Spojení</span>
      <h2 id="onas-c3-heading" data-onas-in-item>Myšlenka potkala zázemí.</h2>
      <p data-onas-in-item>
        Dobrá myšlenka potřebuje lidi, kteří ji umí proměnit ve službu. Honza je našel ve skupině REAMAR, mezi odborníky na marketing, právo, data a technologie, kteří trh novostaveb znají zevnitř. Dnes za každým klientem agentury stojí celý tým.
      </p>
      <a
        class="onas-c3-l"
        href="https://www.reamar.cz"
        target="_blank"
        rel="noopener noreferrer"
        data-onas-ext
        data-onas-in-item
      >
        Více o skupině REAMAR · reamar.cz <Fragment set:html={ext} />
      </a>
    </div>
  </section>

  <div class="onas-modal" data-onas-modal hidden>
    <button type="button" class="onas-modal-backdrop" data-onas-close aria-label="Zavřít video"></button>
    <div class="onas-modal-panel" role="dialog" aria-modal="true" aria-label="Agentura pro kupující">
      <button type="button" class="onas-modal-close" data-onas-close>Zavřít</button>
      <video
        class="onas-modal-video"
        data-onas-feature
        controls
        playsinline
        preload="none"
        poster={featurePoster}
      >
        <source src={featureSrc} type="video/mp4" />
      </video>
    </div>
  </div>

  <section class="onas-c4" aria-labelledby="onas-c4-heading">
    <div class="onas-wrap">
      <div class="onas-c4-h" data-onas-in>
        <span class="onas-kick" data-onas-in-item>Čtyři oddělení agentury pro kupující</span>
        <h3 id="onas-c4-heading" data-onas-in-item>Za každou úspěšnou strategií stojí lidé,<br />kteří znají trh do nejmenšího detailu.</h3>
      </div>
      <div class="onas-dp" data-onas-in>
        <article class="onas-d" data-onas-in-item>
          <div class="onas-ill onas-ill-cons" aria-hidden="true">
            <span class="onas-cn"><i>1</i>Zadání</span>
            <span class="onas-cn"><i>2</i>Výběr projektů</span>
            <span class="onas-cn is-on"><i>3</i>Prohlídky a jednání</span>
            <span class="onas-cn"><i>4</i>Smlouva a předání</span>
          </div>
          <small>01</small>
          <b>Konzultanti</b>
          <p>Váš osobní průvodce od prvního zadání až po předání klíčů. Přebíráme iniciativu, vedeme jednání s prodejci a tvrdě hájíme vaše peníze v každém kroku procesu.</p>
        </article>
        <article class="onas-d" data-onas-in-item>
          <svg viewBox="0 0 300 160" class="onas-ill" aria-hidden="true">
            <rect width="300" height="160" fill="#eceeec"></rect>
            <path d="M-5 100 L305 80M80 -5 L120 165M-5 40 C100 55 200 25 305 45" stroke="#fff" stroke-width="6" fill="none"></path>
            <circle cx="62" cy="111" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="255" cy="49" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="20" cy="112" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="123" cy="143" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="64" cy="77" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="200" cy="32" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="182" cy="109" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="101" cy="73" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="55" cy="150" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="221" cy="118" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="51" cy="21" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="84" cy="60" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="44" cy="115" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="192" cy="121" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="41" cy="68" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="72" cy="94" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="31" cy="101" r="2.6" fill="#c4c7ca"></circle>
            <circle cx="150" cy="78" r="9" fill="#000"></circle>
            <text x="150" y="82" font-size="10" text-anchor="middle" fill="#fff" font-family="Yellix,system-ui">1</text>
            <circle cx="96" cy="58" r="7" fill="#000"></circle>
            <circle cx="214" cy="106" r="7" fill="#000"></circle>
          </svg>
          <small>02</small>
          <b>Analytické oddělení</b>
          <p>Pracujeme s daty o celém trhu. Náš vlastní software filtruje nabídky podle více než 100 parametrů a porovnává skutečné ceny. Hned tak víme, jestli nepřeplácíte.</p>
          <a class="onas-lnk" href="https://www.reamar.cz/prazsky-rezidencni-trh" target="_blank" rel="noopener noreferrer">
            Pražský rezidenční trh <Fragment set:html={corner} />
          </a>
        </article>
        <article class="onas-d" data-onas-in-item>
          <div class="onas-ill onas-ill-doc" aria-hidden="true">
            <b>Rezervační smlouva</b>
            <i></i><i></i><i class="hl"></i><i></i><i class="s"></i>
            <span>čl. 4.2 – smluvní pokuta</span>
            <i></i><i class="s"></i>
          </div>
          <small>03</small>
          <b>Právní oddělení</b>
          <p>Smlouvy od developera chrání především developera. My prověříme každou kličku v rezervační i kupní smlouvě dřív, než vezmete do ruky pero. Kupujete bezpečně.</p>
        </article>
        <article class="onas-d" data-onas-in-item>
          <div class="onas-ill onas-ill-price" aria-hidden="true">
            <div><span>B.204 · 3+kk · 78 m²</span><b>10 990 000</b></div>
            <div><span>Cena za m²</span><b>140 900</b></div>
            <div><span>Orientace · terasa</span><b>J · 14 m²</b></div>
            <div><span>Cena vs. trh</span><b class="g">−4,1 %</b></div>
          </div>
          <small>04</small>
          <b>Marketing</b>
          <p>Známe prodejní kampaně zevnitř. Zkušeně proto oddělíme krásné vizualizace od skutečné hodnoty bytu a posoudíme reálnou cenu, standard i potenciál dané lokality.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="onas-c5" aria-labelledby="onas-c5-heading">
    <img
      class="onas-c5-bg"
      src="/images/agency/jv-holder3.jpg"
      alt=""
      width="1920"
      height="1080"
      loading="lazy"
    />
    <div class="onas-c5-ov" aria-hidden="true"></div>
    <div class="onas-wrap onas-c5-g" data-onas-in>
      <div data-onas-in-item>
        <span class="onas-kick">Agentura pro kupující</span>
        <h2 id="onas-c5-heading">Kupujete nemovitost za miliony.<br />Nenechávejte podmínky a vyjednávání na lidech, kteří pracují pro druhou stranu.</h2>
      </div>
      <div class="onas-c5-b" data-onas-in-item>
        <button
          type="button"
          class="onas-btn onas-btn-w"
          data-smart-meeting-open
          data-smart-meeting-type="client"
        >
          <Fragment set:html={corner} />
          Domluvit schůzku
        </button>
        <a class="onas-btn onas-btn-o" href="/pribehy-z-trhu/">
          <Fragment set:html={play} />
          Příběhy z trhu
        </a>
      </div>
    </div>
  </section>
</div>

<script>
  import { bindHeroLoop, type HeroLoopHandle } from '../scripts/hero-loop';

  function initOnasStoryLoop() {
    const wrap = document.querySelector('[data-onas-story]') as HTMLElement | null;
    const video = document.querySelector('[data-onas-story-video]') as HTMLVideoElement | null;
    if (!wrap || !video) return;
    const prev = (wrap as HTMLElement & { _onasStoryLoop?: HeroLoopHandle | null })._onasStoryLoop;
    prev?.destroy();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      (wrap as HTMLElement & { _onasStoryLoop?: HeroLoopHandle | null })._onasStoryLoop = null;
      return;
    }
    (wrap as HTMLElement & { _onasStoryLoop?: HeroLoopHandle | null })._onasStoryLoop = bindHeroLoop(video, {
      host: wrap,
      markHost: wrap,
      eager: false,
      clickToPause: false,
    });
  }

  function initOnasVideo() {
    const section = document.querySelector('[data-onas-zazemi]');
    if (!section || section.dataset.onasVideoInit === '1') return;
    section.dataset.onasVideoInit = '1';

    const loop = section.querySelector('[data-onas-loop]');
    const modal = document.querySelector('[data-onas-modal]');
    const feature = modal && modal.querySelector('[data-onas-feature]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function armLoop() {
      if (!loop) return;
      const src = loop.getAttribute('data-src');
      if (src && loop.getAttribute('src') !== src) loop.setAttribute('src', src);
    }

    function playLoop() {
      if (!loop || reduced || (modal && !modal.hidden)) return;
      armLoop();
      loop.muted = true;
      const play = loop.play();
      if (play && typeof play.catch === 'function') play.catch(() => {});
    }

    function pauseLoop() {
      if (!loop || loop.paused) return;
      loop.pause();
    }

    if (loop) {
      loop.addEventListener('playing', () => loop.classList.add('is-playing'));
      const io = new IntersectionObserver(
        (entries) => {
          const on = entries.some((entry) => entry.isIntersecting);
          if (on) playLoop();
          else pauseLoop();
        },
        { rootMargin: '200px' }
      );
      io.observe(section);
    }

    function openModal() {
      if (!modal) return;
      pauseLoop();
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      if (feature) {
        try { feature.currentTime = 0; } catch (e) {}
        const play = feature.play();
        if (play && typeof play.catch === 'function') play.catch(() => {});
      }
    }

    function closeModal() {
      if (!modal || modal.hidden) return;
      if (feature) feature.pause();
      modal.hidden = true;
      document.body.style.overflow = '';
      playLoop();
    }

    section.querySelectorAll('[data-onas-ext]').forEach((link) => {
      link.addEventListener('click', (event) => event.stopPropagation());
    });

    section.addEventListener('click', (event) => {
      if (event.target.closest('[data-onas-ext]')) return;
      event.preventDefault();
      openModal();
    });

    if (modal) {
      modal.querySelectorAll('[data-onas-close]').forEach((el) => {
        el.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          closeModal();
        });
      });
    }

    if (!window.__onasEscBound) {
      window.__onasEscBound = true;
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const live = document.querySelector('[data-onas-modal]');
        if (!live || live.hidden) return;
        const liveFeature = live.querySelector('[data-onas-feature]');
        if (liveFeature) liveFeature.pause();
        live.hidden = true;
        document.body.style.overflow = '';
        const liveLoop = document.querySelector('[data-onas-loop]');
        if (
          liveLoop &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          const play = liveLoop.play();
          if (play && typeof play.catch === 'function') play.catch(() => {});
        }
      });
    }
  }

  function initOnasScroll() {
    const link = document.querySelector('.oh__sc');
    const target = document.getElementById('strana-developera');
    if (!link || !target || link.dataset.onasScrollInit === '1') return;
    link.dataset.onasScrollInit = '1';
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const top = window.scrollY + target.getBoundingClientRect().top;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    });
  }

  function initOnasFlow() {
    const page = document.querySelector('.onas');
    if (!page || page.dataset.onasFlowInit === '1') return;
    page.dataset.onasFlowInit = '1';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    page.setAttribute('data-onas-flow', '');

    function introOn() {
      const root = document.documentElement;
      return root.classList.contains('rmi-on') || root.classList.contains('rmm-on');
    }

    function afterIntro(fn) {
      if (!introOn()) {
        fn();
        return;
      }
      let done = false;
      const run = () => {
        if (done) return;
        done = true;
        mo.disconnect();
        fn();
      };
      const mo = new MutationObserver(() => {
        if (!introOn()) run();
      });
      mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      window.setTimeout(run, 4500);
    }

    const hero = page.querySelector('[data-onas-in-hero]');
    if (hero) afterIntro(() => hero.classList.add('is-in'));

    function watch(group) {
      group.querySelectorAll('[data-onas-in-item]').forEach((el, i) => {
        el.style.setProperty('--onas-i', String(i));
      });
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          group.classList.add('is-in');
          playOnasCount(group.querySelector('[data-onas-count]'));
          io.disconnect();
        },
        { threshold: 0.2, rootMargin: '0px 0px -22% 0px' }
      );
      io.observe(group);
    }

    page.querySelectorAll('[data-onas-in]').forEach(watch);
  }

  function playOnasCount(el) {
    if (!el || el.dataset.onasCountPlayed === '1') return;
    el.dataset.onasCountPlayed = '1';
    const target = parseInt(el.getAttribute('data-onas-count') || '200', 10);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      el.textContent = String(target);
      return;
    }
    el.textContent = '0';
    const t0 = performance.now();
    const delay = 160;
    const dur = 1200;
    function frame(now) {
      const t = Math.min(1, (now - t0 - delay) / dur);
      if (t < 0) {
        requestAnimationFrame(frame);
        return;
      }
      const e = 1 - Math.pow(1 - t, 3);
      el.textContent = String(Math.round(e * target));
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  function initOnas() {
    initOnasFlow();
    initOnasStoryLoop();
    initOnasVideo();
    initOnasScroll();
  }

  initOnas();
  document.addEventListener('astro:page-load', initOnas);
</script>
