    .bh__list {
      display: none;
    }
  }
  @media (min-width: 1280px) {
    .bh__cap h2 { font-size: 36px; }
    .bh__cite-q { font-size: 32px; }
    .bh__cite-s { font-size: 17px; }
  }
</style>

<script>
  function initBh() {
    const root = document.querySelector('[data-bh]') as HTMLElement | null;
    if (!root) return;
    if ((root as any)._bhCleanup) (root as any)._bhCleanup();

    const isTrh = root.getAttribute('data-bh-mode') === 'trh';
    const track = root.querySelector('[data-bh-track]') as HTMLElement | null;
    const video = root.querySelector('[data-bh-video]') as HTMLVideoElement | null;
    const claim = root.querySelector('[data-bh-claim]') as HTMLElement | null;
    const hint = root.querySelector('[data-bh-hint]') as HTMLElement | null;
    const trh = root.querySelector('[data-bh-trh]') as HTMLElement | null;
    const fades = Array.from(root.querySelectorAll('[data-bh-fade]')) as HTMLElement[];
    const caps = Array.from(root.querySelectorAll('[data-bh-cap]')) as HTMLElement[];
    const axis = Array.from(root.querySelectorAll('[data-bh-ax]')) as HTMLElement[];
    const fill = root.querySelector('[data-bh-fill]') as HTMLElement | null;
    const cta = root.querySelector('[data-bh-cta]') as HTMLElement | null;
    if (!track || !video || !claim || !hint) return;
    if (!isTrh && (!fill || !cta)) return;

    const desk = window.matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)');
    const deskVideoMq = window.matchMedia('(min-width: 768px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const deskSrc = video.getAttribute('data-src') || '';
    const INTRO = isTrh ? 0.38 : 0.45;
    const START = isTrh ? 0.4 : 0.55;
    const STEP = 0.8;
    const N = caps.length;
    const clamp = (v: number) => Math.max(0, Math.min(1, v));

    video.muted = true;
    video.defaultMuted = true;
    video.volume = 0;
    video.playsInline = true;
    video.setAttribute('muted', '');
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', 'true');

    const tryPlay = () => {
      if (!deskVideoMq.matches || reduceMotion.matches) return;
      const play = video.play();
      if (play) play.catch(() => {});
    };
    const syncDeskVideo = () => {
      if (deskVideoMq.matches && !reduceMotion.matches && deskSrc) {
        if (video.getAttribute('src') !== deskSrc) {
          video.src = deskSrc;
          video.preload = 'auto';
        }
        tryPlay();
      } else {
        video.pause();
        if (video.hasAttribute('src')) {
          video.removeAttribute('src');
          video.load();
        }
      }
    };
    syncDeskVideo();
    video.addEventListener('canplay', tryPlay);
    video.addEventListener('loadeddata', tryPlay);
    deskVideoMq.addEventListener('change', syncDeskVideo);
    reduceMotion.addEventListener('change', syncDeskVideo);

    const sticky = root.querySelector('.bh__sticky') as HTMLElement | null;
    const videoIo = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) tryPlay();
        else if (entry.boundingClientRect.height > 1) video.pause();
      });
    }, { threshold: 0.01 });
    videoIo.observe(sticky || video);

    const reset = () => {
      [claim, hint, ...fades].forEach((el) => el.removeAttribute('style'));
      if (trh) {
        trh.removeAttribute('style');
        trh.classList.remove('is-on');
      }
      caps.forEach((cap) => cap.classList.remove('is-on'));
      axis.forEach((item) => item.classList.remove('is-on', 'is-done'));
      cta?.classList.remove('is-on');
      fill?.removeAttribute('style');
    };

    let raf = 0;
    let last = -2;
    const tick = () => {
      raf = 0;
      if (!desk.matches) {
        reset();
        last = -2;
        return;
      }
      const sc = -track.getBoundingClientRect().top / window.innerHeight;
      const intro = clamp(sc / INTRO);
      claim.style.opacity = String(1 - intro);
      claim.style.transform = `translateY(${-30 * intro}px)`;

      if (isTrh && trh) {
        const show = clamp((sc - 0.26) / 0.18);
        trh.style.opacity = String(show);
        trh.classList.toggle('is-on', show > 0.5);
        return;
      }

      const fade = String(clamp((sc - 0.35) / 0.2));
      fades.forEach((el) => {
        el.style.opacity = fade;
      });

      const raw = (sc - START) / STEP;
      const idx = sc < START ? -1 : Math.min(N - 1, Math.floor(raw));
      if (fill) fill.style.transform = `scaleX(${clamp(raw / Math.max(1, N - 1))})`;
      if (idx !== last) {
        last = idx;
        caps.forEach((cap, i) => cap.classList.toggle('is-on', i === idx));
        axis.forEach((item, i) => {
          item.classList.toggle('is-on', i === idx);
          item.classList.toggle('is-done', i < idx);
        });
        cta?.classList.toggle('is-on', idx === N - 1);
      }
    };
    const req = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    const onGo = (event: Event) => {
      const btn = (event.currentTarget as HTMLElement);
      const i = Number(btn.dataset.bhGo);
      const top = track.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({ top: top + (START + STEP * i + 0.05) * window.innerHeight, behavior: 'smooth' });
    };
    const goBtns = Array.from(root.querySelectorAll('[data-bh-go]'));
    goBtns.forEach((btn) => btn.addEventListener('click', onGo));

    const onHint = (event: Event) => {
      event.preventDefault();
      if (isTrh) {
        const target = document.getElementById('co-delame');
        if (target) {
          const top = target.getBoundingClientRect().top + window.scrollY;
          window.scrollTo({ top, behavior: 'smooth' });
        }
        return;
      }
      if (!desk.matches) {
        document.getElementById('jak-to-probiha')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      const top = track.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({ top: top + (START + 0.05) * window.innerHeight, behavior: 'smooth' });
    };
    hint.addEventListener('click', onHint);

    window.addEventListener('scroll', req, { passive: true });
    window.addEventListener('resize', req);
    desk.addEventListener('change', req);
    req();

    (root as any)._bhCleanup = () => {
      videoIo.disconnect();
      video.removeEventListener('canplay', tryPlay);
      video.removeEventListener('loadeddata', tryPlay);
      deskVideoMq.removeEventListener('change', syncDeskVideo);
      reduceMotion.removeEventListener('change', syncDeskVideo);
      goBtns.forEach((btn) => btn.removeEventListener('click', onGo));
      hint.removeEventListener('click', onHint);
      window.removeEventListener('scroll', req);
      window.removeEventListener('resize', req);
      desk.removeEventListener('change', req);
      if (raf) cancelAnimationFrame(raf);
      (root as any)._bhCleanup = null;
    };
  }

  function initMhero() {
    const vid = document.querySelector('[data-mhero-video]') as HTMLVideoElement | null;
    if (!vid) return;
    if ((vid as any)._mheroCleanup) (vid as any)._mheroCleanup();

    const src = vid.getAttribute('data-src') || '';
    const mobile = window.matchMedia('(max-width: 767px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const sync = () => {
      const want = mobile.matches && !reduced.matches && src;
      if (want) {
        if (vid.getAttribute('src') !== src) {
          vid.src = src;
          vid.preload = 'metadata';
        }
        vid.muted = true;
        vid.playsInline = true;
        vid.setAttribute('playsinline', '');
        vid.setAttribute('webkit-playsinline', 'true');
        const play = vid.play();
        if (play) play.catch(() => {});
      } else {
        vid.pause();
        if (vid.hasAttribute('src')) {
          vid.removeAttribute('src');
          vid.load();
        }
      }
    };

    sync();
    mobile.addEventListener('change', sync);
    reduced.addEventListener('change', sync);
    (vid as any)._mheroCleanup = () => {
      mobile.removeEventListener('change', sync);
      reduced.removeEventListener('change', sync);
      (vid as any)._mheroCleanup = null;
    };
  }

  function initBhSwipe() {
    const scroller = document.querySelector('[data-bh-swipe]') as HTMLElement | null;
    const dots = [...document.querySelectorAll('[data-bh-dots] span')];
    if (!scroller || !dots.length) return;
    if (scroller.dataset.bhSwipeBound === '1') return;
    scroller.dataset.bhSwipeBound = '1';

    const cards = [...scroller.querySelectorAll('li')];
    const update = () => {
      const step = (cards[0]?.offsetWidth || 0) + 12 || 1;
      const active = Math.min(dots.length - 1, Math.max(0, Math.round(scroller.scrollLeft / step)));
      dots.forEach((dot, i) => dot.classList.toggle('is-on', i === active));
    };

    scroller.addEventListener('scroll', update, { passive: true });
    update();
  }

  initBh();
  initBhSwipe();
  initMhero();
  document.addEventListener('astro:page-load', () => {
    initBh();
    initBhSwipe();
    initMhero();
  });
</script>
