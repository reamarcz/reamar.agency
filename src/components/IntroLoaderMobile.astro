---
// Mobilní intro (≤ 767 px): „Developer. / Vás. / Nezastupuje.“ → „My ano.“
// přes hero video, které se pak usadí do hlavičky.
---
<script is:inline>
  (function () {
    var root = document.documentElement;
    try {
      var skip =
        sessionStorage.getItem('rmIntroSeen') === '1' ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !window.matchMedia('(max-width: 767px)').matches;
      root.classList.remove('rmm-on', 'rmm-skip', 'rmm-landing');
      root.classList.add(skip ? 'rmm-skip' : 'rmm-on');
    } catch (e) {
      root.classList.remove('rmm-on', 'rmm-landing');
      root.classList.add('rmm-skip');
    }
  })();
</script>

<div class="rmm" id="rmm" aria-hidden="true">
  <div class="rmm__scrim"></div>
  <div class="rmm__cap">
    <span class="rmm__w rmm__w--1">Developer.</span>
    <span class="rmm__w rmm__w--2">Vás.</span>
    <span class="rmm__w rmm__w--3">Nezastupuje.</span>
    <span class="rmm__w rmm__w--4">My ano.</span>
  </div>
</div>

<style is:global>
  html.rmm-skip .rmm,
  html.rmm-done .rmm { display: none; }
  html.rmm-on:not(.rmm-skip):not(.rmm-done) .rmm { display: block; }
  html.rmm-on:not(.rmm-skip):not(.rmm-done) { overflow: hidden; }

  html.rmm-on:not(.rmm-skip):not(.rmm-done) [data-intro-media] {
    position: fixed !important;
    z-index: 9998;
    inset: 0 !important;
    width: auto !important;
    height: auto !important;
    max-width: none !important;
  }
  html.rmm-on:not(.rmm-skip):not(.rmm-done) .hero-strip-mobile-visual { background: #000; }
  html.rmm-landing [data-intro-media] {
    transition:
      top .8s cubic-bezier(.76, 0, .24, 1),
      left .8s cubic-bezier(.76, 0, .24, 1),
      width .8s cubic-bezier(.76, 0, .24, 1),
      height .8s cubic-bezier(.76, 0, .24, 1);
  }
  [data-intro-media].rmm-still .hero-intro-poster,
  [data-intro-media].rmm-still [data-intro-video] { animation: rmm-kb 5s linear both; }
  @keyframes rmm-kb { from { transform: scale(1); } to { transform: scale(1.06); } }

  .rmm {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    font-family: 'Yellix', system-ui, sans-serif;
    font-weight: 500;
    transition: opacity .3s ease;
    view-transition-name: none;
  }
  .rmm.is-gone { opacity: 0; }
  .rmm__scrim { position: fixed; inset: -2px; background: #000; opacity: .68; transition: opacity .6s ease; }
  .rmm.is-lift .rmm__scrim { opacity: 0; }

  .rmm__cap {
    position: absolute;
    left: 24px; right: 24px;
    top: 0; bottom: 0;
    padding-top: 40px;
    display: grid;
    align-items: center;
    justify-items: center;
    color: #fff;
    letter-spacing: -.03em;
    line-height: 1.05;
    text-align: center;
    transform: translateY(0);
    transition: transform .3s cubic-bezier(.22, 1, .36, 1);
  }
  .rmm.is-lift .rmm__cap { transform: translateY(-28px); }
  .rmm__w { grid-area: 1 / 1; white-space: nowrap; opacity: 0; }
  .rmm__w--1 { font-size: 14.4vw; }
  .rmm__w--2 { font-size: 28vw; }
  .rmm__w--3 { font-size: 13.8vw; }
  .rmm__w--4 { font-size: 19.5vw; }

  .rmm__w.is-on { opacity: 1; animation: rmm-punch .45s linear both; }
  @keyframes rmm-punch { from { transform: scale(1.08); } to { transform: scale(1); } }

  .rmm__w--4.is-on { animation: rmm-land .35s cubic-bezier(.16, 1, .3, 1) both; }
  @keyframes rmm-land { from { transform: scale(.85); } to { transform: scale(1); } }

  .rmm__w--4 { transition: opacity .3s cubic-bezier(.55, 0, .75, .2); }
  .rmm__w--4.is-out {
    opacity: 0;
    animation: none;
  }

  html.rmm-on:not(.rmm-skip):not(.rmm-done) #header,
  html.rmm-on:not(.rmm-skip):not(.rmm-done) .hero-strip-mobile h1 .hero-w > span,
  html.rmm-on:not(.rmm-skip):not(.rmm-done) .hero-strip-mobile-kicker,
  html.rmm-on:not(.rmm-skip):not(.rmm-done) .hero-strip-mhero-lead,
  html.rmm-on:not(.rmm-skip):not(.rmm-done) .hero-strip-mhero-btns {
    opacity: 0;
    transform: translateY(12px);
  }
  html.rmm-on:not(.rmm-skip):not(.rmm-done) #header { pointer-events: none; }
  html.rmm-done #header,
  html.rmm-done .hero-strip-mobile h1 .hero-w > span,
  html.rmm-done .hero-strip-mobile-kicker,
  html.rmm-done .hero-strip-mhero-lead,
  html.rmm-done .hero-strip-mhero-btns {
    animation: rmm-rise .7s cubic-bezier(.22, 1, .36, 1) both;
  }
  html.rmm-done .hero-strip-mobile h1 .hero-w > span { animation-delay: calc(var(--i, 0) * 80ms); }
  html.rmm-done .hero-strip-mobile-kicker { animation-delay: .16s; }
  html.rmm-done .hero-strip-mhero-lead { animation-delay: .24s; }
  html.rmm-done .hero-strip-mhero-btns { animation-delay: .32s; }
  html.rmm-done #header { pointer-events: auto; }
  @keyframes rmm-rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  function startRmm() {
  const root = document.documentElement;
  const el = document.getElementById('rmm');
  if (!el || el.dataset.rmmPlay === '1' || !root.classList.contains('rmm-on') || root.classList.contains('rmm-skip')) return;
  el.dataset.rmmPlay = '1';

  if (el && root.classList.contains('rmm-on')) {
    const medias = Array.from(document.querySelectorAll('[data-intro-media]'));
    const media = medias.find((node) => node.getClientRects().length > 0) || null;
    const video = media ? media.querySelector('[data-intro-video]') : null;
    const words = Array.from(el.querySelectorAll('.rmm__w'));
    const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    let done = false;

    window.scrollTo(0, 0);

    let playing = false;
    const kickVideo = () => {
      if (!video) return;
      video.muted = true;
      video.defaultMuted = true;
      video.volume = 0;
      video.playsInline = true;
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', 'true');
      const play = video.play();
      if (play && typeof play.then === 'function') play.then(mark).catch(() => {});
    };
    const mark = () => {
      playing = true;
      if (media) media.classList.remove('rmm-still');
    };
    if (video) {
      video.addEventListener('playing', mark, { once: true });
      if (!video.paused) mark();
      kickVideo();
      setTimeout(() => { if (!playing && !done && media) media.classList.add('rmm-still'); }, 2000);
    }

    const skipEvents = ['touchstart', 'wheel', 'click', 'keydown'];
    const onSkip = () => {
      kickVideo();
      finish();
    };
    skipEvents.forEach((ev) => window.addEventListener(ev, onSkip, { passive: true }));

    const cleanup = () => {
      if (media) ['top', 'left', 'width', 'height'].forEach((prop) => media.style.removeProperty(prop));
      root.classList.remove('rmm-on', 'rmm-landing');
      root.classList.add('rmm-done', 'rmm-skip');
      el.classList.add('is-gone');
      window.dispatchEvent(new CustomEvent('rm:intro-done'));
      setTimeout(() => el.remove(), 350);
    };

    function finish() {
      if (done) return;
      done = true;
      skipEvents.forEach((ev) => window.removeEventListener(ev, onSkip));
      try { sessionStorage.setItem('rmIntroSeen', '1'); } catch (e) {}
      cleanup();
    }

    const flash = async (word, ms) => {
      word.classList.add('is-on');
      await wait(ms);
      word.classList.remove('is-on');
    };

    const land = async () => {
      if (!media || !media.parentElement) return;
      const r = media.parentElement.getBoundingClientRect();
      const frame = el.getBoundingClientRect();
      media.style.top = frame.top + 'px';
      media.style.left = frame.left + 'px';
      media.style.width = frame.width + 'px';
      media.style.height = frame.height + 'px';
      await new Promise((res) => requestAnimationFrame(() => requestAnimationFrame(res)));
      root.classList.add('rmm-landing');
      media.style.top = r.top + 'px';
      media.style.left = r.left + 'px';
      media.style.width = r.width + 'px';
      media.style.height = r.height + 'px';
      await wait(800);
    };

    (async () => {
      try { await Promise.race([document.fonts.load('500 60px Yellix'), wait(800)]); } catch (e) {}
      if (done) return;

      await wait(200); if (done) return;
      await flash(words[0], 400); if (done) return;
      await flash(words[1], 400); if (done) return;
      await flash(words[2], 500); if (done) return;

      words[3].classList.add('is-on');
      await wait(900); if (done) return;
      words[3].classList.add('is-out');
      el.classList.add('is-lift');
      await wait(250); if (done) return;

      await land();
      if (done) return;
      done = true;
      skipEvents.forEach((ev) => window.removeEventListener(ev, onSkip));
      try { sessionStorage.setItem('rmIntroSeen', '1'); } catch (e) {}
      cleanup();
    })();
  }
  }

  startRmm();
  document.addEventListener('astro:page-load', startRmm);
</script>
