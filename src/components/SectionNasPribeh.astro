---
interface Props {
  ctaHref?: string | false;
  ctaLabel?: string;
  headingAs?: 'h1' | 'h2';
  underNav?: boolean;
  kicker?: string;
}

const {
  ctaHref = '/#pribeh',
  ctaLabel = 'Náš příběh',
  headingAs = 'h2',
  underNav = false,
  kicker,
} = Astro.props;
const Heading = headingAs;
const ctaExternal = typeof ctaHref === 'string' && ctaHref.startsWith('http');
const image = '/images/agency/Storyholder.jpeg';
const lines = [
  { text: 'Nejdřív pro sebe.', em: false, indent: 0 },
  { text: 'Pak pro rodinu.', em: false, indent: 1 },
  { text: 'Dnes pro klienty.', em: true, indent: 2 },
];
---

<section
  id="o-nas"
  class:list={['pribeh-section relative w-full overflow-hidden', underNav && 'pribeh-section--hero']}
  aria-labelledby="pribeh-heading"
  data-pribeh
>
  <div class="relative h-[64vh] min-h-[520px] max-h-[760px] w-full">
    <div class="absolute inset-0" data-sm-parallax>
      <img
        src={image}
        alt=""
        class="h-full w-full object-cover object-[42%_center]"
        width="1280"
        height="853"
        loading={underNav ? 'eager' : 'lazy'}
      />
    </div>

    <div class="pribeh-inner relative mx-auto flex h-full max-w-[1440px] items-center px-5 py-8 md:px-10 md:py-12 xl:px-14 xl:py-14">
      <div class="flex w-full max-w-[32rem] flex-col gap-10">
        <Heading
          id="pribeh-heading"
          class="font-yellix text-[22px] font-medium leading-[1.18] tracking-[-0.02em] text-white md:text-[28px] xl:text-[32px] [text-shadow:0_1px_16px_rgba(0,0,0,0.35)]"
        >
          {kicker && <span class="pribeh-kicker">{kicker}</span>}
          {lines.map((line, index) => (
            <span
              class:list={['pribeh-line', line.em && 'pribeh-em']}
              style={`--i: ${index}; --indent: ${line.indent}`}
            >
              {line.text}
            </span>
          ))}
        </Heading>

        <div class="pribeh-body">
          <p class="font-yellix text-[14px] font-medium leading-[1.55] text-white md:text-[15px] [text-shadow:0_1px_12px_rgba(0,0,0,0.4)]">
            Na developerském trhu se sami dlouhodobě pohybujeme a sami na něm nakupujeme. Postupně jsme začali stejným způsobem pomáhat rodině, blízkým a lidem kolem nás.
          </p>
          <p class="mt-4 font-yellix text-[14px] font-medium leading-[1.55] text-white md:text-[15px] [text-shadow:0_1px_12px_rgba(0,0,0,0.4)]">
            Čím častěji jsme to řešili, tím jasnější bylo, že taková služba nemá zůstat jen pro náš okruh. Kupující ji potřebují také.
          </p>
          {ctaHref && (
            <a
              href={ctaHref}
              class="mt-6 inline-flex items-center gap-1.5 bg-white px-3 py-1.5 font-yellix text-[13px] font-medium leading-none text-black no-underline transition-opacity hover:opacity-85"
              target={ctaExternal ? '_blank' : undefined}
              rel={ctaExternal ? 'noopener noreferrer' : undefined}
            >
              <img src="/images/arrow-1.svg" alt="" class="h-3 w-3 shrink-0 brightness-0" width="12" height="12" />
              {ctaLabel}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pribeh-section {
    z-index: 40;
  }
  .pribeh-section--hero {
    margin-top: -80px;
    background: #111;
  }
  .pribeh-section--hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.52) 0%, rgba(0, 0, 0, 0.18) 38%, transparent 62%);
    pointer-events: none;
  }
  .pribeh-section--hero .pribeh-inner {
    z-index: 2;
    padding-top: 6.5rem;
  }
  @media (min-width: 768px) {
    .pribeh-section--hero {
      margin-top: -108px;
    }
    .pribeh-section--hero .pribeh-inner {
      padding-top: 8.5rem;
    }
  }
  .pribeh-kicker {
    display: block;
    margin-bottom: 1.1rem;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.82;
  }
  .pribeh-line {
    display: block;
    width: fit-content;
    opacity: 0;
    transform: translateY(14px);
    margin-left: calc(var(--indent) * 1.25rem);
  }
  .pribeh-line.is-in {
    animation: pribeh-line-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i) * 220ms);
  }
  @keyframes pribeh-line-in {
    to { opacity: 1; transform: translateY(0); }
  }
  .pribeh-em {
    width: fit-content;
    border-bottom: 2.5px solid #fff;
    padding-bottom: 0.02em;
  }
  .pribeh-body {
    margin-left: 2.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .pribeh-line {
      opacity: 1;
      transform: none;
    }
    .pribeh-line.is-in {
      animation: none;
    }
  }
</style>

<script>
  function initPribeh() {
    const wrap = document.querySelector('[data-pribeh]');
    if (!wrap) return;
    if (wrap._pribehCleanup) wrap._pribehCleanup();

    const lines = [...wrap.querySelectorAll('.pribeh-line')];
    if (!lines.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      lines.forEach((el) => el.classList.add('is-in'));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        lines.forEach((el) => el.classList.add('is-in'));
        io.disconnect();
      },
      { threshold: 0.16, rootMargin: '0px 0px -8% 0px' }
    );

    io.observe(wrap);

    wrap._pribehCleanup = () => {
      io.disconnect();
      wrap._pribehCleanup = null;
    };
  }

  initPribeh();
  document.addEventListener('astro:page-load', initPribeh);
</script>
