---
const navLinks = [
  { href: '/#developery', label: 'Pro developery' },
  { href: '/#klienty', label: 'Pro klienty' },
  { href: '/#zahranici', label: 'Zahraničí' },
  { href: '/kontakt', label: 'Kontakt' },
];

---

<header id="header" class="fixed inset-x-0 top-0 z-[70] w-full transition-all duration-300 ease-out" role="banner" data-nav>
  <div class="nav-bar-inner relative h-[75px] md:h-[91px] w-full">
    <button type="button" class="nav-btn-edge nav-btn-left absolute top-1/2 -translate-y-1/2 flex items-center gap-2 border-0 bg-transparent p-0 text-black cursor-pointer z-10" aria-expanded="false" aria-controls="menu-drawer" aria-label="Menu" data-nav-toggle>
      <span class="flex items-center justify-center w-6 h-6 transition-opacity duration-200" data-nav-hamburger>
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </span>
      <span class="absolute left-0 top-1/2 -translate-y-1/2 flex items-center gap-2 opacity-0 pointer-events-none transition-opacity duration-200" data-nav-close-wrap aria-hidden="true">
        <span class="w-6 h-6 relative flex-shrink-0"><span class="absolute left-1/2 top-1/2 w-3.5 h-px bg-current -translate-x-1/2 -translate-y-1/2 rotate-45"></span><span class="absolute left-1/2 top-1/2 w-3.5 h-px bg-current -translate-x-1/2 -translate-y-1/2 -rotate-45"></span></span>
        <span class="hidden md:inline font-yellix text-[14px] font-medium">Zavřít</span>
      </span>
    </button>

    <a href="/" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center opacity-0 scale-150 pointer-events-none transition-all duration-300 ease-out origin-top" data-nav-logo title="Reamar">
      <img src="/images/logo-rig-b.svg" alt="Reamar" width="140" height="36" class="h-[46px] md:h-[51px] w-auto object-contain" />
    </a>

    <button type="button" class="nav-btn-edge nav-btn-right absolute right-0 top-1/2 -translate-y-1/2 hidden md:flex items-center gap-2 border-0 bg-transparent p-0 font-yellix text-[14px] font-medium text-black cursor-pointer hover:opacity-80 transition-opacity" aria-controls="contact-drawer" aria-expanded="false" data-contact-toggle>
      <span data-contact-label>Kontakt</span>
      <span class="absolute right-0 top-1/2 -translate-y-1/2 flex items-center gap-2 opacity-0 pointer-events-none transition-opacity duration-200" data-contact-close-wrap aria-hidden="true">
        <span class="font-yellix text-[14px] font-medium">Zavřít</span>
        <span class="w-6 h-6 relative flex-shrink-0"><span class="absolute left-1/2 top-1/2 w-3.5 h-px bg-current -translate-x-1/2 -translate-y-1/2 rotate-45"></span><span class="absolute left-1/2 top-1/2 w-3.5 h-px bg-current -translate-x-1/2 -translate-y-1/2 -rotate-45"></span></span>
      </span>
    </button>
  </div>
</header>

<!-- Menu drawer (hamburger): bílý panel vlevo + zatmavení -->
<div id="menu-drawer" class="fixed inset-0 z-[60] pointer-events-none transition-opacity duration-300" aria-hidden="true" data-menu-drawer>
  <button type="button" class="absolute inset-0 bg-black/85 opacity-0 transition-opacity duration-300 data-[open]:opacity-100 pointer-events-none data-[open]:pointer-events-auto" data-drawer-backdrop aria-label="Zavřít menu"></button>
  <div class="absolute left-0 top-0 bottom-0 w-full md:w-1/4 bg-white flex flex-col opacity-0 -translate-x-full transition-all duration-300 pointer-events-auto data-[open]:opacity-100 data-[open]:translate-x-0 z-10" data-drawer-panel>
    <button type="button" class="flex items-center gap-2 pt-8 pb-6 pl-12 pr-8 w-full text-left border-0 bg-transparent shadow-none cursor-pointer hover:opacity-80 transition-opacity" aria-label="Zavřít menu" data-drawer-close>
      <span class="relative flex items-center justify-center w-10 h-10 flex-shrink-0"><span class="absolute left-1/2 top-1/2 w-5 h-px bg-current -translate-x-1/2 -translate-y-1/2 rotate-45"></span><span class="absolute left-1/2 top-1/2 w-5 h-px bg-current -translate-x-1/2 -translate-y-1/2 -rotate-45"></span></span>
      <span class="font-yellix text-[14px] font-medium text-black drawer-close-label">Zavřít</span>
    </button>
    <nav class="flex flex-col pt-8 pl-12 pr-8 gap-6" aria-label="Hlavní">
      {navLinks.map((link) => link.href === '/kontakt' ? (
        <button type="button" class="font-yellix text-[24px] font-medium text-black leading-tight text-left w-full border-0 bg-transparent p-0 cursor-pointer hover:opacity-70 transition-opacity" data-drawer-close data-contact-open>{link.label}</button>
      ) : (
        <a href={link.href} class="font-yellix text-[24px] font-medium text-black leading-tight hover:opacity-70 transition-opacity" data-drawer-close>{link.label}</a>
      ))}
    </nav>
    <div class="mt-auto pt-8 pb-10 pl-12 pr-8 md:hidden">
      <div class="font-yellix text-[16px] leading-relaxed space-y-4 mb-6">
        <div><p class="text-[14px] text-black/70">Adresa</p><p class="font-medium text-black">Záběhlický zámek, Praha 10</p></div>
        <div><p class="text-[14px] text-black/70">Telefon</p><p class="font-medium text-black"><a href="tel:+420607066044" class="hover:opacity-80 transition-opacity">+420 607 066 044</a></p></div>
      </div>
      <p class="font-yellix text-[16px] font-medium text-black mb-4">Rychlý kontakt</p>
      <div class="flex flex-col gap-4">
        <a href="mailto:info@reamar.cz" class="flex items-center gap-3 group hidden md:flex" data-drawer-close><span class="w-6 h-6 flex-shrink-0 flex items-center justify-center text-black group-hover:opacity-70 transition-opacity"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><span class="font-yellix text-[16px] font-medium text-black group-hover:opacity-70 transition-opacity">Napsat zprávu</span></a>
        <a href="https://wa.me/420607066044" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 group flex md:hidden" data-drawer-close><span class="w-6 h-6 flex-shrink-0 flex items-center justify-center text-black group-hover:opacity-70 transition-opacity"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><span class="font-yellix text-[16px] font-medium text-black group-hover:opacity-70 transition-opacity">Napsat zprávu</span></a>
        <a href="#" class="flex items-center gap-3 group" data-drawer-close data-smart-contact-open><span class="w-6 h-6 flex-shrink-0 flex items-center justify-center text-black group-hover:opacity-70 transition-opacity"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 7h10M7 12h10M7 17h6"/></svg></span><span class="font-yellix text-[16px] font-medium text-black group-hover:opacity-70 transition-opacity">Poptávkový formulář</span></a>
        <a href="#" class="flex items-center gap-3 group" data-drawer-close data-smart-meeting-open><span class="w-6 h-6 flex-shrink-0 flex items-center justify-center text-black group-hover:opacity-70 transition-opacity"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><span class="font-yellix text-[16px] font-medium text-black group-hover:opacity-70 transition-opacity">Osobní schůzka v Praze nebo online</span></a>
      </div>
    </div>
  </div>
</div>

<!-- Kontaktní sidebar: bílý panel vpravo + zatmavení -->
<div id="contact-drawer" class="fixed inset-0 z-[60] pointer-events-none transition-opacity duration-300" aria-hidden="true" data-contact-drawer>
  <button type="button" class="absolute inset-0 bg-black/85 opacity-0 transition-opacity duration-300 data-[open]:opacity-100 pointer-events-none data-[open]:pointer-events-auto" data-contact-backdrop aria-label="Zavřít"></button>
  <div class="absolute right-0 top-0 bottom-0 w-full md:w-1/4 bg-white flex flex-col opacity-0 translate-x-full transition-all duration-300 pointer-events-auto data-[open]:opacity-100 data-[open]:translate-x-0 z-10" data-contact-panel>
    <button type="button" class="flex items-center gap-2 pt-10 pb-8 pl-10 pr-12 w-full justify-end border-0 bg-transparent cursor-pointer hover:opacity-80 transition-opacity" aria-label="Zavřít" data-contact-close>
      <span class="font-yellix text-[14px] font-medium text-black">Zavřít</span>
      <span class="relative flex items-center justify-center w-10 h-10 flex-shrink-0"><span class="absolute left-1/2 top-1/2 w-5 h-px bg-current -translate-x-1/2 -translate-y-1/2 rotate-45"></span><span class="absolute left-1/2 top-1/2 w-5 h-px bg-current -translate-x-1/2 -translate-y-1/2 -rotate-45"></span></span>
    </button>
    <div class="flex-1 overflow-y-auto px-12 pb-14 pt-2">
      <h2 class="font-yellix text-[24px] font-medium text-black leading-tight mb-10">Kontaktujte nás</h2>
      <div class="flex flex-col gap-6">
        <a href="mailto:info@reamar.cz" class="flex items-center gap-4 group py-1 hidden md:flex" data-contact-close><span class="w-6 h-6 flex-shrink-0 flex items-center justify-center text-black group-hover:opacity-70 transition-opacity"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><span class="font-yellix text-[16px] font-medium text-black group-hover:opacity-70 transition-opacity">Napsat zprávu</span></a>
        <a href="https://wa.me/420607066044" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 group py-1 flex md:hidden" data-contact-close><span class="w-6 h-6 flex-shrink-0 flex items-center justify-center text-black group-hover:opacity-70 transition-opacity"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><span class="font-yellix text-[16px] font-medium text-black group-hover:opacity-70 transition-opacity">Napsat zprávu</span></a>
        <a href="#" class="flex items-center gap-4 group py-1" data-contact-close data-smart-contact-open><span class="w-6 h-6 flex-shrink-0 flex items-center justify-center text-black group-hover:opacity-70 transition-opacity"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 7h10M7 12h10M7 17h6"/></svg></span><span class="font-yellix text-[16px] font-medium text-black group-hover:opacity-70 transition-opacity">Poptávkový formulář</span></a>
        <a href="#" class="flex items-center gap-4 group py-1" data-contact-close data-smart-meeting-open><span class="w-6 h-6 flex-shrink-0 flex items-center justify-center text-black group-hover:opacity-70 transition-opacity"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><span class="font-yellix text-[16px] font-medium text-black group-hover:opacity-70 transition-opacity">Osobní schůzka v Praze nebo online</span></a>
      </div>
      <div class="mt-12 pt-8 font-yellix text-[16px] leading-relaxed space-y-5">
        <div><p class="font-normal text-black/70">Adresa</p><p class="font-medium text-black">Záběhlický zámek, Praha 10</p></div>
        <div><p class="font-normal text-black/70">Telefon</p><p class="font-medium text-black"><a href="tel:+420607066044" class="hover:opacity-80 transition-opacity">+420 607 066 044</a></p></div>
        <div><p class="font-normal text-black/70">E-mail</p><p class="font-medium text-black"><a href="mailto:info@reamar.cz" class="hover:opacity-80 transition-opacity">info@reamar.cz</a></p></div>
      </div>
    </div>
  </div>
</div>

<style>
  header[data-nav] { width: 100%; max-width: none; }
  header[data-nav] .nav-bar-inner { width: 100%; box-sizing: border-box; }
  header[data-nav] .nav-btn-edge.nav-btn-left { left: 1rem; }
  header[data-nav] .nav-btn-edge.nav-btn-right { left: auto; right: 10vh; }
  @media (min-width: 768px) {
    header[data-nav] .nav-btn-edge.nav-btn-left { left: 10vh; }
  }

  [data-drawer-panel] [data-drawer-close],
  [data-contact-panel] [data-contact-close],
  [data-drawer-panel],
  [data-contact-panel] {
    box-shadow: none !important;
    border: none !important;
    -webkit-appearance: none;
    appearance: none;
  }
  @media (max-width: 767px) {
    [data-drawer-panel] .drawer-close-label { display: none !important; }
  }
</style>

<script>
  (function () {
    const header = document.querySelector('[data-nav]');
    const navLogo = document.querySelector('[data-nav-logo]');
    const heroLogo = document.querySelector('[data-hero-logo]');
    const toggle = document.querySelector('[data-nav-toggle]');
    const hamburger = document.querySelector('[data-nav-hamburger]');
    const closeWrap = document.querySelector('[data-nav-close-wrap]');
    const drawer = document.querySelector('[data-menu-drawer]');
    const backdrop = document.querySelector('[data-drawer-backdrop]');
    const panel = document.querySelector('[data-drawer-panel]');
    const contactDrawer = document.querySelector('[data-contact-drawer]');
    const contactBackdrop = document.querySelector('[data-contact-backdrop]');
    const contactPanel = document.querySelector('[data-contact-panel]');
    const contactToggle = document.querySelector('[data-contact-toggle]');
    const contactLabel = document.querySelector('[data-contact-label]');
    const contactCloseWrap = document.querySelector('[data-contact-close-wrap]');

    if (!header) return;

    const BAR_HEIGHT = 91;
    const SCROLL_SHOW = 60;
    const isSubpage = !heroLogo;

    if (!isSubpage) {
      header.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-100%]');
    } else {
      header.classList.add('bg-white');
      if (navLogo) {
        navLogo.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
        navLogo.classList.remove('opacity-0', 'pointer-events-none', 'scale-150');
      }
    }

    function updateHeader() {
      if (isSubpage) {
        header.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-100%]');
        header.classList.add('bg-white');
        if (navLogo) {
          navLogo.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
          navLogo.classList.remove('opacity-0', 'pointer-events-none', 'scale-150');
        }
        return;
      }
      const y = window.scrollY ?? document.documentElement.scrollTop;
      if (y <= SCROLL_SHOW) {
        header.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-100%]');
        header.classList.remove('bg-white');
        if (navLogo) { navLogo.classList.add('opacity-0', 'pointer-events-none', 'scale-150'); navLogo.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100'); }
        return;
      }
      header.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-100%]');
      header.classList.add('bg-white');
      if (navLogo && heroLogo) {
        const heroRect = heroLogo.getBoundingClientRect();
        const showLogo = heroRect.bottom <= BAR_HEIGHT;
        navLogo.classList.toggle('opacity-100', showLogo);
        navLogo.classList.toggle('pointer-events-auto', showLogo);
        navLogo.classList.toggle('scale-100', showLogo);
        navLogo.classList.toggle('opacity-0', !showLogo);
        navLogo.classList.toggle('pointer-events-none', !showLogo);
        navLogo.classList.toggle('scale-150', !showLogo);
      }
    }
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();

    function openDrawer() {
      if (!drawer || !backdrop) return;
      drawer.setAttribute('data-open', '');
      drawer.classList.remove('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'false');
      backdrop.setAttribute('data-open', '');
      if (panel) panel.setAttribute('data-open', '');
      document.body.style.overflow = 'hidden';
      if (toggle) { toggle.setAttribute('aria-expanded', 'true'); hamburger?.classList.add('opacity-0', 'pointer-events-none'); closeWrap?.classList.remove('opacity-0', 'pointer-events-none'); closeWrap?.setAttribute('aria-hidden', 'false'); }
    }
    function closeDrawer() {
      if (!drawer || !backdrop) return;
      drawer.removeAttribute('data-open');
      drawer.classList.add('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'true');
      backdrop.removeAttribute('data-open');
      if (panel) panel.removeAttribute('data-open');
      document.body.style.overflow = '';
      if (toggle) { toggle.setAttribute('aria-expanded', 'false'); hamburger?.classList.remove('opacity-0', 'pointer-events-none'); closeWrap?.classList.add('opacity-0', 'pointer-events-none'); closeWrap?.setAttribute('aria-hidden', 'true'); }
    }

    toggle?.addEventListener('click', () => { toggle.getAttribute('aria-expanded') === 'true' ? closeDrawer() : openDrawer(); });
    backdrop?.addEventListener('click', closeDrawer);
    document.querySelectorAll('[data-drawer-close]').forEach(btn => btn.addEventListener('click', closeDrawer));

    function openContactDrawer() {
      if (!contactDrawer || !contactBackdrop) return;
      contactDrawer.setAttribute('data-open', '');
      contactDrawer.classList.remove('pointer-events-none');
      contactDrawer.setAttribute('aria-hidden', 'false');
      contactBackdrop.setAttribute('data-open', '');
      contactPanel?.setAttribute('data-open', '');
      document.body.style.overflow = 'hidden';
      contactToggle?.setAttribute('aria-expanded', 'true');
      contactLabel?.classList.add('opacity-0', 'pointer-events-none');
      contactCloseWrap?.classList.remove('opacity-0', 'pointer-events-none');
      contactCloseWrap?.setAttribute('aria-hidden', 'false');
    }
    function closeContactDrawer() {
      if (!contactDrawer || !contactBackdrop) return;
      contactDrawer.removeAttribute('data-open');
      contactDrawer.classList.add('pointer-events-none');
      contactDrawer.setAttribute('aria-hidden', 'true');
      contactBackdrop.removeAttribute('data-open');
      contactPanel?.removeAttribute('data-open');
      document.body.style.overflow = '';
      contactToggle?.setAttribute('aria-expanded', 'false');
      contactLabel?.classList.remove('opacity-0', 'pointer-events-none');
      contactCloseWrap?.classList.add('opacity-0', 'pointer-events-none');
      contactCloseWrap?.setAttribute('aria-hidden', 'true');
    }

    contactToggle?.addEventListener('click', () => { contactDrawer?.hasAttribute('data-open') ? closeContactDrawer() : openContactDrawer(); });
    contactBackdrop?.addEventListener('click', closeContactDrawer);
    document.querySelectorAll('[data-contact-close]').forEach(btn => btn.addEventListener('click', closeContactDrawer));
    document.querySelectorAll('[data-contact-open]').forEach(btn => btn.addEventListener('click', () => { closeDrawer(); openContactDrawer(); }));

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (contactDrawer?.hasAttribute('data-open')) closeContactDrawer();
      else if (drawer?.hasAttribute('data-open')) closeDrawer();
    });
  })();
</script>
