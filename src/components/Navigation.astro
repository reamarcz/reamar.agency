---
type NavLink = { href: string; label: string; external?: boolean };

const defaultNavLinks: NavLink[] = [
  { href: '/bydleni', label: 'Bydlení' },
  { href: '/investice', label: 'Investice' },
  { href: '/o-nas', label: 'O nás' },
];

const onepagerNavLinks: NavLink[] = [
  { href: '#koncept', label: 'Co děláme' },
  { href: '#specializace', label: 'Specializace' },
  { href: 'https://www.reamar.cz/', label: 'O nás', external: true },
  { href: '#nejcastejsi-otazky', label: 'FAQ' },
];

const { currentPath = '/' } = Astro.props;
const path = currentPath.replace(/\/$/, '') || '/';
const cinematicNav = path === '/bydleni' || path === '/investice' || path === '/investice-2';
const fullbleedNav = path === '/' || cinematicNav || path === '/o-nas';
const portalNav = path === '/klientsky-portal';
const autohideNav = path === '/' || path === '/investice' || path === '/investice-2' || path === '/o-nas';
const storiesOverview = path === '/pribehy-z-trhu';
const overlayNav = path === '/agent-pro-kupujici' || path === '/o-nas' || storiesOverview || fullbleedNav;
const isOnepager = path === '/agentura-pro-kupujici-onepager';
const navLinks = isOnepager ? onepagerNavLinks : defaultNavLinks;
const sluzbyHref = isOnepager ? '#vyber-sluzeb' : '/sluzby';
const isCurrent = (href: string) => {
  const linkPath = href.split('#')[0];
  if (!linkPath || linkPath === '/') return false;
  if (linkPath === '/bydleni' && path.startsWith('/bydleni')) return true;
  if (linkPath === '/investice' && path.startsWith('/investice')) return true;
  if (linkPath === '/klientsky-portal' && path.startsWith('/klientsky-portal')) return true;
  if (linkPath === '/pribehy-z-trhu' && path.startsWith('/pribehy-z-trhu')) return true;
  if (linkPath === '/o-nas' && path.startsWith('/o-nas')) return true;
  return path === linkPath;
};
---

<header
  id="header"
  class:list={[
    'inset-x-0 top-0 z-[70] w-full',
    fullbleedNav || portalNav ? 'fixed' : 'sticky',
    !overlayNav && 'bg-white',
  ]}
  role="banner"
  data-nav
  data-path={currentPath}
  data-nav-overlay={overlayNav ? '' : undefined}
  data-nav-fullbleed={fullbleedNav ? '' : undefined}
  data-nav-autohide={autohideNav ? '' : undefined}
>
  <div class="nav-bar-inner mx-auto flex h-[80px] w-full max-w-[1440px] items-center justify-between px-5 md:h-[108px] md:px-10 xl:px-14">
    <div class="flex min-w-0 items-center gap-5 md:gap-8">
      <a href={isOnepager ? '/agentura-pro-kupujici-onepager' : '/'} class="relative flex shrink-0 items-center" title="Reamar">
        <img
          src="/images/logo-rig-b.svg"
          alt="Reamar"
          width="140"
          height="36"
          class="nav-logo nav-logo-b h-10 w-auto object-contain md:h-12"
        />
        <img
          src="/images/logo-rig-w.svg"
          alt=""
          width="140"
          height="36"
          class="nav-logo nav-logo-w h-10 w-auto object-contain md:h-12"
          aria-hidden="true"
        />
      </a>
      {!overlayNav && (
        <div class="nav-aside hidden min-w-0 md:block" data-nav-aside>
          <div class="nav-live" data-nav-live>
            <p class="nav-muted font-yellix text-[10px] font-medium leading-none text-black/50">Aktuální nabídka v Praze a okolí</p>
            <p class="nav-fg mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 font-yellix text-[13px] leading-none text-black">
              <span class="nav-live-dot" aria-hidden="true"></span>
              <span class="font-medium">562 projektů</span>
              <span class="nav-muted font-medium text-black/55">9 689 jednotek</span>
            </p>
          </div>
          <p class="nav-title nav-fg font-yellix text-[13px] font-medium leading-[1.2] text-black" data-nav-title aria-hidden="true">
            Zastupujeme kupující<br />
            na developerském trhu
          </p>
        </div>
      )}
    </div>

    <nav class="hidden items-center gap-5 xl:gap-9 lg:flex" aria-label="Hlavní" data-nav-desktop>
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'nav-fg font-yellix text-[14px] text-black no-underline whitespace-nowrap transition-opacity hover:opacity-70',
            isCurrent(link.href) ? 'font-semibold' : 'font-medium',
          ]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
        </a>
      ))}

      {!isOnepager && (
        <a
          href="/pribehy-z-trhu/"
          class:list={[
            'nav-fg inline-flex items-center gap-2 font-yellix text-[14px] text-black no-underline whitespace-nowrap transition-opacity hover:opacity-70',
            isCurrent('/pribehy-z-trhu') ? 'font-semibold' : 'font-medium',
          ]}
          aria-current={isCurrent('/pribehy-z-trhu') ? 'page' : undefined}
        >
          <svg class="h-[13px] w-[18px] shrink-0" viewBox="0 0 24 17" aria-hidden="true">
            <path fill="#FF0000" d="M23.5 2.65A3.02 3.02 0 0 0 21.38.5C19.5 0 12 0 12 0S4.5 0 2.62.5A3.02 3.02 0 0 0 .5 2.65 31.9 31.9 0 0 0 0 8.5a31.9 31.9 0 0 0 .5 5.85 3.02 3.02 0 0 0 2.12 2.15C4.5 17 12 17 12 17s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.15A31.9 31.9 0 0 0 24 8.5a31.9 31.9 0 0 0-.5-5.85Z"/>
            <path fill="#fff" d="M9.75 12.15V4.85L15.7 8.5 9.75 12.15Z"/>
          </svg>
          Příběhy z trhu
        </a>
      )}

      {!isOnepager && (
        <a
          href="/klientsky-portal"
          class:list={[
            'nav-fg inline-flex items-center gap-2 font-yellix text-[14px] text-black no-underline whitespace-nowrap transition-opacity hover:opacity-70',
            isCurrent('/klientsky-portal') ? 'font-semibold' : 'font-medium',
          ]}
          aria-current={isCurrent('/klientsky-portal') ? 'page' : undefined}
        >
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="3.2"/>
            <path d="M5.4 19.2c.7-3.3 3.3-5.1 6.6-5.1s5.9 1.8 6.6 5.1"/>
          </svg>
          Klientský portál
        </a>
      )}

      <a
        href={sluzbyHref}
        class:list={[
          'nav-cta inline-flex items-center gap-1.5 bg-black px-3 py-1.5 font-yellix text-[13px] text-white no-underline whitespace-nowrap transition-opacity hover:opacity-85',
          isCurrent('/sluzby') ? 'font-semibold' : 'font-medium',
        ]}
        aria-current={isCurrent('/sluzby') ? 'page' : undefined}
      >
        <img src="/images/arrow-1.svg" alt="" class="h-3 w-3 shrink-0" width="12" height="12" />
        Vybrat službu
      </a>
    </nav>

    <div class="flex items-center gap-2 lg:hidden">
    <button
      type="button"
      class="nav-fg flex h-10 w-10 items-center justify-center border-0 bg-transparent p-0 text-black lg:hidden"
      aria-expanded="false"
      aria-controls="menu-drawer"
      aria-label="Menu"
      data-nav-toggle
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
    </div>
  </div>
</header>

<div
  id="menu-drawer"
  class="fixed inset-0 z-[80] pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
  data-menu-drawer
>
  <button
    type="button"
    class="absolute inset-0 bg-black/85 opacity-0 transition-opacity duration-300 data-[open]:opacity-100 pointer-events-none data-[open]:pointer-events-auto"
    data-drawer-backdrop
    aria-label="Zavřít menu"
  ></button>
  <div
    class="absolute inset-0 z-10 flex min-h-0 w-full flex-col bg-white opacity-0 pointer-events-none transition-opacity duration-300 data-[open]:pointer-events-auto data-[open]:opacity-100"
    data-drawer-panel
  >
    <button
      type="button"
      class="flex h-[80px] shrink-0 items-center justify-end gap-2 px-5 w-full border-0 bg-transparent cursor-pointer hover:opacity-80"
      aria-label="Zavřít menu"
      data-drawer-close
    >
      <span class="font-yellix text-[14px] font-medium text-black">Zavřít</span>
      <span class="relative flex h-10 w-10 shrink-0 items-center justify-center">
        <span class="absolute left-1/2 top-1/2 h-px w-5 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-current"></span>
        <span class="absolute left-1/2 top-1/2 h-px w-5 -translate-x-1/2 -translate-y-1/2 -rotate-45 bg-current"></span>
      </span>
    </button>

    <nav class="flex min-h-0 flex-1 flex-col gap-6 overflow-y-auto px-5 pb-6 pt-2" aria-label="Hlavní">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'font-yellix text-[21px] leading-tight text-black no-underline hover:opacity-70',
            isCurrent(link.href) ? 'font-semibold' : 'font-medium',
          ]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          data-drawer-close
        >
          {link.label}
        </a>
      ))}

      <a
        href="/#kontakt"
        class="font-yellix text-[21px] font-medium leading-tight text-black no-underline hover:opacity-70"
        data-nav-home-kontakt
        data-drawer-close
      >
        Kontakty
      </a>

      {!isOnepager && (
        <a
          href="/pribehy-z-trhu/"
          class:list={[
            'mt-2 inline-flex items-center gap-2.5 font-yellix text-[21px] leading-tight text-black no-underline hover:opacity-70',
            isCurrent('/pribehy-z-trhu') ? 'font-semibold' : 'font-medium',
          ]}
          aria-current={isCurrent('/pribehy-z-trhu') ? 'page' : undefined}
          data-drawer-close
        >
          <svg class="h-3.5 w-5 shrink-0" viewBox="0 0 24 17" aria-hidden="true">
            <path fill="#FF0000" d="M23.5 2.65A3.02 3.02 0 0 0 21.38.5C19.5 0 12 0 12 0S4.5 0 2.62.5A3.02 3.02 0 0 0 .5 2.65 31.9 31.9 0 0 0 0 8.5a31.9 31.9 0 0 0 .5 5.85 3.02 3.02 0 0 0 2.12 2.15C4.5 17 12 17 12 17s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.15A31.9 31.9 0 0 0 24 8.5a31.9 31.9 0 0 0-.5-5.85Z"/>
            <path fill="#fff" d="M9.75 12.15V4.85L15.7 8.5 9.75 12.15Z"/>
          </svg>
          Příběhy z trhu
        </a>
      )}

      {!isOnepager && (
        <a
          href="/klientsky-portal"
          class:list={[
            'inline-flex items-center gap-2.5 font-yellix text-[21px] leading-tight text-black no-underline hover:opacity-70',
            isCurrent('/klientsky-portal') ? 'font-semibold' : 'font-medium',
          ]}
          aria-current={isCurrent('/klientsky-portal') ? 'page' : undefined}
          data-drawer-close
        >
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="3.2"/>
            <path d="M5.4 19.2c.7-3.3 3.3-5.1 6.6-5.1s5.9 1.8 6.6 5.1"/>
          </svg>
          Klientský portál
        </a>
      )}

      <a
        href={sluzbyHref}
        class:list={[
          'inline-flex w-fit items-center gap-1.5 bg-black px-3 py-1.5 font-yellix text-[13px] text-white no-underline',
          isCurrent('/sluzby') ? 'font-semibold' : 'font-medium',
        ]}
        aria-current={isCurrent('/sluzby') ? 'page' : undefined}
        data-drawer-close
      >
        <img src="/images/arrow-1.svg" alt="" class="h-3 w-3 shrink-0" width="12" height="12" />
        Vybrat službu
      </a>
    </nav>

    <div class="drawer-quick-contact mt-auto flex-shrink-0 px-5 pb-8 pt-6">
      <p class="mb-3 font-yellix text-[14px] font-medium text-black">Rychlý kontakt</p>
      <div class="flex flex-col gap-3">
        <a
          href="https://wa.me/420607066044"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3 no-underline"
          data-drawer-close
        >
          <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center text-black transition-opacity group-hover:opacity-70">
            <svg class="h-[15px] w-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </span>
          <span class="font-yellix text-[14px] font-medium text-black transition-opacity group-hover:opacity-70">Napsat zprávu</span>
        </a>
        <button
          type="button"
          class="group flex items-center gap-3 border-0 bg-transparent p-0 text-left cursor-pointer"
          data-smart-contact-open
          data-smart-contact-type="client"
        >
          <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center text-black transition-opacity group-hover:opacity-70">
            <svg class="h-[15px] w-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              <path d="M7 7h10M7 12h10M7 17h6"></path>
            </svg>
          </span>
          <span class="font-yellix text-[14px] font-medium text-black transition-opacity group-hover:opacity-70">Poptávkový formulář</span>
        </button>
        <button
          type="button"
          class="group flex items-center gap-3 border-0 bg-transparent p-0 text-left cursor-pointer"
          data-smart-meeting-open
          data-smart-meeting-type="client"
        >
          <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center text-black transition-opacity group-hover:opacity-70">
            <svg class="h-[15px] w-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </span>
          <span class="font-yellix text-[14px] font-medium text-black transition-opacity group-hover:opacity-70">Osobní schůzka v Praze nebo online</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .nav-logo-w {
    display: none;
  }
  [data-nav-dark] {
    border-bottom: 1px solid #222;
  }
  [data-nav-dark] .nav-logo-b { display: none; }
  [data-nav-dark] .nav-logo-w { display: block; }
  [data-nav-dark] .nav-fg,
  [data-nav-dark] .nav-title { color: #fff; }
  [data-nav-dark] .nav-muted { color: rgba(255, 255, 255, 0.62); }
  [data-nav-dark] .nav-aside { border-left-color: rgba(255, 255, 255, 0.22); }
  [data-nav-dark] .nav-cta {
    background: #fff;
    color: #000;
  }
  [data-nav-dark] .nav-cta img { filter: brightness(0); }
  [data-nav-overlay]:not([data-nav-solid]) {
    background: transparent;
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-logo-b {
    display: none;
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-logo-w {
    display: block;
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-fg,
  [data-nav-overlay]:not([data-nav-solid]) .nav-title {
    color: #fff;
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-muted {
    color: rgba(255, 255, 255, 0.68);
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-aside {
    border-left-color: rgba(255, 255, 255, 0.28);
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-cta {
    background: #fff;
    color: #000;
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-cta img {
    filter: brightness(0);
  }
  [data-nav-overlay][data-nav-solid] {
    background: #fff;
  }
  [data-nav-desktop] a[aria-current="page"]:not(.nav-cta) {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }
  [data-nav-autohide] {
    transition: transform 0.35s ease;
  }
  [data-nav-autohide][data-nav-follow] {
    transition: none;
  }
  [data-nav-autohide][data-nav-hidden] {
    transform: translateY(-100%);
  }
  .nav-aside {
    position: relative;
    border-left: 1px solid rgba(0, 0, 0, 0.1);
    padding-left: 2rem;
    transition: border-color 0.6s ease, padding-left 0.6s ease;
  }
  [data-nav-compact] .nav-aside {
    border-left-color: transparent;
    padding-left: 0;
  }
  .nav-title {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  .nav-live {
    transition: opacity 0.5s ease 0.12s;
  }
  [data-nav-compact] .nav-live {
    opacity: 0;
    pointer-events: none;
    transition-delay: 0s;
  }
  [data-nav-compact] .nav-title {
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0.16s;
  }
  [data-nav] {
    transition: box-shadow 0.6s ease, background-color 0.35s ease;
  }
  [data-nav-compact] {
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-live,
    .nav-title {
      transition: none;
    }
  }
  .nav-live-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.45);
    animation: nav-live-pulse 2.2s ease-in-out infinite;
  }
  @keyframes nav-live-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.45); }
    50% { opacity: 0.7; box-shadow: 0 0 0 4px rgba(22, 163, 74, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-live-dot { animation: none; }
  }
  [data-nav-fullbleed] {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
  }
  .drawer-quick-contact {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }
</style>

<script>
  (function () {
    if (!document.querySelector('[data-nav]')) return;

    function openDrawer() {
      var drawer = document.querySelector('[data-menu-drawer]');
      var backdrop = document.querySelector('[data-drawer-backdrop]');
      var panel = document.querySelector('[data-drawer-panel]');
      var toggle = document.querySelector('[data-nav-toggle]');
      if (!drawer || !backdrop) return;
      drawer.setAttribute('data-open', '');
      drawer.classList.remove('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'false');
      backdrop.setAttribute('data-open', '');
      if (panel) panel.setAttribute('data-open', '');
      document.body.style.overflow = 'hidden';
      if (toggle) toggle.setAttribute('aria-expanded', 'true');
    }

    function scrollHomeKontakt(smooth) {
      var el = document.getElementById('kontakt');
      if (!el) return false;
      el.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
      return true;
    }

    function closeDrawer() {
      var drawer = document.querySelector('[data-menu-drawer]');
      var backdrop = document.querySelector('[data-drawer-backdrop]');
      var panel = document.querySelector('[data-drawer-panel]');
      var toggle = document.querySelector('[data-nav-toggle]');
      if (!drawer || !backdrop) return;
      drawer.removeAttribute('data-open');
      drawer.classList.add('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'true');
      backdrop.removeAttribute('data-open');
      if (panel) panel.removeAttribute('data-open');
      var contact = document.querySelector('[data-smart-contact]');
      var meeting = document.querySelector('[data-smart-meeting]');
      var modalOpen = (contact && !contact.classList.contains('pointer-events-none'))
        || (meeting && !meeting.classList.contains('pointer-events-none'));
      if (!modalOpen) document.body.style.overflow = '';
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    }

    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-nav-toggle]')) {
        e.preventDefault();
        var toggle = document.querySelector('[data-nav-toggle]');
        if (toggle?.getAttribute('aria-expanded') === 'true') closeDrawer();
        else openDrawer();
        return;
      }
      if (e.target.closest('[data-drawer-backdrop]')) { closeDrawer(); return; }
      if (e.target.closest('[data-nav-home-kontakt]')) {
        e.preventDefault();
        closeDrawer();
        var onHome = location.pathname === '/' || location.pathname === '';
        if (onHome && scrollHomeKontakt(true)) {
          if (location.hash !== '#kontakt') history.replaceState(null, '', '/#kontakt');
        } else {
          location.assign('/#kontakt');
        }
        return;
      }
      if (e.target.closest('[data-drawer-close]')) {
        var link = e.target.closest('a[href]');
        if (link) window.setTimeout(closeDrawer, 0);
        else closeDrawer();
        return;
      }
    });

    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-smart-contact-open], [data-smart-meeting-open]')) closeDrawer();
    }, true);

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var drawer = document.querySelector('[data-menu-drawer]');
      if (drawer?.hasAttribute('data-open')) closeDrawer();
    });

    var compactOnScroll = null;
    var compactOnResize = null;
    function fullbleedVisual(header) {
      var selectors = ['.hero-strip-mobile-visual', '.hero-mobile-visual', '[data-hero-alt]', '.hero-strip-film', '[data-onas-hero]'];
      for (var i = 0; i < selectors.length; i++) {
        var el = document.querySelector(selectors[i]);
        if (el && el.getBoundingClientRect().height > 1) return el;
      }
      return null;
    }
    function dockFullbleed(header, mobile) {
      if (!mobile || !header.hasAttribute('data-nav-fullbleed') || header.getAttribute('data-path') !== '/' || document.documentElement.classList.contains('intro-on')) {
        header.style.top = '';
        header.removeAttribute('data-nav-dock');
        return;
      }
      if (header.style.top !== '0px') header.style.top = '0px';
      header.setAttribute('data-nav-dock', 'top');
    }
    function setNavCompact(on) {
      var header = document.querySelector('[data-nav]');
      var live = document.querySelector('[data-nav-live]');
      var title = document.querySelector('[data-nav-title]');
      if (!header) return;
      if (on) header.setAttribute('data-nav-compact', '');
      else header.removeAttribute('data-nav-compact');
      if (live) live.setAttribute('aria-hidden', on ? 'true' : 'false');
      if (title) title.setAttribute('aria-hidden', on ? 'false' : 'true');
    }
    function setNavSolid(on) {
      var header = document.querySelector('[data-nav]');
      if (!header) return;
      if (on) header.setAttribute('data-nav-solid', '');
      else header.removeAttribute('data-nav-solid');
    }
    function setNavFollow(header, offset) {
      if (offset === null) {
        header.removeAttribute('data-nav-follow');
        header.style.transform = '';
        return;
      }
      header.setAttribute('data-nav-follow', '');
      header.style.transform = 'translateY(' + -offset + 'px)';
    }
    function autohide(header, y) {
      if (!header.hasAttribute('data-nav-autohide')) return;
      var zones = document.querySelectorAll('[data-nav-hide-zone]');
      var drawer = document.querySelector('[data-menu-drawer]');
      var active = zones.length
        && window.matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)').matches
        && !(drawer && drawer.hasAttribute('data-open'));
      if (!active) {
        setNavFollow(header, null);
        header.removeAttribute('data-nav-hidden');
        return;
      }
      var h = header.offsetHeight;
      var pin = document.querySelector('.hero-cover-pin');
      var pinBottom = pin ? pin.getBoundingClientRect().bottom : 0;
      var start = pinBottom > 0 ? pinBottom - 1 : h;
      var covering = false;
      for (var i = 0; i < zones.length; i++) {
        var r = zones[i].getBoundingClientRect();
        if (r.bottom > h && r.top < start) {
          covering = true;
          break;
        }
      }
      setNavFollow(header, null);
      if (covering) header.setAttribute('data-nav-hidden', '');
      else header.removeAttribute('data-nav-hidden');
    }
    function initNavCompact() {
      if (compactOnScroll) {
        window.removeEventListener('scroll', compactOnScroll);
        compactOnScroll = null;
      }
      if (compactOnResize) {
        window.removeEventListener('resize', compactOnResize);
        compactOnResize = null;
      }
      var header = document.querySelector('[data-nav]');
      var aside = document.querySelector('[data-nav-aside]');
      if (!header) {
        setNavCompact(false);
        setNavSolid(false);
        return;
      }
      compactOnScroll = function () {
        var y = window.scrollY;
        var overlay = header.hasAttribute('data-nav-overlay');
        var fullbleed = header.hasAttribute('data-nav-fullbleed');
        var mobile = window.matchMedia('(max-width: 1023px)').matches;

        if (overlay || !aside) {
          setNavCompact(false);
        } else {
          var on = header.hasAttribute('data-nav-compact');
          if (!on && y > 48) setNavCompact(true);
          else if (on && y < 16) setNavCompact(false);
        }

        if (fullbleed) {
          var visual = fullbleedVisual(header);
          if (visual) {
    document.addEventListener('astro:page-load', function () {
      if (location.hash === '#kontakt') scrollHomeKontakt(false);
    });
            var bottom = visual.getBoundingClientRect().bottom;
            var solid = header.hasAttribute('data-nav-solid');
            if (!solid && bottom <= 84) setNavSolid(true);
            else if (solid && bottom > 120) setNavSolid(false);
          } else {
            setNavSolid(false);
          }
          dockFullbleed(header, mobile);
          autohide(header, y);
        } else if (overlay) {
          var banner = document.querySelector('[data-agent-banner], [data-pz-hero], [data-onas-hero]');
          if (banner) {
            setNavSolid(banner.getBoundingClientRect().bottom <= header.offsetHeight + 4);
          }
        } else {
          setNavSolid(false);
          header.style.top = '';
          header.removeAttribute('data-nav-dock');
        }
      };
      compactOnResize = compactOnScroll;
      compactOnScroll();
      window.addEventListener('scroll', compactOnScroll, { passive: true });
      window.addEventListener('resize', compactOnResize);
      window.addEventListener('hero-intro-done', compactOnScroll, { once: true });
    }
    initNavCompact();
    document.addEventListener('astro:page-load', initNavCompact);
  })();
</script>
