---
interface Props {
  loginHref: string;
  demoHref: string;
}
const { loginHref, demoHref } = Astro.props;
---

<section class="kph" data-kph aria-labelledby="kph-h">
  <div class="kph__text">
    <p class="kph__kicker font-yellix">Klientský portál</p>
    <h1 id="kph-h" class="kph__h1 font-yellix">Trh novostaveb tak, jak ho vidíme my.</h1>
    <div class="kph__btns">
      <a class="kph__b1 font-yellix" href={demoHref}>
        Projít ukázku
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6 L18 18" /><path d="M18 9 L18 18 L9 18" /></svg>
      </a>
      <a class="kph__b2 font-yellix" href={loginHref}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1-4 4-6 8-6s7 2 8 6" /></svg>
        Přihlásit se
      </a>
    </div>
  </div>

  <div class="kph__stage">
    <img
      class="kph__phone"
      src="/images/agency/portal-mobil-900.webp"
      alt="Klientský portál REAMAR v telefonu: váš výběr projektů od konzultanta"
      width="900"
      height="1611"
      fetchpriority="high"
      decoding="async"
    />
    <div class="kph__fade"></div>

    <div class="kph__pill kph__pill--top kph__float font-yellix" style="--d:0s">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.8z" /></svg>
      <span>Předprodeje<br />a nové projekty</span>
    </div>
    <div class="kph__pill kph__float font-yellix" style="top:46%; right:10px; left:auto; --d:-2.2s">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z" /><path d="M10 20.5h4" /></svg>
      <span>Upozornění<br />na zlevněné nabídky</span>
    </div>
    <div class="kph__pill kph__float kph__pill--3 font-yellix" style="top:54%; --d:-4.1s">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M12 4l9 5-9 5-9-5z" /><path d="M3 14l9 5 9-5" /></svg>
      <span>Výběr napříč<br />celým trhem</span>
    </div>
  </div>
</section>

<style>
  .kph {
    --pw: min(284px, 72vw);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    display: none;
    position: relative;
    height: 100svh;
    overflow: hidden;
    box-sizing: border-box;
    padding-top: var(--nav-h);
    background: #000;
    color: #fff;
    font-weight: 500;
  }
  @media (max-width: 767px) {
    .kph {
      display: flex;
      flex-direction: column;
    }
  }
  .kph__stage {
    position: relative;
    flex: 1;
    min-height: 0;
    height: calc(var(--pw) * 1.84);
    margin-top: 28px;
  }
  .kph__phone {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--pw);
    height: auto;
    transform: translateX(-50%);
  }
  .kph__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42%;
    pointer-events: none;
    background: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.85) 40%, rgba(0, 0, 0, 0) 100%);
  }
  .kph__pill {
    position: absolute;
    left: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    width: max-content;
    padding: 8px 10px;
    font-size: 11.5px;
    line-height: 1.25;
    color: #000;
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }
  .kph__pill svg { flex: none; }
  .kph__pill--top {
    top: auto;
    bottom: 12%;
    left: 50%;
    translate: -50% 0;
  }
  .kph__float {
    animation: kph-float 6.5s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    animation-delay: var(--d, 0s);
    will-change: transform;
  }
  .kph__text {
    position: relative;
    z-index: 3;
    flex: none;
    padding: 16px 20px 0;
    text-align: center;
  }
  .kph__kicker {
    margin: 0 0 12px;
    font-size: 11px;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }
  .kph__h1 {
    margin: 0 0 18px;
    font-size: 31px;
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 500;
    text-wrap: balance;
  }
  .kph__btns {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .kph__b1,
  .kph__b2 {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 136px;
    height: 42px;
    padding: 0 12px;
    box-sizing: border-box;
    border: 0;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }
  .kph__b1 {
    background: #fff;
    color: #000;
  }
  .kph__b2 {
    width: 134px;
    height: 40px;
    color: #fff;
    box-shadow: 0 0 0 1px #fff;
  }
  .kph__btns svg {
    display: block;
    flex-shrink: 0;
  }
  @media (max-width: 359px) {
    .kph__pill--3 { display: none; }
  }
  @media (max-height: 700px) {
    .kph { --pw: min(200px, 54vw); }
    .kph__stage { margin-top: 16px; }
    .kph__pill--top { bottom: 10%; }
    .kph__h1 { margin-bottom: 14px; font-size: 28px; }
    .kph__text { padding-top: 8px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .kph__stage,
    .kph__text { animation: kph-in 0.55s 0.12s var(--ease) both; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kph__float { animation: none; }
  }
  @keyframes kph-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes kph-float {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, -8px, 0); }
  }
</style>
