---
const heroImage = '/images/pro-klienty-bg.webp';
---
<section id="klienty" class="bg-[#ededed]" aria-labelledby="klienty-heading">
  <!-- Hero: 75vh, širokoúhlá fotka -->
  <div class="relative w-full h-[75vh] min-h-[320px] overflow-hidden">
    <img
      src={heroImage}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-left"
      width="1920"
      height="1080"
      loading="lazy"
    />
    <!-- Gradient overlay: tmavší vlevo (kde je text), světlejší vpravo – text zůstane čitelný na světlé fotce -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/55 via-black/25 to-transparent" aria-hidden="true" />
    <!-- Text vlevo nad klidnější částí scény -->
    <div class="absolute inset-0 flex flex-col justify-center pl-[10%] pr-[20%] md:pl-[12%] md:pr-[35%]">
      <h2
        id="klienty-heading"
        class="font-yellix text-3xl md:text-4xl lg:text-[42px] font-medium leading-tight text-white max-w-md break-words [text-shadow:0_1px_2px_rgba(0,0,0,0.4),0_2px_8px_rgba(0,0,0,0.3)]"
        data-aos="fade-right"
        data-aos-duration="800"
        data-aos-easing="ease"
        data-aos-delay="100"
      >
        Služby pro klienty
      </h2>
      <p
        class="mt-4 md:mt-6 font-yellix text-lg md:text-xl text-white/95 max-w-md [text-shadow:0_1px_3px_rgba(0,0,0,0.5)]"
        data-aos="fade-up"
        data-aos-duration="800"
        data-aos-easing="ease"
        data-aos-delay="400"
      >
        Pomáháme vám kupovat, prodávat a zhodnocovat vaše nemovitosti
      </p>
      <div
        class="klienty-hero-ctas"
        data-aos="fade-up"
        data-aos-duration="800"
        data-aos-easing="ease"
        data-aos-delay="500"
      >
        <a
          href="javascript:void(0)"
          class="klienty-hero-btn klienty-hero-btn--primary"
          data-smart-contact-open
          data-smart-contact-type="client"
          data-smart-contact-service="Vyhledání nemovitosti"
        >
          <img
            src="/images/arrow-1.svg"
            alt=""
            class="klienty-hero-btn-icon"
            width="16"
            height="16"
            aria-hidden="true"
          />
          <span class="klienty-hero-btn-label">Koupit nemovitost</span>
        </a>
        <a href="/prodej" class="klienty-hero-btn klienty-hero-btn--secondary">
          <span class="klienty-hero-btn-label">Prodat nemovitost</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .klienty-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .klienty-hero-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0.875rem 1.5rem;
    font-family: 'Yellix', system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.005em;
    line-height: 1;
    border-radius: 0;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    cursor: pointer;
  }
  .klienty-hero-btn:hover {
    transform: translateY(-1px);
  }
  .klienty-hero-btn-icon {
    flex-shrink: 0;
    display: block;
    width: 16px;
    height: 16px;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .klienty-hero-btn--primary {
    background: #fff;
    color: #0a0a0a;
    border: 1px solid #fff;
  }
  .klienty-hero-btn--primary:hover {
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(255, 255, 255, 0.92);
  }
  .klienty-hero-btn--primary .klienty-hero-btn-icon {
    filter: invert(1);
  }
  .klienty-hero-btn:hover .klienty-hero-btn-icon {
    transform: translate(2px, 2px);
  }
  .klienty-hero-btn--secondary {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
  }
  .klienty-hero-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.8);
  }
  .klienty-hero-btn:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.9);
    outline-offset: 3px;
  }
  @media (max-width: 767px) {
    .klienty-hero-ctas {
      flex-direction: column;
      align-items: flex-start;
    }
    .klienty-hero-btn {
      width: auto;
      max-width: 100%;
    }
  }
</style>
