---
interface Props {
  faqHref?: string;
  showIntro?: boolean;
  introTitle?: string | false;
}

const {
  faqHref = '/konzultace#nejcastejsi-otazky',
  showIntro = true,
  introTitle = 'Dobrý výběr začíná lepším přehledem.',
} = Astro.props;
const logo = '/images/logo-rig-w.svg';
---

<footer id="kontakt" class="bg-black text-white" role="contentinfo">
  {showIntro && (
    <>
      <div class="mx-auto max-w-[1440px] px-5 pt-20 md:px-10 md:pt-28 xl:px-14 xl:pt-32">
        <div class="flex flex-col items-center text-center">
          {introTitle && (
            <h2 class="font-yellix text-[26px] font-medium leading-[1.18] tracking-[-0.02em] text-white md:text-[32px] xl:text-[36px]">
              {introTitle}
            </h2>
          )}
          <p class={`max-w-[62ch] font-yellix text-[14px] font-medium leading-[1.55] text-white/80 md:text-[16px] ${introTitle ? 'mt-4' : ''}`}>
            Pomůžeme vám zorientovat se v nabídce novostaveb, porovnat konkrétní možnosti a vybrat další krok podle vašeho zadání.
          </p>
          <button
            type="button"
            class="mt-6 inline-flex items-center gap-1.5 bg-white px-3 py-1.5 font-yellix text-[13px] font-medium leading-none text-black transition-opacity hover:opacity-85"
            data-smart-contact-open
            data-smart-contact-type="client"
          >
            První krok
            <img src="/images/arrow-1.svg" alt="" class="h-3 w-3 shrink-0 brightness-0" width="12" height="12" />
          </button>
        </div>
      </div>

      <div class="mt-16 h-px w-full bg-white/20 md:mt-20" aria-hidden="true"></div>
    </>
  )}

  <div class="mx-auto max-w-[1440px] px-5 py-12 pb-16 md:px-10 md:py-16 md:pb-20 xl:px-14 xl:pb-16">
    <div class="flex flex-col gap-14 md:gap-16 lg:flex-row lg:items-end lg:justify-between lg:gap-20">
      <div class="flex min-w-0 flex-1 flex-col gap-10 md:flex-row md:flex-wrap md:gap-x-16 md:gap-12 lg:gap-x-20">
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-3 md:gap-12 md:gap-x-14 lg:gap-x-16">
          <div>
            <p class="mb-2 font-yellix text-[14px] font-medium text-[#BFBFBF] md:text-[15px]">Adresa</p>
            <p class="font-yellix text-[16px] font-medium leading-snug text-white">
              Záběhlický zámek<br />
              Za potokem 46/4<br />
              106 00 Praha 10
            </p>
          </div>
          <div>
            <p class="mb-2 font-yellix text-[14px] font-medium text-[#BFBFBF] md:text-[15px]">Telefon</p>
            <p class="whitespace-nowrap font-yellix text-[16px] font-medium text-white">
              <a href="tel:+420607066044" class="transition-opacity hover:opacity-80">+420 607 066 044</a>
            </p>
          </div>
          <div>
            <p class="mb-2 font-yellix text-[14px] font-medium text-[#BFBFBF] md:text-[15px]">E-mail</p>
            <p class="font-yellix text-[16px] font-medium text-white">
              <a href="mailto:info@reamar.cz" class="transition-opacity hover:opacity-80">info@reamar.cz</a>
            </p>
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <a href="mailto:info@reamar.cz" class="group hidden w-fit items-center gap-3 md:flex">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center text-white transition-opacity group-hover:opacity-70">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <span class="font-yellix text-[16px] font-medium text-white transition-opacity group-hover:opacity-70">Napsat zprávu</span>
          </a>
          <a href="https://wa.me/420607066044" target="_blank" rel="noopener noreferrer" class="group flex w-fit items-center gap-3 md:hidden">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center text-white transition-opacity group-hover:opacity-70">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <span class="font-yellix text-[16px] font-medium text-white transition-opacity group-hover:opacity-70">Napsat zprávu</span>
          </a>
          <button
            type="button"
            class="group flex w-fit items-center gap-3 bg-transparent p-0 text-left"
            data-smart-contact-open
            data-smart-contact-type="client"
          >
            <span class="flex h-6 w-6 shrink-0 items-center justify-center text-white transition-opacity group-hover:opacity-70">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 7h10M7 12h10M7 17h6"/></svg>
            </span>
            <span class="font-yellix text-[16px] font-medium text-white transition-opacity group-hover:opacity-70">Poptávkový formulář</span>
          </button>
          <button
            type="button"
            class="group flex w-fit items-center gap-3 bg-transparent p-0 text-left"
            data-smart-meeting-open
            data-smart-meeting-type="client"
          >
            <span class="flex h-6 w-6 shrink-0 items-center justify-center text-white transition-opacity group-hover:opacity-70">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <span class="font-yellix text-[16px] font-medium text-white transition-opacity group-hover:opacity-70">Osobní schůzka v Praze nebo online</span>
          </button>
        </div>
      </div>

      <div class="footer-logo-wrap flex shrink-0 items-end justify-start lg:justify-end" data-footer-logo-wrap>
        <img
          src={logo}
          alt="REAMAR"
          width="400"
          height="107"
          class="h-28 w-auto object-contain object-bottom md:h-36 lg:h-40 xl:h-44"
        />
      </div>
    </div>

    <div class="mt-14 text-center md:mt-20 md:text-left">
      <div class="md:flex md:items-end md:justify-between md:gap-12">
        <div class="min-w-0">
          <p class="font-yellix text-[13px] font-medium leading-snug tracking-[-0.01em] text-white/55 md:text-[14px]">
            REAMAR Agency<span class="hidden md:inline"> · </span><br class="md:hidden" />Agentura pro kupující novostaveb v Praze a okolí
          </p>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 font-yellix text-[12px] font-medium text-white/40 md:mt-6 md:justify-start md:gap-x-6">
            <a href="https://www.reamar.cz" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white/70 md:underline md:decoration-white/25 md:underline-offset-[3px] md:hover:decoration-white/50">reamar.cz</a>
            <a href={faqHref} class="transition-colors hover:text-white/70 md:underline md:decoration-white/25 md:underline-offset-[3px] md:hover:decoration-white/50">
              <span class="md:hidden">FAQ</span>
              <span class="hidden md:inline">Nejčastější otázky</span>
            </a>
            <a href="https://www.reamar.cz/prazsky-rezidencni-trh" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white/70 md:underline md:decoration-white/25 md:underline-offset-[3px] md:hover:decoration-white/50">Data z trhu</a>
            <a href="/ochrana-osobnich-udaju" class="transition-colors hover:text-white/70 md:underline md:decoration-white/25 md:underline-offset-[3px] md:hover:decoration-white/50">Osobní údaje</a>
            <button type="button" class="cursor-pointer bg-transparent p-0 text-left transition-colors hover:text-white/70 md:underline md:decoration-white/25 md:underline-offset-[3px] md:hover:decoration-white/50" data-cookie-settings aria-label="Nastavení cookies">Cookies</button>
          </div>
        </div>
        <p class="mt-6 font-yellix text-[11px] font-medium leading-snug text-white/40 md:mt-0 md:shrink-0 md:text-right md:text-[12px]">
          Reamar Invest Group, s.r.o. · IČO 23413646<span class="hidden md:inline"> · DIČ CZ23413646</span> · DS 2ejj4q
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-logo-wrap {
    opacity: 0;
    transform: translateX(40px) scale(0.96);
    transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .footer-logo-wrap.reveal {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-logo-wrap {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initFooterReveal() {
    if (window.__footerRevealObserver) {
      window.__footerRevealObserver.disconnect();
      window.__footerRevealObserver = null;
    }
    const wrap = document.querySelector('[data-footer-logo-wrap]');
    if (!wrap) return;

    const observer = new IntersectionObserver(
      function (entries) {
        const entry = entries[0];
        if (entry.isIntersecting) {
          wrap.classList.add('reveal');
        } else {
          wrap.classList.remove('reveal');
        }
      },
      { root: null, rootMargin: '0px', threshold: 0.4 }
    );
    window.__footerRevealObserver = observer;
    observer.observe(wrap);
  }
  initFooterReveal();
  document.addEventListener('astro:page-load', initFooterReveal);
</script>
