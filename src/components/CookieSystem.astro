---
const STORAGE_KEY = 'reamar-cookie-consent';
// temporarily off — desktop + mobile
const SHOW_COOKIE_BANNER = false;
const CATEGORIES = [
  { id: 'necessary', label: 'Nezbytné', alwaysOn: true },
  { id: 'analytical', label: 'Analytické', alwaysOn: false },
  { id: 'marketing', label: 'Marketingové', alwaysOn: false },
] as const;
---
{SHOW_COOKIE_BANNER && (
<div
  id="cookie-banner"
  class="cookie-banner"
  aria-hidden="true"
  data-cookie-banner
>
  <div class="cookie-banner-card">
    <p class="cookie-banner-title">Cookies nám pomáhají web zlepšovat</p>
    <p class="cookie-banner-copy">
      Používáme je k analýze návštěvnosti a vylepšení webu. Podrobnosti v
      <button type="button" class="cookie-banner-link" data-cookie-open-settings>nastavení</button>.
    </p>
    <div class="cookie-banner-actions">
      <button type="button" class="cookie-banner-btn" data-cookie-accept>Souhlasím</button>
      <button type="button" class="cookie-banner-btn" data-cookie-reject>Odmítnout</button>
    </div>
  </div>
</div>
)}

<!-- Cookie Modal: nastavení (styl jako poptávkový formulář) -->
<div
  id="cookie-modal-overlay"
  class="cookie-modal-overlay fixed inset-0 z-[100] flex items-center justify-center bg-black/80 opacity-0 pointer-events-none transition-opacity duration-200"
  aria-hidden="true"
  data-cookie-overlay
>
  <div
    class="cookie-modal relative w-[94vw] max-w-[1000px] max-h-[90vh] overflow-y-auto bg-white rounded-none shadow-none border border-gray-200 scale-95 transition-all duration-200"
    role="dialog"
    aria-labelledby="cookie-modal-title"
    aria-modal="true"
    tabindex="-1"
    data-cookie-modal
    onclick="event.stopPropagation()"
  >
    <div class="p-10 md:p-14 lg:p-16">
      <button
        type="button"
        class="absolute top-8 right-8 flex items-center gap-2 border-0 bg-transparent p-0 font-yellix text-[14px] font-normal text-gray-400 cursor-pointer hover:text-gray-600 transition-colors"
        aria-label="Zavřít"
        data-cookie-modal-close
      >
        <span>Zavřít</span>
        <span class="text-[#000000]" aria-hidden="true">×</span>
      </button>

      <h2 id="cookie-modal-title" class="font-yellix text-[27px] font-normal text-[#000000] pr-20 mb-8 uppercase tracking-[0.2em]">
        Využití cookies
      </h2>

      <p class="font-yellix text-[14px] font-normal text-[#000000] leading-relaxed mb-10">
        Pro zajištění plné funkčnosti a analýzu návštěvnosti využívají tyto stránky soubory cookies – malé textové soubory ukládané ve vašem prohlížeči. Ze zákona ukládáme pouze cookies nezbytně nutné pro provoz webu. Pro analytické a reklamní účely (včetně služeb třetích stran) potřebujeme váš souhlas. Podrobné informace naleznete v našich <a href="/ochrana-osobnich-udaju" class="text-[#000000] underline hover:opacity-80">Zásadách ochrany osobních údajů</a>.
      </p>

      <p class="font-yellix text-[14px] font-normal text-gray-500 mb-3">Kategorie</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 mb-10">
        {CATEGORIES.map((cat) => (
          <span class="inline-flex items-center gap-2">
            {cat.alwaysOn ? (
              <span class="font-yellix text-[14px] font-normal text-[#000000] underline underline-offset-2 decoration-[#000000]">
                {cat.label}
              </span>
            ) : (
              <button
                type="button"
                class="cookie-category font-yellix text-[14px] font-normal border-0 bg-transparent p-0 cursor-pointer no-underline hover:text-gray-600 transition-colors text-gray-400"
                data-category={cat.id}
              >
                {cat.label}
              </button>
            )}
          </span>
        ))}
      </div>

      <div class="flex justify-center">
        <button
          type="button"
          class="font-yellix text-[14px] font-normal text-white bg-[#000000] border border-[#000000] py-3 px-8 cursor-pointer hover:opacity-90 transition-opacity"
          data-cookie-save
        >
          Uložit preference
        </button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    width: 100%;
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .cookie-banner.is-on {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
  .cookie-banner-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.1rem 1.25rem 1.15rem;
    background: #fff;
    border-top: 1px solid #e5e5e5;
  }
  .cookie-banner-title {
    display: none;
    margin: 0;
    font-family: Yellix, system-ui, sans-serif;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #000;
  }
  .cookie-banner-copy {
    margin: 0;
    font-family: Yellix, system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
    color: rgba(0, 0, 0, 0.62);
  }
  .cookie-banner-link {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: #000;
    text-decoration: underline;
    text-underline-offset: 0.14em;
    cursor: pointer;
  }
  .cookie-banner-link:hover {
    opacity: 0.7;
  }
  .cookie-banner-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.85rem;
  }
  .cookie-banner-btn {
    margin: 0;
    padding: 10px 18px;
    border: 1px solid #000;
    background: #000;
    color: #fff;
    font-family: Yellix, system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
  }
  .cookie-banner-btn[data-cookie-reject] {
    background: #fff;
    color: #000;
    border-color: rgba(0, 0, 0, 0.18);
  }
  .cookie-banner-btn:hover {
    opacity: 0.88;
  }
  @media (min-width: 1024px) {
    .cookie-banner-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 1.05rem 2.5rem 1.1rem;
    }
    .cookie-banner-copy {
      flex: 1;
      max-width: 46rem;
    }
    .cookie-banner-actions {
      flex-shrink: 0;
    }
  }
  @media (max-width: 1023px) {
    .cookie-banner {
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      width: auto;
    }
    .cookie-banner-card {
      gap: 0.85rem;
      padding: 1.2rem 1.15rem 1.1rem;
      border: 0;
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.78);
      -webkit-backdrop-filter: blur(22px);
      backdrop-filter: blur(22px);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.18);
    }
    .cookie-banner-title {
      display: block;
    }
    .cookie-banner-copy {
      font-size: 13px;
      line-height: 1.4;
      color: rgba(0, 0, 0, 0.68);
    }
    .cookie-banner-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 0.25rem;
    }
    .cookie-banner-btn {
      width: 100%;
      padding: 12px 14px;
      border-radius: 999px;
      border-color: rgba(0, 0, 0, 0.12);
      background: #fff;
      color: #000;
    }
    .cookie-banner-btn[data-cookie-reject] {
      background: #fff;
      color: #000;
      border-color: rgba(0, 0, 0, 0.12);
    }
  }
</style>

<script define:vars={{ STORAGE_KEY, SHOW_COOKIE_BANNER }}>
  function initCookieSystem() {
    const banner = SHOW_COOKIE_BANNER ? document.querySelector('[data-cookie-banner]') : null;
    const overlay = document.querySelector('[data-cookie-overlay]');
    const modal = document.querySelector('[data-cookie-modal]');
    if (!banner && !overlay && !modal) return;
    if (window.__cookieBannerTimer) {
      clearTimeout(window.__cookieBannerTimer);
      window.__cookieBannerTimer = null;
    }

    if (window.__cookieOpenSettingsHandler) {
      document.body.removeEventListener('click', window.__cookieOpenSettingsHandler);
    }

    const defaultConsent = {
      necessary: true,
      analytical: false,
      marketing: false,
      consented: false,
    };

    function getConsent() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        const data = JSON.parse(raw);
        return { ...defaultConsent, ...data };
      } catch (_) {
        return null;
      }
    }

    function setConsent(data) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...defaultConsent, ...data }));
      } catch (_) {}
    }

    function updateGtagConsent(prefs) {
      if (typeof window.gtag !== 'function') return;
      window.gtag('consent', 'update', {
        analytics_storage: prefs.analytical ? 'granted' : 'denied',
        ad_storage: prefs.marketing ? 'granted' : 'denied',
        ad_user_data: prefs.marketing ? 'granted' : 'denied',
        ad_personalization: prefs.marketing ? 'granted' : 'denied',
      });
    }

    function introPlaying() {
      const root = document.documentElement;
      return root.classList.contains('rmm-on') || root.classList.contains('rmi-on') || root.classList.contains('intro-on');
    }

    function isPhone() {
      return window.matchMedia('(max-width: 1023px)').matches;
    }

    function showBanner() {
      if (!banner) return;
      const consent = getConsent();
      if (consent && consent.consented) return;
      if (introPlaying()) {
        window.addEventListener('rm:intro-done', function () {
          window.setTimeout(showBanner, 1800);
        }, { once: true });
        return;
      }
      banner.classList.add('is-on');
      banner.setAttribute('aria-hidden', 'false');
    }

    function hideBanner() {
      if (!banner) return;
      banner.classList.remove('is-on');
      banner.setAttribute('aria-hidden', 'true');
    }

    function scheduleBanner() {
      if (window.__cookieBannerTimer) clearTimeout(window.__cookieBannerTimer);
      const start = performance.now();
      const arm = function () {
        if (getConsent() && getConsent().consented) return;
        if (introPlaying()) {
          window.addEventListener('rm:intro-done', function () {
            window.__cookieBannerTimer = setTimeout(arm, 1800);
          }, { once: true });
          window.addEventListener('hero-intro-done', function () {
            window.__cookieBannerTimer = setTimeout(arm, 1800);
          }, { once: true });
          window.__cookieBannerTimer = setTimeout(arm, 12000);
          return;
        }
        const min = isPhone() ? 6500 : 2000;
        const left = min - (performance.now() - start);
        if (left > 40) {
          window.__cookieBannerTimer = setTimeout(arm, left);
          return;
        }
        showBanner();
      };
      window.__cookieBannerTimer = setTimeout(arm, 80);
    }

    function openModal() {
      const prefs = getConsent() || defaultConsent;
      document.querySelectorAll('.cookie-category').forEach(function (btn) {
        const id = btn.getAttribute('data-category');
        if (!id || id === 'necessary') return;
        const active = id === 'analytical' ? prefs.analytical : prefs.marketing;
        btn.setAttribute('data-active', active ? 'true' : 'false');
        if (active) {
          btn.classList.add('underline', 'underline-offset-2', 'decoration-[#000000]', 'text-[#000000]');
          btn.classList.remove('text-gray-400', 'no-underline');
        } else {
          btn.classList.remove('underline', 'underline-offset-2', 'decoration-[#000000]', 'text-[#000000]');
          btn.classList.add('text-gray-400', 'no-underline');
        }
      });
      if (overlay) {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      if (modal) {
        modal.classList.remove('scale-95');
        modal.classList.add('scale-100');
        modal.focus();
      }
    }

    function closeModal() {
      if (overlay) {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      if (modal) {
        modal.classList.remove('scale-100');
        modal.classList.add('scale-95');
      }
    }

    if (SHOW_COOKIE_BANNER && !window.__cookieBannerScheduled) {
      window.__cookieBannerScheduled = true;
      scheduleBanner();
    }

    function handleOpenSettings(e) {
      if (e.target.closest('#open-cookie-settings') || e.target.closest('[data-cookie-settings]')) {
        e.preventDefault();
        openModal();
      }
    }

    if (banner && banner.dataset.bound === '1') {
      window.__cookieOpenSettingsHandler = handleOpenSettings;
      document.body.addEventListener('click', handleOpenSettings);
      return;
    }
    if (banner) banner.dataset.bound = '1';

    function saveAndHide(prefs) {
      setConsent(prefs);
      updateGtagConsent(prefs);
      hideBanner();
    }

    document.querySelector('[data-cookie-accept]')?.addEventListener('click', function () {
      saveAndHide({ necessary: true, analytical: true, marketing: true, consented: true });
    });
    document.querySelector('[data-cookie-reject]')?.addEventListener('click', function () {
      saveAndHide({ necessary: true, analytical: false, marketing: false, consented: true });
    });

    // Nastavení = otevřít modal (ze banneru)
    document.querySelector('[data-cookie-open-settings]')?.addEventListener('click', openModal);

    window.__cookieOpenSettingsHandler = handleOpenSettings;
    document.body.addEventListener('click', handleOpenSettings);

    // Toggle kategorie v modalu (Analytické, Marketingové)
    document.querySelectorAll('.cookie-category').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-category');
        if (!id || id === 'necessary') return;
        const isActive = btn.getAttribute('data-active') === 'true';
        const next = !isActive;
        btn.setAttribute('data-active', next ? 'true' : 'false');
        if (next) {
          btn.classList.add('underline', 'underline-offset-2', 'decoration-[#000000]', 'text-[#000000]');
          btn.classList.remove('text-gray-400', 'no-underline');
        } else {
          btn.classList.remove('underline', 'underline-offset-2', 'decoration-[#000000]', 'text-[#000000]');
          btn.classList.add('text-gray-400', 'no-underline');
        }
      });
    });

    // Uložit preference
    document.querySelector('[data-cookie-save]')?.addEventListener('click', function () {
      const analytical = document.querySelector('.cookie-category[data-category="analytical"]')?.getAttribute('data-active') === 'true';
      const marketing = document.querySelector('.cookie-category[data-category="marketing"]')?.getAttribute('data-active') === 'true';
      const prefs = { necessary: true, analytical, marketing, consented: true };
      setConsent(prefs);
      updateGtagConsent(prefs);
      hideBanner();
      closeModal();
    });

    overlay?.addEventListener('click', closeModal);
    document.querySelectorAll('[data-cookie-modal-close]').forEach(function (btn) {
      btn.addEventListener('click', closeModal);
    });
    modal?.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });
  }
  initCookieSystem();
  document.addEventListener('astro:page-load', initCookieSystem);
</script>
