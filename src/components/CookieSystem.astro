---
const STORAGE_KEY = 'reamar-cookie-consent';
const SHOW_COOKIE_BANNER = true;
/** true = vždy zobrazí lištu (ignoruje localStorage + delay). Po ladění vypnout. */
const COOKIE_DESIGN_PREVIEW = false;
const CATEGORIES = [
  { id: 'necessary', label: 'Nezbytné', alwaysOn: true },
  { id: 'analytical', label: 'Analytické', alwaysOn: false },
  { id: 'marketing', label: 'Marketingové', alwaysOn: false },
] as const;
---
{SHOW_COOKIE_BANNER && (
<div
  id="cookie-banner"
  class="cookie-banner"
  aria-hidden="true"
  data-cookie-banner
>
  <div class="cookie-banner-card">
    <svg class="cookie-banner-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="8.2" cy="10.2" r="1.15" fill="currentColor"/>
      <circle cx="12.6" cy="7.8" r="1" fill="currentColor"/>
      <circle cx="15.4" cy="11.4" r="1.2" fill="currentColor"/>
      <circle cx="10.1" cy="14.6" r="1.05" fill="currentColor"/>
      <circle cx="14.2" cy="15.8" r="0.9" fill="currentColor"/>
    </svg>
    <div class="cookie-banner-main">
      <p class="cookie-banner-label">Cookies</p>
      <p class="cookie-banner-copy">
        Používáme je k analýze návštěvnosti a vylepšení webu.
      </p>
    </div>
    <div class="cookie-banner-actions">
      <button type="button" class="cookie-banner-btn" data-cookie-accept>Přijmout vše</button>
      <button type="button" class="cookie-banner-btn cookie-banner-btn--ghost" data-cookie-reject>Jen nezbytné</button>
      <button type="button" class="cookie-banner-link" data-cookie-open-settings>Nastavení</button>
    </div>
  </div>
</div>
)}

<!-- Cookie Modal: nastavení (styl jako poptávkový formulář) -->
<div
  id="cookie-modal-overlay"
  class="cookie-modal-overlay fixed inset-0 z-[100] flex items-center justify-center bg-black/80 opacity-0 pointer-events-none transition-opacity duration-200"
  aria-hidden="true"
  data-cookie-overlay
>
  <div
    class="cookie-modal relative w-[94vw] max-w-[1000px] max-h-[90vh] overflow-y-auto bg-white rounded-none shadow-none border border-gray-200 scale-95 transition-all duration-200"
    role="dialog"
    aria-labelledby="cookie-modal-title"
    aria-modal="true"
    tabindex="-1"
    data-cookie-modal
    onclick="event.stopPropagation()"
  >
    <div class="p-10 md:p-14 lg:p-16">
      <button
        type="button"
        class="absolute top-8 right-8 flex items-center gap-2 border-0 bg-transparent p-0 font-yellix text-[14px] font-normal text-gray-400 cursor-pointer hover:text-gray-600 transition-colors"
        aria-label="Zavřít"
        data-cookie-modal-close
      >
        <span>Zavřít</span>
        <span class="text-[#000000]" aria-hidden="true">×</span>
      </button>

      <h2 id="cookie-modal-title" class="font-yellix text-[27px] font-normal text-[#000000] pr-20 mb-8 uppercase tracking-[0.2em]">
        Využití cookies
      </h2>

      <p class="font-yellix text-[14px] font-normal text-[#000000] leading-relaxed mb-10">
        Pro zajištění plné funkčnosti a analýzu návštěvnosti využívají tyto stránky soubory cookies – malé textové soubory ukládané ve vašem prohlížeči. Ze zákona ukládáme pouze cookies nezbytně nutné pro provoz webu. Pro analytické a reklamní účely (včetně služeb třetích stran) potřebujeme váš souhlas. Podrobné informace naleznete v našich <a href="/ochrana-osobnich-udaju" class="text-[#000000] underline hover:opacity-80">Zásadách ochrany osobních údajů</a>.
      </p>

      <p class="font-yellix text-[14px] font-normal text-gray-500 mb-3">Kategorie</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 mb-10">
        {CATEGORIES.map((cat) => (
          <span class="inline-flex items-center gap-2">
            {cat.alwaysOn ? (
              <span class="font-yellix text-[14px] font-normal text-[#000000] underline underline-offset-2 decoration-[#000000]">
                {cat.label}
              </span>
            ) : (
              <button
                type="button"
                class="cookie-category font-yellix text-[14px] font-normal border-0 bg-transparent p-0 cursor-pointer no-underline hover:text-gray-600 transition-colors text-gray-400"
                data-category={cat.id}
              >
                {cat.label}
              </button>
            )}
          </span>
        ))}
      </div>

      <div class="flex justify-center">
        <button
          type="button"
          class="font-yellix text-[14px] font-normal text-white bg-[#000000] border border-[#000000] py-3 px-8 cursor-pointer hover:opacity-90 transition-opacity"
          data-cookie-save
        >
          Uložit preference
        </button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Floating cookie panel — dole uprostřed (zatím jen desktop) */
  .cookie-banner {
    position: fixed;
    left: 50%;
    right: auto;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 90;
    width: min(620px, calc(100vw - 24px));
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 16px);
    transition: opacity 0.35s ease, transform 0.4s ease;
  }
  @media (max-width: 1023px) {
    .cookie-banner {
      display: none !important;
    }
  }
  .cookie-banner.is-on {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .cookie-banner-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: #eef4f0;
    border: 1px solid rgba(47, 90, 72, 0.16);
    border-radius: 12px;
    box-shadow: 0 12px 36px rgba(20, 50, 35, 0.16);
  }
  .cookie-banner-icon {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    color: #2f5a48;
  }
  .cookie-banner-main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    min-width: 0;
    flex: 1 1 auto;
  }
  .cookie-banner-label {
    margin: 0;
    font-family: Yellix, system-ui, sans-serif;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #2f5a48;
  }
  .cookie-banner-copy {
    margin: 0;
    font-family: Yellix, system-ui, sans-serif;
    font-size: clamp(11px, 2.8vw, 12.5px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: rgba(20, 45, 35, 0.68);
    white-space: nowrap;
  }
  .cookie-banner-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-self: center;
    gap: 6px 10px;
    flex: 0 0 auto;
  }
  .cookie-banner-btn {
    margin: 0;
    padding: 8px 14px;
    border: 1px solid #2f5a48;
    border-radius: 6px;
    background: #2f5a48;
    color: #fff;
    font-family: Yellix, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    cursor: pointer;
  }
  .cookie-banner-btn:hover {
    background: #264a3b;
    border-color: #264a3b;
  }
  .cookie-banner-btn--ghost {
    background: transparent;
    color: #2f5a48;
  }
  .cookie-banner-btn--ghost:hover {
    background: rgba(47, 90, 72, 0.08);
  }
  .cookie-banner-link {
    margin: 0;
    padding: 0 4px;
    border: 0;
    background: none;
    font-family: Yellix, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    color: rgba(47, 90, 72, 0.72);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cookie-banner-link:hover {
    color: #2f5a48;
  }
  @media (max-width: 640px) {
    .cookie-banner-card {
      flex-wrap: wrap;
      row-gap: 10px;
    }
    .cookie-banner-main {
      flex: 1 1 calc(100% - 52px);
    }
    .cookie-banner-actions {
      flex: 1 1 100%;
      padding-left: 48px;
    }
    .cookie-banner-copy {
      white-space: normal;
    }
  }
  @media (max-width: 379px) {
    .cookie-banner-actions {
      padding-left: 0;
    }
  }
  @media (min-width: 768px) {
    .cookie-banner {
      bottom: 24px;
      width: min(740px, calc(100vw - 48px));
    }
    .cookie-banner-card {
      gap: 14px;
      padding: 12px 16px;
    }
    .cookie-banner-icon {
      width: 40px;
      height: 40px;
    }
    .cookie-banner-label {
      font-size: 18px;
    }
    .cookie-banner-copy {
      font-size: 12.5px;
      white-space: nowrap;
    }
    .cookie-banner-actions {
      flex-wrap: nowrap;
    }
  }
</style>

<script define:vars={{ STORAGE_KEY, SHOW_COOKIE_BANNER, COOKIE_DESIGN_PREVIEW }}>
  function initCookieSystem() {
    const banner = SHOW_COOKIE_BANNER ? document.querySelector('[data-cookie-banner]') : null;
    const overlay = document.querySelector('[data-cookie-overlay]');
    const modal = document.querySelector('[data-cookie-modal]');
    if (!banner && !overlay && !modal) return;
    if (window.__cookieBannerTimer) {
      clearTimeout(window.__cookieBannerTimer);
      window.__cookieBannerTimer = null;
    }

    if (window.__cookieOpenSettingsHandler) {
      document.body.removeEventListener('click', window.__cookieOpenSettingsHandler);
    }

    const designPreview =
      COOKIE_DESIGN_PREVIEW ||
      new URLSearchParams(window.location.search).has('cookies');

    const defaultConsent = {
      necessary: true,
      analytical: false,
      marketing: false,
      consented: false,
    };

    function getConsent() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        const data = JSON.parse(raw);
        return { ...defaultConsent, ...data };
      } catch (_) {
        return null;
      }
    }

    function setConsent(data) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...defaultConsent, ...data }));
      } catch (_) {}
    }

    function updateGtagConsent(prefs) {
      if (typeof window.gtag !== 'function') return;
      window.gtag('consent', 'update', {
        analytics_storage: prefs.analytical ? 'granted' : 'denied',
        ad_storage: prefs.marketing ? 'granted' : 'denied',
        ad_user_data: prefs.marketing ? 'granted' : 'denied',
        ad_personalization: prefs.marketing ? 'granted' : 'denied',
      });
    }

    function isPhone() {
      return window.matchMedia('(max-width: 1023px)').matches;
    }

    function introPlaying() {
      if (designPreview) return false;
      const root = document.documentElement;
      return root.classList.contains('rmm-on') || root.classList.contains('rmi-on') || root.classList.contains('intro-on');
    }

    function showBanner() {
      if (!banner) return;
      if (isPhone()) return;
      const consent = getConsent();
      if (!designPreview && consent && consent.consented) return;
      if (introPlaying()) {
        window.addEventListener('rm:intro-done', function () {
          window.setTimeout(showBanner, 400);
        }, { once: true });
        window.addEventListener('hero-intro-done', function () {
          window.setTimeout(showBanner, 400);
        }, { once: true });
        return;
      }
      banner.classList.add('is-on');
      banner.setAttribute('aria-hidden', 'false');
    }

    function hideBanner() {
      if (!banner) return;
      if (designPreview) return;
      banner.classList.remove('is-on');
      banner.setAttribute('aria-hidden', 'true');
    }

    function findSecondSection() {
      const root = document.querySelector('main') || document.body;
      const sections = Array.prototype.slice.call(root.querySelectorAll('section')).filter(function (el) {
        return el.getClientRects().length > 0;
      });
      return sections[1] || null;
    }

    function scheduleBanner() {
      if (window.__cookieBannerTimer) clearTimeout(window.__cookieBannerTimer);
      if (window.__cookieBannerIo) {
        window.__cookieBannerIo.disconnect();
        window.__cookieBannerIo = null;
      }
      if (window.__cookieBannerScroll) {
        window.removeEventListener('scroll', window.__cookieBannerScroll);
        window.__cookieBannerScroll = null;
      }

      // Mobil: zatím vůbec (desktop až od 2. sekce).
      if (isPhone()) return;

      // Design preview: hned, ať ladíte vzhled.
      if (designPreview) {
        window.__cookieBannerTimer = setTimeout(showBanner, 800);
        return;
      }
      if (getConsent() && getConsent().consented) return;

      const arm = function () {
        if (getConsent() && getConsent().consented) return;
        if (introPlaying()) {
          window.addEventListener('rm:intro-done', function () {
            window.__cookieBannerTimer = setTimeout(arm, 400);
          }, { once: true });
          window.addEventListener('hero-intro-done', function () {
            window.__cookieBannerTimer = setTimeout(arm, 400);
          }, { once: true });
          return;
        }
        showBanner();
      };

      const trigger = findSecondSection();
      if (trigger && 'IntersectionObserver' in window) {
        window.__cookieBannerIo = new IntersectionObserver(
          function (entries) {
            if (!entries.some(function (e) { return e.isIntersecting; })) return;
            if (window.__cookieBannerIo) {
              window.__cookieBannerIo.disconnect();
              window.__cookieBannerIo = null;
            }
            arm();
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        window.__cookieBannerIo.observe(trigger);
        return;
      }

      // Fallback: po scrollu ~3/4 viewportu.
      window.__cookieBannerScroll = function () {
        if (window.scrollY < window.innerHeight * 0.75) return;
        window.removeEventListener('scroll', window.__cookieBannerScroll);
        window.__cookieBannerScroll = null;
        arm();
      };
      window.addEventListener('scroll', window.__cookieBannerScroll, { passive: true });
    }

    function openModal() {
      const prefs = getConsent() || defaultConsent;
      document.querySelectorAll('.cookie-category').forEach(function (btn) {
        const id = btn.getAttribute('data-category');
        if (!id || id === 'necessary') return;
        const active = id === 'analytical' ? prefs.analytical : prefs.marketing;
        btn.setAttribute('data-active', active ? 'true' : 'false');
        if (active) {
          btn.classList.add('underline', 'underline-offset-2', 'decoration-[#000000]', 'text-[#000000]');
          btn.classList.remove('text-gray-400', 'no-underline');
        } else {
          btn.classList.remove('underline', 'underline-offset-2', 'decoration-[#000000]', 'text-[#000000]');
          btn.classList.add('text-gray-400', 'no-underline');
        }
      });
      if (overlay) {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      if (modal) {
        modal.classList.remove('scale-95');
        modal.classList.add('scale-100');
        modal.focus();
      }
    }

    function closeModal() {
      if (overlay) {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      if (modal) {
        modal.classList.remove('scale-100');
        modal.classList.add('scale-95');
      }
    }

    if (SHOW_COOKIE_BANNER && (designPreview || !window.__cookieBannerScheduled)) {
      if (!designPreview) window.__cookieBannerScheduled = true;
      scheduleBanner();
    }

    function handleOpenSettings(e) {
      if (e.target.closest('#open-cookie-settings') || e.target.closest('[data-cookie-settings]')) {
        e.preventDefault();
        openModal();
      }
    }

    if (banner && banner.dataset.bound === '1') {
      window.__cookieOpenSettingsHandler = handleOpenSettings;
      document.body.addEventListener('click', handleOpenSettings);
      return;
    }
    if (banner) banner.dataset.bound = '1';

    function saveAndHide(prefs) {
      setConsent(prefs);
      updateGtagConsent(prefs);
      hideBanner();
    }

    document.querySelector('[data-cookie-accept]')?.addEventListener('click', function () {
      saveAndHide({ necessary: true, analytical: true, marketing: true, consented: true });
    });
    document.querySelector('[data-cookie-reject]')?.addEventListener('click', function () {
      saveAndHide({ necessary: true, analytical: false, marketing: false, consented: true });
    });

    // Nastavení = otevřít modal (ze banneru)
    document.querySelector('[data-cookie-open-settings]')?.addEventListener('click', openModal);

    window.__cookieOpenSettingsHandler = handleOpenSettings;
    document.body.addEventListener('click', handleOpenSettings);

    // Toggle kategorie v modalu (Analytické, Marketingové)
    document.querySelectorAll('.cookie-category').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-category');
        if (!id || id === 'necessary') return;
        const isActive = btn.getAttribute('data-active') === 'true';
        const next = !isActive;
        btn.setAttribute('data-active', next ? 'true' : 'false');
        if (next) {
          btn.classList.add('underline', 'underline-offset-2', 'decoration-[#000000]', 'text-[#000000]');
          btn.classList.remove('text-gray-400', 'no-underline');
        } else {
          btn.classList.remove('underline', 'underline-offset-2', 'decoration-[#000000]', 'text-[#000000]');
          btn.classList.add('text-gray-400', 'no-underline');
        }
      });
    });

    // Uložit preference
    document.querySelector('[data-cookie-save]')?.addEventListener('click', function () {
      const analytical = document.querySelector('.cookie-category[data-category="analytical"]')?.getAttribute('data-active') === 'true';
      const marketing = document.querySelector('.cookie-category[data-category="marketing"]')?.getAttribute('data-active') === 'true';
      const prefs = { necessary: true, analytical, marketing, consented: true };
      setConsent(prefs);
      updateGtagConsent(prefs);
      hideBanner();
      closeModal();
    });

    overlay?.addEventListener('click', closeModal);
    document.querySelectorAll('[data-cookie-modal-close]').forEach(function (btn) {
      btn.addEventListener('click', closeModal);
    });
    modal?.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });
  }
  initCookieSystem();
  document.addEventListener('astro:page-load', initCookieSystem);
</script>
