---
const heroImage = '/images/hero-reamar.webp';
const mobileHeroImage = '/images/Mobil-Hero-Bg.webp';
const videoLeft = '/videos/' + encodeURIComponent('video Pro developery.mp4');
const videoRight = '/videos/' + encodeURIComponent('video Pro klienty.mp4');
---
<section class="hero-split hero-split-height relative w-full overflow-hidden bg-black" aria-label="Úvod">
  <!-- ========== MOBILNÍ HERO – statický obrázek dle designu ========== -->
  <div class="hero-mobile absolute inset-0 flex flex-col md:hidden z-40">
    <!-- Plnoobrazovkové pozadí -->
    <img
      src={mobileHeroImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center"
      width="1080"
      height="1920"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/30 pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 flex flex-1 flex-col min-h-0">
      <!-- Logo REAMAR nahoře, vycentrované -->
      <div class="flex justify-center pt-10 sm:pt-14 shrink-0">
        <img
          src="/images/logo-rig-w.svg"
          alt="Reamar"
          class="max-h-[10vh] w-auto object-contain"
          width="240"
          height="60"
        />
      </div>
      <!-- Blok Reality. + rotující slovo (mobil) + tlačítka; pb s ohledem na lišty a safe-area -->
      <div class="flex flex-1 flex-col justify-end items-start px-6 pb-[max(3.5rem,calc(1rem+env(safe-area-inset-bottom)))] -translate-y-3">
        <div class="hero-mobile-headline text-left font-yellix text-[56px] sm:text-[64px] font-medium leading-[1.15] tracking-tight text-white">
          <span class="hero-line-reality block">Reality.</span>
          <span class="rotating-word ml-[10px] inline-block" aria-live="polite">Marketing.</span>
        </div>
        <div class="mt-6 flex flex-col gap-3 items-start">
          <a
            href="/#developery"
            class="hero-mobile-btn hero-mobile-btn-1 inline-flex items-center gap-2 rounded-none border border-gray-800 bg-white px-5 py-2.5 font-yellix text-sm font-medium text-black no-underline opacity-0 animate-hero-btn-in"
          >
            <img src="/images/arrow-1.svg" alt="" class="h-3.5 w-3.5 shrink-0 brightness-0" width="14" height="14" />
            Pro developery
          </a>
          <a
            href="/#klienty"
            class="hero-mobile-btn hero-mobile-btn-2 inline-flex items-center gap-2 rounded-none border border-gray-800 bg-white px-5 py-2.5 font-yellix text-sm font-medium text-black no-underline opacity-0 animate-hero-btn-in"
          >
            <img src="/images/arrow-1.svg" alt="" class="h-3.5 w-3.5 shrink-0 brightness-0" width="14" height="14" />
            Pro klienty
          </a>
        </div>
      </div>
      <!-- Naše portfolio – vpravo dole, linka pod textem, s vyjevením -->
      <a
        href="/#developery"
        class="hero-mobile-portfolio absolute bottom-0 right-0 pr-6 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-20 pl-8 pointer-events-auto font-yellix text-sm font-medium text-white no-underline inline-block w-fit opacity-0 animate-hero-portfolio-reveal"
        aria-label="Přejít na sekci Formujeme prodej"
      >
        <span class="border-b border-white pb-0.5">Naše portfolio</span>
      </a>
    </div>
  </div>

  <style>
    /* Mobil: 100svh = viditelná výška i s lištami (Safari/Chrome); fallback 100vh pro starší prohlížeče */
    .hero-split-height {
      height: 100vh;
      height: 100svh;
    }
    @media (min-width: 768px) {
      .hero-split-height {
        height: 100vh;
      }
    }

    @keyframes hero-portfolio-reveal {
      0% {
        opacity: 0;
        transform: translateX(12px);
      }
      100% {
        opacity: 1;
        transform: translateX(0);
      }
    }
    .animate-hero-portfolio-reveal {
      animation: hero-portfolio-reveal 0.6s ease-out 0.8s forwards;
    }

    @keyframes hero-btn-in {
      from {
        opacity: 0;
        transform: translateX(24px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }
    .hero-mobile-btn-1 {
      animation: hero-btn-in 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.25s forwards;
    }
    .hero-mobile-btn-2 {
      animation: hero-btn-in 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.4s forwards;
    }

    /* Rotující slovo – mechanický strojek, jen osa Y */
    @keyframes mechanicalClack {
      0% {
        transform: translateY(40px);
        opacity: 0;
      }
      70% {
        transform: translateY(-5px);
        opacity: 1;
      }
      100% {
        transform: translateY(0);
        opacity: 1;
      }
    }
    .rotating-word.snap {
      display: inline-block;
      animation: mechanicalClack 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }
  </style>

  <script>
    function initHeroRotatingWord() {
      if (window.__heroRotatingWordTimeoutId != null) {
        clearTimeout(window.__heroRotatingWordTimeoutId);
        window.__heroRotatingWordTimeoutId = null;
      }
      var words = ['Marketing.', 'Strategie.', 'Investice.', 'Emoce.', 'Prodej.'];
      var el = document.querySelector('.rotating-word');
      var mobile = document.querySelector('.hero-mobile');
      if (!el || !mobile || window.getComputedStyle(mobile).display === 'none') return;
      var i = 0;
      function tick() {
        el.classList.remove('snap');
        el.textContent = words[i];
        el.offsetHeight;
        el.classList.add('snap');
        i = (i + 1) % words.length;
        window.__heroRotatingWordTimeoutId = setTimeout(tick, 2000);
      }
      window.__heroRotatingWordTimeoutId = setTimeout(tick, 0);
    }
    initHeroRotatingWord();
    document.addEventListener('astro:page-load', initHeroRotatingWord);
  </script>

  <!-- ========== DESKTOP HERO (skryté na mobilu) ========== -->
  <div class="absolute inset-0 z-0 hidden md:block">
  <!-- Výchozí: celoobrazovkový obrázek hero-reamar s lehkým zatměním -->
  <div class="absolute inset-0 z-0">
    <img
      src={heroImage}
      alt=""
      class="h-full w-full object-cover"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/50" aria-hidden="true"></div>
  </div>

  <!-- Levá polovina: video (zobrazí se při hoveru na levou stranu). Bez src v HTML = na mobilu se nestahuje (~9 MB). -->
  <div class="hero-half hero-half-left absolute left-0 top-0 z-10 h-full w-1/2 overflow-hidden opacity-0 transition-opacity duration-300" data-half="left">
    <video
      class="h-full w-full object-cover"
      muted
      loop
      playsinline
      preload="none"
      data-hero-video="left"
      data-src={videoLeft}
      aria-hidden="true"
    >
      <source type="video/mp4" data-src={videoLeft} />
    </video>
    <div class="absolute inset-0 bg-black/10 pointer-events-none" aria-hidden="true"></div>
  </div>
  <!-- Pravá polovina: video (zobrazí se při hoveru na pravou stranu). Bez src v HTML = na mobilu se nestahuje (~8 MB). -->
  <div class="hero-half hero-half-right absolute left-1/2 top-0 z-10 h-full w-1/2 overflow-hidden opacity-0 transition-opacity duration-300" data-half="right">
    <video
      class="h-full w-full object-cover"
      muted
      loop
      playsinline
      preload="none"
      data-hero-video="right"
      data-src={videoRight}
      aria-hidden="true"
    >
      <source type="video/mp4" data-src={videoRight} />
    </video>
    <div class="absolute inset-0 bg-black/10 pointer-events-none" aria-hidden="true"></div>
  </div>

  <!-- Zatmavení levé poloviny, když je aktivní pravá -->
  <div class="hero-left-dim absolute left-0 top-0 z-[5] h-full w-1/2 bg-black/0 pointer-events-none transition-colors duration-300" data-left-dim></div>

  <!-- Hover zóny + proklik na kotvy (levá → developery, pravá → klienty) -->
  <a href="/#developery" class="hero-zone absolute left-0 top-0 z-20 h-full w-1/2 cursor-pointer" data-zone="left" aria-label="Pro developery"></a>
  <a href="/#klienty" class="hero-zone absolute left-1/2 top-0 z-20 h-full w-1/2 cursor-pointer" data-zone="right" aria-label="Pro klienty"></a>

  <!-- Pravý horní roh (desktop): REALITY. MARKETING. + Zahájit spolupráci – decentní -->
  <div class="absolute top-0 right-0 z-30 flex flex-col items-end pt-8 md:pt-16 pr-6 md:pr-10 lg:pr-12">
    <span class="font-yellix text-[13px] text-white/60 uppercase tracking-wide">REALITY. MARKETING.</span>
    <a href="javascript:void(0)" class="mt-1.5 font-yellix text-[14px] font-medium text-white/80 border-b border-white/50 hover:text-white hover:border-white/80 transition-colors inline-block w-fit pointer-events-auto" data-smart-contact-open>Zahájit spolupráci</a>
  </div>

  <!-- Bílé logo uprostřed – při scrollu „dojíždí“ do bílé baru, pak se v něm změní na černé (pozice img se sleduje) -->
  <div class="absolute inset-0 z-30 flex items-center justify-center pointer-events-none">
    <img
      data-hero-logo
      src="/images/logo-rig-w.svg"
      alt="Reamar"
      class="max-h-[15vh] w-auto object-contain md:max-h-[18vh]"
      width="400"
      height="100"
    />
  </div>

  <!-- Texty v každé polovině dole – podnadpisy vycentrované pod nadpisy -->
  <div class="absolute left-0 bottom-0 flex h-1/2 w-1/2 items-end justify-center pb-12 md:pb-16 pointer-events-none z-[25]">
    <div class="text-center">
      <h2 class="font-yellix text-xl font-medium text-white md:text-[36px] md:leading-[48px]">
        <a href="/#developery" class="pointer-events-auto hover:underline">Pro developery</a>
      </h2>
      <p class="mt-1 text-sm text-white/90">Marketing - Sales - Consulting - Capital</p>
    </div>
  </div>
  <div class="absolute right-0 bottom-0 flex h-1/2 w-1/2 items-end justify-center pb-12 md:pb-16 pointer-events-none z-[25]">
    <div class="text-center">
      <h2 class="font-yellix text-xl font-medium text-white md:text-[36px] md:leading-[48px]">
        <a href="/#klienty" class="pointer-events-auto hover:underline">Pro klienty</a>
      </h2>
      <p class="mt-1 text-sm text-white/90">Realitní činnost - Výkup - Marketing - Hypotéky</p>
    </div>
  </div>
  </div>
  <!-- konec desktop hero -->

</section>

<script>
  function initHeroVideos() {
    var hero = document.querySelector('.hero-split');
    if (!hero) return;
    const zones = document.querySelectorAll('.hero-zone');
    const leftDim = document.querySelector('[data-left-dim]');
    const leftVideoWrap = document.querySelector('.hero-half-left');
    const rightVideoWrap = document.querySelector('.hero-half-right');
    const leftVideo = document.querySelector('[data-hero-video="left"]');
    const rightVideo = document.querySelector('[data-hero-video="right"]');

    function loadAndPlay(el, src) {
      if (!el || !src) return;
      const source = el.querySelector('source');
      if (source && !source.getAttribute('src')) {
        source.setAttribute('src', src);
        el.load();
      }
      el.play().catch(function () {});
    }
    function pause(el) {
      if (el) el.pause();
    }

    var hover = null;

    function setHover(side) {
      if (hover === side) return;
      hover = side;

      if (leftVideoWrap) leftVideoWrap.style.opacity = hover === 'left' ? '1' : '0';
      if (rightVideoWrap) rightVideoWrap.style.opacity = hover === 'right' ? '1' : '0';
      if (leftDim) leftDim.style.backgroundColor = hover === 'right' ? 'rgba(0,0,0,0.4)' : 'transparent';

      if (hover === 'left') {
        loadAndPlay(leftVideo, leftVideo.getAttribute('data-src'));
        pause(rightVideo);
      } else if (hover === 'right') {
        loadAndPlay(rightVideo, rightVideo.getAttribute('data-src'));
        pause(leftVideo);
      } else {
        pause(leftVideo);
        pause(rightVideo);
      }
    }

    zones.forEach(function (zone) {
      var side = zone.getAttribute('data-zone');
      zone.addEventListener('mouseenter', function () { setHover(side); });
    });
    hero.addEventListener('mouseleave', function () { setHover(null); });
  }

  initHeroVideos();
  document.addEventListener('astro:page-load', initHeroVideos);
</script>
