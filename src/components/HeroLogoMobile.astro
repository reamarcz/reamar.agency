      </g>
      <!-- N-motiv + červené akcenty z loga -->
      <g class="logo-icon">
        <path class="icon-main" d="M27.4436 10.3999V37.8476H9.86132L18.9026 28.8145L18.8985 24.3001L5.35095 37.8476H0V10.3999H17.328L8.54101 19.1869L8.54921 23.6973L21.8384 10.3999H27.4436Z" fill="white"/>
        <path class="icon-accent accent-1" d="M27.4437 0.288086V4.79846L21.8385 10.3995H17.3281L27.4437 0.288086Z" fill="#E20E17"/>
        <path class="icon-accent accent-2" d="M9.86132 37.8462L0 47.7116V43.2053L5.35095 37.8462H9.86132Z" fill="#E20E17"/>
      </g>
    </svg>
  </div>
  <div class="noise-overlay" aria-hidden="true"></div>
</div>

<style>
  .hero-logo-mobile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 4px;
    background: #000;
    position: relative;
    overflow: hidden;
  }

  /* Vrstva pro statické pozadí — pod logem, nad černým pozadím */
  .hero-logo-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: url('/images/SQRE-bg.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .noise-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-size: 256px 256px;
    pointer-events: none;
    opacity: 0.5;
  }

  .logo-wrapper {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: min(320px, calc(100% - 8px));
  }

  .logo-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* --- Výchozí stav (bez .run-animation): vše skryté --- */
  .logo-icon {
    transform-origin: 0 24px;
  }

  .icon-main {
    opacity: 0;
    transform: scale(0.92);
    transform-origin: 14px 24px;
  }

  .icon-accent {
    opacity: 0;
    transform-origin: center;
  }

  .logo-square .letter {
    opacity: 0;
    transform: translateX(28px) skewX(-4deg);
    transform-origin: center center;
  }

  .logo-sub {
    opacity: 0;
    transform: translateY(8px);
  }

  /* --- Animace běží jen při třídě .run-animation (přidá JS při vstupu do viewportu) --- */
  .hero-logo-mobile.run-animation .icon-main {
    animation: iconReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
  }

  .hero-logo-mobile.run-animation .accent-1 {
    animation: accentPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1.7s forwards, accentPulse 0.6s ease-in-out 2.8s 1;
  }

  .hero-logo-mobile.run-animation .accent-2 {
    animation: accentPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1.95s forwards, accentPulse 0.6s ease-in-out 3s 1;
  }

  .hero-logo-mobile.run-animation .logo-square .letter {
    animation: letterShot 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(1.6s + var(--i, 0) * 0.18s);
  }

  .hero-logo-mobile.run-animation .logo-sub {
    animation: subReveal 1s ease-out 3s forwards;
  }

  @keyframes iconReveal {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes accentPop {
    0% {
      opacity: 0;
      transform: scale(0) rotate(-12deg);
      filter: brightness(3);
    }
    60% {
      opacity: 1;
      transform: scale(1.15) rotate(2deg);
      filter: brightness(2.5);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
      filter: brightness(1);
    }
  }

  @keyframes accentPulse {
    0% { filter: brightness(1); }
    50% { filter: brightness(2.5) drop-shadow(0 0 8px #E20E17); }
    100% { filter: brightness(1); }
  }

  @keyframes letterShot {
    from {
      opacity: 0;
      transform: translateX(24px) skewX(-4deg);
    }
    to {
      opacity: 1;
      transform: translateX(0) skewX(0deg);
    }
  }

  @keyframes subReveal {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  (function () {
    const root = document.getElementById('hero-logo-mobile-root');
    if (!root) return;

    let wasVisible = false;

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry) return;

        const isVisible = entry.isIntersecting;

        if (isVisible && !wasVisible) {
          // Právě vjelo do viewportu → malé zpoždění, pak spustit animaci
          root.classList.remove('run-animation');
          root.offsetHeight; // reflow
          setTimeout(() => {
            root.classList.add('run-animation');
          }, 400);
        }

        wasVisible = isVisible;
      },
      { rootMargin: '0px', threshold: 0.2 }
    );

    observer.observe(root);
  })();
</script>
