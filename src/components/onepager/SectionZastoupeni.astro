---
---

<section class="bg-black" aria-label="Zastoupení kupujícího" data-zastoupeni>
  <div class="mx-auto max-w-[1440px] px-5 py-20 md:px-10 md:py-28 xl:px-14 xl:py-32">
    <h2 class="zast-piece m-0 font-yellix text-[28px] font-medium leading-[1.15] tracking-[-0.02em] text-white md:text-[36px] xl:text-[40px]" style="--i: 0">
      Rozhodnutí za miliony<br class="md:hidden" /> si zaslouží<br />
      víc než jen dobrý pocit.
    </h2>

    <div class="zast-split">
      <div class="zast-piece" style="--i: 1">
        <p class="zast-who">Vy</p>
        <p class="zast-claim">
          Kupujete byt<br />
          párkrát za život.
        </p>
      </div>
      <div class="zast-piece zast-side" style="--i: 2">
        <p class="zast-who">My</p>
        <p class="zast-claim">
          Developerský trh<br />
          řešíme každý den.
        </p>
      </div>
    </div>

    <p class="zast-piece zast-note" style="--i: 3">
      Známe ceny, projekty, podmínky i rozdíly, které při jedné návštěvě showroomu nemusí být vidět.
    </p>

    <div class="zast-stats">
      <div class="zast-piece" style="--i: 4">
        <p class="zast-num">456 000 Kč</p>
        <p class="zast-cap">průměrná úspora na ceně a podmínkách jedné transakce</p>
      </div>
      <div class="zast-piece zast-side" style="--i: 5">
        <p class="zast-num">80+ hodin</p>
        <p class="zast-cap">hledání, porovnání a jednání, které nemusíte dělat sami</p>
      </div>
    </div>
  </div>
</section>

<style>
  .zast-piece {
    opacity: 0;
    transform: translateY(14px);
  }
  .zast-piece.is-in {
    animation: zast-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i) * 90ms);
  }
  @keyframes zast-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .zast-who,
  .zast-claim,
  .zast-note,
  .zast-num,
  .zast-cap {
    margin: 0;
    font-family: 'Yellix', system-ui, sans-serif;
    font-weight: 500;
  }
  .zast-who {
    margin-bottom: 0.7rem;
    font-size: 13px;
    letter-spacing: 0.08em;
    line-height: 1;
    color: rgba(255, 255, 255, 0.5);
  }
  .zast-claim {
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .zast-note {
    max-width: 40rem;
    margin-top: 2.5rem;
    font-size: 16px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
  }
  .zast-split,
  .zast-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .zast-split { margin-top: 2.75rem; }
  .zast-stats {
    margin-top: 2.75rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .zast-num {
    font-size: 32px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #afc8b4;
  }
  .zast-cap {
    max-width: 28ch;
    margin-top: 0.55rem;
    font-size: 14px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.62);
  }

  @media (min-width: 768px) {
    .zast-claim { font-size: 26px; }
    .zast-num { font-size: 40px; }
    .zast-split,
    .zast-stats {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .zast-side {
      padding-left: 4rem;
      border-left: 1px solid rgba(255, 255, 255, 0.16);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zast-piece {
      opacity: 1;
      transform: none;
    }
    .zast-piece.is-in { animation: none; }
  }
</style>

<script>
  function initZastoupeni() {
    const wrap = document.querySelector('[data-zastoupeni]');
    if (!wrap) return;
    if (wrap._zastCleanup) wrap._zastCleanup();

    const pieces = [...wrap.querySelectorAll('.zast-piece')];
    if (!pieces.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      pieces.forEach((el) => el.classList.add('is-in'));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        pieces.forEach((el) => el.classList.add('is-in'));
        io.disconnect();
      },
      { threshold: 0.28 }
    );

    io.observe(wrap);

    wrap._zastCleanup = () => {
      io.disconnect();
      wrap._zastCleanup = null;
    };
  }

  initZastoupeni();
  document.addEventListener('astro:page-load', initZastoupeni);
</script>
