---
const bandItems = [
  {
    kind: 'why' as const,
    title: 'Širší výběr.',
    text: 'Včetně předprodejů a neveřejných nabídek.',
  },
  {
    kind: 'why' as const,
    title: 'Byty pod cenou.',
    text: 'Zvýhodněné nabídky, které v běžných cenících nenajdete.',
  },
  {
    kind: 'why' as const,
    title: 'Silnější pozice.',
    text: 'Při jednání s developerem i nastavování podmínek koupě.',
  },
  {
    kind: 'stat' as const,
    to: 456000,
    suffix: ' Kč',
    format: 'spaces',
    fallback: '456 000 Kč',
    text: 'průměrná úspora na ceně a podmínkách jedné transakce',
  },
  {
    kind: 'stat' as const,
    to: 80,
    suffix: '+ hodin',
    format: 'plus',
    fallback: '80+ hodin',
    text: 'hledání, porovnání a jednání, které nemusíte dělat sami',
  },
];
---

<section class="bg-black" aria-label="Zastoupení kupujícího" data-zastoupeni>
  <div class="mx-auto max-w-[1440px] px-5 py-20 md:px-10 md:py-28 xl:px-14 xl:py-32">
    <h2 class="zast-piece m-0 font-yellix text-[28px] font-medium leading-[1.15] tracking-[-0.02em] text-white md:text-[36px] xl:text-[40px]" style="--i: 0">
      Rozhodnutí za miliony<br class="md:hidden" /> si zaslouží<br />
      víc než jen dobrý pocit.
    </h2>

    <div class="zast-split">
      <div class="zast-piece" style="--i: 1">
        <p class="zast-who">Vy</p>
        <p class="zast-claim zast-claim--muted">
          Kupujete byt<br />
          párkrát za život.
        </p>
      </div>
      <div class="zast-piece zast-side" style="--i: 2">
        <p class="zast-who">My</p>
        <p class="zast-claim">
          Developerský trh<br />
          řešíme každý den.
        </p>
      </div>
    </div>

    <div class="zast-band" aria-label="Výhody">
      <p class="zast-who zast-band-kicker zast-piece" style="--i: 3">Výhody</p>
      {bandItems.map((item, index) => (
        <div class:list={['zast-piece', 'zast-band-item', item.kind === 'why' && 'zast-band-why', index > 0 && 'zast-band-side']} style={`--i: ${index + 4}`}>
          {item.kind === 'why' ? (
            <>
              <p class="zast-band-title">{item.title}</p>
              <p class="zast-band-text">{item.text}</p>
            </>
          ) : (
            <>
              <p
                class="zast-num"
                data-zast-count
                data-to={String(item.to)}
                data-suffix={item.suffix}
                data-format={item.format}
              >{item.fallback}</p>
              <p class="zast-band-text">{item.text}</p>
            </>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .zast-piece {
    opacity: 0;
    transform: translateY(14px);
  }
  .zast-piece.is-in {
    animation: zast-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i) * 90ms);
  }
  @keyframes zast-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .zast-who,
  .zast-claim,
  .zast-num,
  .zast-band-title,
  .zast-band-text {
    margin: 0;
    font-family: 'Yellix', system-ui, sans-serif;
    font-weight: 500;
  }
  .zast-who {
    margin-bottom: 0.7rem;
    font-size: 13px;
    letter-spacing: 0.08em;
    line-height: 1;
    color: rgba(255, 255, 255, 0.5);
  }
  .zast-claim {
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .zast-claim--muted {
    color: rgba(255, 255, 255, 0.42);
  }
  .zast-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2.75rem;
  }
  .zast-band {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    margin-top: 2.75rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .zast-band-kicker {
    margin: 0 0 0.25rem;
    grid-column: 1 / -1;
  }
  .zast-band-title {
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #46c37b;
  }
  .zast-num {
    font-size: 28px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #46c37b;
  }
  .zast-band-text {
    max-width: 26ch;
    margin-top: 0.5rem;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.62);
  }

  @media (max-width: 767px) {
    .zast-num {
      font-size: 20px;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }
  }

  @media (min-width: 768px) {
    .zast-claim { font-size: 26px; }
    .zast-num {
      font-size: 22px;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }
    .zast-band-title { font-size: 22px; }
    .zast-split {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .zast-side {
      padding-left: 4rem;
      border-left: 1px solid rgba(255, 255, 255, 0.16);
    }
  }

  @media (min-width: 1100px) {
    .zast-band {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: 0;
      row-gap: 1.25rem;
    }
    .zast-band-kicker {
      margin-bottom: 0;
    }
    .zast-band-title,
    .zast-num { font-size: 18px; }
    .zast-band-item {
      padding-right: 1.5rem;
    }
    .zast-band-side {
      padding-left: 1.5rem;
      border-left: 1px solid rgba(255, 255, 255, 0.16);
    }
    .zast-band-item:last-child {
      padding-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zast-piece {
      opacity: 1;
      transform: none;
    }
    .zast-piece.is-in { animation: none; }
  }
</style>

<script>
  function formatZastCount(value, format, suffix) {
    const n = Math.round(value);
    if (format === 'spaces') {
      return n.toLocaleString('cs-CZ') + suffix;
    }
    if (format === 'plus') {
      return n + suffix;
    }
    return String(n) + suffix;
  }

  function runZastCounters(wrap) {
    const nodes = [...wrap.querySelectorAll('[data-zast-count]')];
    if (!nodes.length) return;
    const duration = 1400;
    const ease = (t) => 1 - Math.pow(1 - t, 3);
    const startAt = performance.now();

    nodes.forEach((el) => {
      el.textContent = formatZastCount(0, el.dataset.format || 'plain', el.dataset.suffix || '');
    });

    const tick = (now) => {
      const t = Math.min(1, (now - startAt) / duration);
      const e = ease(t);
      nodes.forEach((el) => {
        const to = Number(el.dataset.to || 0);
        el.textContent = formatZastCount(to * e, el.dataset.format || 'plain', el.dataset.suffix || '');
      });
      if (t < 1) requestAnimationFrame(tick);
      else {
        nodes.forEach((el) => {
          const to = Number(el.dataset.to || 0);
          el.textContent = formatZastCount(to, el.dataset.format || 'plain', el.dataset.suffix || '');
        });
      }
    };
    requestAnimationFrame(tick);
  }

  function initZastoupeni() {
    const wrap = document.querySelector('[data-zastoupeni]');
    if (!wrap) return;
    if (wrap._zastCleanup) wrap._zastCleanup();

    const pieces = [...wrap.querySelectorAll('.zast-piece')];
    if (!pieces.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      pieces.forEach((el) => el.classList.add('is-in'));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        pieces.forEach((el) => el.classList.add('is-in'));
        // Počítadla: 4. a 5. položka pásu (--i: 7)
        window.setTimeout(() => runZastCounters(wrap), 630);
        io.disconnect();
      },
      { threshold: 0.16, rootMargin: '0px 0px -8% 0px' }
    );

    io.observe(wrap);

    wrap._zastCleanup = () => {
      io.disconnect();
      wrap._zastCleanup = null;
    };
  }

  initZastoupeni();
  document.addEventListener('astro:page-load', initZastoupeni);
</script>
