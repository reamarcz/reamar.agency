  @keyframes kp-bar { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes kp-d-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes kp-d-photo {
    from { opacity: 0; transform: scale(1.05); }
    to { opacity: 1; transform: none; }
  }
  @keyframes kp-shimmer {
    from { background-position: 120% 0; }
    to { background-position: -40% 0; }
  }
  .kp-d-in {
    animation: kp-d-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0s);
  }
  .kp-d-photo > img { animation: kp-d-photo 0.9s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .kp-d-skel {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #e8ece9 0%, #f6f6f5 48%, #e8ece9 100%);
    background-size: 220% 100%;
    animation: kp-shimmer 1.15s linear infinite;
  }
  .kp-pay-bar { transform-origin: left; animation: kp-bar 0.85s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .kp-d-facts div,
  .kp-around-stats div,
  .kp-around-grid div {
    animation: kp-d-in 0.48s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(0.16s + var(--i, 0) * 0.05s);
  }
  @media (prefers-reduced-motion: reduce) {
    .kp-d-in,
    .kp-d-photo > img,
    .kp-d-skel,
    .kp-pay-bar,
    .kp-d-facts div,
    .kp-around-stats div,
    .kp-around-grid div {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
  }

