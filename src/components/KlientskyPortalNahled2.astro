  async function setupMini(p: Project) {
    const box = root!.querySelector('[data-kp-mini]') as HTMLElement | null;
    if (!box) return;
    try {
      await loadMapLibre();
    } catch {
      return;
    }
    const ml = (window as any).maplibregl;
    destroyMini();
    mini = new ml.Map({
      container: box,
      style: STYLE,
      center: [p.lng, p.lat],
      zoom: 13.5,
      interactive: true,
      scrollZoom: false,
      attributionControl: true,
    });
    mini.addControl(new ml.NavigationControl({ showCompass: false }), 'top-right');
    mini.on('load', () => {
      box.querySelector('.kp-d-skel')?.remove();
      mini.resize();
      const pin = document.createElement('div');
      pin.className = 'kp-pin is-on';
      pin.style.background = pinColor(p.pricePerSmFrom);
      new ml.Marker({ element: pin, anchor: 'center' }).setLngLat([p.lng, p.lat]).addTo(mini);
      const label = document.createElement('div');
      label.className = 'kp-d-map-name';
      label.textContent = p.name;
      new ml.Marker({ element: label, anchor: 'bottom', offset: [0, -18] }).setLngLat([p.lng, p.lat]).addTo(mini);
      const spots = [
        { cat: 'bus', dlat: 0.0018, dlng: -0.0022 },
        { cat: 'tram', dlat: -0.0015, dlng: 0.0024 },
        { cat: 'park', dlat: 0.0022, dlng: 0.0009 },
        { cat: 'school', dlat: -0.002, dlng: -0.0015 },
        { cat: 'kindergarten', dlat: 0.0007, dlng: 0.0027 },
        { cat: 'supermarket', dlat: -0.0009, dlng: -0.0025 },
        { cat: 'vlak', dlat: 0.0025, dlng: -0.0005 },
        { cat: 'cafe', dlat: -0.0024, dlng: 0.0006 },
        { cat: 'restaurant', dlat: 0.0012, dlng: 0.002 },
      ];
      spots.forEach((s) => {
        const el = document.createElement('div');
        el.className = 'kp-d-poi';
        el.innerHTML = ico(s.cat);
        new ml.Marker({ element: el, anchor: 'center' }).setLngLat([p.lng + s.dlng, p.lat + s.dlat]).addTo(mini);
      });
    });
  }

  function openDetail(id: string) {
    if (!id) return;
    if (isDemoPage() && state.tab !== 'detail') {
      prevTab = state.tab === 'detail' ? 'vyber' : state.tab;
      pushLayer();
    }
    state.selected = id;
    if (isMobileApp()) state.tab = 'detail';
    clickPop?.remove();
    hoverPop?.remove();
    render();
  }
  function closeDetail(tab?: string) {
    state.selected = '';
    state.tab = tab || (isMobileApp() ? prevTab || 'vyber' : 'vyber');
    render();
    requestAnimationFrame(() => {
      map?.resize();
      if (map) syncMap(filtered());
      if (state.tab === 'mapa') bootMap();
    });
  }

  function openLock(kind = '') {
    const lock = qs<HTMLElement>('[data-kp-lock]');
    const title = lock.querySelector('#kp-lock-title') as HTMLElement;
    const text = lock.querySelector('.kp-lock-text') as HTMLElement;
    if (kind === 'predprodeje') {
      title.textContent = 'Předprodej projektu otevřeme na schůzce';
      text.textContent = 'Jste na našem priority listu. Předprodej projektu makléř ukáže osobně – neposíláme ho e-mailem.';
    } else if (kind === 'zadani') {
      title.textContent = 'Zadání upravíme na schůzce';
      text.textContent = 'Dispozici, rozpočet a lokalitu mění makléř s vámi. Tahle ukázka ukazuje jen aktuální výběr.';
    } else if (kind === 'zpravy') {
      title.textContent = 'Zprávy otevřeme na schůzce';
      text.textContent = 'V portálu si s makléřem píšete o výběru, prohlídkách i dokumentech. Tahle ukázka ukazuje jen výběr projektů.';
    } else if (kind === 'compose') {
      title.textContent = 'Psát makléři můžete po podpisu smlouvy.';
      text.textContent = 'V ukázce je vlákno jen ke čtení. Po podpisu smlouvy si s makléřem píšete přímo v portálu.';
    } else if (kind === 'telefon' || kind === 'email') {
      title.textContent = 'Kontakt otevřeme na schůzce';
      text.textContent = 'Telefon a e-mail na makléře dostanete po podpisu smlouvy. Tahle ukázka ukazuje jen výběr projektů.';
    } else if (kind === 'jednotky') {
      title.textContent = 'Jednotky otevřeme na schůzce';
      text.textContent = 'Konkrétní byty, ceny a rezervace řeší makléř s vámi. Tahle ukázka ukazuje jen výběr projektů.';
    } else if (kind === 'dokumenty') {
      title.textContent = 'Dokumenty otevřeme na schůzce';
      text.textContent = 'Standardy, půdorysy a smlouvy posílá makléř osobně. Tahle ukázka ukazuje jen výběr projektů.';
    } else if (kind === 'podklady') {
      title.textContent = 'Další podklady otevřeme na schůzce';
      text.textContent = 'Půdorysy, ceník, harmonogram i poznámky k jednotkám řeší makléř s vámi. Tahle ukázka ukazuje jen výběr projektů.';
    } else {
      title.textContent = 'Tohle otevřeme na schůzce';
      text.textContent = 'Porovnání, prohlídky a dokumenty řeší makléř s vámi. Tahle ukázka ukazuje jen výběr projektů.';
    }
    if (isDemoPage() && lock.hidden) pushLayer();
    lock.hidden = false;
    (qs<HTMLElement>('[data-kp-lock-close]') as HTMLButtonElement).focus();
  }
  function closeLock() {
    const lock = root?.querySelector('[data-kp-lock]') as HTMLElement | null;
    if (lock) lock.hidden = true;
  }
  function requestCloseLock() {
    if (isDemoPage() && history.state?.kp) history.back();
    else closeLock();
  }
  function openAgent() {
    const ash = qs<HTMLElement>('[data-kp-ash]');
    if (!ash) return;
    if (isDemoPage() && ash.hidden) pushLayer();
    ash.hidden = false;
  }
  function closeAgent() {
    const ash = root?.querySelector('[data-kp-ash]') as HTMLElement | null;
    if (ash) ash.hidden = true;
  }

  function onClick(event: Event) {
    const t = event.target as HTMLElement;
    if (t.closest('[data-kp-lock-close]')) {
      requestCloseLock();
      return;
    }
    if (t.closest('[data-kp-lock]') && !t.closest('[data-kp-lock-card]')) {
      requestCloseLock();
      return;
    }
    if (t.closest('[data-kp-ash-close]') || (t.closest('[data-kp-ash]') && !t.closest('[data-kp-ash-card]'))) {
      if (isDemoPage() && history.state?.kp) history.back();
      else closeAgent();
      return;
    }
    if (t.closest('[data-kp-agent-open]')) {
      openAgent();
      return;
    }
    if (t.closest('[data-smart-meeting-open]')) {
      closeLock();
      closeAgent();
      return;
    }
    const tabBtn = t.closest('[data-kp-tab]') as HTMLElement | null;
    if (tabBtn) {
      if (state.tab === 'detail' && isDemoPage() && history.state?.kp) {
        skipPop = true;
        history.back();
      }
      setTab(tabBtn.dataset.kpTab || 'vyber');
      return;
    }
    const locked = t.closest('[data-kp-locked]') as HTMLElement | null;
    if (locked) {
      openLock(locked.dataset.kpLocked || '');
      return;
    }
    const open = t.closest('[data-kp-open]') as HTMLElement | null;
    if (open) {
      openDetail(open.dataset.kpOpen || '');
      return;
    }
    const card = t.closest('[data-kp-card]') as HTMLElement | null;
    if (card) {
      openDetail(card.dataset.kpCard || '');
      return;
    }
    if (t.closest('[data-kp-back]')) {
      if (isDemoPage() && history.state?.kp) history.back();
      else closeDetail();
    }
  }

  function onFocusIn(event: Event) {
    const t = event.target as HTMLElement;
    if (t.closest('[data-smart-meeting-open]')) return;
    const locked = t.closest?.('[data-kp-locked]') as HTMLElement | null;
    if (!locked || !root?.contains(locked)) return;
    t.blur?.();
    openLock(locked.dataset.kpLocked || '');
  }

  function onKey(event: KeyboardEvent) {
    if (event.key !== 'Escape') return;
    const lock = root?.querySelector('[data-kp-lock]') as HTMLElement | null;
    if (lock && !lock.hidden) {
      requestCloseLock();
      event.stopPropagation();
      return;
    }
    const ash = root?.querySelector('[data-kp-ash]') as HTMLElement | null;
    if (ash && !ash.hidden) {
      if (isDemoPage() && history.state?.kp) history.back();
      else closeAgent();
      event.stopPropagation();
    }
  }

  function onOver(event: Event) {
    if (state.selected) return;
    const card = (event.target as HTMLElement).closest('[data-kp-card]') as HTMLElement | null;
    if (!card || !root!.contains(card)) return;
    const id = card.dataset.kpCard || '';
    if (id === state.hover) return;
    setHover(id, { fly: true, pop: true });
  }
  function onOut(event: Event) {
    const card = (event.target as HTMLElement).closest('[data-kp-card]') as HTMLElement | null;
    if (!card) return;
    const next = (event as MouseEvent).relatedTarget as Node | null;
    if (next && card.contains(next)) return;
    if (next && (next as HTMLElement).closest?.('.kp-pin')) return;
    setHover('');
  }

  function onPop() {
    if (skipPop) {
      skipPop = false;
      return;
    }
    const sheet = document.querySelector('[data-pdm-sheet]') as HTMLElement | null;
    if (sheet && !sheet.hidden) return;
    const ash = root?.querySelector('[data-kp-ash]') as HTMLElement | null;
    if (ash && !ash.hidden) {
      closeAgent();
      return;
    }
    const lock = root?.querySelector('[data-kp-lock]') as HTMLElement | null;
    if (lock && !lock.hidden) {
      closeLock();
      return;
    }
    if (state.tab === 'detail' || state.selected) {
      closeDetail();
    }
  }
  function onSideScroll() {
    const side = root?.querySelector('[data-kp-side]') as HTMLElement | null;
    const ttl = side?.querySelector('.kp-ttl') as HTMLElement | null;
    if (!side || !ttl) return;
    side.classList.toggle('is-stuck', ttl.getBoundingClientRect().bottom < side.getBoundingClientRect().top + 10);
  }

  function cleanup() {
    if (!root) return;
    root.removeEventListener('click', onClick);
    root.removeEventListener('focusin', onFocusIn);
    root.removeEventListener('mouseover', onOver);
    root.removeEventListener('mouseout', onOut);
    document.removeEventListener('keydown', onKey);
    window.removeEventListener('resize', onWinResize);
    window.removeEventListener('popstate', onPop);
    root.querySelector('[data-kp-side]')?.removeEventListener('scroll', onSideScroll);
    destroyMap();
    destroyMini();
    mapBooted = false;
    root = null;
  }

  function onWinResize() {
    map?.resize();
    mini?.resize();
  }

  async function init() {
    const next = document.querySelector('[data-kp]') as HTMLElement | null;
    if (!next) return;
    if (!shouldBoot()) return;
    if (root === next) return;
    cleanup();
    root = next;
    if (!payloadJson) {
      const mod = await import('../data/praha9-nahled.json');
      payloadJson = ((mod as { default?: { projects: Project[] } }).default || mod) as { projects: Project[] };
    }
    allProjects = payloadJson.projects || [];
    const byId = new Map(allProjects.map((p) => [p.id, p]));
    projects = VYBER.map((item) => byId.get(item.id)).filter(Boolean) as Project[];
    const pps = [...allProjects.map((p) => p.pricePerSmFrom)].sort((a, b) => a - b);
    t1 = pps[Math.floor(pps.length / 3)] || 0;
    t2 = pps[Math.floor((pps.length * 2) / 3)] || 0;
    state = { selected: '', hover: '', tab: 'vyber' };
    applyStartTab();
    root.addEventListener('click', onClick);
    root.addEventListener('focusin', onFocusIn);
    root.addEventListener('mouseover', onOver);
    root.addEventListener('mouseout', onOut);
    document.addEventListener('keydown', onKey);
    window.addEventListener('resize', onWinResize);
    window.addEventListener('popstate', onPop);
    root.querySelector('[data-kp-side]')?.addEventListener('scroll', onSideScroll, { passive: true });
    const att = root.querySelector('[data-kp-att-photo]') as HTMLImageElement | null;
    if (att && projects[0]?.coverUrl) att.src = projects[0].coverUrl;
    render();
    if (!isMobileApp() || state.tab === 'mapa') bootMap();
    if (isDemoPage() && state.tab === 'detail') pushLayer();
    maybeNudge();
  }

  init();
  document.addEventListener('astro:page-load', () => { init(); });
  document.addEventListener('astro:before-swap', cleanup);
</script>
