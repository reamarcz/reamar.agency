---
const brief = ['3+kk', 'do 12 mil. Kč', 'Praha 9', 'dokončení do 2028', 'balkon / terasa', 'MHD do 10 min.'];
const menu: { id: string; label: string; count?: number; current?: boolean; lock?: string }[] = [
  { id: 'vyber', label: 'Můj výběr', count: 4, current: true },
  { id: 'zpravy', label: 'Zprávy', count: 2, lock: 'zpravy' },
  { id: 'porovnani', label: 'Porovnání' },
  { id: 'prohlidky', label: 'Prohlídky', count: 2 },
  { id: 'dokumenty', label: 'Dokumenty' },
];
---

<div class="kp" data-kp>
  <div class="kp-app" data-kp-app>
    <aside class="kp-nav" aria-label="Klientský výběr">
      <div class="kp-nav-main">
        <div class="kp-client">
          <span class="kp-ava font-yellix" aria-hidden="true">TK</span>
          <div>
            <p class="kp-client-name font-yellix">Tereza K.</p>
            <p class="kp-client-meta font-yellix">Aktualizováno 6. 11.</p>
          </div>
        </div>
        <div class="kp-brief">
          <div class="kp-brief-head">
            <p class="kp-nav-kicker font-yellix">Vaše zadání</p>
            <button
              type="button"
              class="kp-brief-edit"
              data-kp-locked="zadani"
              aria-label="Upravit zadání s makléřem"
              title="Upravit zadání s makléřem"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 20h9"/>
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
              </svg>
            </button>
          </div>
          <ul>
            {brief.map((tag) => (
              <li class="font-yellix">{tag}</li>
            ))}
          </ul>
        </div>
        <nav class="kp-menu" aria-label="Sekce výběru">
          <ul>
            {menu.map((item) => (
              <li>
                {item.current ? (
                  <span class="kp-nav-item is-on" aria-current="page">
                    {item.label}
                    {item.count != null && <em>{item.count}</em>}
                  </span>
                ) : (
                  <button type="button" class="kp-nav-item" data-kp-locked={item.lock || true}>
                    {item.label}
                    {item.count != null && <em class={item.id === 'zpravy' ? 'is-new' : undefined}>{item.count}</em>}
                  </button>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <button type="button" class="kp-prio" data-kp-locked="predprodeje">
        <span class="kp-prio-copy">
          <span class="kp-prio-kicker font-yellix">Priority list</span>
          <span class="kp-prio-name font-yellix">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
              <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
            </svg>
            Předprodej projektu
          </span>
          <span class="kp-prio-meta font-yellix">Jste zařazení · 3 projekty</span>
        </span>
        <span class="kp-prio-go" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 6l6 6-6 6"/>
          </svg>
        </span>
      </button>
      <div class="kp-agent">
        <p class="kp-nav-kicker font-yellix">Konzultant</p>
        <div class="kp-agent-row">
          <img src="/images/agency/jan-prochazka.jpg" alt="" width="40" height="40" />
          <p class="kp-agent-name font-yellix">Jan Procházka</p>
          <div class="kp-agent-acts" aria-hidden="true">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6.7 3.8h2.4l1.2 3.3-1.9 1.2a13 13 0 0 0 6.3 6.3l1.2-1.9 3.3 1.2v2.4c0 1.3-1.4 2.6-3 2.6C8.8 19 4 14.2 4 6.8c0-1.6 1.3-3 2.7-3z"/>
              </svg>
            </span>
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/>
                <path d="m4.2 7.2 7.8 6 7.8-6"/>
              </svg>
            </span>
          </div>
        </div>
      </div>
    </aside>
    <aside class="kp-side" data-kp-side>
      <header class="kp-mhead">
        <span class="kp-mava font-yellix" aria-hidden="true">TK</span>
        <div class="kp-mhi">
          <b class="font-yellix">Tereza K.</b>
          <small class="font-yellix">Aktualizováno 6. 11.</small>
        </div>
        <button type="button" class="kp-mkp font-yellix" data-kp-agent-open>
          <img src="/images/agency/jan-prochazka.jpg" alt="" width="28" height="28" />
          Konzultant
        </button>
      </header>
      <div class="kp-stk">
        <b class="font-yellix">Váš výběr</b>
        <span class="font-yellix">4 projekty</span>
        <div class="kp-stk-r">
          <button type="button" class="kp-ic-s" data-kp-locked="porovnani" aria-label="Porovnání, zamčeno v ukázce">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7h.01M8 12h.01M8 17h.01M12 7h8M12 12h8M12 17h8"/></svg>
            <span class="kp-lk-s" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="8" height="8" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="6" y="11" width="12" height="9"/><path d="M8 11V8.5a4 4 0 0 1 8 0V11"/></svg>
            </span>
          </button>
          <button type="button" class="kp-ic-s" data-kp-locked="filtr" aria-label="Filtr, zamčeno v ukázce">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
          </button>
        </div>
      </div>
      <div class="kp-ttl">
        <h1 class="font-yellix">Váš výběr</h1>
        <span class="font-yellix">4 projekty</span>
      </div>
      <div class="kp-zd">
        <div class="kp-zd-h">
          <span class="font-yellix">Vaše zadání</span>
          <button type="button" data-kp-locked="zadani" aria-label="Upravit zadání, zamčeno v ukázce">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          </button>
        </div>
        <div class="kp-chips">
          {brief.map((tag) => (
            <span class="font-yellix">{tag}</span>
          ))}
        </div>
      </div>
      <button type="button" class="kp-prl" data-kp-locked="predprodeje">
        <i aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
        </i>
        <span>
          <small class="font-yellix">Priority list</small>
          <b class="font-yellix">Předprodej projektu</b>
          <em class="font-yellix">Jste zařazení · 3 projekty</em>
        </span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>
      <div class="kp-side-top">
        <div class="kp-side-head">
          <span class="font-yellix">Váš výběr</span>
          <b class="font-yellix">4 projekty</b>
        </div>
      </div>
      <div class="kp-cards" data-kp-cards></div>
      <p class="kp-empty font-yellix" data-kp-empty hidden>V tomhle výběru teď nic není.</p>
    </aside>
    <div class="kp-mapwrap">
      <div class="kp-map" data-kp-mapbox></div>
      <div class="kp-mtop">
        <div class="kp-mttl">
          <b class="font-yellix">Váš výběr</b>
          <span class="font-yellix">4 projekty · Praha 9</span>
        </div>
        <button type="button" class="kp-mlist" data-kp-tab="vyber" aria-label="Seznam projektů">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M8 7h.01M8 12h.01M8 17h.01M12 7h8M12 12h8M12 17h8"/></svg>
        </button>
      </div>
      <aside class="kp-mleg" aria-label="Barva pinu podle ceny za metr">
        <small class="font-yellix">Cena / m²</small>
        <b class="kp-mleg-bar" aria-hidden="true"></b>
        <div>
          <span class="font-yellix"><i class="is-low"></i>nižší</span>
          <span class="font-yellix"><i class="is-mid"></i>střed</span>
          <span class="font-yellix"><i class="is-high"></i>vyšší</span>
          <span class="font-yellix"><i class="is-rest"></i>mimo výběr</span>
        </div>
      </aside>
      <div class="kp-mcards" data-kp-mcards></div>
      <aside class="kp-legend" aria-label="Barva pinu podle ceny za metr">
        <div class="kp-legend-head">
          <span>Barva podle ceny / m²</span>
        </div>
        <div class="kp-legend-bar" aria-hidden="true"></div>
        <div class="kp-legend-scale" aria-hidden="true">
          <span>levnější</span>
          <span>dražší</span>
        </div>
        <ul>
          <li><i class="is-low"></i>Nižší cena</li>
          <li><i class="is-mid"></i>Střed spektra</li>
          <li><i class="is-high"></i>Vyšší cena</li>
          <li><i class="is-rest"></i>Mimo váš výběr</li>
        </ul>
      </aside>
    </div>
  </div>
  <div class="kp-detail" data-kp-detail hidden></div>
  <div class="kp-chat" data-kp-chat hidden>
    <div class="kp-chat-head">
      <button type="button" class="kp-chat-back" data-kp-tab="vyber" aria-label="Zpět">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
      </button>
      <img src="/images/agency/jan-prochazka.jpg" alt="" width="40" height="40" />
      <div>
        <p class="kp-chat-name font-yellix">Jan Procházka</p>
        <p class="kp-chat-meta font-yellix"><i class="kp-on" aria-hidden="true"></i>Konzultant · online</p>
      </div>
      <button type="button" class="kp-chat-call" data-kp-locked="telefon" aria-label="Zavolat, zamčeno v ukázce">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.7 3.8h2.4l1.2 3.3-1.9 1.2a13 13 0 0 0 6.3 6.3l1.2-1.9 3.3 1.2v2.4c0 1.3-1.4 2.6-3 2.6C8.8 19 4 14.2 4 6.8c0-1.6 1.3-3 2.7-3z"/></svg>
      </button>
    </div>
    <div class="kp-chat-log">
      <p class="c-day font-yellix">Dnes</p>
      <p class="msg m-in is-them font-yellix">Terezo, posílám výběr 3+kk na Praze 9. Mallard dává nejlíp smysl k zadání.</p>
      <button type="button" class="att" data-kp-open="d5dd1a8d-f2da-40e3-ae83-28b2db25063c">
        <img src="" alt="" data-kp-att-photo />
        <span>
          <small class="rk font-yellix">01 · Doporučujeme</small>
          <b class="font-yellix">Mallard</b>
          <small class="font-yellix">Hrdlořezy · od 10,5 mil. Kč</small>
        </span>
      </button>
      <p class="msg m-out is-me font-yellix">Díky. Můžeme se na Mallard podívat příští týden?</p>
      <p class="msg m-in is-them font-yellix">Ano, prohlídka 12. 11. v 16:00. Ještě potvrdím termín developerovi.</p>
      <div class="ev">
        <div class="ev-d"><small class="font-yellix">LIS</small><b class="font-yellix">12</b></div>
        <div class="ev-t">
          <b class="font-yellix">Prohlídka · Mallard</b>
          <small class="font-yellix">čt 16:00 · Praha 9, Hrdlořezy</small>
        </div>
        <span class="ev-ok" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5 10 17l9-10"/></svg>
        </span>
      </div>
      <span class="ev-add font-yellix" data-kp-locked="kalendar" role="button" tabindex="0">+ Přidat do kalendáře</span>
    </div>
    <div class="c-in kp-chat-compose" data-kp-locked="compose" role="button" tabindex="0" aria-label="Napsat makléři, zamčeno v ukázce">
      <span class="c-fld font-yellix">Napište makléři…</span>
      <span class="c-snd" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </span>
    </div>
  </div>
  <nav class="kp-tabbar" data-kp-tabbar aria-label="Sekce portálu">
    <button type="button" class="is-on" data-kp-tab="vyber">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="7" height="7"/><rect x="13" y="4" width="7" height="7"/><rect x="4" y="13" width="7" height="7"/><rect x="13" y="13" width="7" height="7"/></svg>
      Výběr
    </button>
    <button type="button" data-kp-tab="mapa">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
      Mapa
    </button>
    <button type="button" data-kp-tab="zpravy">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6h14v10H8l-3 3V6z"/></svg>
      Zprávy
      <em>2</em>
    </button>
    <button type="button" class="is-lk" data-kp-locked="prohlidky" aria-disabled="true" aria-label="Prohlídky, zamčeno v ukázce">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="1.5"/><path d="M8 5V3.8A2.2 2.2 0 0 1 10.2 1.6h3.6A2.2 2.2 0 0 1 16 3.8V5"/><path d="M8 11h8M8 15h5"/></svg>
      Prohlídky
      <span class="kp-tb-lk" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="8" height="8" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="6" y="11" width="12" height="9"/><path d="M8 11V8.5a4 4 0 0 1 8 0V11"/></svg>
      </span>
    </button>
    <button type="button" class="is-lk" data-kp-locked="dokumenty" aria-disabled="true" aria-label="Dokumenty, zamčeno v ukázce">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3.5h7.5L19 8v12.5H7z"/><path d="M14.5 3.5V8H19"/><path d="M9.5 12.5h5M9.5 16h5"/></svg>
      Dokumenty
      <span class="kp-tb-lk" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="8" height="8" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="6" y="11" width="12" height="9"/><path d="M8 11V8.5a4 4 0 0 1 8 0V11"/></svg>
      </span>
    </button>
  </nav>
  <div class="kp-ash" data-kp-ash hidden>
    <div class="kp-ash-card" role="dialog" aria-modal="true" aria-labelledby="kp-ash-title" data-kp-ash-card>
      <button type="button" class="kp-lock-close" data-kp-ash-close aria-label="Zavřít">×</button>
      <img src="/images/agency/jan-prochazka.jpg" alt="" width="56" height="56" />
      <h2 class="font-yellix" id="kp-ash-title">Jan Procházka</h2>
      <p class="font-yellix">Konzultant</p>
      <div class="kp-ash-btns">
        <button type="button" class="font-yellix" data-kp-locked="telefon">Zavolat</button>
        <button type="button" class="font-yellix" data-kp-locked="email">E-mail</button>
      </div>
    </div>
  </div>
  <div class="kp-lock" data-kp-lock hidden>
    <div class="kp-lock-card" role="dialog" aria-modal="true" aria-labelledby="kp-lock-title" data-kp-lock-card>
      <button type="button" class="kp-lock-close" data-kp-lock-close aria-label="Zavřít">×</button>
      <div class="kp-lock-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5.5" y="11" width="13" height="9" rx="0"/>
          <path d="M8 11V8.4a4 4 0 0 1 8 0V11"/>
        </svg>
      </div>
      <h2 class="kp-lock-title font-yellix" id="kp-lock-title">Tohle otevřeme na schůzce</h2>
      <p class="kp-lock-text font-yellix">Porovnání, prohlídky a dokumenty řeší makléř s vámi. Tahle ukázka ukazuje jen výběr projektů.</p>
      <button type="button" class="kp-lock-cta font-yellix" data-smart-meeting-open data-smart-meeting-type="client">
        <img src="/images/arrow-1.svg" alt="" width="12" height="12" />
        Domluvit schůzku
      </button>
    </div>
  </div>
</div>

<style is:global>
  .kp {
    --kp-green: #022d20;
    --kp-blue: #1d3b8a;
    --kp-blue-soft: #e8eeff;
    --kp-blue-mid: #5b8def;
    --kp-blue-line: #c9d6f5;
    --kp-line: rgba(0, 0, 0, 0.1);
    --kp-soft: #f4f4f3;
    --kp-low: #2f9e6b;
    --kp-mid: #d4a017;
    --kp-high: #e24b4a;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--kp-line);
    background: #fff;
    color: #111;
    min-height: 36rem;
    height: min(74rem, calc(100dvh - var(--nav-h) - 8.5rem));
  }
  .kp [hidden] { display: none !important; }
  .kp .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  @media (max-width: 959px) {
    .kp {
      height: calc(100dvh - var(--nav-h));
      min-height: 36rem;
      border: 0;
    }
  }

  .kp-app {
    display: grid;
    grid-template-columns: 16.75rem minmax(18rem, 24rem) 1fr;
    flex: 1;
    height: auto;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
  }
  @media (max-width: 959px) {
    .kp-app {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(13rem, 1fr) auto auto auto;
      grid-template-areas:
        "head"
        "map"
        "prio"
        "cards"
        "agent";
      height: 100%;
      min-height: 0;
    }
  }

  .kp-nav {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 1rem 0.9rem 1rem;
    background: #fbfbfb;
    color: #111;
    border-right: 1px solid var(--kp-line);
  }
  @media (max-width: 959px) {
    .kp-nav {
      display: contents;
    }
    .kp-nav-main {
      grid-area: head;
      padding: 0.7rem 0.8rem 0.5rem;
      background: #fff;
      border-bottom: 1px solid var(--kp-line);
    }
    .kp-brief {
      margin-top: 0.55rem;
      padding-top: 0;
      border-top: 0;
    }
    .kp-brief ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .kp-brief ul::-webkit-scrollbar { display: none; }
    .kp-menu { margin-top: 0.65rem; }
    .kp-menu ul {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .kp-menu ul::-webkit-scrollbar { display: none; }
  }
  .kp-client {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .kp-ava {
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--kp-green);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .kp-client-name {
    margin: 0;
    font-size: 16px;
