<script>
  type Project = {
    id: string;
    name: string;
    developer?: string;
    quarter: string;
    address?: string;
    lat: number;
    lng: number;
    completion?: string | null;
    coverUrl?: string | null;
    projectUrl?: string | null;
    priceFrom: number;
    pricePerSmFrom: number;
    layouts: string[];
    counts: { available: number; reserved: number; sold: number; total: number };
    header?: {
      payments?: { contractPct: number; constructionPct: number; moveInPct: number };
      priceFromByLayout?: { layout: string; priceFrom: number | null; note?: string | null }[];
    };
    surroundings?: { category: string; label: string; name: string | null; distanceM: number }[];
    summary?: {
      available: number;
      sold: number;
      total: number;
      soldPct: number;
      layoutMix: { layout: string; available: number; total: number }[];
      pricePerSm: { min: number; median: number; max: number };
    };
    priceTrend?: { month: string; medianPerSm: number | null }[];
    standards?: Record<string, unknown>;
  };

  const MONTHS = ['leden', 'únor', 'březen', 'duben', 'květen', 'červen', 'červenec', 'srpen', 'září', 'říjen', 'listopad', 'prosinec'];
  const FALLBACKS = ['#d7e2d9', '#e4ddd4', '#d9e0e6', '#e8e4dc', '#dce6df'];
  const PIN = { low: '#2f9e6b', mid: '#d4a017', high: '#e24b4a' };
  const PIN_DEMO = { low: '#3e9a5f', mid: '#d4a32a', high: '#d9534f' };
  const ML_CSS = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css';
  const ML_JS = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js';
  const STYLE = 'https://tiles.openfreemap.org/styles/positron';
  const WANT = '3+kk';
  const VYBER = [
    {
      id: 'd5dd1a8d-f2da-40e3-ae83-28b2db25063c',
      note: 'Nejlepší poměr v Hrdlořezích. 3+kk od 10,5 mil., část s terasou.',
      status: { kind: 'view', label: 'K prohlídce 12. 11.' },
    },
    {
      id: 'e58c0de2-a10b-46fb-874f-13f712932aa1',
      note: 'Nejvíc volných 3+kk a termín 2028. Cena je kousek nad zadáním.',
      status: { kind: 'hold', label: 'Rezervace do 20. 11.' },
    },
    {
      id: '04baac53-a76d-4a09-abed-d76b3655748f',
      note: 'Velký výběr 3+kk. Termín 2029 je za zadáním, ale dispozice a cena sedí.',
      status: { kind: 'view', label: 'K prohlídce 12. 11.' },
    },
    {
      id: 'ce1767bd-1620-45a6-bbc7-fcb88ab3aa01',
      note: 'Jediný volný 3+kk v etapě. Hodí se, pokud chcete bydlet dřív – kolaudace 2026.',
      status: { kind: 'view', label: 'K prohlídce 12. 11.' },
    },
  ] as const;

  let root: HTMLElement | null = null;
  let payloadJson: { projects: Project[] } | null = null;
  let allProjects: Project[] = [];
  let projects: Project[] = [];
  let state = { selected: '', hover: '', tab: 'vyber' };
  let prevTab = 'vyber';
  let skipPop = false;
  let mapBooted = false;
  let map: any = null;
  let mini: any = null;
  let markers: { id: string; marker: any; el: HTMLElement }[] = [];
  let hoverPop: any = null;
  let clickPop: any = null;
  let t1 = 0;
  let t2 = 0;

  function qs<T extends Element>(sel: string) {
    return root!.querySelector(sel) as T;
  }
  function prefersLess() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  function czk(n: number) {
    return `${Math.round(n).toLocaleString('cs-CZ')}\u00a0Kč`;
  }
  function odCzk(n: number) {
    if (n >= 1_000_000) {
      const mil = n / 1_000_000;
      const t = mil.toLocaleString('cs-CZ', { maximumFractionDigits: 1 });
      return `od ${t}\u00a0mil.\u00a0Kč`;
    }
    return `od ${czk(n)}`;
  }
  function milLabel(n: number) {
    return `${(n / 1_000_000).toLocaleString('cs-CZ', { maximumFractionDigits: 1 })}\u00a0mil.\u00a0Kč`;
  }
  function priceFromWanted(p: Project) {
    const row = p.header?.priceFromByLayout?.find((r) => r.layout === WANT);
    return row?.priceFrom || p.priceFrom;
  }
  function matchCount(p: Project) {
    const row = p.summary?.layoutMix?.find((m) => m.layout === WANT);
    if (row) return row.available;
    return hasLayout(p, WANT) ? 1 : 0;
  }
  function matchLabel(n: number) {
    if (n === 1) return '1 byt 3+kk';
    if (n >= 2 && n <= 4) return `${n} byty 3+kk`;
    return `${n} bytů 3+kk`;
  }
  function dist(m: number) {
    if (m >= 1000) return `${(m / 1000).toLocaleString('cs-CZ', { maximumFractionDigits: 1 })}\u00a0km`;
    return `${Math.round(m)}\u00a0m`;
  }
  function doneWhen(raw?: string | null) {
    if (!raw) return 'termín upřesníme';
    const [y, m] = raw.split('-');
    if (!m) return y;
    return `${MONTHS[Number(m) - 1] || m} ${y}`;
  }
  function fallback(id: string) {
    let h = 0;
    for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;
    return FALLBACKS[h % FALLBACKS.length];
  }
  function pinBand(pps: number): 'low' | 'mid' | 'high' {
    if (pps <= t1) return 'low';
    if (pps <= t2) return 'mid';
    return 'high';
  }
  function pinColor(pps: number) {
    return (isDemoPage() ? PIN_DEMO : PIN)[pinBand(pps)];
  }
  function esc(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }
  function photo(url: string | null | undefined, alt: string) {
    if (!url) return '';
    return `<img src="${url}" alt="${esc(alt)}" loading="lazy" onerror="this.remove()">`;
  }
  function hasLayout(p: Project, layout: string) {
    const row = p.summary?.layoutMix?.find((m) => m.layout === layout);
    if (row) return row.available > 0;
    return (p.layouts || []).includes(layout);
  }
  function trendOf(p: Project) {
    const pts = (p.priceTrend || []).filter((t) => t.medianPerSm != null) as { medianPerSm: number }[];
    if (pts.length < 2) return null;
    const a = pts[0].medianPerSm;
    const b = pts[pts.length - 1].medianPerSm;
    if (!a) return null;
    const pct = ((b - a) / a) * 100;
    const dir = Math.abs(pct) < 0.15 ? 'flat' : pct > 0 ? 'up' : 'down';
    const n = `${pct > 0 ? '+' : ''}${pct.toLocaleString('cs-CZ', { maximumFractionDigits: 1 })}`;
    return { dir, text: `Cena vs. trh ${n}\u00a0%` };
  }
  function ico(kind: string) {
    const s = 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
    const wrap = (d: string) => `<svg viewBox="0 0 16 16" aria-hidden="true"><path ${s} d="${d}"/></svg>`;
    if (kind === 'supermarket') return wrap('M2.5 3.5h2l.8 8h7.4l1.3-6H5.2M6.5 13.5h.1M11.5 13.5h.1');
    if (kind === 'school') return wrap('M2 12.5 8 4l6 8.5M8 4v8.5M4.5 12.5h7');
    if (kind === 'kindergarten') return wrap('M8 3.5v9M4 7.5c0-2 1.8-4 4-4s4 2 4 4M4.5 13h7');
    if (kind === 'metro') return wrap('M3.5 3.5h9v9h-9zM6 12.5v-6M10 12.5v-6');
    if (kind === 'tram') return wrap('M4 5.5h8v6H4zM6 3.5h4M5 14h.1M11 14h.1M4 8.5h8');
    if (kind === 'bus') return wrap('M4 3.5h8v8H4zM5.5 13.5h.1M10.5 13.5h.1M4 9.5h8');
    if (kind === 'vlak') return wrap('M4 4.5h8v7H4zM6 13.5h4M4 8.5h8');
    if (kind === 'cafe') return wrap('M4 5.5h7.5v5A3.5 3.5 0 0 1 8 14 3.5 3.5 0 0 1 4.5 10.5v-5H4M11.5 6.5h1.4A1.6 1.6 0 0 1 14.5 8a1.6 1.6 0 0 1-1.6 1.5H11.5');
    if (kind === 'restaurant') return wrap('M5 2.5v11M5 6.5h2.2M11 2.5c0 3-1.6 4-1.6 4v7');
    if (kind === 'playground') return wrap('M3.5 13.5h9M8 13.5V6.5M5 8.5h6M4 6.5h8');
    if (kind === 'green' || kind === 'park') return wrap('M8 13.5V8M4.5 11c0-3 1.6-5.5 3.5-5.5S11.5 8 11.5 11M6 7c.4-2 1.4-3.5 2-3.5s1.6 1.5 2 3.5');
    return wrap('M8 13.5s-5-3.2-5-7A5 5 0 0 1 8 1.5a5 5 0 0 1 5 5c0 3.8-5 7-5 7z');
  }
  function seed(s: string) {
    let h = 0;
    for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
    return h;
  }
  function aroundM(p: Project, cat: string) {
    const hit = (p.surroundings || []).find((s) => s.category === cat);
    if (hit?.distanceM != null) return hit.distanceM;
    return 70 + (seed(p.id + cat) % 280);
  }
  function doneDot(raw?: string | null) {
    if (!raw) return 'termín upřesníme';
    const [y, m] = raw.split('-');
    if (!m) return y;
    const last = new Date(Number(y), Number(m), 0).getDate();
    return `${last}. ${Number(m)}. ${y}`;
  }
  function unitRows(p: Project) {
    const base = priceFromWanted(p);
    const rows = [
      { layout: '3+kk', area: 85, floor: '-1. patro', extra: 'balkon 5 m²', k: 1.12 },
      { layout: '2+kk', area: 45, floor: '-1. patro', extra: 'balkon 11 m²', k: 0.74 },
      { layout: '2+kk', area: 47, floor: '1. patro', extra: 'balkon 7 m² · zahrada 51,1 m²', k: 0.735 },
      { layout: '2+kk', area: 53, floor: '1. patro', extra: 'balkon 16 m² · zahrada 55 m²', k: 0.85 },
      { layout: '2+kk', area: 59, floor: '1. patro', extra: 'balkon 4 m² · zahrada 101,6 m²', k: 0.875 },
      { layout: '2+kk', area: 49, floor: '2. patro', extra: 'balkon 3 m²', k: 0.725 },
      { layout: '3+kk', area: 92, floor: '2. patro', extra: 'balkon 6 m²', k: 1.17 },
      { layout: '3+kk', area: 92, floor: '4. patro', extra: 'balkon 6 m²', k: 1.2, reserved: true },
    ];
    return rows.map((r) => ({
      ...r,
      price: Math.round((base * r.k) / 1000) * 1000,
    }));
  }
  function lockCard(title: string, text: string) {
    return `
      <div class="kp-lock-card kp-d-lock-card">
        <div class="kp-lock-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5.5" y="11" width="13" height="9" rx="0"/>
            <path d="M8 11V8.4a4 4 0 0 1 8 0V11"/>
          </svg>
        </div>
        <h2 class="kp-lock-title font-yellix">${title}</h2>
        <p class="kp-lock-text font-yellix">${text}</p>
        <button type="button" class="kp-lock-cta font-yellix" data-smart-meeting-open data-smart-meeting-type="client">
          <img src="/images/arrow-1.svg" alt="" width="12" height="12" />
          Domluvit schůzku
        </button>
      </div>
    `;
  }
  function filtered() {
    return projects;
  }
  function pickMeta(id: string) {
    const i = VYBER.findIndex((item) => item.id === id);
    return i < 0 ? null : { ...VYBER[i], rank: i + 1 };
  }
  function cardHtml(p: Project) {
    if (isDemoPage()) return cardHtmlMobile(p);
    const color = fallback(p.id);
    const tr = trendOf(p);
    const meta = pickMeta(p.id);
    const rank = String(meta?.rank || 0).padStart(2, '0');
    const rankLabel = meta?.rank === 1 ? `${rank} · Doporučujeme` : rank;
    const units = matchLabel(matchCount(p));
    return `<button type="button" class="kp-card" data-kp-card="${p.id}" style="--kp-fallback:${color}">
      <div class="kp-card-photo">
        ${photo(p.coverUrl, p.name)}
        ${tr ? `<span class="kp-badge kp-badge-trend is-${tr.dir}">${esc(tr.text)}</span>` : ''}
        <span class="kp-badge kp-badge-av">${esc(units)}</span>
      </div>
      <div class="kp-card-body">
        <p class="kp-card-rank${meta?.rank === 1 ? ' is-top' : ''}">${esc(rankLabel)}</p>
        <h3>${esc(p.name)}</h3>
        <p class="kp-card-loc">Praha · ${esc(p.quarter)}</p>
        ${meta?.note ? `<p class="kp-card-note">${esc(meta.note)}</p>` : ''}
        <div class="kp-card-foot">
          ${meta ? `<span class="kp-card-status is-${meta.status.kind}">${esc(meta.status.label)}</span>` : ''}
          <p class="kp-card-pps"><span>od</span> ${milLabel(priceFromWanted(p))}</p>
        </div>
      </div>
    </button>`;
  }
  function cardHtmlMobile(p: Project) {
    const color = fallback(p.id);
    const tr = trendOf(p);
    const meta = pickMeta(p.id);
    const rank = String(meta?.rank || 0).padStart(2, '0');
    const rankLabel = meta?.rank === 1 ? `${rank} · Doporučujeme` : rank;
    const units = matchLabel(matchCount(p));
    const bdg = tr ? (tr.dir === 'down' ? 'is-dn' : tr.dir === 'up' ? 'is-up' : 'is-flat') : '';
    return `<button type="button" class="kp-card" data-kp-card="${p.id}" style="--kp-fallback:${color}">
      <div class="kp-card-photo">
        ${photo(p.coverUrl, p.name)}
        ${tr ? `<span class="kp-bdg ${bdg}">${esc(tr.text)}</span>` : ''}
        <span class="kp-bdg is-units">${esc(units)}</span>
      </div>
      <div class="kp-card-body">
        <span class="kp-card-rank${meta?.rank === 1 ? ' is-top' : ''}">${esc(rankLabel)}</span>
        <h3 class="font-yellix">${esc(p.name)}</h3>
        <p class="kp-card-loc font-yellix">Praha · ${esc(p.quarter)}</p>
        ${meta?.note ? `<p class="kp-card-note font-yellix">${esc(meta.note)}</p>` : ''}
        <div class="kp-cf">
          ${meta ? `<span class="kp-card-status is-${meta.status.kind}">${esc(meta.status.label)}</span>` : ''}
          <p class="kp-card-pps"><span>od</span> ${milLabel(priceFromWanted(p))}</p>
        </div>
      </div>
    </button>`;
  }
  function mapCardHtml(p: Project) {
    const color = fallback(p.id);
    const meta = pickMeta(p.id);
    const rank = String(meta?.rank || 0).padStart(2, '0');
    const rankLabel = meta?.rank === 1 ? `${rank} · Doporučujeme` : rank;
    return `<button type="button" class="kp-mc" data-kp-card="${p.id}" style="--kp-fallback:${color}">
      ${p.coverUrl ? `<img src="${esc(p.coverUrl)}" alt="" loading="lazy">` : `<span class="ph"></span>`}
      <span>
        <span class="rk font-yellix">${esc(rankLabel)}</span>
        <h4 class="font-yellix">${esc(p.name)}</h4>
        <p class="font-yellix">${esc(p.quarter)} · ${esc(odCzk(priceFromWanted(p)))}</p>
        ${meta ? `<span class="kp-card-status is-${meta.status.kind}">${esc(meta.status.label)}</span>` : ''}
      </span>
    </button>`;
  }

  function isDemoPage() {
    return location.pathname.replace(/\/+$/, '').endsWith('/portal-demo/mobil');
  }
  function isMobileApp() {
    return isDemoPage() || window.matchMedia('(max-width: 959px)').matches;
  }
  function shouldBoot() {
    return isDemoPage() || window.matchMedia('(min-width: 1024px)').matches;
  }
  function syncTabClass() {
    if (!root) return;
    const tab = isMobileApp() ? state.tab : 'vyber';
    root.classList.remove('is-tab-vyber', 'is-tab-mapa', 'is-tab-detail', 'is-tab-zpravy');
    root.classList.add(`is-tab-${tab}`);
    root.querySelectorAll('[data-kp-tab]').forEach((btn) => {
      const on = (btn as HTMLElement).dataset.kpTab === tab;
      btn.classList.toggle('is-on', on);
      if (on) btn.setAttribute('aria-current', 'page');
      else btn.removeAttribute('aria-current');
    });
    const chat = root.querySelector('[data-kp-chat]') as HTMLElement | null;
    if (chat) chat.hidden = tab !== 'zpravy';
    window.dispatchEvent(new CustomEvent('kp-demo-detail', { detail: { open: tab === 'detail' } }));
  }
  function applyStartTab() {
    if (!isMobileApp()) {
      state.tab = 'vyber';
      return;
    }
    const q = new URLSearchParams(location.search).get('tab') || 'vyber';
    if (q === 'detail' && projects[0]) {
      state.tab = 'detail';
      state.selected = projects[0].id;
      prevTab = 'vyber';
      return;
    }
    const allowed = ['vyber', 'mapa', 'zpravy'];
    state.tab = allowed.includes(q) ? q : 'vyber';
  }
  function maybeNudge() {
    if (!isDemoPage()) return;
    try {
      if (sessionStorage.getItem('kp-nudge')) return;
      sessionStorage.setItem('kp-nudge', '1');
    } catch {}
    window.dispatchEvent(new Event('kp-demo-nudge'));
  }
  function pushLayer() {
    if (!isDemoPage()) return;
    history.pushState({ kp: true }, '');
  }
  function bootMap() {
    if (mapBooted && map) {
      requestAnimationFrame(() => map?.resize());
      return;
    }
    mapBooted = true;
    loadMapLibre().then(() => {
      ensureMap();
      syncMap(filtered());
    }).catch(() => {});
  }
  function setTab(tab: string) {
    const allowed = ['vyber', 'mapa', 'zpravy'];
    state.tab = allowed.includes(tab) ? tab : 'vyber';
    state.selected = '';
    syncTabClass();
    render();
    if (state.tab === 'mapa') bootMap();
  }

  function render() {
    const list = filtered();
    const empty = qs<HTMLElement>('[data-kp-empty]');
    const cards = qs<HTMLElement>('[data-kp-cards]');
    const app = qs<HTMLElement>('[data-kp-app]');
    const detail = qs<HTMLElement>('[data-kp-detail]');
    const mobile = isMobileApp();
    const showDetail = mobile ? (state.tab === 'detail' && !!state.selected) : !!state.selected;

    syncTabClass();
    app.toggleAttribute('inert', showDetail);
    app.setAttribute('aria-hidden', showDetail ? 'true' : 'false');

    if (showDetail) {
      detail.hidden = false;
      renderDetail(projects.find((p) => p.id === state.selected)!);
      return;
    }

    detail.hidden = true;
    destroyMini();
    const none = list.length === 0;
    empty.hidden = !none;
    cards.hidden = none;
    cards.innerHTML = list.map((p) => cardHtml(p)).join('');
    if (isDemoPage()) {
      const mcards = root?.querySelector('[data-kp-mcards]') as HTMLElement | null;
      if (mcards) mcards.innerHTML = list.map((p) => mapCardHtml(p)).join('');
    }
    requestAnimationFrame(() => {
      map?.resize();
      if (map) syncMap(list);
    });
  }

  function setHover(id: string, opts: { fly?: boolean; pop?: boolean } = {}) {
    state.hover = id;
    root!.querySelectorAll('[data-kp-card]').forEach((el) => {
      el.classList.toggle('is-on', (el as HTMLElement).dataset.kpCard === id);
    });
    markers.forEach(({ id: mid, el }) => {
      if (!el.classList.contains('kp-pin')) return;
      el.classList.toggle('is-on', !!id && mid === id);
    });
    const p = projects.find((x) => x.id === id);
    if (id && p) {
      const card = qs<HTMLElement>('[data-kp-cards]').querySelector(`[data-kp-card="${id}"]`) as HTMLElement | null;
      card?.scrollIntoView({ block: 'nearest' });
      const mcard = root?.querySelector('[data-kp-mcards]')?.querySelector(`[data-kp-card="${id}"]`) as HTMLElement | null;
      mcard?.scrollIntoView({ inline: 'center', block: 'nearest', behavior: prefersLess() ? 'auto' : 'smooth' });
      if (opts.pop && hoverPop && map) {
        hoverPop.setLngLat([p.lng, p.lat]).setHTML(
          `<div class="kp-tip"><strong>${esc(p.name)}</strong>${esc(p.quarter)}<br>${odCzk(priceFromWanted(p))}</div>`
        ).addTo(map);
      }
      if (opts.fly && map && !prefersLess()) {
        map.easeTo({ center: [p.lng, p.lat], duration: 450, essential: true });
      }
    } else {
      hoverPop?.remove();
    }
  }

  function loadMapLibre() {
    return new Promise<void>((resolve, reject) => {
      if ((window as any).maplibregl) return resolve();
      if (!document.getElementById('kp-ml-css')) {
        const link = document.createElement('link');
        link.id = 'kp-ml-css';
        link.rel = 'stylesheet';
        link.href = ML_CSS;
        document.head.appendChild(link);
      }
      if (document.getElementById('kp-ml-js')) {
        const wait = () => ((window as any).maplibregl ? resolve() : setTimeout(wait, 40));
        wait();
        return;
      }
      const s = document.createElement('script');
      s.id = 'kp-ml-js';
      s.src = ML_JS;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('maplibre'));
      document.head.appendChild(s);
    });
  }

  function ensureMap() {
    const box = qs<HTMLElement>('[data-kp-mapbox]');
    const ml = (window as any).maplibregl;
    if (!ml || !box) return;
    if (map) {
      map.resize();
      return;
    }
    map = new ml.Map({
      container: box,
      style: STYLE,
      center: [14.505, 50.105],
      zoom: 12,
      attributionControl: true,
    });
    map.addControl(new ml.NavigationControl({ showCompass: false }), 'bottom-right');
    hoverPop = new ml.Popup({ closeButton: false, closeOnClick: false, offset: 14, className: 'kp-hover-pop' });
    clickPop = new ml.Popup({ offset: 16, maxWidth: '280px' });
    map.on('load', () => syncMap(filtered()));
  }

  function clearMarkers() {
    markers.forEach(({ marker }) => marker.remove());
    markers = [];
  }

  function syncMap(list: Project[]) {
    if (!map) return;
    const ml = (window as any).maplibregl;
    clearMarkers();
    hoverPop?.remove();
    clickPop?.remove();
    const bounds = new ml.LngLatBounds();
    const selected = new Set(list.map((p) => p.id));
    allProjects.forEach((p) => {
      if (selected.has(p.id)) return;
      const el = document.createElement('span');
      el.className = 'kp-pin-rest';
      el.setAttribute('aria-hidden', 'true');
      const marker = new ml.Marker({ element: el, anchor: 'center' }).setLngLat([p.lng, p.lat]).addTo(map);
      markers.push({ id: p.id, marker, el });
    });
    list.forEach((p) => {
      const meta = pickMeta(p.id);
      const el = document.createElement('button');
      el.type = 'button';
      el.className = 'kp-pin';
      el.style.background = pinColor(p.pricePerSmFrom);
      el.dataset.id = p.id;
      el.setAttribute('aria-label', p.name);
      if (isDemoPage() && meta?.rank) el.textContent = String(meta.rank);
      el.addEventListener('mouseenter', () => {
        setHover(p.id, { pop: true });
      });
      el.addEventListener('mouseleave', () => {
        setHover('');
      });
      el.addEventListener('click', (event) => {
        event.stopPropagation();
        if (isDemoPage()) {
          setHover(p.id, { fly: true });
          return;
        }
        if (isMobileApp()) {
          openDetail(p.id);
          return;
        }
        hoverPop?.remove();
        const color = fallback(p.id);
        const tr = trendOf(p);
        const units = matchLabel(matchCount(p));
        clickPop.setLngLat([p.lng, p.lat]).setHTML(
          `<div class="kp-pop">
            <div class="kp-card-photo" style="--kp-fallback:${color}">
              ${photo(p.coverUrl, p.name)}
              ${tr ? `<span class="kp-badge kp-badge-trend is-${tr.dir}">${esc(tr.text)}</span>` : ''}
              <span class="kp-badge kp-badge-av">${esc(units)}</span>
            </div>
            <div class="kp-pop-body">
              <h3>${esc(p.name)}</h3>
              <p>Praha · ${esc(p.quarter)}</p>
              <strong><span style="font-size:12px;font-weight:500;color:rgba(0,0,0,.45)">od</span> ${milLabel(priceFromWanted(p))}</strong>
              <button type="button" data-kp-open="${p.id}">Otevřít detail</button>
            </div>
          </div>`
        ).addTo(map);
        clickPop.getElement()?.querySelector('[data-kp-open]')?.addEventListener('click', (e: Event) => {
          e.preventDefault();
          e.stopPropagation();
          openDetail(p.id);
        });
      });
      const marker = new ml.Marker({ element: el, anchor: 'center' }).setLngLat([p.lng, p.lat]).addTo(map);
      markers.push({ id: p.id, marker, el });
      bounds.extend([p.lng, p.lat]);
    });
    if (list.length) {
      const pad = isDemoPage()
        ? { top: 96, right: 56, bottom: 168, left: 24 }
        : { top: 56, right: 88, bottom: 48, left: 40 };
      map.fitBounds(bounds, { padding: pad, maxZoom: 12.7, duration: prefersLess() ? 0 : 500 });
    }
  }

  function destroyMap() {
    clearMarkers();
    hoverPop?.remove();
    clickPop?.remove();
    map?.remove();
    map = null;
    hoverPop = null;
    clickPop = null;
  }
  function destroyMini() {
    mini?.remove();
    mini = null;
  }
