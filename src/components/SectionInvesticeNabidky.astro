---
interface Slide {
  tab: string;
  kicker: string;
  title: string;
  cta: string;
  note: string;
  aside: string | string[];
  stat: string;
  statLabel: string;
  statPhrase?: boolean;
  playLabel?: string;
  image: string;
}

interface Props {
  variant?: 'investice' | 'bydleni';
}

const investiceSlides: Slide[] = [
  {
    tab: 'Neveřejné nabídky a předprodeje',
    kicker: 'Neveřejné nabídky a předprodeje',
    title: 'Dostaňte se k příležitostem dřív, než se objeví ve veřejné nabídce.',
    cta: 'Registrovat k předprodeji',
    note: 'U vybraných projektů řešíme předprodeje, přednostní výběr jednotek a nabídky, které se na běžných portálech vůbec nemusí objevit.',
    aside:
      'Nejzajímavější jednotky často mizí ještě před tím, než si jich všimne širší trh. Díky kontaktům na developerském trhu umíme klientům otevřít přístup k nabídkám ve chvíli, kdy se o nich teprve začíná jednat.',
    stat: 'až 15 %',
    statLabel: 'výhodnější cenová pozice\nu vybraných předprodejů',
    image: '/images/reamar-presale.webp',
  },
  {
    tab: 'Postoupení smlouvy',
    kicker: 'Postoupení smlouvy',
    title: 'Investiční byt nemusíte vždy držet až do převzetí.',
    cta: 'Najít byt na flip',
    note: 'U vhodně vybraných jednotek může investor pracovat s růstem hodnoty už během výstavby a smlouvu postoupit ještě před doplacením celé kupní ceny.',
    aside:
      'Při nákupu v předprodeji investor často hradí jen část kupní ceny na začátku. Pokud se projekt, lokalita nebo cenová hladina posune, může vzniknout prostor pro postoupení smlouvy dalšímu kupujícímu ještě před dokončením.',
    stat: 'před doplacením',
    statPhrase: true,
    statLabel: 'možnost vystoupit z projektu\npostoupením smlouvy',
    image: '/images/Prodej/postoupeni.png',
  },
  {
    tab: 'Platební podmínky',
    kicker: 'Platební podmínky',
    title: 'Vstupte do projektu s menším kapitálem na začátku.',
    cta: 'Chci nižší financování',
    note: 'U vybraných předprodejů stačí uhradit část kupní ceny při podpisu a zbytek řešit až při dokončení projektu.',
    aside:
      'Platební kalendář může zásadně změnit ekonomiku investice. Pokud investor platí jen menší část ceny na začátku, kapitál mu zůstává déle k dispozici a financování řeší až ve chvíli, kdy je projekt blíž dokončení.',
    stat: '10 / 90',
    statLabel: '10 % při podpisu,\n90 % až při dokončení',
    image: '/images/Prodej/investicni.png',
  },
  {
    tab: 'Investorské balíčky',
    kicker: 'Investorské balíčky',
    title: 'Méně náhodných nabídek. Více jednotek, které dávají investiční smysl.',
    cta: 'Připravit výběr',
    note: 'Připravujeme užší výběry jednotek podle rozpočtu, strategie a cíle investora. Nejde o seznam celého trhu, ale o výběr k rozhodnutí.',
    aside:
      'Investorský balíček skládáme z jednotek, které prošly základním filtrem ceny, lokality, dispozice, nájemního potenciálu a budoucí likvidity. Investor tak nemusí začínat od nuly a procházet stovky nabídek bez kontextu.',
    stat: '3 až 10',
    statLabel: 'jednotek v jednom\ninvestorském výběru',
    image: '/images/agency/projekty-seznam.webp',
  },
];

const bydleniSlides: Slide[] = [
  {
    tab: 'Vlastní software',
    kicker: 'Vlastní software',
    title: 'Přístup k celému trhu novostaveb.',
    cta: 'Spustit výběr',
    note: 'Naším cílem není ukázat klientovi co nejvíce možností. Naším cílem je vybrat ty správné.',
    aside: [
      'Propojujeme vlastní monitoring novostaveb, tržní data a zkušenosti z reálného prodeje developerských projektů. Pomocí AI je vyhodnocujeme v souvislostech a převádíme do praktického pohledu na konkrétní jednotky.',
      'Díky tomu vidíme trh v hloubce, kterou běžné portály ani samostatné veřejné ceníky nenabízejí.',
    ],
    stat: '9 567',
    statLabel: 'jednotek aktuálně na primárním trhu\nv Praze a okolí',
    image: '/images/agency/statistiky.webp',
    playLabel: 'Přehrát ukázku',
  },
  {
    tab: 'Neveřejné nabídky a předprodeje',
    kicker: 'Neveřejné nabídky a předprodeje',
    title: 'Nejlepší nabídky bývají často skryté.',
    cta: 'Registrovat k předprodeji',
    note: 'U vybraných projektů se dostáváme k jednotkám ještě před tím, než se objeví na webu projektu nebo realitních portálech.',
    aside:
      'Dobrý byt často zmizí dřív, než se dostane do běžné nabídky. Díky kontaktům na trhu umíme klientům otevřít předprodeje, přednostní výběry a neveřejné příležitosti, které nejsou dostupné každému.',
    stat: '72',
    statLabel: 'neveřejných nebo přednostních příležitostí\nv aktivním výběru',
    image: '/images/reamar-presale.webp',
  },
  {
    tab: 'Zvýhodněné podmínky',
    kicker: 'Zvýhodněné podmínky',
    title: 'Dohodneme podmínky, na které kupující sám často nedosáhne.',
    cta: 'Zadat preference',
    note: 'Řešíme cenu, splátkový kalendář, rezervaci i další výhody, které mohou nákup posunout o stovky tisíc korun.',
    aside:
      'Developer s běžným kupujícím často drží standardní nabídku. My víme, kdy má smysl jednat o ceně, kdy o platebním režimu a kdy je větší hodnota v rezervaci, vybavení, parkování nebo přednostní pozici u jednotky.',
    stat: 'stovky tisíc\u00A0Kč',
    statPhrase: true,
    statLabel: 'rozdíl, který může vzniknout při správně\nvedeném jednání s developerem',
    image: '/images/agency/vyjednavani.webp',
  },
  {
    tab: 'Právní servis',
    kicker: 'Právní servis',
    title: 'Prověříme developera i smlouvy k podpisu.',
    cta: 'Domluvit konzultaci',
    note: 'Zkontrolujeme developera, smlouvy, termíny, platební režim i závazky, které z nákupu vyplývají.',
    aside:
      'Některá rizika nejsou vidět v ceníku. Mohou být v harmonogramu, smlouvách, platebních podmínkách nebo historii developera. Proto se díváme nejen na byt, ale i na celý nákup kolem něj.',
    stat: 'bezpečný nákup',
    statPhrase: true,
    statLabel: 'společně s výběrem bytu dostanete i naše\nposouzení developera a smluv',
    image: '/images/agency/story.webp',
  },
