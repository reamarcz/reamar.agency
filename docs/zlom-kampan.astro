<!-- Archiv kampaně: podpisová animace sekce Zlom. Na web se neimportuje. Vrátit = zkopírovat do src/components/OnasZlom.astro a použít místo sloupců. -->


<section class="zl" id="zlom" aria-labelledby="zlom-q">
  <div class="zw">
    <span class="ch"><b>II</b>Zlom</span>
    <p class="lead">
      Zlom přišel, když začal sám nakupovat nemovitosti jako investor. Najednou seděl na druhé straně stolu a uvědomil si jednu věc.
    </p>
    <div class="paper">
      <div class="pp-top">
        <div>
          <small>Kupní smlouva</small>
          <b>Bytová jednotka v novostavbě</b>
        </div>
        <span>čl. 12 · Podpisy smluvních stran</span>
      </div>
      <div class="pp-lines" aria-hidden="true">
        <i style="width:92%"></i>
        <i style="width:86%"></i>
        <i style="width:64%"></i>
      </div>
      <div class="r r1">
        <small>Za prodávajícího</small>
        <div class="sl">
          <b><span class="ty">Developer</span></b>
          <i></i>
        </div>
        <p>chce co nejlépe prodat svůj projekt.</p>
        <em>✓ zastoupen</em>
      </div>
      <div class="r r2">
        <small>Za zprostředkovatele</small>
        <div class="sl">
          <b><span class="ty">Realitní makléř</span></b>
          <i></i>
        </div>
        <p>potřebuje udat portfolio svých nemovitostí.</p>
        <em>✓ zastoupen</em>
      </div>
      <div class="r r3">
        <small>Za kupujícího</small>
        <div class="sl">
          <b><span class="caret" aria-hidden="true"></span></b>
          <i></i>
        </div>
        <p>Vy. Chcete hlavně dobře nakoupit.</p>
        <em class="stamp">Nezastoupen</em>
      </div>
    </div>
    <p class="every">Každý přirozeně hájí zájmy toho, koho zastupuje.</p>
    <h2 class="q" id="zlom-q"><span>Ale kdo</span><span>zastupuje vás?</span></h2>
  </div>
</section>

<style>
  .zl {
    background: #0b0b0b;
    color: #fff;
    font-family: 'Yellix', system-ui, sans-serif;
    font-weight: 500;
    -webkit-font-smoothing: antialiased;
    padding: 120px 0 140px;
  }
  .zl * { box-sizing: border-box; }
  .zw {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 56px;
  }
  .ch {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .55);
    margin-bottom: 28px;
  }
  .ch b {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    border: 1px solid currentColor;
    font-weight: 500;
    font-size: 13px;
  }
  .lead {
    margin: 0 0 64px;
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: -.02em;
    max-width: 36ch;
    color: rgba(255, 255, 255, .85);
  }
  .paper {
    position: relative;
    background: #fbfbf8;
    color: #111;
    padding: 44px 56px 40px;
    box-shadow: 0 40px 90px -20px rgba(0, 0, 0, .8), 0 0 0 1px rgba(255, 255, 255, .04);
    margin-bottom: 80px;
  }
  .paper::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, .025), rgba(0, 0, 0, 0) 30%);
    pointer-events: none;
  }
  .pp-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(0, 0, 0, .15);
  }
  .pp-top small {
    display: block;
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, .45);
    margin-bottom: 6px;
  }
  .pp-top b {
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -.02em;
  }
  .pp-top span {
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, .45);
  }
  .pp-lines {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 20px 0 6px;
  }
  .pp-lines i {
    display: block;
    height: 6px;
    background: #e7e7e3;
  }
  .r {
    display: grid;
    grid-template-columns: 200px 1fr 1fr 170px;
    gap: 40px;
    align-items: end;
    padding: 30px 0 18px;
    border-bottom: 1px solid rgba(0, 0, 0, .08);
  }
  .r:last-child { border-bottom: 0; }
  .r small {
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, .5);
    padding-bottom: 6px;
  }
  .sl {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sl b {
    font-weight: 500;
    font-size: 28px;
    letter-spacing: -.02em;
    min-height: 34px;
    display: flex;
    align-items: flex-end;
    color: #111;
  }
  .sl i {
    display: block;
    height: 1px;
    background: #111;
    transform-origin: 0 50%;
  }
  .r p {
    margin: 0;
    font-size: 17px;
    line-height: 1.4;
    color: rgba(0, 0, 0, .6);
    padding-bottom: 6px;
  }
  .r em {
    font-style: normal;
    font-size: 14px;
    color: rgba(0, 0, 0, .55);
    justify-self: end;
    padding-bottom: 6px;
  }
  .r3 small,
  .r3 p { color: #111; }
  .r3 .sl i { height: 2px; }
  .caret {
    display: inline-block;
    width: 2px;
    height: 30px;
    background: #111;
  }
  .stamp {
    color: #e0002a !important;
    border: 2px solid #e0002a;
    padding: 6px 10px 5px;
    font-size: 13px !important;
    letter-spacing: .14em;
    text-transform: uppercase;
    transform: rotate(-6deg);
  }
  .every {
    margin: 0 0 64px;
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: -.025em;
  }
  .q {
    margin: 0;
    font-size: 150px;
    line-height: .9;
    letter-spacing: -.055em;
    font-weight: 500;
  }
  .q span { display: block; }

  @media (prefers-reduced-motion: no-preference) {
    .paper { animation: up .8s cubic-bezier(.22, 1, .36, 1) .1s both; }
    .pp-lines i { animation: draw .6s cubic-bezier(.22, 1, .36, 1) both; }
    .pp-lines i:nth-child(1) { animation-delay: .5s; }
    .pp-lines i:nth-child(2) { animation-delay: .6s; }
    .pp-lines i:nth-child(3) { animation-delay: .7s; }
    .pp-lines i { transform-origin: 0 50%; }
    .r1 .sl i { animation: draw .6s cubic-bezier(.22, 1, .36, 1) 1.0s both; }
    .r1 .ty { animation: type .7s steps(9) 1.4s both; }
    .r1 p { animation: fade .5s ease 1.9s both; }
    .r1 em { animation: fade .4s ease 2.2s both; }
    .r2 .sl i { animation: draw .6s cubic-bezier(.22, 1, .36, 1) 2.4s both; }
    .r2 .ty { animation: type .9s steps(15) 2.8s both; }
    .r2 p { animation: fade .5s ease 3.5s both; }
    .r2 em { animation: fade .4s ease 3.8s both; }
    .r3 .sl i { animation: draw .7s cubic-bezier(.22, 1, .36, 1) 4.1s both; }
    .caret { animation: fade .2s 4.6s both, blink 1s steps(1) 4.8s infinite; }
    .r3 p { animation: fade .5s ease 5.0s both; }
    .stamp { animation: stamp .45s cubic-bezier(.2, 1.6, .4, 1) 5.7s both; }
    .every { animation: upt .7s cubic-bezier(.22, 1, .36, 1) 6.4s both; }
    .q span:nth-child(1) { animation: upt .8s cubic-bezier(.22, 1, .36, 1) 7.0s both; }
    .q span:nth-child(2) { animation: upt .8s cubic-bezier(.22, 1, .36, 1) 7.25s both; }
  }
  .ty {
    display: inline-block;
    white-space: nowrap;
    overflow: hidden;
    vertical-align: bottom;
  }
  @keyframes up {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes upt {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes draw {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes type {
    from { max-width: 0; }
    to { max-width: 16ch; }
  }
  @keyframes fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  @keyframes stamp {
    0% { opacity: 0; transform: rotate(-6deg) scale(1.8); }
    100% { opacity: 1; transform: rotate(-6deg) scale(1); }
  }

  .zl:not(.is-in) * { animation-play-state: paused !important; }

  @media (prefers-reduced-motion: reduce) {
    .zl * { animation: none !important; }
  }

  @media (max-width: 767px) {
    .zl { padding: 80px 0 96px; }
    .zw { padding: 0 20px; }
    .lead { font-size: 21px; margin-bottom: 40px; }
    .paper { padding: 26px 20px 22px; margin-bottom: 56px; }
    .pp-top { flex-direction: column; align-items: flex-start; gap: 8px; }
    .pp-top b { font-size: 18px; }
    .r {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'role em' 'sl sl' 'p p';
      gap: 10px 16px;
      padding: 22px 0 16px;
    }
    .r small { grid-area: role; }
    .r .sl { grid-area: sl; }
    .r p { grid-area: p; font-size: 15px; }
    .r em { grid-area: em; align-self: start; }
    .sl b { font-size: 22px; min-height: 28px; }
    .caret { height: 24px; }
    .every { font-size: 22px; margin-bottom: 40px; }
    .q { font-size: 46px; }
  }
</style>

<script>
  function initOnasZlom() {
    const el = document.getElementById('zlom');
    if (!el || el.dataset.onasZlomInit === '1') return;
    el.dataset.onasZlomInit = '1';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.classList.add('is-in');
      return;
    }
    if (!('IntersectionObserver' in window)) {
      el.classList.add('is-in');
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          el.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.25 }
    );
    io.observe(el);
  }

  initOnasZlom();
  document.addEventListener('astro:page-load', initOnasZlom);
</script>
